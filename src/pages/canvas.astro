---
import "../styles/global.css";
import ReferencesModal from "../components/modals/ReferencesModal.astro";
import ManageAccountModal from "../components/modals/ManageAccountModal.astro";
import GetCreditsModal from "../components/modals/GetCreditsModal.astro";
import LoadingState from "../components/ui/loading-state";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Canvas - Xeni</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/phosphor-icons/1.4.2/css/phosphor.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      body {
        font-family: "Poppins", sans-serif;
      }
      #right-panel {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      #right-panel.collapsed {
        display: none !important;
        width: 0px !important;
        min-width: 0px !important;
        max-width: 0px !important;
        margin: 0px !important;
        padding: 0px !important;
        border: 0px !important;
        border-width: 0px !important;
        border-color: transparent !important;
        opacity: 0 !important;
        pointer-events: none !important;
        overflow: hidden !important;
      }
      /* Minimalist scrollbar for skill-list-container */
      .skill-list-container {
        scrollbar-width: thin;
        scrollbar-color: #d0d5dd transparent;
      }
      .skill-list-container::-webkit-scrollbar {
        width: 4px !important;
        background: transparent !important;
      }
      .skill-list-container::-webkit-scrollbar-track,
      .skill-list-container::-webkit-scrollbar-track-piece {
        background: transparent !important;
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
      }
      .skill-list-container::-webkit-scrollbar-thumb {
        background: #d0d5dd !important;
        border-radius: 10px !important;
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
      }
      .skill-list-container::-webkit-scrollbar-thumb:hover {
        background: #98a2b3 !important;
      }
      .business-dna-options-scrollbar {
        scrollbar-width: thin;
        scrollbar-color: #d0d5dd transparent;
      }
      .business-dna-options-scrollbar::-webkit-scrollbar {
        width: 4px;
        background: transparent;
      }
      .business-dna-options-scrollbar::-webkit-scrollbar-track,
      .business-dna-options-scrollbar::-webkit-scrollbar-track-piece {
        background: transparent;
        border: 0;
      }
      .business-dna-options-scrollbar::-webkit-scrollbar-thumb {
        background: #d0d5dd;
        border: 0;
        border-radius: 999px;
      }
      .business-dna-options-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #98a2b3;
      }
      .chat-table-scroll {
        scrollbar-width: thin;
        scrollbar-color: #d0d5dd transparent;
      }
      .chat-table-scroll::-webkit-scrollbar {
        height: 4px;
      }
      .chat-table-scroll::-webkit-scrollbar-track,
      .chat-table-scroll::-webkit-scrollbar-track-piece {
        background: transparent;
        border: 0;
      }
      .chat-table-scroll::-webkit-scrollbar-thumb {
        background: #d0d5dd;
        border: 0;
        border-radius: 999px;
      }
      .chat-table-scroll::-webkit-scrollbar-thumb:hover {
        background: #98a2b3;
      }

      /* Reference Mini Badge Styles (Compact 22px Pill, Circular Thumbnail, No Box Drop) */
      .ref-badge {
        display: inline-flex !important;
        align-items: center !important;
        gap: 4px !important;
        padding: 0 6px 0 2.5px !important;
        background: #ffffff !important;
        border: 1px solid #e5e7eb !important;
        border-radius: 9999px !important;
        margin: 0 4px 0 0 !important;
        user-select: none !important;
        vertical-align: middle !important;
        height: 22px !important;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04) !important;
        max-width: 200px !important;
        white-space: nowrap !important;
        transition: border-color 0.15s ease !important;
        line-height: 1 !important;
      }
      .ref-badge:hover {
        border-color: #d0d5dd !important;
      }
      .ref-badge .ref-circle,
      .ref-badge .ref-thumb {
        width: 16px !important;
        height: 16px !important;
        border-radius: 9999px !important;
        background-color: #f2f4f7 !important;
        flex-shrink: 0 !important;
        background-size: cover !important;
        background-position: center !important;
        overflow: hidden !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        border: 1px solid rgba(0, 0, 0, 0.08) !important;
      }
      .ref-badge .ref-text {
        font-size: 11.5px !important;
        font-weight: 600 !important;
        color: #111827 !important;
        max-width: 115px !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
        letter-spacing: -0.01em !important;
        line-height: 1 !important;
      }
      .ref-badge .remove-ref-badge {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: 14px !important;
        height: 14px !important;
        border-radius: 9999px !important;
        color: #98a2b3 !important;
        cursor: pointer !important;
        margin-left: 1px !important;
        border: none !important;
        background: transparent !important;
        padding: 0 !important;
        transition: all 0.15s ease !important;
      }
      .ref-badge .remove-ref-badge:hover {
        color: #111827 !important;
        background-color: #f3f4f6 !important;
      }

      /* Dashboard-style Outline Wipe Light Animation around shape (matching draft-border-shine) */
      .draft-border-shine-overlay {
        position: absolute;
        inset: -1.5px;
        border-radius: 24.5px;
        pointer-events: none;
        background:
          linear-gradient(to right, white, white),
          linear-gradient(135deg, #eaecf0 35%, #111827 50%, #eaecf0 65%);
        background-clip: padding-box, border-box;
        background-origin: padding-box, border-box;
        border: 1.5px solid transparent;
        background-size: 200% 100%;
        box-shadow: none;
        z-index: 0;
        opacity: 0;
        will-change: background-position, opacity;
        transform: translateZ(0);
        backface-visibility: hidden;
      }

      .draft-border-shine-overlay.animate-wipe-1x {
        animation: border-glow-flow-canvas 2.6s linear forwards;
      }

      @keyframes border-glow-flow-canvas {
        0% {
          opacity: 0;
          background-position: 150% center;
        }
        15% {
          opacity: 1;
        }
        80% {
          opacity: 1;
        }
        100% {
          opacity: 0;
          background-position: -150% center;
        }
      }

      /* Blue Stroke with Light Swipe Animation for Generating Canvas Frame */
      .frame-generating-border-shine {
        position: absolute;
        inset: -2px;
        border-radius: 4px;
        pointer-events: none;
        padding: 2.5px;
        background: linear-gradient(
          135deg,
          #2563eb 20%,
          #93c5fd 42%,
          #ffffff 50%,
          #93c5fd 58%,
          #2563eb 80%
        );
        background-size: 250% 100%;
        -webkit-mask:
          linear-gradient(#fff 0 0) content-box,
          linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask:
          linear-gradient(#fff 0 0) content-box,
          linear-gradient(#fff 0 0);
        mask-composite: exclude;
        box-shadow: 0 0 24px rgba(37, 99, 235, 0.35);
        z-index: 20;
        animation: frame-border-glow-blue 2s linear infinite;
      }

      @keyframes frame-border-glow-blue {
        0% {
          background-position: 250% center;
        }
        100% {
          background-position: -250% center;
        }
      }

      @keyframes badge-pop-in {
        0% {
          transform: scale(0.8);
          opacity: 0.4;
        }
        55% {
          transform: scale(1.08);
          opacity: 1;
        }
        100% {
          transform: scale(1);
          opacity: 1;
        }
      }
      .badge-pop-highlight {
        animation: badge-pop-in 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      /* Minimalist Black & White Uploading with Wipe Light Shine */
      @keyframes frame-shine-swipe {
        0% {
          transform: translateX(-150%) skewX(-20deg);
        }
        45%,
        100% {
          transform: translateX(250%) skewX(-20deg);
        }
      }
      .frame-shine-sweep {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
          90deg,
          transparent 0%,
          rgba(255, 255, 255, 0.04) 30%,
          rgba(255, 255, 255, 0.22) 50%,
          rgba(255, 255, 255, 0.04) 70%,
          transparent 100%
        );
        animation: frame-shine-swipe 2.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
        pointer-events: none;
        z-index: 10;
      }

      @keyframes pill-shine-swipe {
        0% {
          left: -100%;
        }
        45%,
        100% {
          left: 200%;
        }
      }
      .pill-shine {
        position: relative;
        overflow: hidden;
      }
      .pill-shine::after {
        content: "";
        position: absolute;
        top: 0;
        left: -100%;
        width: 60%;
        height: 100%;
        background: linear-gradient(
          90deg,
          transparent 0%,
          rgba(255, 255, 255, 0.18) 50%,
          transparent 100%
        );
        transform: skewX(-25deg);
        animation: pill-shine-swipe 2.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
        pointer-events: none;
      }

      @keyframes matrix-scan {
        0% {
          transform: translateY(-100%);
        }
        100% {
          transform: translateY(100%);
        }
      }
      @keyframes matrix-shimmer {
        0% {
          transform: translateX(-100%);
        }
        100% {
          transform: translateX(100%);
        }
      }
      .animate-matrix-shimmer {
        animation: matrix-shimmer 2.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
      }
      .animate-matrix-scan {
        animation: matrix-scan 2.8s linear infinite;
      }
    </style>

    <style is:global>
      .star-rating-container {
        display: inline-flex !important;
        flex-direction: row-reverse !important;
        gap: 4px !important;
      }
      .star-rating-container > svg {
        cursor: pointer !important;
        transition:
          color 0.15s ease,
          transform 0.1s ease !important;
        color: #d0d5dd !important;
      }
      .star-rating-container > svg:hover {
        transform: scale(1.15) !important;
      }
      .star-rating-container:hover > svg {
        color: #d0d5dd !important;
      }
      .star-rating-container > svg:hover,
      .star-rating-container > svg:hover ~ svg {
        color: #f59e0b !important;
      }
      .star-rating-container.rated > svg.active,
      .star-rating-container.rated > svg.active ~ svg {
        color: #f59e0b !important;
      }

      @keyframes matrix-scan {
        0% {
          transform: translateY(-100%);
        }
        100% {
          transform: translateY(100%);
        }
      }
      @keyframes matrix-shimmer {
        0% {
          transform: translateX(-100%);
        }
        100% {
          transform: translateX(100%);
        }
      }
      .animate-matrix-shimmer {
        animation: matrix-shimmer 2.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
      }
      .animate-matrix-scan {
        animation: matrix-scan 2.8s linear infinite;
      }
    </style>
  </head>
  <body
    class="flex flex-col h-screen w-screen overflow-hidden bg-[#F3F4F6] text-[#111827] antialiased"
  >
    <!-- Modal Injections -->
    <ReferencesModal />
    <ManageAccountModal />
    <GetCreditsModal />

    <!-- MAIN WORKSPACE -->
    <main class="flex-1 flex overflow-hidden">
      <!-- LEFT PANEL: CANVAS -->
      <section
        class="flex-1 relative bg-[#F5F5F7] overflow-hidden flex items-center justify-center"
        id="canvas-container"
      >
        <!-- Top-Left Floating Tools -->
        <div class="absolute top-4 left-4 flex items-center gap-2 z-10">
          <!-- Project Name Badge + Back Button -->
          <div
            class="flex items-center h-9 px-3 pr-4 bg-[#F5F5F7] rounded-full border border-[#eaecf0]"
          >
            <!-- Back Button -->
            <a
              href="/studio"
              class="w-6 h-6 rounded-full flex items-center justify-center hover:bg-black/5 text-[#344054] transition-colors cursor-pointer"
              data-tooltip="Back to Studio"
            >
              <i class="ti ti-chevron-left text-[15px]"></i>
            </a>

            <div class="w-px h-3 bg-[#eaecf0] mx-1.5"></div>

            <div
              class="flex items-center gap-1.5 ml-1 cursor-pointer hover:opacity-80 transition-opacity"
              data-tooltip="Summer Refreshing Drink and Social Media Campaign 2026"
            >
              <i class="ti ti-folder-open text-[14px] text-[#667085]"></i>
              <span
                class="text-[12px] font-medium text-[#344054] truncate max-w-[130px]"
                >Summer Refreshing Drink and Social Media Campaign 2026</span
              >
            </div>
          </div>

          <!-- Undo/Redo & Zoom Pill -->
          <div
            class="flex items-center bg-[#F5F5F7] rounded-full border border-[#eaecf0] px-3 h-9 gap-1.5"
          >
            <button
              id="btn-undo"
              class="w-6 h-6 rounded-full flex items-center justify-center hover:bg-black/5 text-[#667085] transition-colors cursor-pointer opacity-40"
              data-tooltip="Undo"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 256 256"
                class="w-[14px] h-[14px] text-[#667085] shrink-0"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="16"
              >
                <polyline points="80 136 32 88 80 40"></polyline>
                <path d="M80,200h88a56,56,0,0,0,56-56h0a56,56,0,0,0-56-56H32"
                ></path>
              </svg>
            </button>
            <button
              id="btn-redo"
              class="w-6 h-6 rounded-full flex items-center justify-center hover:bg-black/5 text-[#667085] transition-colors cursor-pointer opacity-40"
              data-tooltip="Redo"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 256 256"
                class="w-[14px] h-[14px] text-[#667085] shrink-0"
                fill="currentColor"
              >
                <path
                  d="M170.34,130.34,204.69,96H88a48,48,0,0,0,0,96h88a8,8,0,0,1,0,16H88A64,64,0,0,1,88,80H204.69L170.34,45.66a8,8,0,0,1,11.32-11.32l48,48a8,8,0,0,1,0,11.32l-48,48a8,8,0,0,1-11.32-11.32Z"
                ></path>
              </svg>
            </button>

            <div class="w-px h-3 bg-[#eaecf0] mx-1"></div>

            <!-- Zoom Controls -->
            <button
              id="btn-zoom-out"
              class="w-6 h-6 rounded-full flex items-center justify-center hover:bg-black/5 text-[#667085] transition-colors cursor-pointer"
              data-tooltip="Zoom Out"
            >
              <i class="ti ti-zoom-out text-[14px]"></i>
            </button>
            <div
              id="zoom-level"
              class="px-0.5 text-[12px] font-medium text-[#344054] w-[36px] text-center select-none"
              data-tooltip="Zoom"
            >
              75%
            </div>
            <button
              id="btn-zoom-in"
              class="w-6 h-6 rounded-full flex items-center justify-center hover:bg-black/5 text-[#667085] transition-colors cursor-pointer"
              data-tooltip="Zoom In"
            >
              <i class="ti ti-zoom-in text-[14px]"></i>
            </button>
          </div>
        </div>

        <!-- Top-Right Canvas Tools (Credits with Dropdown) -->
        <div class="absolute top-4 right-4 z-20 flex items-center gap-2">
          <div class="relative" id="credit-wrapper">
            <div
              id="btn-credit"
              class="flex items-center h-9 bg-[#F5F5F7] border border-[#eaecf0] rounded-full px-3 gap-2 hover:border-[#d0d5dd] transition-all cursor-pointer group"
              data-tooltip="Credits"
            >
              <div class="flex items-center gap-1.5">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  class="text-[#344054]"
                  aria-hidden="true"
                >
                  <path
                    d="M17.949 9.61616C20.6497 10.6155 22 11.1151 22 12C22 12.8848 20.6497 13.3845 17.949 14.3838L16.4429 14.9411C15.9036 15.1407 15.6339 15.2405 15.4372 15.4372C15.2405 15.6339 15.1407 15.9036 14.9411 16.4429L14.3838 17.949C13.3845 20.6497 12.8848 22 12 22C11.1151 22 10.6155 20.6497 9.61616 17.949L9.05883 16.4429C8.85926 15.9036 8.75948 15.6339 8.56277 15.4372C8.36606 15.2405 8.09641 15.1407 7.5571 14.9411L6.05093 14.3838C3.3503 13.3845 1.99998 12.8848 1.99998 12C1.99998 11.1151 3.3503 10.6155 6.05093 9.61616L7.5571 9.05883C8.09641 8.85926 8.36606 8.75948 8.56277 8.56277C8.75948 8.36606 8.85926 8.09641 9.05883 7.5571L9.61616 6.05093C10.6155 3.3503 11.1151 1.99998 12 1.99998C12.8848 1.99998 13.3845 3.3503 14.3838 6.05093L14.9411 7.5571C15.1407 8.09641 15.2405 8.36606 15.4372 8.56277C15.6339 8.75948 15.9036 8.85926 16.4429 9.05883L17.949 9.61616Z"
                    fill="currentColor"></path>
                </svg>
                <span
                  id="canvas-credits-badge-val"
                  class="text-[12px] font-medium text-[#344054] leading-none"
                  >30</span
                >
                <i class="ti ti-chevron-down text-[11px] text-[#98a2b3] ml-0.5"
                ></i>
              </div>
            </div>

            <!-- Credit Dropdown (Identical to Studio) -->
            <div
              id="credit-dropdown"
              class="hidden absolute top-full right-0 mt-2 w-60 bg-white border border-[#eaecf0] rounded-xl p-3 z-50 shadow-lg"
            >
              <div class="flex items-center justify-between mb-3">
                <span class="plan-label-free text-[14px] font-medium text-[#111827]">Free</span>
                <div class="plan-label-pro hidden items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" class="shrink-0 text-amber-500" aria-hidden="true">
                    <path d="M239.75,90.81c0,.11,0,.21-.07.32L217,195a16,16,0,0,1-15.72,13H54.71A16,16,0,0,1,39,195L16.32,91.13c0-.11-.05-.21-.07-.32A16,16,0,0,1,44,77.39l33.67,36.29,35.8-80.29a1,1,0,0,0,0-.1,16,16,0,0,1,29.06,0,1,1,0,0,0,0,.1l35.8,80.29L212,77.39a16,16,0,0,1,27.71,13.42Z"></path>
                  </svg>
                  <span class="text-[13px] font-semibold text-[#111827]">Pro Plan</span>
                </div>
                <button
                  class="btn-upgrade-trigger btn-plan-action px-3 py-1.5 rounded-lg bg-[#111827] text-white text-[11px] font-medium hover:bg-black transition-colors cursor-pointer"
                >
                  Upgrade
                </button>
              </div>
              <div class="h-[1px] w-full bg-[#f2f4f7] mb-3"></div>
              <div class="flex flex-col gap-3 mb-3">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2.5">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      class="text-[#111827]"
                      aria-hidden="true"
                    >
                      <path
                        d="M17.949 9.61616C20.6497 10.6155 22 11.1151 22 12C22 12.8848 20.6497 13.3845 17.949 14.3838L16.4429 14.9411C15.9036 15.1407 15.6339 15.2405 15.4372 15.4372C15.2405 15.6339 15.1407 15.9036 14.9411 16.4429L14.3838 17.949C13.3845 20.6497 12.8848 22 12 22C11.1151 22 10.6155 20.6497 9.61616 17.949L9.05883 16.4429C8.85926 15.9036 8.75948 15.6339 8.56277 15.4372C8.36606 15.2405 8.09641 15.1407 7.5571 14.9411L6.05093 14.3838C3.3503 13.3845 1.99998 12.8848 1.99998 12C1.99998 11.1151 3.3503 10.6155 6.05093 9.61616L7.5571 9.05883C8.09641 8.85926 8.36606 8.75948 8.56277 8.56277C8.75948 8.36606 8.85926 8.09641 9.05883 7.5571L9.61616 6.05093C10.6155 3.3503 11.1151 1.99998 12 1.99998C12.8848 1.99998 13.3845 3.3503 14.3838 6.05093L14.9411 7.5571C15.1407 8.09641 15.2405 8.36606 15.4372 8.56277C15.6339 8.75948 15.9036 8.85926 16.4429 9.05883L17.949 9.61616Z"
                        fill="currentColor"></path>
                    </svg>
                    <span class="text-[13px] font-medium text-[#344054]"
                      >Credits</span
                    >
                  </div>
                  <span id="canvas-credits-dropdown-val" class="text-[13px] font-medium text-[#111827]">30</span>
                </div>
              </div>
              <div class="h-[1px] w-full bg-[#f2f4f7] mb-2"></div>
              <button
                id="btn-nav-usage-details"
                class="w-full flex items-center justify-between py-1.5 text-[13px] font-medium text-[#111827] hover:opacity-70 transition-opacity"
              >
                Usage details
                <i class="ti ti-chevron-right text-[13px] text-[#98a2b3]"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- Bottom Floating Tools -->
        <div
          class="absolute bottom-6 left-1/2 -translate-x-1/2 flex items-center bg-white rounded-xl border border-[#eaecf0] p-1.5 z-20 gap-1.5"
        >
          <!-- Selection / Hand Tool -->
          <div id="select-tool-wrapper" class="relative group">
            <!-- Selection Dropdown (Upwards on Hover) -->
            <div
              id="dropdown-select"
