        const carouselCaptions = [
          "🌞 Refresh your day with our signature collection! Swipe right 👉 to explore all roast variants crafted for coffee lovers. Which one is your favourite? #CoffeeVibes #DailyBrew #Carousel",
          "✨ From sunrise till dusk: Here is the complete breakdown of our latest drop. Swipe through ➡️ to see every angle and detail! #NewArrivals #ProductDrop #SwipeLeft",
          "📸 The full gallery is here! Swipe across to discover how each piece comes together to create the ultimate aesthetic. Save this post for later! #LookBook #Aesthetic #Trending",
        ];

        let captionIndex = 0;

        function updateScheduleCarouselUI() {
          if (!scheduleCarouselTrack) return;

          // Animate slide transition
          scheduleCarouselTrack.style.transform = `translateX(-${currentScheduleSlide * 100}%)`;

          const total = scheduleImages.length;
          const isMultiple = total > 1;

          // Counter Badge (Instagram-style: 1/3)
          if (scheduleCarouselBadge && scheduleCarouselCounter) {
            if (isMultiple) {
              scheduleCarouselBadge.classList.remove("hidden");
              scheduleCarouselCounter.textContent = `${currentScheduleSlide + 1}/${total}`;
            } else {
              scheduleCarouselBadge.classList.add("hidden");
            }
          }

          // Post Type Badge
          if (schedulePostTypeBadge) {
            if (isMultiple) {
              schedulePostTypeBadge.innerHTML = `<i class="ti ti-carousel-horizontal text-[12px]"></i> Carousel (${total})`;
              schedulePostTypeBadge.className =
                "px-2 py-0.5 rounded-full bg-blue-50 border border-blue-200 text-[10px] font-medium text-blue-700 shadow-2xs flex items-center gap-1";
            } else {
              schedulePostTypeBadge.textContent = "Single Post";
              schedulePostTypeBadge.className =
                "px-2 py-0.5 rounded-full bg-white border border-[#eaecf0] text-[10px] font-medium text-[#475467] shadow-2xs";
            }
          }

          // Arrow Buttons (shown on card hover via CSS group-hover)
          if (btnSchedulePrev) {
            if (isMultiple) {
              btnSchedulePrev.classList.remove("hidden");
              btnSchedulePrev.disabled = currentScheduleSlide === 0;
            } else {
              btnSchedulePrev.classList.add("hidden");
            }
          }

          if (btnScheduleNext) {
            if (isMultiple) {
              btnScheduleNext.classList.remove("hidden");
              btnScheduleNext.disabled = currentScheduleSlide === total - 1;
            } else {
              btnScheduleNext.classList.add("hidden");
            }
          }

          // Pagination Dots
          if (scheduleCarouselDots) {
            if (isMultiple) {
              scheduleCarouselDots.classList.remove("hidden");
              const dots = scheduleCarouselDots.querySelectorAll(
                ".schedule-carousel-dot",
              );
              dots.forEach((dot, idx) => {
                if (idx === currentScheduleSlide) {
                  dot.className =
                    "schedule-carousel-dot w-2 h-2 rounded-full bg-white shadow-sm transition-all duration-200";
                } else {
                  dot.className =
                    "schedule-carousel-dot w-1.5 h-1.5 rounded-full bg-white/50 transition-all duration-200";
                }
              });
            } else {
              scheduleCarouselDots.classList.add("hidden");
            }
          }

          // Count Indicator
          if (scheduleImagesCount) {
            scheduleImagesCount.textContent = total;
          }

          // Thumbnail Highlight
          if (scheduleThumbnailsStrip) {
            const thumbs = scheduleThumbnailsStrip.querySelectorAll(
              ".schedule-thumb-item",
            );
            thumbs.forEach((th, idx) => {
              if (idx === currentScheduleSlide) {
                th.className =
                  "schedule-thumb-item relative w-10 h-10 rounded-md overflow-hidden border-2 border-[#111827] shadow-xs shrink-0 cursor-pointer transition-all scale-105";
              } else {
                th.className =
                  "schedule-thumb-item relative w-10 h-10 rounded-md overflow-hidden border border-[#eaecf0] opacity-60 hover:opacity-100 shrink-0 cursor-pointer transition-all hover:scale-102";
              }
            });
          }

          // Top Right Remove Button on Preview (only show when >= 2 slides)
          const btnScheduleRemoveSlide = document.getElementById(
            "btn-schedule-remove-slide",
          );
          if (btnScheduleRemoveSlide) {
            if (total >= 2) {
              btnScheduleRemoveSlide.classList.remove("hidden");
            } else {
              btnScheduleRemoveSlide.classList.add("hidden");
            }
          }
        }

        function goToScheduleSlide(index) {
          if (index < 0) index = 0;
          if (index >= scheduleImages.length) index = scheduleImages.length - 1;
          currentScheduleSlide = index;
          updateScheduleCarouselUI();
        }

        function renderScheduleImages() {
          if (!scheduleCarouselTrack) return;

          // Render Slides
          scheduleCarouselTrack.innerHTML = scheduleImages
            .map(
              (imgItem, idx) => `
          <div class="w-full h-full shrink-0 flex items-center justify-center bg-[#0B0F19] relative select-none" data-slide-index="${idx}">
            <img src="${imgItem.src}" alt="${imgItem.title || "Schedule Image"}" class="w-full h-full object-cover select-none pointer-events-none" />
          </div>
        `,
            )
            .join("");

          // Render Dots
          if (scheduleCarouselDots) {
            scheduleCarouselDots.innerHTML = scheduleImages
              .map(
                (_, idx) => `
            <div class="schedule-carousel-dot ${idx === currentScheduleSlide ? "w-2 h-2 rounded-full bg-white shadow-sm" : "w-1.5 h-1.5 rounded-full bg-white/50"} transition-all duration-200"></div>
          `,
              )
              .join("");
          }

          // Render Thumbnails (No remove button on thumbnail strip)
          if (scheduleThumbnailsStrip) {
            scheduleThumbnailsStrip.innerHTML = scheduleImages
              .map(
                (imgItem, idx) => `
            <div class="schedule-thumb-item relative w-10 h-10 rounded-md overflow-hidden border ${idx === currentScheduleSlide ? "border-2 border-[#111827] shadow-xs" : "border-[#eaecf0] opacity-60"} shrink-0 cursor-pointer transition-all" data-index="${idx}">
              <img src="${imgItem.src}" alt="Thumb ${idx + 1}" class="w-full h-full object-cover pointer-events-none" />
              <span class="absolute bottom-0.5 right-0.5 px-1 py-0.2 rounded bg-black/60 backdrop-blur-xs text-white text-[8px] font-medium leading-none pointer-events-none">${idx + 1}</span>
            </div>
          `,
              )
              .join("");

            scheduleThumbnailsStrip
              .querySelectorAll(".schedule-thumb-item")
              .forEach((thumb) => {
                thumb.addEventListener("click", (e) => {
                  e.stopPropagation();
                  const idx = parseInt(thumb.getAttribute("data-index"), 10);
                  goToScheduleSlide(idx);
                });
              });
          }

          updateScheduleCarouselUI();
        }

        function openSchedule() {
          modalSchedule.classList.remove("hidden");
          modalSchedule.classList.add("flex");

          // Extract selected images: Marquee block or shift-click or fallback
          let targetFrames = [];
          if (selectedFrames && selectedFrames.size > 0) {
            targetFrames = Array.from(selectedFrames);
            // Sort left-to-right based on canvas layout
            targetFrames.sort((a, b) => {
              const rectA = a.getBoundingClientRect();
              const rectB = b.getBoundingClientRect();
              return rectA.left - rectB.left;
            });
          } else if (primarySelectedFrame) {
            targetFrames = [primarySelectedFrame];
          } else {
            const allFrames = document.querySelectorAll(".canvas-frame");
            if (allFrames.length > 0) {
              targetFrames = [allFrames[0]];
            }
          }

          scheduleImages = [];
          targetFrames.forEach((frame) => {
            const img = frame.querySelector("img");
            if (img && img.src) {
              scheduleImages.push({
                src: img.src,
                title: frame.getAttribute("data-title") || "Image",
              });
            }
          });

          // Fallback if no images found
          if (scheduleImages.length === 0) {
            const anyImg = document.querySelector(".canvas-frame img");
            if (anyImg) {
              scheduleImages.push({
                src: anyImg.src,
                title: "Image",
              });
            }
          }

          currentScheduleSlide = 0;
          renderScheduleImages();

          // Initialize empty caption & state
          if (scheduleCaptionInput) {
            scheduleCaptionInput.value = "";
            scheduleCaptionInput.classList.remove("opacity-0");
          }
          if (scheduleCaptionSkeleton) {
            scheduleCaptionSkeleton.classList.add("hidden");
          }
          if (btnScheduleGenerateCaption) {
            btnScheduleGenerateCaption.disabled = false;
          }
          if (btnScheduleCaptionText) {
            btnScheduleCaptionText.textContent = "Regenerate";
          }
          const sparkIcon = document.getElementById("caption-sparkle-icon");
          if (sparkIcon) {
            sparkIcon.classList.remove("animate-spin");
          }
          captionIndex = 0;

          // Default Business DNA in Schedule Modal to current selected Business DNA on Canvas if set
          const selectBusinessDnaEl = document.getElementById("select-business-dna");
          if (selectBusinessDnaEl && typeof currentBusinessDna !== "undefined" && currentBusinessDna && currentBusinessDna !== "none") {
            selectBusinessDnaEl.value = currentBusinessDna;
            selectBusinessDnaEl.dispatchEvent(new Event("change"));
          }

          // Set default date to today if empty
          if (scheduleDateInput && !scheduleDateInput.value) {
            const now = new Date();
            const yyyy = now.getFullYear();
            const mm = String(now.getMonth() + 1).padStart(2, "0");
            const dd = String(now.getDate()).padStart(2, "0");
            scheduleDateInput.value = `${yyyy}-${mm}-${dd}`;
          }

          // Reset Time to default 9:00 AM
          if (scheduleSelectHour) scheduleSelectHour.value = "9";
          if (scheduleSelectMinute) scheduleSelectMinute.value = "00";
          if (scheduleSelectPeriod) scheduleSelectPeriod.value = "AM";

          if (contextMenu) {
            contextMenu.style.opacity = "0";
            contextMenu.style.pointerEvents = "none";
          }
        }

        function closeSchedule() {
          modalSchedule.classList.add("hidden");
          modalSchedule.classList.remove("flex");
        }

        if (btnScheduleImage) {
          btnScheduleImage.addEventListener("click", (e) => {
            e.stopPropagation();
            openSchedule();
          });
        }

        if (btnSchedulePrev) {
          btnSchedulePrev.addEventListener("click", (e) => {
            e.stopPropagation();
            goToScheduleSlide(currentScheduleSlide - 1);
          });
        }

        if (btnScheduleNext) {
          btnScheduleNext.addEventListener("click", (e) => {
            e.stopPropagation();
            goToScheduleSlide(currentScheduleSlide + 1);
          });
        }

        // Remove current slide from big preview button
        const btnScheduleRemoveSlide = document.getElementById(
          "btn-schedule-remove-slide",
        );
        if (btnScheduleRemoveSlide) {
          btnScheduleRemoveSlide.addEventListener("click", (e) => {
            e.stopPropagation();
            if (scheduleImages.length <= 1) return;
            scheduleImages.splice(currentScheduleSlide, 1);
            if (currentScheduleSlide >= scheduleImages.length) {
              currentScheduleSlide = Math.max(0, scheduleImages.length - 1);
            }
            renderScheduleImages();
          });
        }

        // Click on mini fullscreen button to open Fullscreen Lightbox
        const btnScheduleFullscreenTrigger = document.getElementById(
          "btn-schedule-fullscreen-trigger",
        );
        if (btnScheduleFullscreenTrigger) {
          btnScheduleFullscreenTrigger.addEventListener("click", (e) => {
            e.stopPropagation();
            openScheduleLightbox(currentScheduleSlide);
          });
        }

        // Fullscreen Image Lightbox Logic (Image Only Preview)
        const modalScheduleLightbox = document.getElementById(
          "modal-schedule-lightbox",
        );
        const closeScheduleLightboxBtn = document.getElementById(
          "close-schedule-lightbox",
        );
        const scheduleLightboxImg = document.getElementById(
          "schedule-lightbox-img",
        );
        const scheduleLightboxBadge = document.getElementById(
          "schedule-lightbox-badge",
        );
        const scheduleLightboxCounter = document.getElementById(
          "schedule-lightbox-counter",
        );
        const btnScheduleLightboxPrev = document.getElementById(
          "btn-schedule-lightbox-prev",
        );
        const btnScheduleLightboxNext = document.getElementById(
          "btn-schedule-lightbox-next",
        );

        function updateLightboxUI() {
          if (!scheduleImages || scheduleImages.length === 0) return;
          const currentItem = scheduleImages[currentScheduleSlide];
          if (currentItem && scheduleLightboxImg) {
            scheduleLightboxImg.src = currentItem.src;
            scheduleLightboxImg.alt = currentItem.title || "Fullscreen Preview";
          }

          const total = scheduleImages.length;
          if (scheduleLightboxBadge && scheduleLightboxCounter) {
            if (total > 1) {
              scheduleLightboxBadge.classList.remove("hidden");
              scheduleLightboxCounter.textContent = `${currentScheduleSlide + 1}/${total}`;
            } else {
              scheduleLightboxBadge.classList.add("hidden");
            }
          }

          if (btnScheduleLightboxPrev) {
            if (total > 1) {
              btnScheduleLightboxPrev.classList.remove("hidden");
              btnScheduleLightboxPrev.style.opacity =
                currentScheduleSlide === 0 ? "0" : "1";
              btnScheduleLightboxPrev.style.pointerEvents =
                currentScheduleSlide === 0 ? "none" : "auto";
            } else {
              btnScheduleLightboxPrev.classList.add("hidden");
            }
          }

          if (btnScheduleLightboxNext) {
            if (total > 1) {
              btnScheduleLightboxNext.classList.remove("hidden");
              btnScheduleLightboxNext.style.opacity =
                currentScheduleSlide === total - 1 ? "0" : "1";
              btnScheduleLightboxNext.style.pointerEvents =
                currentScheduleSlide === total - 1 ? "none" : "auto";
            } else {
              btnScheduleLightboxNext.classList.add("hidden");
            }
          }

          // Keep carousel track synced
          updateScheduleCarouselUI();
        }

        function openScheduleLightbox(index) {
          if (
            !modalScheduleLightbox ||
            !scheduleImages ||
            scheduleImages.length === 0
          )
            return;
          currentScheduleSlide =
            typeof index === "number" ? index : currentScheduleSlide;
          updateLightboxUI();
          modalScheduleLightbox.classList.remove("hidden");
          modalScheduleLightbox.classList.add("flex");
        }

        function closeScheduleLightbox() {
          if (!modalScheduleLightbox) return;
          modalScheduleLightbox.classList.add("hidden");
          modalScheduleLightbox.classList.remove("flex");
        }

        if (closeScheduleLightboxBtn) {
          closeScheduleLightboxBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            closeScheduleLightbox();
          });
        }

        if (modalScheduleLightbox) {
          modalScheduleLightbox.addEventListener("click", (e) => {
            if (
              e.target === modalScheduleLightbox ||
              e.target === scheduleLightboxImg
            ) {
              closeScheduleLightbox();
            }
          });
        }

        if (btnScheduleLightboxPrev) {
          btnScheduleLightboxPrev.addEventListener("click", (e) => {
            e.stopPropagation();
            if (currentScheduleSlide > 0) {
              currentScheduleSlide--;
              updateLightboxUI();
            }
          });
        }

        if (btnScheduleLightboxNext) {
          btnScheduleLightboxNext.addEventListener("click", (e) => {
            e.stopPropagation();
            if (currentScheduleSlide < scheduleImages.length - 1) {
              currentScheduleSlide++;
              updateLightboxUI();
            }
          });
        }

        document.addEventListener("keydown", (e) => {
          if (
            modalScheduleLightbox &&
            !modalScheduleLightbox.classList.contains("hidden")
          ) {
            if (e.key === "Escape") {
              closeScheduleLightbox();
            } else if (e.key === "ArrowLeft") {
              if (currentScheduleSlide > 0) {
                currentScheduleSlide--;
                updateLightboxUI();
              }
            } else if (e.key === "ArrowRight") {
              if (currentScheduleSlide < scheduleImages.length - 1) {
                currentScheduleSlide++;
                updateLightboxUI();
              }
            }
          }
        });

        // Swipe support on preview card for mobile/touch
        const schedulePreviewCard = document.querySelector(
          '#modal-schedule [class*="aspect-"]',
        );
        if (schedulePreviewCard) {
          let touchStartX = 0;
          let touchEndX = 0;

          schedulePreviewCard.addEventListener(
            "touchstart",
            (e) => {
              touchStartX = e.changedTouches[0].screenX;
            },
            { passive: true },
          );

          schedulePreviewCard.addEventListener(
            "touchend",
            (e) => {
              touchEndX = e.changedTouches[0].screenX;
              const diff = touchStartX - touchEndX;
              if (Math.abs(diff) > 40) {
                if (diff > 0) {
                  goToScheduleSlide(currentScheduleSlide + 1);
                } else {
                  goToScheduleSlide(currentScheduleSlide - 1);
                }
              }
            },
            { passive: true },
          );
        }

        // Regenerate Caption modal for Canvas
        const modalRegenCanvas = document.getElementById("modal-regenerate-canvas");
        const closeRegenCanvas = document.getElementById("close-regenerate-modal-canvas");
        const submitRegenCanvas = document.getElementById("btn-submit-regenerate-canvas");

        function openRegenCanvasModal() {
          if (modalRegenCanvas) {
            modalRegenCanvas.classList.remove("hidden");
            modalRegenCanvas.classList.add("flex");
          }
          const prompt = document.getElementById("regenerate-prompt-canvas");
          if (prompt) prompt.value = "";
        }

        function closeRegenCanvasModal() {
          if (modalRegenCanvas) {
            modalRegenCanvas.classList.add("hidden");
            modalRegenCanvas.classList.remove("flex");
          }
        }

        if (btnScheduleGenerateCaption) {
          btnScheduleGenerateCaption.addEventListener("click", (e) => {
            e.stopPropagation();
            openRegenCanvasModal();
          });
        }
        if (closeRegenCanvas) {
          closeRegenCanvas.addEventListener("click", closeRegenCanvasModal);
        }
        if (modalRegenCanvas) {
          modalRegenCanvas.addEventListener("click", (e) => {
            if (e.target === modalRegenCanvas) closeRegenCanvasModal();
          });
        }

        if (submitRegenCanvas) {
          submitRegenCanvas.addEventListener("click", () => {
            closeRegenCanvasModal();

            if (btnScheduleGenerateCaption && scheduleCaptionInput) {
              btnScheduleGenerateCaption.disabled = true;
              if (btnScheduleCaptionText)
                btnScheduleCaptionText.textContent = "Generating...";
              const sparkIcon = document.getElementById("caption-sparkle-icon");
              if (sparkIcon) sparkIcon.classList.add("animate-spin");

              if (scheduleCaptionSkeleton)
                scheduleCaptionSkeleton.classList.remove("hidden");
              scheduleCaptionInput.classList.add("opacity-0");

              setTimeout(() => {
                const list =
                  scheduleImages.length > 1 ? carouselCaptions : singleCaptions;
                const chosenCaption = list[captionIndex % list.length];
                captionIndex++;

                scheduleCaptionInput.value = chosenCaption;

                if (scheduleCaptionSkeleton)
                  scheduleCaptionSkeleton.classList.add("hidden");
                scheduleCaptionInput.classList.remove("opacity-0");
                scheduleCaptionInput.focus();

                btnScheduleGenerateCaption.disabled = false;
                if (btnScheduleCaptionText)
                  btnScheduleCaptionText.textContent = "Regenerate";
                if (sparkIcon) sparkIcon.classList.remove("animate-spin");
              }, 1000);
            }
          });
        }

        // Date input: clicking anywhere opens native picker
        if (scheduleDateInput) {
          scheduleDateInput.addEventListener("click", () => {
            try {
              if (typeof scheduleDateInput.showPicker === "function") {
                scheduleDateInput.showPicker();
              }
            } catch (err) {}
          });
        }

        if (closeScheduleBtn)
          closeScheduleBtn.addEventListener("click", closeSchedule);
        if (cancelScheduleBtn)
          cancelScheduleBtn.addEventListener("click", closeSchedule);
        if (modalSchedule) {
          modalSchedule.addEventListener("click", (e) => {
            if (e.target === modalSchedule) {
              closeSchedule();
              // Reset DNA and Hide social accounts when closed
              const selectBusinessDna = document.getElementById(
                "select-business-dna",
              );
              const socialAccountsContainer = document.getElementById(
                "social-accounts-container",
              );
              if (selectBusinessDna) selectBusinessDna.value = "none";
              if (socialAccountsContainer)
                socialAccountsContainer.classList.add("hidden");
            }
          });
        }

        // Toggle Social Accounts based on Business DNA
        const selectBusinessDna = document.getElementById(
          "select-business-dna",
        );
        const socialAccountsContainer = document.getElementById(
          "social-accounts-container",
        );
        const businessDnaBadge = document.getElementById(
          "btn-business-dna-badge",
        );
        const businessDnaBadgeLabel = document.getElementById(
          "business-dna-badge-label",
        );
        const businessDnaBadgeIcon = document.getElementById(
          "business-dna-badge-icon",
        );
        const businessDnaDropdown = document.getElementById(
          "dropdown-business-dna-badge",
        );
        const businessDnaOptions = document.querySelectorAll(
          ".business-dna-option",
        );
        const businessDnaSearch = document.getElementById(
          "business-dna-search",
        );

        if (businessDnaBadge && businessDnaDropdown) {
          businessDnaBadge.addEventListener("click", (event) => {
            event.stopPropagation();
            const isOpen = !businessDnaDropdown.classList.contains("hidden");
            businessDnaDropdown.classList.toggle("hidden", isOpen);
            businessDnaBadge.setAttribute("aria-expanded", String(!isOpen));
            if (!isOpen && businessDnaSearch) businessDnaSearch.focus();
          });

          if (businessDnaSearch) {
            businessDnaSearch.addEventListener("input", () => {
              const query = businessDnaSearch.value.trim().toLowerCase();
              businessDnaOptions.forEach((option) => {
                const label =
                  option
                    .getAttribute("data-business-dna-label")
                    ?.toLowerCase() || "";
                option.classList.toggle("hidden", !label.includes(query));
              });
            });
          }

          let currentBusinessDna = "none";

          function setBusinessDna(value, label, iconHtml) {
            currentBusinessDna = value;
            if (value === "none") {
              if (businessDnaBadgeLabel)
                businessDnaBadgeLabel.textContent = "Business DNA";
              if (businessDnaBadgeIcon) {
                businessDnaBadgeIcon.className =
                  "flex items-center justify-center shrink-0 text-[#667085]";
                businessDnaBadgeIcon.innerHTML =
                  '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m10 16l1.5 1.5M14 8l-1.5-1.5M15 2c-1.798 1.998-2.518 3.995-2.807 5.993M16.5 10.5l1 1M17 6l-2.891-2.891M2 15c6.667-6 13.333 0 20-6m-2 0l.891.891M3.109 14.109L4 15m2.5-2.5l1 1M7 18l2.891 2.891M9 22c1.798-1.998 2.518-3.995 2.807-5.993"/></svg>';
              }
            } else {
              if (businessDnaBadgeLabel && label)
                businessDnaBadgeLabel.textContent = label;
              if (businessDnaBadgeIcon && iconHtml) {
                businessDnaBadgeIcon.className =
                  "flex items-center justify-center shrink-0";
                businessDnaBadgeIcon.innerHTML = iconHtml;
              }
            }
            if (selectBusinessDna) {
              selectBusinessDna.value = value;
              selectBusinessDna.dispatchEvent(new Event("change"));
            }
          }

          businessDnaOptions.forEach((option) => {
            option.addEventListener("click", () => {
              const value = option.getAttribute("data-business-dna") || "none";
              const label =
                option.getAttribute("data-business-dna-label") ||
                "Business DNA";
              const iconSpan = option.querySelector(
                ".business-dna-option-icon",
              );

              // If user clicks currently active non-default DNA again, toggle back to default 'none'
              if (value !== "none" && currentBusinessDna === value) {
                setBusinessDna("none", "Business DNA", null);
              } else {
                setBusinessDna(
                  value,
                  label,
                  iconSpan ? iconSpan.innerHTML : null,
                );
              }

              businessDnaDropdown.classList.add("hidden");
              businessDnaBadge.setAttribute("aria-expanded", "false");
            });
          });

          document.addEventListener("click", (event) => {
            if (businessDnaDropdown.contains(event.target)) return;
            businessDnaDropdown.classList.add("hidden");
            businessDnaBadge.setAttribute("aria-expanded", "false");
          });
        }

        if (selectBusinessDna && socialAccountsContainer) {
          selectBusinessDna.addEventListener("change", () => {
            if (selectBusinessDna.value !== "none") {
              socialAccountsContainer.classList.remove("hidden");
            } else {
              socialAccountsContainer.classList.add("hidden");
            }
          });
        }

        // Toast Logic (reui.io c-alert-6 Success & c-alert-8 Error Alert, Title-Only, Top-Center)
        const toast = document.getElementById("toast");
        const toastTitle = document.getElementById("toast-title");
        const toastIconContainer = document.getElementById(
          "toast-icon-container",
        );
        const toastCloseBtn = document.getElementById("toast-close-btn");
        let toastTimeout;

        function showToast(titleOrMsg, optDescOrType, optType) {
          if (!toast) return;

          let message = titleOrMsg;
          let type = "success";

          if (typeof optDescOrType === "string") {
            if (
              optDescOrType === "success" ||
              optDescOrType === "error" ||
              optDescOrType === "failed"
            ) {
              type = optDescOrType === "failed" ? "error" : optDescOrType;
            } else if (optType === "error" || optType === "failed") {
              type = "error";
            }
          }

          // Display only the title as requested
          message = titleOrMsg;

          // Auto-detect error type from title or description if not specified
          if (type !== "error") {
            const lower =
              `${titleOrMsg || ""} ${optDescOrType || ""}`.toLowerCase();
            if (
              lower.includes("fail") ||
              lower.includes("error") ||
              lower.includes("gagal") ||
              lower.includes("delete") ||
              lower.includes("hapus")
            ) {
              type = "error";
