        // Smart collision resolver: ensures extracted frames do not overlap any existing frames
        function findNonOverlappingScreenPos({
          desiredLeft,
          desiredTop,
          width,
          height,
          obstacles,
          vx = 0,
          vy = 0,
          zoom = 1,
        }) {
          const gap = 24 * zoom;

          function rectsOverlap(r1, r2) {
            return !(
              r1.left + r1.width + gap <= r2.left ||
              r1.left >= r2.left + r2.width + gap ||
              r1.top + r1.height + gap <= r2.top ||
              r1.top >= r2.top + r2.height + gap
            );
          }

          function collidesWithAny(r) {
            return obstacles.some((obs) =>
              rectsOverlap(r, {
                left: obs.left,
                top: obs.top,
                width: obs.width,
                height: obs.height,
              }),
            );
          }

          const initialRect = {
            left: desiredLeft,
            top: desiredTop,
            width,
            height,
          };

          // If no collision with any frame on canvas, use exact position!
          if (!collidesWithAny(initialRect)) {
            return { left: desiredLeft, top: desiredTop };
          }

          // Determine user directional intent
          let dirX = 0;
          let dirY = 0;
          if (Math.abs(vx) > 15 * zoom) dirX = Math.sign(vx);
          if (Math.abs(vy) > 15 * zoom) dirY = Math.sign(vy);
          if (dirX === 0 && dirY === 0) {
            // Default direction when not dragged (e.g. extracted via button)
            dirX = 1;
          }

          const candidates = [];

          // 1. Push along X in direction of dirX
          if (dirX !== 0) {
            let curX = desiredLeft;
            for (let iter = 0; iter < 12; iter++) {
              const curRect = { left: curX, top: desiredTop, width, height };
              const overlapping = obstacles.filter((obs) =>
                rectsOverlap(curRect, obs),
              );
              if (overlapping.length === 0) {
                candidates.push({ left: curX, top: desiredTop, bias: 0.7 });
                break;
              }
              if (dirX > 0) {
                curX =
                  Math.max(...overlapping.map((o) => o.left + o.width)) + gap;
              } else {
                curX =
                  Math.min(...overlapping.map((o) => o.left)) - width - gap;
              }
            }
          }

          // 2. Push along Y in direction of dirY
          const targetDirY = dirY !== 0 ? dirY : 1;
          let curY = desiredTop;
          for (let iter = 0; iter < 12; iter++) {
            const curRect = { left: desiredLeft, top: curY, width, height };
            const overlapping = obstacles.filter((obs) =>
              rectsOverlap(curRect, obs),
            );
            if (overlapping.length === 0) {
              candidates.push({
                left: desiredLeft,
                top: curY,
                bias: dirY !== 0 ? 0.7 : 1.0,
              });
              break;
            }
            if (targetDirY > 0) {
              curY =
                Math.max(...overlapping.map((o) => o.top + o.height)) + gap;
            } else {
              curY = Math.min(...overlapping.map((o) => o.top)) - height - gap;
            }
          }

          // 3. Candidate positions adjacent to all obstacles
          obstacles.forEach((obs) => {
            const testPositions = [
              {
                left: obs.left + obs.width + gap,
                top: desiredTop,
                bias: dirX > 0 ? 0.8 : 1.1,
              },
              {
                left: obs.left - width - gap,
                top: desiredTop,
                bias: dirX < 0 ? 0.8 : 1.2,
              },
              {
                left: desiredLeft,
                top: obs.top + obs.height + gap,
                bias: dirY > 0 ? 0.8 : 1.1,
              },
              {
                left: desiredLeft,
                top: obs.top - height - gap,
                bias: dirY < 0 ? 0.8 : 1.2,
              },
              // Aligned edges
              { left: obs.left + obs.width + gap, top: obs.top, bias: 0.9 },
              { left: obs.left - width - gap, top: obs.top, bias: 1.1 },
              { left: obs.left, top: obs.top + obs.height + gap, bias: 0.95 },
              { left: obs.left, top: obs.top - height - gap, bias: 1.15 },
            ];

            testPositions.forEach((pos) => {
              const candRect = { left: pos.left, top: pos.top, width, height };
              if (!collidesWithAny(candRect)) {
                candidates.push(pos);
              }
            });
          });

          if (candidates.length === 0) {
            // Fallback: place to the far right of all obstacles
            const maxRight = Math.max(
              ...obstacles.map((o) => o.left + o.width),
              desiredLeft,
            );
            return { left: maxRight + gap, top: desiredTop };
          }

          // Score candidates and pick the one with minimal score
          let best = candidates[0];
          let minScore = Infinity;
          candidates.forEach((cand) => {
            const dist = Math.hypot(
              cand.left - desiredLeft,
              cand.top - desiredTop,
            );
            const score = dist * (cand.bias || 1.0);
            if (score < minScore) {
              minScore = score;
              best = cand;
            }
          });

          return { left: best.left, top: best.top };
        }

        // Extract layer or nested frame back to canvas as an independent frame
        function extractLayerToCanvas(layerEl) {
          if (!layerEl) return;
          const img = layerEl.querySelector("img");
          if (!img) return;
          const imgSrc = img.src;
          const parentFrame = layerEl.closest(".canvas-frame");
          const parentArtboard = document.getElementById("artboard-content");
          if (!parentArtboard) return;

          // 1. Measure layer size and screen position before removing
          const layerRect = layerEl.getBoundingClientRect();
          const parentRect = parentFrame
            ? parentFrame.getBoundingClientRect()
            : null;
          const frameW = layerEl.offsetWidth || 420;
          const frameH = layerEl.offsetHeight || 560;
          const screenW = frameW * zoomLevel;
          const screenH = frameH * zoomLevel;

          // Calculate drag extraction vector from parent frame
          let vx = 0;
          let vy = 0;
          if (parentRect) {
            const pCenterX = parentRect.left + parentRect.width / 2;
            const pCenterY = parentRect.top + parentRect.height / 2;
            const lCenterX = layerRect.left + screenW / 2;
            const lCenterY = layerRect.top + screenH / 2;
            vx = lCenterX - pCenterX;
            vy = lCenterY - pCenterY;
          }

          // 2. Gather obstacles (all other frames currently on canvas)
          const obstacles = [];
          getAllCanvasFrames().forEach((f) => {
            if (f.isConnected && f !== layerEl.sourceFrame) {
              obstacles.push(f.getBoundingClientRect());
            }
          });

          // 3. Find non-overlapping screen position
          const resolvedPos = findNonOverlappingScreenPos({
            desiredLeft: layerRect.left,
            desiredTop: layerRect.top,
            width: screenW,
            height: screenH,
            obstacles,
            vx,
            vy,
            zoom: zoomLevel,
          });

          // 4. Remove layer from parent frame
          const sourceFrame = layerEl.sourceFrame;
          deselectLayer();
          layerEl.remove();

          // 5. Restore original frame or create new frame
          let extractedFrame = null;
          if (sourceFrame) {
            parentArtboard.appendChild(sourceFrame);
            extractedFrame = sourceFrame;
            const inner = extractedFrame.querySelector(".canvas-frame-inner");
            if (inner) {
              inner.style.width = frameW + "px";
              inner.style.height = frameH + "px";
            }
            const dimBadge = extractedFrame.querySelector(".dimension-badge");
            if (dimBadge) {
              dimBadge.textContent = `${frameW} × ${frameH}`;
              extractedFrame.dataset.dimensions = `${frameW} × ${frameH}`;
            }
          } else {
            const isNested = layerEl.classList.contains("nested-frame-item");
            const fileName = isNested
              ? parentFrame?.dataset.title || "Extracted Image"
              : "Extracted Image";
            extractedFrame = createNewCanvasFrame({
              url: imgSrc,
              fileName,
              width: frameW,
              height: frameH,
            });
            if (extractedFrame) {
              const inner = extractedFrame.querySelector(".canvas-frame-inner");
              if (inner) {
                inner.style.width = frameW + "px";
                inner.style.height = frameH + "px";
              }
            }
          }

          if (extractedFrame) {
            // 6. Position accurately using resolved non-overlapping screen coordinates
            extractedFrame.style.transform = "none";
            const baseRect = extractedFrame.getBoundingClientRect();
            const targetTx = Math.round(
              (resolvedPos.left - baseRect.left) / zoomLevel,
            );
            const targetTy = Math.round(
              (resolvedPos.top - baseRect.top) / zoomLevel,
            );

            extractedFrame.dataset.x = targetTx.toString();
            extractedFrame.dataset.y = targetTy.toString();
            extractedFrame.style.transform = `translate(${targetTx}px, ${targetTy}px)`;

            selectFrame(extractedFrame, false);
            updateContextMenuPosition();

            pushAction({
              type: "EXTRACT_FRAME",
              frame: extractedFrame,
              parentFrame,
              parentArtboard,
              layerEl,
              targetContainer: parentFrame
                ? parentFrame.querySelector(".canvas-frame-inner") ||
                  parentFrame
                : null,
            });
          }

          showToast("Image Extracted", "success");
        }

        // Drag layer inside frame
        function makeLayerDraggable(layerEl, container) {
          let isDraggingLayer = false;
          let startX = 0;
          let startY = 0;
          let startLeft = 0;
          let startTop = 0;
          let hasMoved = false;

          layerEl.addEventListener("mousedown", (e) => {
            if (currentTool === "hand" || isSpacePressed || e.button === 1)
              return;
            if (
              e.target.closest(".btn-delete-layer") ||
              e.target.closest(".btn-extract-frame") ||
              e.target.closest(".layer-resize-handle")
            )
              return;
            e.preventDefault();
            e.stopPropagation();
            isDraggingLayer = true;
            hasMoved = false;
            startX = e.clientX;
            startY = e.clientY;
            startLeft = parseFloat(layerEl.style.left) || 0;
            startTop = parseFloat(layerEl.style.top) || 0;
            layerEl.style.cursor = "grabbing";
            selectLayer(layerEl);
          });

          window.addEventListener("mousemove", (e) => {
            if (!isDraggingLayer) return;
            const dx = (e.clientX - startX) / zoomLevel;
            const dy = (e.clientY - startY) / zoomLevel;
            if (Math.abs(dx) > 3 || Math.abs(dy) > 3) {
              hasMoved = true;
            }
            const newLeft = startLeft + dx;
            const newTop = startTop + dy;
            layerEl.style.left = newLeft + "px";
            layerEl.style.top = newTop + "px";
            updateContextMenuPosition();
          });

          window.addEventListener("mouseup", () => {
            if (isDraggingLayer) {
              isDraggingLayer = false;
              layerEl.style.cursor = "move";

              // Check if dropped outside parent container bounds to auto-extract
              if (hasMoved && container) {
                const cRect = container.getBoundingClientRect();
                const lRect = layerEl.getBoundingClientRect();
                const layerCenterX = lRect.left + lRect.width / 2;
                const layerCenterY = lRect.top + lRect.height / 2;

                const isOutside =
                  layerCenterX < cRect.left ||
                  layerCenterX > cRect.right ||
                  layerCenterY < cRect.top ||
                  layerCenterY > cRect.bottom ||
                  lRect.right < cRect.left + 50 ||
                  lRect.left > cRect.right - 50 ||
                  lRect.bottom < cRect.top + 50 ||
                  lRect.top > cRect.bottom - 50;

                if (isOutside) {
                  extractLayerToCanvas(layerEl);
                }
              }
            }
          });
        }

        // Make layer resizable via corner handles
        function makeLayerResizable(layerEl) {
          if (!layerEl) return;
          const handles = layerEl.querySelectorAll(".layer-resize-handle");
          handles.forEach((handle) => {
            handle.addEventListener("mousedown", (e) => {
              if (currentTool !== "select") return;
              e.preventDefault();
              e.stopPropagation();

              isResizingLayer = true;
              resizingLayer = layerEl;
              layerResizeHandle = handle.dataset.handle;
              layerResizeStartW = layerEl.offsetWidth;
              layerResizeStartH = layerEl.offsetHeight;
              layerResizeStartLeft = parseFloat(layerEl.style.left) || 0;
              layerResizeStartTop = parseFloat(layerEl.style.top) || 0;
              layerResizeStartX = e.clientX;
              layerResizeStartY = e.clientY;

              selectLayer(layerEl);
            });
          });
        }

        // Setup drop target on a frame
        function setupFrameDropTarget(frameEl) {
          frameEl.addEventListener("dragenter", (e) => {
            e.preventDefault();
            e.stopPropagation();
            frameEl.classList.add("ring-2", "ring-[#2563EB]", "ring-offset-2");
          });

          frameEl.addEventListener("dragover", (e) => {
            e.preventDefault();
            e.stopPropagation();
            e.dataTransfer.dropEffect = "copy";
          });

          frameEl.addEventListener("dragleave", (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (!frameEl.contains(e.relatedTarget)) {
              frameEl.classList.remove(
                "ring-2",
                "ring-[#2563EB]",
                "ring-offset-2",
              );
            }
          });

          frameEl.addEventListener("drop", (e) => {
            e.preventDefault();
            e.stopPropagation();
            frameEl.classList.remove(
              "ring-2",
              "ring-[#2563EB]",
              "ring-offset-2",
            );

            const files = e.dataTransfer.files;
            if (files && files.length > 0) {
              let hasImage = false;
              for (let i = 0; i < files.length; i++) {
                const file = files[i];
                if (file.type.startsWith("image/")) {
                  hasImage = true;
                  const url = URL.createObjectURL(file);
                  addImageLayerToFrame(frameEl, { url, fileName: file.name });
                }
              }
              if (!hasImage) {
                showToast(
                  "Upload Failed",
                  "Only image files (PNG, JPG, WebP) can be added to frames.",
                  "error",
                );
              }
            }
          });
        }

        // Initialize drop targets on existing frames
        getAllCanvasFrames().forEach(setupFrameDropTarget);

        // Drag & Drop onto empty canvas area -> Create New Frame
        if (canvasContainer) {
          canvasContainer.addEventListener("dragover", (e) => {
