          if (aiInput) {
            const badges = aiInput.querySelectorAll(".ref-badge");
            badges.forEach((b) => {
              const circle = b.querySelector(".ref-circle");
              if (circle && circle.style.backgroundImage) {
                const match = circle.style.backgroundImage.match(
                  /url\(['"]?(.*?)['"]?\)/,
