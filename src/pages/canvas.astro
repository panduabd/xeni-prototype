        function addChatReference({ name, url }) {
          const aiInput = document.getElementById("ai-input-canvas");
          if (!aiInput) return;

          // If aiInput is currently empty or has only whitespace/newlines, clean it first so badge starts at line 1 top-left
          const currentText = (aiInput.innerText || aiInput.textContent || "").replace(/\u00A0/g, " ").trim();
          const hasExistingBadges = aiInput.querySelectorAll(".ref-badge").length > 0;
          if (!currentText && !hasExistingBadges) {
            aiInput.innerHTML = "";
          }

          const badge = document.createElement("span");
          badge.className =
            "ref-badge badge-pop-highlight inline-flex items-center gap-1 pl-1 pr-1.5 py-0.5 bg-white border border-[#e5e7eb] rounded-full mr-1 select-none align-middle h-[22px] shadow-sm max-w-[200px] whitespace-nowrap hover:border-[#d0d5dd] transition-all";
          badge.contentEditable = "false";

          const cleanName = (name || "Reference").trim();
          const circleStyle = url
            ? `background-image: url('${url}'); background-size: cover; background-position: center;`
            : `background-color: #f2f4f7;`;
          const circleContent = url
            ? ""
            : `<i class="ti ti-photo text-[9px] text-[#98a2b3]"></i>`;

          badge.innerHTML = `
          <span class="ref-circle w-4 h-4 rounded-full shrink-0 border border-black/10 overflow-hidden flex items-center justify-center" style="${circleStyle}">
            ${circleContent}
          </span>
          <span class="ref-text text-[11.5px] font-medium text-[#111827] max-w-[115px] overflow-hidden text-ellipsis whitespace-nowrap leading-none tracking-tight" title="${cleanName}">${cleanName}</span>
          <button type="button" class="remove-ref-badge flex items-center justify-center w-3.5 h-3.5 rounded-full text-[#98a2b3] hover:text-[#111827] hover:bg-[#f3f4f6] cursor-pointer ml-0.5 transition-colors border-0 bg-transparent p-0" title="Remove reference">
            <i class="ti ti-x text-[10px]"></i>
          </button>
        `;

          badge
            .querySelector(".remove-ref-badge")
            .addEventListener("click", (e) => {
              e.stopPropagation();
              badge.remove();
              checkPlaceholderCanvas();
            });

          // Insert badge directly inline into contenteditable aiInput (same as dashboard!)
          const sel = window.getSelection();
          if (sel && sel.rangeCount > 0 && aiInput.contains(sel.anchorNode)) {
            const range = sel.getRangeAt(0);
            range.deleteContents();
            range.insertNode(badge);

            const space = document.createTextNode("\u00A0");
            range.collapse(false);
            range.insertNode(space);

            range.setStartAfter(space);
            range.setEndAfter(space);
            sel.removeAllRanges();
            sel.addRange(range);
          } else {
            aiInput.appendChild(badge);
            aiInput.appendChild(document.createTextNode("\u00A0"));
          }

          checkPlaceholderCanvas();
          openChatPanel();

          // Outline wipe light animation around the shape (1x slow wipe, 0 to 100 on every click)
          const borderGlow = document.getElementById("ai-input-border-glow");
          if (borderGlow) {
            borderGlow.classList.remove("animate-wipe-1x");
            void borderGlow.offsetWidth; // force DOM reflow to restart animation from 0%
            borderGlow.classList.add("animate-wipe-1x");
            borderGlow.onanimationend = () => {
              borderGlow.classList.remove("animate-wipe-1x");
            };
          }

          // Focus and place cursor at end
          aiInput.focus();
          try {
            const selection = window.getSelection();
            const range = document.createRange();
            range.selectNodeContents(aiInput);
            range.collapse(false);
            selection.removeAllRanges();
            selection.addRange(range);
          } catch (err) {
            // fallback
          }
        }

