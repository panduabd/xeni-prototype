    <!-- REUI.IO ALERT NOTIFICATION (Top-Center, Title-Only, c-alert-6 for success & c-alert-8 for error) -->
    <div
      id="toast"
      role="alert"
      data-slot="alert"
      class="fixed top-6 left-1/2 -translate-x-1/2 -translate-y-12 opacity-0 pointer-events-none transition-all duration-300 ease-out z-[9999] flex items-center gap-2.5 rounded-xl px-4 py-2.5 shadow-[0_10px_30px_-10px_rgba(16,185,129,0.2),0_4px_12px_rgba(0,0,0,0.05)] border border-emerald-500/30 bg-emerald-50/95 text-emerald-950 backdrop-blur-sm select-none"
    >
      <div
        id="toast-icon-container"
        data-slot="alert-icon"
        class="flex items-center justify-center shrink-0"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-emerald-600"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
      </div>
      <span
        id="toast-title"
        data-slot="alert-title"
        class="text-[13px] font-medium tracking-tight text-emerald-950 leading-none whitespace-nowrap"
        >Success! All good</span
      >
      <button
        id="toast-close-btn"
        class="text-emerald-700/60 hover:text-emerald-950 hover:bg-emerald-100/60 p-1 rounded-md transition-colors cursor-pointer shrink-0 ml-1.5"
        aria-label="Close"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>

    <!-- SCRIPT BINDINGS -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        // --- Global Tooltip Manager ---
        function initCanvasTooltips() {
          let tooltip = document.getElementById("xeni-global-tooltip");
          if (!tooltip) {
            tooltip = document.createElement("div");
            tooltip.id = "xeni-global-tooltip";
            document.body.appendChild(tooltip);
          }

          let activeTarget = null;

          function hideTooltip() {
            activeTarget = null;
            if (tooltip) tooltip.classList.remove("show");
          }

          function showTooltip(el) {
            const text =
              el.getAttribute("data-tooltip") || el.getAttribute("title");
            if (!text || text.trim() === "") return;

            if (el.hasAttribute("title")) {
              el.setAttribute("data-tooltip", text);
              el.removeAttribute("title");
            }

            activeTarget = el;
            tooltip.textContent = text;

            const rect = el.getBoundingClientRect();
            const tooltipRect = tooltip.getBoundingClientRect();
            const pos = el.getAttribute("data-tooltip-pos") || "top";

            let top = 0;
            let left = rect.left + rect.width / 2 - tooltipRect.width / 2;

            if (pos === "bottom") {
              top = rect.bottom + 6;
            } else if (pos === "left") {
              left = rect.left - tooltipRect.width - 6;
              top = rect.top + rect.height / 2 - tooltipRect.height / 2;
            } else if (pos === "right") {
              left = rect.right + 6;
              top = rect.top + rect.height / 2 - tooltipRect.height / 2;
            } else {
              top = rect.top - tooltipRect.height - 6;
              if (top < 8) {
                top = rect.bottom + 6;
              }
            }

            left = Math.max(
              8,
              Math.min(window.innerWidth - tooltipRect.width - 8, left),
            );

            tooltip.style.top = `${top}px`;
            tooltip.style.left = `${left}px`;
            tooltip.classList.add("show");
          }

          document.addEventListener(
            "mouseover",
            (e) => {
              const target = e.target;
              if (!target || !(target instanceof Element)) return;
              const el = target.closest("[data-tooltip], [title]");
              if (!el) {
                if (activeTarget) hideTooltip();
                return;
              }
              if (el === activeTarget) return;
              showTooltip(el);
            },
            true,
          );

          document.addEventListener(
            "mouseout",
            (e) => {
              if (
                activeTarget &&
                (!e.relatedTarget || !activeTarget.contains(e.relatedTarget))
              ) {
                hideTooltip();
              }
            },
            true,
          );

          document.addEventListener(
            "mousedown",
            () => {
              hideTooltip();
            },
            true,
          );

          window.addEventListener(
            "scroll",
            () => {
              hideTooltip();
            },
            { passive: true },
          );
        }

        initCanvasTooltips();

        // ==========================================
        // CANVAS ENGINE (Pan, Zoom, Frame Dragging & Marquee Selection)
        // ==========================================
        const canvasContainer = document.getElementById("canvas-container");
        const artboardViewport = document.getElementById("artboard-viewport");
        const zoomLevelText = document.getElementById("zoom-level");
        const btnZoomIn = document.getElementById("btn-zoom-in");
        const btnZoomOut = document.getElementById("btn-zoom-out");
        const contextMenu = document.getElementById("image-context-menu");
        const marqueeBox = document.getElementById("canvas-marquee-box");
        const rightPanel = document.getElementById("right-panel");
        const btnUndo = document.getElementById("btn-undo");
        const btnRedo = document.getElementById("btn-redo");

        // Pan & Zoom State
        let zoomLevel = 0.75; // Default zoomed out
        let panX = 0;
        let panY = 0;
        let isPanning = false;
        let panStartX = 0;
        let panStartY = 0;
        let currentTool = "select"; // 'select' | 'hand'
        let isSpacePressed = false;

        // Frame Selection & Movement State (Default unselected)
        let selectedFrames = new Set();
        let primarySelectedFrame = null;
        let selectedLayer = null;
        let isDraggingFrames = false;
        let dragStartX = 0;
        let dragStartY = 0;
        let frameStartPositions = new Map();
        let hoveredNestingTarget = null;

        // Frame Resizing State
        let isResizingFrame = false;
        let resizeHandle = null;
        let resizingFrame = null;
        let resizeStartW = 0;
        let resizeStartH = 0;
        let resizeStartX = 0;
        let resizeStartY = 0;
        let resizeFrameStartX = 0;
        let resizeFrameStartY = 0;
        let resizeOldDimensions = "";

        // Layer Resizing State
        let isResizingLayer = false;
        let resizingLayer = null;
        let layerResizeHandle = null;
        let layerResizeStartW = 0;
        let layerResizeStartH = 0;
        let layerResizeStartLeft = 0;
        let layerResizeStartTop = 0;
        let layerResizeStartX = 0;
        let layerResizeStartY = 0;

        // Marquee Box Selection State ("block frame")
        let isMarqueeSelecting = false;
        let marqueeStartX = 0;
        let marqueeStartY = 0;

        // ==========================================
        // UNDO / REDO HISTORY MANAGER
        // ==========================================
        const undoStack = [];
        const redoStack = [];

        function updateUndoRedoUI() {
          if (btnUndo) {
            if (undoStack.length > 0) {
              btnUndo.classList.remove("opacity-40", "cursor-not-allowed");
              btnUndo.classList.add("cursor-pointer");
            } else {
              btnUndo.classList.add("opacity-40", "cursor-not-allowed");
              btnUndo.classList.remove("cursor-pointer");
            }
          }
          if (btnRedo) {
            if (redoStack.length > 0) {
              btnRedo.classList.remove("opacity-40", "cursor-not-allowed");
              btnRedo.classList.add("cursor-pointer");
            } else {
              btnRedo.classList.add("opacity-40", "cursor-not-allowed");
              btnRedo.classList.remove("cursor-pointer");
            }
          }
        }

        function pushAction(action) {
          undoStack.push(action);
          redoStack.length = 0; // Clear redo on new action
          updateUndoRedoUI();
        }

        function executeUndo() {
          if (undoStack.length === 0) return;
          const action = undoStack.pop();

          if (action.type === "MOVE") {
            action.frames.forEach((item) => {
              if (item.frame) {
                item.frame.dataset.x = item.oldX;
                item.frame.dataset.y = item.oldY;
                item.frame.style.transform = `translate(${item.oldX}px, ${item.oldY}px)`;
              }
            });
            redoStack.push(action);
          } else if (action.type === "RESIZE") {
            const { frame, oldW, oldH, oldX, oldY, oldDimensions } = action;
            const inner = frame.querySelector(".canvas-frame-inner");
            const dimBadge = frame.querySelector(".dimension-badge");
            if (inner) {
              inner.style.width = oldW + "px";
              inner.style.height = oldH + "px";
            }
            frame.dataset.x = oldX;
            frame.dataset.y = oldY;
            frame.style.transform = `translate(${oldX}px, ${oldY}px)`;
            frame.dataset.dimensions = oldDimensions;
            if (dimBadge) dimBadge.textContent = oldDimensions;
            redoStack.push(action);
          } else if (action.type === "CREATE_FRAME") {
            const { frame } = action;
            if (frame && frame.parentElement) {
              frame.remove();
            }
            selectedFrames.delete(frame);
            if (primarySelectedFrame === frame) primarySelectedFrame = null;
            updateSelectionUI();
            redoStack.push(action);
          } else if (action.type === "ADD_LAYER") {
            const { layer } = action;
            if (selectedLayer === layer) {
              deselectLayer();
            }
            if (layer && layer.parentElement) {
              layer.remove();
            }
            redoStack.push(action);
          } else if (action.type === "NEST_FRAME") {
            const { frameA, parentArtboard, nestedEl, oldX, oldY } = action;
            if (selectedLayer === nestedEl) {
              deselectLayer();
            }
            if (nestedEl && nestedEl.parentElement) {
              nestedEl.remove();
            }
            if (frameA && parentArtboard) {
              parentArtboard.appendChild(frameA);
              frameA.dataset.x = oldX;
              frameA.dataset.y = oldY;
              frameA.style.transform = `translate(${oldX}px, ${oldY}px)`;
              selectFrame(frameA, false);
            }
            redoStack.push(action);
          } else if (action.type === "RESIZE_LAYER") {
            const { layer, oldW, oldH, oldLeft, oldTop } = action;
            if (layer) {
              layer.style.width = oldW + "px";
              layer.style.height = oldH + "px";
              layer.style.left = oldLeft + "px";
              layer.style.top = oldTop + "px";
            }
            redoStack.push(action);
          } else if (action.type === "EXTRACT_FRAME") {
            const { frame, layerEl, targetContainer } = action;
            if (frame && frame.parentElement) {
              frame.remove();
            }
            if (layerEl && targetContainer) {
              targetContainer.appendChild(layerEl);
              selectLayer(layerEl);
            }
            redoStack.push(action);
          }

          updateUndoRedoUI();
          updateContextMenuPosition();
          showToast("Undo Action", "Reverted previous change.", "success");
        }

        function executeRedo() {
          if (redoStack.length === 0) return;
          const action = redoStack.pop();

          if (action.type === "MOVE") {
            action.frames.forEach((item) => {
              if (item.frame) {
                item.frame.dataset.x = item.newX;
                item.frame.dataset.y = item.newY;
                item.frame.style.transform = `translate(${item.newX}px, ${item.newY}px)`;
              }
            });
            undoStack.push(action);
          } else if (action.type === "RESIZE") {
            const { frame, newW, newH, newX, newY, newDimensions } = action;
            const inner = frame.querySelector(".canvas-frame-inner");
            const dimBadge = frame.querySelector(".dimension-badge");
            if (inner) {
              inner.style.width = newW + "px";
              inner.style.height = newH + "px";
            }
            frame.dataset.x = newX;
            frame.dataset.y = newY;
            frame.style.transform = `translate(${newX}px, ${newY}px)`;
            frame.dataset.dimensions = newDimensions;
            if (dimBadge) dimBadge.textContent = newDimensions;
            undoStack.push(action);
          } else if (action.type === "CREATE_FRAME") {
            const { frame, parent } = action;
            if (frame && parent) {
              parent.appendChild(frame);
              selectFrame(frame, false);
            }
            undoStack.push(action);
          } else if (action.type === "ADD_LAYER") {
            const { container, layer } = action;
            if (container && layer) {
              container.appendChild(layer);
            }
            undoStack.push(action);
          } else if (action.type === "NEST_FRAME") {
            const { frameA, containerB, nestedEl } = action;
            if (frameA && frameA.parentElement) {
              frameA.remove();
            }
            if (containerB && nestedEl) {
              containerB.appendChild(nestedEl);
            }
            undoStack.push(action);
          } else if (action.type === "RESIZE_LAYER") {
            const { layer, newW, newH, newLeft, newTop } = action;
            if (layer) {
              layer.style.width = newW + "px";
              layer.style.height = newH + "px";
              layer.style.left = newLeft + "px";
              layer.style.top = newTop + "px";
            }
            undoStack.push(action);
          } else if (action.type === "EXTRACT_FRAME") {
            const { frame, layerEl, parentArtboard } = action;
            if (layerEl && layerEl.parentElement) {
              layerEl.remove();
            }
            if (frame && parentArtboard) {
              parentArtboard.appendChild(frame);
              selectFrame(frame, false);
            }
            undoStack.push(action);
          }

          updateUndoRedoUI();
          updateContextMenuPosition();
          showToast("Redo Action", "Reapplied previous change.", "success");
        }

        if (btnUndo)
          btnUndo.addEventListener("click", (e) => {
            e.stopPropagation();
            executeUndo();
          });
        if (btnRedo)
          btnRedo.addEventListener("click", (e) => {
            e.stopPropagation();
            executeRedo();
          });

        // Apply Canvas Pan & Zoom
        function applyCanvasTransform() {
          if (artboardViewport) {
            artboardViewport.style.transform = `translate(${panX}px, ${panY}px) scale(${zoomLevel})`;
          }
          if (zoomLevelText) {
            zoomLevelText.textContent = Math.round(zoomLevel * 100) + "%";
          }
          updateContextMenuPosition();
        }

        // Update Context Menu Position & Auto-Hide on Navbar & Chatbox Collision
        function updateContextMenuPosition() {
          const scheduleMenuWrapper = document.getElementById(
            "schedule-menu-wrapper",
          );
          const btnExtractMenuItem = document.getElementById(
            "btn-extract-menu-item",
          );

          let targetEl = null;
          if (selectedLayer && document.body.contains(selectedLayer)) {
            targetEl = selectedLayer;
            if (scheduleMenuWrapper) {
              scheduleMenuWrapper.classList.add("hidden");
            }
            if (btnExtractMenuItem) {
              btnExtractMenuItem.classList.remove("hidden");
            }
          } else if (
            primarySelectedFrame &&
            selectedFrames.size > 0 &&
            document.body.contains(primarySelectedFrame)
          ) {
            targetEl = primarySelectedFrame;
            if (scheduleMenuWrapper) {
              scheduleMenuWrapper.classList.remove("hidden");
            }
            if (btnExtractMenuItem) {
              btnExtractMenuItem.classList.add("hidden");
            }
          }

          if (!contextMenu || !targetEl) {
            if (contextMenu) {
              contextMenu.style.opacity = "0";
              contextMenu.style.pointerEvents = "none";
            }
            return;
          }

          const rect = targetEl.getBoundingClientRect();
          const menuHeight = contextMenu.offsetHeight || 44;
          const menuWidth = contextMenu.offsetWidth || 380;

          // Target positioning 14px above the frame or layer
          const targetTop = rect.top - menuHeight - 14;
          const targetLeft = rect.left + rect.width / 2 - menuWidth / 2;

          // Navbar Collision (top < 50px auto-hide when frame is scrolled under top navbar)
          const isCoveredByNavbar = targetTop < 50;

          // Off-screen: only hide if selected element is completely scrolled out of viewport
          const isOutOfScreen =
            rect.bottom < 40 ||
            rect.top > window.innerHeight - 20 ||
            rect.right < 40 ||
            rect.left > window.innerWidth - 20;

          if (isCoveredByNavbar || isOutOfScreen) {
            contextMenu.style.opacity = "0";
            contextMenu.style.pointerEvents = "none";
            contextMenu.style.transform = `translate(${targetLeft}px, ${targetTop}px) scale(0.95)`;
          } else {
            contextMenu.style.opacity = "1";
            contextMenu.style.pointerEvents = "auto";
            contextMenu.style.transform = `translate(${targetLeft}px, ${targetTop}px) scale(1)`;
          }
        }

        function getAllCanvasFrames() {
          return document.querySelectorAll(".canvas-frame");
        }

        function deselectLayer() {
          if (selectedLayer) {
            selectedLayer.classList.remove(
              "outline",
              "outline-2",
              "outline-[#2563EB]",
              "ring-offset-1",
            );
            const handles = selectedLayer.querySelector(
              ".layer-resize-handles",
            );
            if (handles) handles.classList.add("hidden");
            selectedLayer = null;
          }
        }

        function selectLayer(layerEl) {
          if (!layerEl) {
            deselectLayer();
            updateContextMenuPosition();
            return;
          }
          // Deselect frames
          selectedFrames.clear();
          primarySelectedFrame = null;
          getAllCanvasFrames().forEach((frame) => {
            const overlay = frame.querySelector(".image-selection-overlay");
            if (overlay) overlay.classList.add("hidden");
          });

          // Hide handles on other layers
          document
            .querySelectorAll(".layer-resize-handles")
            .forEach((h) => h.classList.add("hidden"));

          // Toggle layer outline
          if (selectedLayer && selectedLayer !== layerEl) {
            selectedLayer.classList.remove(
              "outline",
              "outline-2",
              "outline-[#2563EB]",
              "ring-offset-1",
            );
          }
          selectedLayer = layerEl;
          selectedLayer.classList.add(
            "outline",
            "outline-2",
            "outline-[#2563EB]",
            "ring-offset-1",
          );

          const handles = selectedLayer.querySelector(".layer-resize-handles");
          if (handles) handles.classList.remove("hidden");

          updateContextMenuPosition();
        }

        // Update selection overlays for all frames
        function updateSelectionUI() {
          getAllCanvasFrames().forEach((frame) => {
            const overlay = frame.querySelector(".image-selection-overlay");
            if (overlay) {
              if (selectedFrames.has(frame)) {
                overlay.classList.remove("hidden");
              } else {
                overlay.classList.add("hidden");
              }
            }
          });

          if (selectedFrames.size > 0) {
            deselectLayer();
            if (
              !primarySelectedFrame ||
              !selectedFrames.has(primarySelectedFrame)
            ) {
              primarySelectedFrame = Array.from(selectedFrames)[0];
            }
            updateContextMenuPosition();
          } else if (!selectedLayer) {
            primarySelectedFrame = null;
            if (contextMenu) {
              contextMenu.style.opacity = "0";
              contextMenu.style.pointerEvents = "none";
            }
          }

          const btnScheduleText = document.getElementById("btn-schedule-text");
          const btnSchedule = document.getElementById("btn-schedule-image");
          if (btnSchedule) {
            if (selectedFrames.size > 1) {
              if (btnScheduleText)
                btnScheduleText.textContent = `Schedule (${selectedFrames.size})`;
              btnSchedule.setAttribute(
                "data-tooltip",
                `Schedule ${selectedFrames.size} Posts (Carousel)`,
              );
            } else {
              if (btnScheduleText) btnScheduleText.textContent = "Schedule";
              btnSchedule.setAttribute("data-tooltip", "Schedule Post");
            }
          }
        }

        // Select / Deselect Frame
        function selectFrame(frame, isMulti = false) {
          deselectLayer();
          if (!frame) {
            selectedFrames.clear();
            primarySelectedFrame = null;
          } else {
            if (!isMulti) {
              selectedFrames.clear();
              selectedFrames.add(frame);
              primarySelectedFrame = frame;
            } else {
              if (selectedFrames.has(frame)) {
                selectedFrames.delete(frame);
                if (primarySelectedFrame === frame) {
                  primarySelectedFrame = Array.from(selectedFrames)[0] || null;
                }
              } else {
                selectedFrames.add(frame);
                primarySelectedFrame = frame;
              }
            }
          }
          updateSelectionUI();
        }

        // Tool Switching (Select vs Hand)
        function setTool(tool) {
          currentTool = tool;
          const btnSelectAction = document.getElementById("btn-select-action");
          const btnHandAction = document.getElementById("btn-hand-action");
          const activeToolIcon = document.getElementById("active-tool-icon");
          const btnSelectTool = document.getElementById("btn-select-tool");

          if (tool === "hand") {
            if (btnHandAction) {
              btnHandAction.classList.add(
                "bg-[#F3F4F6]",
                "text-[#111827]",
                "font-medium",
              );
              btnHandAction.classList.remove("text-[#667085]", "font-medium");
            }
            if (btnSelectAction) {
              btnSelectAction.classList.remove(
                "bg-[#F3F4F6]",
                "text-[#111827]",
                "font-medium",
              );
              btnSelectAction.classList.add("text-[#667085]", "font-medium");
            }
            if (activeToolIcon) {
              activeToolIcon.innerHTML = `<i class="ti ti-hand-stop text-[15px] text-[#111827]"></i>`;
            }
            if (canvasContainer) {
              canvasContainer.style.cursor = "grab";
            }
          } else {
            if (btnSelectAction) {
              btnSelectAction.classList.add(
                "bg-[#F3F4F6]",
                "text-[#111827]",
                "font-medium",
              );
              btnSelectAction.classList.remove("text-[#667085]", "font-medium");
            }
            if (btnHandAction) {
              btnHandAction.classList.remove(
                "bg-[#F3F4F6]",
                "text-[#111827]",
                "font-medium",
              );
              btnHandAction.classList.add("text-[#667085]", "font-medium");
            }
            if (activeToolIcon) {
              activeToolIcon.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-[15px] h-[15px] text-[#111827] shrink-0">
                <path fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="2" d="m9.803 4.63l6.033 2.36c3.48 1.362 5.22 2.043 5.163 3.123c-.058 1.08-1.874 1.576-5.506 2.566c-1.081.295-1.622.442-1.997.817s-.522.916-.817 1.997c-.99 3.632-1.486 5.448-2.566 5.506s-1.76-1.683-3.122-5.163L4.63 9.803C3.204 6.159 2.49 4.338 3.414 3.414c.924-.923 2.745-.21 6.389 1.216Z"/>
              </svg>`;
            }
            if (canvasContainer) {
              canvasContainer.style.cursor = "";
            }
          }
        }

        // Nest Frame Into Frame
        function nestFrameIntoFrame(sourceFrame, targetFrame) {
          if (!sourceFrame || !targetFrame || sourceFrame === targetFrame)
            return;
          const targetContainer =
            targetFrame.querySelector(".canvas-frame-inner") ||
            targetFrame.querySelector(".relative.w-\\[420px\\]") ||
            targetFrame.firstElementChild;
          if (!targetContainer) return;

          const img = sourceFrame.querySelector("img");
          const imgSrc = img ? img.src : "";
          const title = sourceFrame.dataset.title || "Nested Image";
          const oldX = sourceFrame.dataset.x || "0";
          const oldY = sourceFrame.dataset.y || "0";
          const parentArtboard = sourceFrame.parentElement;

          // Keep 100% original dimensions without shrinking or changing size
          const sourceInner = sourceFrame.querySelector(".canvas-frame-inner");
          const nestedW = sourceInner ? sourceInner.offsetWidth : 420;
          const nestedH = sourceInner ? sourceInner.offsetHeight : 560;

          // Calculate relative position based on actual screen bounding rects
          const sRect = sourceFrame.getBoundingClientRect();
          const tRect = targetContainer.getBoundingClientRect();
          let relLeft = Math.round((sRect.left - tRect.left) / zoomLevel);
          let relTop = Math.round((sRect.top - tRect.top) / zoomLevel);

          // Snap to 0,0 if dropped roughly covering the target frame
          if (Math.abs(relLeft) < 60 && Math.abs(relTop) < 60) {
            relLeft = 0;
            relTop = 0;
          }

          const nestedEl = document.createElement("div");
          nestedEl.className =
            "nested-frame-item absolute cursor-move group z-10 select-none hover:outline hover:outline-1 hover:outline-[#2563EB] pointer-events-auto";
          nestedEl.sourceFrame = sourceFrame;
          nestedEl.style.width = nestedW + "px";
          nestedEl.style.height = nestedH + "px";
          nestedEl.style.left = relLeft + "px";
          nestedEl.style.top = relTop + "px";
          nestedEl.style.pointerEvents = "auto";

          nestedEl.innerHTML = `
          <img src="${imgSrc}" alt="${title}" class="w-full h-full object-cover pointer-events-none select-none" />
          <button class="btn-extract-frame opacity-0 group-hover:opacity-100 absolute top-1.5 right-1.5 w-6 h-6 bg-[#111827]/80 hover:bg-[#111827] text-white rounded-full flex items-center justify-center text-[11px] transition-opacity cursor-pointer z-20 shadow-sm pointer-events-auto" title="Extract image back to canvas">
            <i class="ti ti-arrow-up-right"></i>
          </button>
          <!-- Layer Resize Handles -->
          <div class="layer-resize-handles hidden absolute inset-0 pointer-events-none z-30">
            <div class="layer-resize-handle handle-tl absolute -top-2 -left-2 w-3.5 h-3.5 bg-white border-2 border-[#2563EB] rounded-[2px] shadow-sm cursor-nwse-resize pointer-events-auto" data-handle="tl"></div>
            <div class="layer-resize-handle handle-tr absolute -top-2 -right-2 w-3.5 h-3.5 bg-white border-2 border-[#2563EB] rounded-[2px] shadow-sm cursor-nesw-resize pointer-events-auto" data-handle="tr"></div>
            <div class="layer-resize-handle handle-bl absolute -bottom-2 -left-2 w-3.5 h-3.5 bg-white border-2 border-[#2563EB] rounded-[2px] shadow-sm cursor-nesw-resize pointer-events-auto" data-handle="bl"></div>
            <div class="layer-resize-handle handle-br absolute -bottom-2 -right-2 w-3.5 h-3.5 bg-white border-2 border-[#2563EB] rounded-[2px] shadow-sm cursor-nwse-resize pointer-events-auto" data-handle="br"></div>
          </div>
        `;

          targetContainer.style.overflow = "visible";
          targetContainer.appendChild(nestedEl);
          sourceFrame.remove();

          makeLayerDraggable(nestedEl, targetContainer);
          makeLayerResizable(nestedEl);

          // Extract button handler
          const btnExtract = nestedEl.querySelector(".btn-extract-frame");
          if (btnExtract) {
            btnExtract.addEventListener("click", (e) => {
              e.stopPropagation();
              extractLayerToCanvas(nestedEl);
            });
          }

          pushAction({
            type: "NEST_FRAME",
            frameA: sourceFrame,
            frameB: targetFrame,
            parentArtboard,
            containerB: targetContainer,
            nestedEl,
            oldX,
            oldY,
          });

          selectLayer(nestedEl);
          showToast("Image Inserted", "success");
        }

        // ==========================================
        // CANVAS INTERACTION (Mouse, Marquee, Drag & Resize)
        // ==========================================
        if (canvasContainer) {
          // Mousedown Handler
          canvasContainer.addEventListener("mousedown", (e) => {
            // Case -1: Resizing Layer Corner Handle (Immediate Priority)
            const clickedLayerHandle = e.target.closest(".layer-resize-handle");
            if (clickedLayerHandle && currentTool === "select") {
              const layer = clickedLayerHandle.closest(
                ".nested-frame-item, .canvas-frame-layer",
              );
              if (layer) {
                isResizingLayer = true;
                resizingLayer = layer;
                layerResizeHandle = clickedLayerHandle.dataset.handle;
                layerResizeStartW = layer.offsetWidth;
                layerResizeStartH = layer.offsetHeight;
                layerResizeStartLeft = parseFloat(layer.style.left) || 0;
                layerResizeStartTop = parseFloat(layer.style.top) || 0;
                layerResizeStartX = e.clientX;
                layerResizeStartY = e.clientY;
                selectLayer(layer);
                e.preventDefault();
                e.stopPropagation();
                return;
              }
            }

            // Case 0: Resizing Frame Corner Handle
            const clickedHandle = e.target.closest(".resize-handle");
            if (clickedHandle && currentTool === "select") {
              const frame = clickedHandle.closest(".canvas-frame");
              if (frame) {
                isResizingFrame = true;
                resizeHandle = clickedHandle.dataset.handle;
                resizingFrame = frame;
                const inner = frame.querySelector(".canvas-frame-inner");
                resizeStartW = inner ? inner.offsetWidth : 420;
                resizeStartH = inner ? inner.offsetHeight : 560;
                resizeStartX = e.clientX;
                resizeStartY = e.clientY;
                resizeFrameStartX = parseFloat(frame.dataset.x || "0");
                resizeFrameStartY = parseFloat(frame.dataset.y || "0");
                resizeOldDimensions = frame.dataset.dimensions || "768 × 1024";

                selectFrame(frame, false);
                e.preventDefault();
                e.stopPropagation();
                return;
              }
            }

            // Floating UI / buttons / inputs should not trigger canvas drag
            if (
              e.target.closest("#image-context-menu") ||
              e.target.closest("button") ||
              e.target.closest("input") ||
              e.target.closest("#dropdown-select") ||
              e.target.closest("#credit-wrapper") ||
              e.target.closest("#credit-dropdown")
            ) {
              return;
            }

            // Case 1: Hand Tool or Spacebar or Middle Mouse -> Pan Canvas Viewport (High Priority)
            if (currentTool === "hand" || isSpacePressed || e.button === 1) {
              isPanning = true;
              panStartX = e.clientX - panX;
              panStartY = e.clientY - panY;
              canvasContainer.style.cursor = "grabbing";
              e.preventDefault();
              return;
            }

            // If clicking inside layers when in Select Tool, let layer interaction handle it
            if (
              e.target.closest(".nested-frame-item") ||
              e.target.closest(".canvas-frame-layer")
            ) {
              return;
            }

            const clickedFrame = e.target.closest(".canvas-frame");

            // Case 2: Select Tool + Clicked Frame -> Drag Frame(s)
            if (
              clickedFrame &&
              !clickedFrame.querySelector(".frame-generating-border-shine") &&
              currentTool === "select"
            ) {
              const isMulti = e.shiftKey;

              // If clicking a frame that's not selected yet
              if (!selectedFrames.has(clickedFrame)) {
                selectFrame(clickedFrame, isMulti);
              } else if (isMulti) {
                // Toggle off on shift click
                selectFrame(clickedFrame, true);
                return;
              }

              isDraggingFrames = true;
              dragStartX = e.clientX;
              dragStartY = e.clientY;

              frameStartPositions.clear();
              selectedFrames.forEach((frame) => {
                const sx = parseFloat(frame.dataset.x || "0");
                const sy = parseFloat(frame.dataset.y || "0");
                frameStartPositions.set(frame, { sx, sy });
              });

              canvasContainer.style.cursor = "move";
              e.preventDefault();
              return;
            }

            // Case 3: Select Tool + Empty Canvas Background -> Marquee Selection ("Block Frame")
            if (!clickedFrame && currentTool === "select" && !isSpacePressed) {
              isMarqueeSelecting = true;
              marqueeStartX = e.clientX;
              marqueeStartY = e.clientY;

              if (!e.shiftKey) {
                selectedFrames.clear();
                primarySelectedFrame = null;
                deselectLayer();
                updateSelectionUI();
              }

              if (marqueeBox) {
                marqueeBox.style.left = marqueeStartX + "px";
                marqueeBox.style.top = marqueeStartY + "px";
                marqueeBox.style.width = "0px";
                marqueeBox.style.height = "0px";
                marqueeBox.classList.remove("hidden");
              }

              e.preventDefault();
            }
          });

          // Trackpad / Wheel Support: Pinch-to-zoom or 2-finger Pan
          canvasContainer.addEventListener(
            "wheel",
            (e) => {
              if (
                e.target.closest("#right-panel") ||
                e.target.closest(".overflow-y-auto")
              )
                return;

              e.preventDefault();
              if (e.ctrlKey || e.metaKey) {
                // Zooming
                const zoomDelta = -e.deltaY * 0.005;
                zoomLevel = Math.min(
                  3.0,
                  Math.max(0.2, +(zoomLevel + zoomDelta).toFixed(2)),
                );
                applyCanvasTransform();
              } else {
                // Panning
                panX -= e.deltaX;
                panY -= e.deltaY;
                applyCanvasTransform();
              }
            },
            { passive: false },
          );
        }

        // Mousemove Handler
        window.addEventListener("mousemove", (e) => {
          // 1. Panning Canvas
          if (isPanning) {
            panX = e.clientX - panStartX;
            panY = e.clientY - panStartY;
            applyCanvasTransform();
            return;
          }

          // 1b. Resizing Layer Handle (Locked Aspect Ratio)
          if (isResizingLayer && resizingLayer) {
            const dx = (e.clientX - layerResizeStartX) / zoomLevel;
            const dy = (e.clientY - layerResizeStartY) / zoomLevel;

            let newW = layerResizeStartW;
            let newH = layerResizeStartH;
            let newLeft = layerResizeStartLeft;
            let newTop = layerResizeStartTop;

            const aspectRatio =
              layerResizeStartW && layerResizeStartH
                ? layerResizeStartW / layerResizeStartH
                : 420 / 560;
            const minW = 30;
            const minH = Math.round(minW / aspectRatio);

            if (layerResizeHandle === "br") {
              if (Math.abs(dx) >= Math.abs(dy)) {
                newW = Math.max(minW, layerResizeStartW + dx);
                newH = Math.round(newW / aspectRatio);
              } else {
                newH = Math.max(minH, layerResizeStartH + dy);
                newW = Math.round(newH * aspectRatio);
              }
            } else if (layerResizeHandle === "bl") {
              if (Math.abs(dx) >= Math.abs(dy)) {
                newW = Math.max(minW, layerResizeStartW - dx);
                newH = Math.round(newW / aspectRatio);
              } else {
                newH = Math.max(minH, layerResizeStartH + dy);
                newW = Math.round(newH * aspectRatio);
              }
              newLeft = layerResizeStartLeft + (layerResizeStartW - newW);
            } else if (layerResizeHandle === "tr") {
              if (Math.abs(dx) >= Math.abs(dy)) {
                newW = Math.max(minW, layerResizeStartW + dx);
                newH = Math.round(newW / aspectRatio);
              } else {
                newH = Math.max(minH, layerResizeStartH - dy);
                newW = Math.round(newH * aspectRatio);
              }
              newTop = layerResizeStartTop + (layerResizeStartH - newH);
            } else if (layerResizeHandle === "tl") {
              if (Math.abs(dx) >= Math.abs(dy)) {
                newW = Math.max(minW, layerResizeStartW - dx);
                newH = Math.round(newW / aspectRatio);
              } else {
                newH = Math.max(minH, layerResizeStartH - dy);
                newW = Math.round(newH * aspectRatio);
              }
              newLeft = layerResizeStartLeft + (layerResizeStartW - newW);
              newTop = layerResizeStartTop + (layerResizeStartH - newH);
            }

            resizingLayer.style.width = Math.round(newW) + "px";
            resizingLayer.style.height = Math.round(newH) + "px";
            resizingLayer.style.left = Math.round(newLeft) + "px";
            resizingLayer.style.top = Math.round(newTop) + "px";

            updateContextMenuPosition();
            return;
          }

          // 2. Resizing Frame Handle (Locked Aspect Ratio)
          if (isResizingFrame && resizingFrame) {
            const dx = (e.clientX - resizeStartX) / zoomLevel;
            const dy = (e.clientY - resizeStartY) / zoomLevel;
            const inner = resizingFrame.querySelector(".canvas-frame-inner");
            const dimBadge = resizingFrame.querySelector(".dimension-badge");
            if (!inner) return;

            let newW = resizeStartW;
            let newH = resizeStartH;
            let newX = resizeFrameStartX;
            let newY = resizeFrameStartY;

            const aspectRatio =
              resizeStartW && resizeStartH
                ? resizeStartW / resizeStartH
                : 420 / 560;
            const minW = 160;
            const minH = Math.round(minW / aspectRatio);

            if (resizeHandle === "br") {
              if (Math.abs(dx) >= Math.abs(dy)) {
                newW = Math.max(minW, resizeStartW + dx);
                newH = Math.round(newW / aspectRatio);
              } else {
                newH = Math.max(minH, resizeStartH + dy);
                newW = Math.round(newH * aspectRatio);
              }
            } else if (resizeHandle === "bl") {
              if (Math.abs(dx) >= Math.abs(dy)) {
                newW = Math.max(minW, resizeStartW - dx);
                newH = Math.round(newW / aspectRatio);
              } else {
                newH = Math.max(minH, resizeStartH + dy);
                newW = Math.round(newH * aspectRatio);
              }
              newX = resizeFrameStartX + (resizeStartW - newW);
            } else if (resizeHandle === "tr") {
              if (Math.abs(dx) >= Math.abs(dy)) {
                newW = Math.max(minW, resizeStartW + dx);
                newH = Math.round(newW / aspectRatio);
              } else {
                newH = Math.max(minH, resizeStartH - dy);
                newW = Math.round(newH * aspectRatio);
              }
              newY = resizeFrameStartY + (resizeStartH - newH);
            } else if (resizeHandle === "tl") {
              if (Math.abs(dx) >= Math.abs(dy)) {
                newW = Math.max(minW, resizeStartW - dx);
                newH = Math.round(newW / aspectRatio);
              } else {
                newH = Math.max(minH, resizeStartH - dy);
                newW = Math.round(newH * aspectRatio);
              }
              newX = resizeFrameStartX + (resizeStartW - newW);
              newY = resizeFrameStartY + (resizeStartH - newH);
            }

            inner.style.width = Math.round(newW) + "px";
            inner.style.height = Math.round(newH) + "px";
            resizingFrame.dataset.x = Math.round(newX);
            resizingFrame.dataset.y = Math.round(newY);
            resizingFrame.style.transform = `translate(${Math.round(newX)}px, ${Math.round(newY)}px)`;

            // Calculate dynamic pixel dimensions for badge
            const pxW = Math.round(newW * 1.83);
            const pxH = Math.round(newH * 1.83);
            const newDimText = `${pxW} × ${pxH}`;
            resizingFrame.dataset.dimensions = newDimText;
            if (dimBadge) {
              dimBadge.textContent = newDimText;
            }

            updateContextMenuPosition();
            return;
          }

          // 3. Dragging Frame(s)
          if (isDraggingFrames) {
            const dx = (e.clientX - dragStartX) / zoomLevel;
            const dy = (e.clientY - dragStartY) / zoomLevel;

            frameStartPositions.forEach((startPos, frame) => {
              const nx = startPos.sx + dx;
              const ny = startPos.sy + dy;
              frame.dataset.x = nx;
              frame.dataset.y = ny;
              frame.style.transform = `translate(${nx}px, ${ny}px)`;
            });

            // Check if dragging single frame over another frame for nesting
            if (selectedFrames.size === 1 && primarySelectedFrame) {
              let foundDropTarget = null;
              const mouseX = e.clientX;
              const mouseY = e.clientY;

              getAllCanvasFrames().forEach((otherFrame) => {
                if (otherFrame === primarySelectedFrame) return;
                const r = otherFrame.getBoundingClientRect();
                if (
                  mouseX >= r.left &&
                  mouseX <= r.right &&
                  mouseY >= r.top &&
                  mouseY <= r.bottom
                ) {
                  foundDropTarget = otherFrame;
                }
              });

              if (foundDropTarget !== hoveredNestingTarget) {
                if (hoveredNestingTarget) {
                  hoveredNestingTarget.classList.remove(
                    "ring-4",
                    "ring-[#2563EB]",
                    "ring-offset-2",
                    "bg-blue-50/20",
                  );
                }
                hoveredNestingTarget = foundDropTarget;
                if (hoveredNestingTarget) {
                  hoveredNestingTarget.classList.add(
                    "ring-4",
                    "ring-[#2563EB]",
                    "ring-offset-2",
                    "bg-blue-50/20",
                  );
                }
              }
            }

            updateContextMenuPosition();
            return;
          }

          // 4. Marquee Box Selection ("Block Frame")
          if (isMarqueeSelecting && marqueeBox) {
            const minX = Math.min(marqueeStartX, e.clientX);
            const maxX = Math.max(marqueeStartX, e.clientX);
            const minY = Math.min(marqueeStartY, e.clientY);
            const maxY = Math.max(marqueeStartY, e.clientY);

            marqueeBox.style.left = minX + "px";
            marqueeBox.style.top = minY + "px";
            marqueeBox.style.width = maxX - minX + "px";
            marqueeBox.style.height = maxY - minY + "px";

            // Detect intersection with each canvas frame
            getAllCanvasFrames().forEach((frame) => {
              const r = frame.getBoundingClientRect();
              const isOverlap = !(
                r.right < minX ||
                r.left > maxX ||
                r.bottom < minY ||
                r.top > maxY
              );

              if (isOverlap) {
                selectedFrames.add(frame);
                if (!primarySelectedFrame) primarySelectedFrame = frame;
              } else if (!e.shiftKey) {
                selectedFrames.delete(frame);
              }
            });

            updateSelectionUI();
          }
        });

        // Mouseup Handler
        window.addEventListener("mouseup", () => {
          if (isPanning) {
            isPanning = false;
            if (canvasContainer) {
              canvasContainer.style.cursor =
                currentTool === "hand" || isSpacePressed ? "grab" : "";
            }
          }

          if (isResizingLayer) {
            if (resizingLayer) {
              const finalW = resizingLayer.offsetWidth;
              const finalH = resizingLayer.offsetHeight;
              const finalLeft = parseFloat(resizingLayer.style.left) || 0;
              const finalTop = parseFloat(resizingLayer.style.top) || 0;
              if (
                finalW !== layerResizeStartW ||
                finalH !== layerResizeStartH ||
                finalLeft !== layerResizeStartLeft ||
                finalTop !== layerResizeStartTop
              ) {
                pushAction({
                  type: "RESIZE_LAYER",
                  layer: resizingLayer,
                  oldW: layerResizeStartW,
                  oldH: layerResizeStartH,
                  oldLeft: layerResizeStartLeft,
                  oldTop: layerResizeStartTop,
                  newW: finalW,
                  newH: finalH,
                  newLeft: finalLeft,
                  newTop: finalTop,
                });
              }
            }
            isResizingLayer = false;
            resizingLayer = null;
            layerResizeHandle = null;
          }

          if (isResizingFrame) {
            if (resizingFrame) {
              const inner = resizingFrame.querySelector(".canvas-frame-inner");
              const finalW = inner ? inner.offsetWidth : resizeStartW;
              const finalH = inner ? inner.offsetHeight : resizeStartH;
              const finalX = parseFloat(resizingFrame.dataset.x || "0");
              const finalY = parseFloat(resizingFrame.dataset.y || "0");
              const finalDim = resizingFrame.dataset.dimensions || "";

              if (finalW !== resizeStartW || finalH !== resizeStartH) {
                pushAction({
                  type: "RESIZE",
                  frame: resizingFrame,
                  oldW: resizeStartW,
                  oldH: resizeStartH,
                  newW: finalW,
                  newH: finalH,
                  oldX: resizeFrameStartX,
                  oldY: resizeFrameStartY,
                  newX: finalX,
                  newY: finalY,
                  oldDimensions: resizeOldDimensions,
                  newDimensions: finalDim,
                });
              }
            }
            isResizingFrame = false;
            resizingFrame = null;
            resizeHandle = null;
          }

          if (isDraggingFrames) {
            if (
              hoveredNestingTarget &&
              selectedFrames.size === 1 &&
              primarySelectedFrame
            ) {
              const dragged = primarySelectedFrame;
              const target = hoveredNestingTarget;
              hoveredNestingTarget.classList.remove(
                "ring-4",
                "ring-[#2563EB]",
                "ring-offset-2",
                "bg-blue-50/20",
              );
              hoveredNestingTarget = null;
              nestFrameIntoFrame(dragged, target);
            } else {
              if (hoveredNestingTarget) {
                hoveredNestingTarget.classList.remove(
                  "ring-4",
                  "ring-[#2563EB]",
                  "ring-offset-2",
                  "bg-blue-50/20",
                );
                hoveredNestingTarget = null;
              }

              // Check if positions changed to record MOVE action
              const movedFrames = [];
              frameStartPositions.forEach((startPos, frame) => {
                const currentX = parseFloat(frame.dataset.x || "0");
                const currentY = parseFloat(frame.dataset.y || "0");
                if (currentX !== startPos.sx || currentY !== startPos.sy) {
                  movedFrames.push({
                    frame,
                    oldX: startPos.sx,
                    oldY: startPos.sy,
                    newX: currentX,
                    newY: currentY,
                  });
                }
              });

              if (movedFrames.length > 0) {
                pushAction({
                  type: "MOVE",
                  frames: movedFrames,
                });
              }
            }

            isDraggingFrames = false;
            if (canvasContainer) {
              canvasContainer.style.cursor =
                currentTool === "hand" || isSpacePressed ? "grab" : "";
            }
          }

          if (isMarqueeSelecting) {
            isMarqueeSelecting = false;
            if (marqueeBox) {
