          const hasBadges = aiInput
            ? aiInput.querySelectorAll(".ref-badge").length > 0
            : false;

          // If chat is empty and has no reference badges, do not submit
          if (!text && !hasBadges) {
            return;
          }

          // If text is empty but has badges, provide default prompt
          if (!text && hasBadges) {
            text = "Generate with attached references";
