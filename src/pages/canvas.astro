          });

          canvasContainer.addEventListener("drop", (e) => {
            e.preventDefault();
            const files = e.dataTransfer.files;
            if (files && files.length > 0) {
              let hasImage = false;
              for (let i = 0; i < files.length; i++) {
                const file = files[i];
                if (file.type.startsWith("image/")) {
                  hasImage = true;
                  const url = URL.createObjectURL(file);
                  const tempImg = new Image();
                  tempImg.onerror = () => {
                    showToast(
                      "Upload Failed",
                      "Could not process dropped image file.",
                      "error",
                    );
                  };
                  tempImg.onload = () => {
                    createNewCanvasFrame({
                      url,
                      fileName: file.name,
                      width: tempImg.naturalWidth,
                      height: tempImg.naturalHeight,
                      isUploading: true,
                    });
                  };
                  tempImg.src = url;
                }
              }
              if (!hasImage) {
                showToast(
                  "Upload Failed",
                  "Only image files (PNG, JPG, WebP) can be dropped onto the canvas.",
                  "error",
                );
              }
            }
          });
        }

