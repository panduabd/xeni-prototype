              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 256 256" class="text-[#111827]"><path d="M208,144a15.78,15.78,0,0,1-10.42,14.94L146,178l-19,51.62a15.92,15.92,0,0,1-29.88,0L78,178l-51.62-19a15.92,15.92,0,0,1,0-29.88L78,110l19-51.62a15.92,15.92,0,0,1,29.88,0L146,110l51.62,19A15.78,15.78,0,0,1,208,144ZM152,48h16V64a8,8,0,0,0,16,0V48h16a8,8,0,0,0,0-16H184V16a8,8,0,0,0-16,0V32H152a8,8,0,0,0,0,16Zm88,32h-8V72a8,8,0,0,0-16,0v8h-8a8,8,0,0,0,0,16h8v8a8,8,0,0,0,16,0V96h8a8,8,0,0,0,0-16Z"></path></svg>
            </div>
            <span class="text-[12px] font-medium text-[#111827]">Xeni</span>
            <span class="text-[11px] font-medium text-[#9CA3AF] ml-1">${today}</span>
          </div>
          <div class="flex gap-2 mt-1 w-full">
            <div class="relative group cursor-pointer overflow-hidden rounded-none border border-[#eaecf0] shadow-sm aspect-[4/5] flex-1 w-0" onclick="window.previewImage(this.querySelector('img').src)">
              <img src="/media/generated_image.png" onerror="this.src='https://images.unsplash.com/photo-1550583724-b2692b85b150?auto=format&fit=crop&w=800&q=80'" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" alt="Generated Image" />
              <button onclick="event.stopPropagation(); window.downloadImage(this.parentElement.querySelector('img').src)" class="absolute top-2 right-2 w-7 h-7 rounded bg-black/60 hover:bg-black text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all z-10 cursor-pointer shadow-sm backdrop-blur-sm" title="Download image">
                <i class="ti ti-download text-[13px]"></i>
              </button>
            </div>
          </div>
          <div class="rating-wrapper flex flex-col items-start mt-2.5 w-full">
            <div class="flex items-center gap-3">
              <div class="text-[13px] text-[#344054] font-medium">
                How was this result?
              </div>
              <div class="star-rating-container flex gap-1">
                <svg onclick="handleStarClick(this, 5)" class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                <svg onclick="handleStarClick(this, 4)" class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                <svg onclick="handleStarClick(this, 3)" class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                <svg onclick="handleStarClick(this, 2)" class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                <svg onclick="handleStarClick(this, 1)" class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              </div>
            </div>
          </div>
        </div>
      `;
            chatHistoryContainer.insertAdjacentHTML("beforeend", imgHtml);
            chatHistoryContainer.scrollTop = chatHistoryContainer.scrollHeight;

            // Canvas replace
            if (frameId) {
              const frameEl = document.getElementById(frameId);
              if (frameEl) {
                // Remove the light shine border
                const shineEl = frameEl.querySelector(
                  ".frame-generating-border-shine",
                );
                if (shineEl) shineEl.remove();

                // Add normal frame border styling
                frameEl.className =
                  "canvas-frame relative bg-white cursor-pointer border border-[#eaecf0] hover:border-[#2563EB] flex items-center justify-center select-none rounded-sm transition-shadow";

                const innerContainer = frameEl.querySelector(
                  ".canvas-frame-inner",
                );
                if (innerContainer) {
                  innerContainer.className =
                    "canvas-frame-inner relative w-[420px] h-[560px] flex items-center justify-center pointer-events-auto overflow-hidden bg-[#1f2937]";
                  innerContainer.innerHTML = `<img src="https://images.unsplash.com/photo-1550583724-b2692b85b150?auto=format&fit=crop&w=800&q=80" class="w-full h-full object-cover pointer-events-none" alt="Generated Image" />`;
                }

                // Ensure drop target is configured
                if (typeof setupFrameDropTarget === "function") {
                  setupFrameDropTarget(frameEl);
                }

                // Automatically select the new frame so it immediately has the exact same active state as other frames!
                if (typeof selectFrame === "function") {
                  selectFrame(frameEl, false);
                }
              }
            }
          }, 5000);
        }
      });
    </script>

    <!-- Popover Modal (moved via JS) -->
    <div
      id="feedback-popover"
      class="hidden mt-2.5 bg-white border border-[#eaecf0] rounded-xl w-[280px] p-3 flex flex-col gap-2 animate-in fade-in duration-150"
    >
      <div class="flex items-center justify-between">
        <h3 class="text-[#111827] text-[12px] font-semibold">
          How was this result?
        </h3>
        <div class="flex gap-0.5 text-[#F59E0B]" id="popover-stars">
          <!-- populated by JS -->
        </div>
      </div>
      <div>
        <div
          class="text-[#344054] text-[11px] font-medium mb-1 flex items-center gap-1"
        >
          Comment <span class="text-[#98a2b3] font-normal">(optional)</span>
        </div>
        <textarea
          id="feedback-textarea"
          class="w-full bg-[#F9FAFB] border border-[#eaecf0] rounded-lg p-2 text-[11px] text-[#111827] placeholder-[#98a2b3] outline-none focus:border-[#d0d5dd] focus:bg-white resize-none h-[46px]"
          placeholder="Additional feedback"></textarea>
      </div>
      <div class="flex items-center justify-end pt-0.5">
        <button
          class="px-3.5 py-1 rounded-lg bg-[#111827] text-white text-[11px] font-medium hover:bg-[#1f2937] transition-colors cursor-pointer"
          onclick="window.submitFeedback()">Submit</button
        >
      </div>
    </div>

    <script is:inline>
      window.currentFeedbackWrapper = null;

      window.handleStarClick = function (svgEl, rating) {
        const container = svgEl.closest(".star-rating-container");
        const wrapper = svgEl.closest(".rating-wrapper");
        if (!container || !wrapper) return;

        window.currentFeedbackWrapper = wrapper;

        // Update UI stars
        container.classList.add("rated");
        const stars = container.querySelectorAll("svg");
        stars.forEach((s) => s.classList.remove("active"));
        svgEl.classList.add("active");

        const popover = document.getElementById("feedback-popover");
        if (popover) {
          // Append popover into wrapper as normal flow element directly below stars
          wrapper.appendChild(popover);
          popover.classList.remove("hidden");

          // Update popover stars
          const popoverStarsContainer =
            document.getElementById("popover-stars");
          if (popoverStarsContainer) {
            popoverStarsContainer.innerHTML = "";
            for (let i = 1; i <= 5; i++) {
              const color = i <= rating ? "text-[#F59E0B]" : "text-[#D0D5DD]";
              popoverStarsContainer.innerHTML += `<svg xmlns="http://www.w3.org/2000/svg" class="w-[13px] h-[13px] ${color}" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`;
            }
          }

          // Smoothly scroll container so the newly expanded popover is fully in view
          const chatContainer = document.getElementById(
            "chat-history-container",
          );
          if (chatContainer) {
            setTimeout(() => {
              chatContainer.scrollTo({
                top: chatContainer.scrollHeight,
                behavior: "smooth",
              });
            }, 60);
          }
        }
      };

      window.submitFeedback = function () {
        const popover = document.getElementById("feedback-popover");
        if (popover) {
          popover.classList.add("hidden");
          document.body.appendChild(popover);
        }

        if (window.currentFeedbackWrapper) {
          const starContainer = window.currentFeedbackWrapper.querySelector(
            ".star-rating-container",
          );
          if (starContainer) {
            starContainer.outerHTML = `<span class="text-[12px] font-medium text-[#16a34a] flex items-center gap-1"><i class="ti ti-check text-[13px]"></i> Feedback received</span>`;
          }
        }
      };

      window.closeFeedbackPopover = function () {
        const popover = document.getElementById("feedback-popover");
        if (popover) {
          popover.classList.add("hidden");
          document.body.appendChild(popover);
        }
        if (window.currentFeedbackWrapper) {
          const container = window.currentFeedbackWrapper.querySelector(
            ".star-rating-container",
          );
          if (container) {
            container.classList.remove("rated");
            const stars = container.querySelectorAll("svg");
            stars.forEach((s) => s.classList.remove("active"));
          }
        }
      };

      // Close popover when clicking outside
      document.addEventListener("click", (e) => {
        const popover = document.getElementById("feedback-popover");
        if (popover && !popover.classList.contains("hidden")) {
          if (
            !popover.contains(e.target) &&
            !e.target.closest(".star-rating-container")
          ) {
            window.closeFeedbackPopover();
          }
        }
      });

      // Lightbox image preview helpers
      let currentPreviewUrl = "";
      window.previewImage = function (src) {
        if (!src) return;
        const modal = document.getElementById("image-preview-modal");
        const img = document.getElementById("preview-modal-img");
        if (modal && img) {
          img.src = src;
          currentPreviewUrl = src;
          modal.classList.remove("hidden");
        }
      };

      window.closeImagePreview = function () {
        const modal = document.getElementById("image-preview-modal");
        if (modal) modal.classList.add("hidden");
      };

      window.downloadCurrentPreview = function () {
        if (currentPreviewUrl) {
          window.downloadImage(currentPreviewUrl);
        }
      };

      window.downloadImage = function (url) {
        if (!url) return;
        fetch(url)
          .then((res) => res.blob())
          .then((blob) => {
            const blobUrl = window.URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = blobUrl;
            a.download = "xeni-generated-image.jpg";
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            window.URL.revokeObjectURL(blobUrl);
          })
          .catch(() => {
            const a = document.createElement("a");
            a.href = url;
            a.download = "xeni-generated-image.jpg";
            a.target = "_blank";
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
          });
      };

      // Close preview modal on ESC key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          window.closeImagePreview();
        }
      });
    </script>

    <!-- Image Lightbox Preview Modal -->
    <div
      id="image-preview-modal"
      class="hidden fixed inset-0 z-[200] bg-black/85 backdrop-blur-sm flex items-center justify-center p-4 animate-in fade-in duration-200"
      onclick="window.closeImagePreview()"
    >
      <div
        class="relative max-w-2xl max-h-[85vh] flex flex-col items-center"
        onclick="event.stopPropagation()"
      >
        <button
          class="absolute -top-10 right-0 text-white/80 hover:text-white transition-colors cursor-pointer flex items-center gap-1.5 text-[13px] font-medium"
          onclick="window.closeImagePreview()"
        >
          <i class="ti ti-x text-[18px]"></i> Tutup
        </button>
        <img
          id="preview-modal-img"
          src=""
          class="max-w-full max-h-[75vh] rounded-2xl object-contain shadow-2xl border border-white/10"
        />
        <div class="mt-3 flex items-center gap-3">
          <button
            id="preview-modal-download"
            class="px-4 py-2 rounded-xl bg-white text-[#111827] text-[13px] font-semibold hover:bg-gray-100 transition-colors flex items-center gap-2 shadow-lg cursor-pointer"
            onclick="window.downloadCurrentPreview()"
          >
            <i class="ti ti-download text-[15px]"></i> Unduh Gambar
          </button>
        </div>
      </div>
    </div>
  </body>
</html>
