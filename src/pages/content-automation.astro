          ? bulkScheduleData.itemIds
          : selectedApprovedIds;
      const itemMap = new Map(generatedContent.map((g) => [g.id, g]));
      return (ids || []).map((id) => itemMap.get(id)).filter(Boolean);
    }

    function openBulkScheduleModal(e) {
      if (e && e.stopPropagation) e.stopPropagation();

      // Re-sync with actual checked checkboxes if any
      const checkedInputs = [
        ...document.querySelectorAll('input[id^="cb-select-"]:checked'),
      ].map((input) => input.id.replace("cb-select-", ""));

      if (checkedInputs.length > 0) {
        selectedApprovedIds = checkedInputs;
      } else {
        selectedApprovedIds = (selectedApprovedIds || []).filter((id) => {
          const item = generatedContent.find((g) => g.id === id);
          return item && item.status === "approved";
        });
      }

      // Schedule batch requires at least 2 items selected
      if (selectedApprovedIds.length < 2) {
        showToast("Select at least 2 approved posts.", "warning");
        return;
      }

      // Lock selected IDs inside bulkScheduleData for the modal lifetime
      bulkScheduleData.itemIds = [...selectedApprovedIds];

      const modal = document.getElementById("modal-bulk-schedule");
      if (!modal) return;

      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      const dateStr = tomorrow.toISOString().split("T")[0];

      const sameDateEl = document.getElementById("bulk-same-date");
      const dailyStartEl = document.getElementById("bulk-daily-start");
      if (sameDateEl) sameDateEl.value = dateStr;
      if (dailyStartEl) dailyStartEl.value = dateStr;
      const countEl = document.getElementById("bulk-schedule-count");
      if (countEl) countEl.textContent = bulkScheduleData.itemIds.length;

      bulkScheduleData.sameDate = dateStr;
      bulkScheduleData.dailyStartDate = dateStr;
      bulkScheduleData.customAssignments = {};
      bulkScheduleData.dailyAssignments = {};

      // Check unique brands from selected approved items
      const selectedItems = getBulkActiveItems();
      const uniqueBrands = [
        ...new Set(selectedItems.map((item) => item.brand).filter(Boolean)),
      ];

      const dnaSelectEl = document.getElementById("bulk-select-dna");
      const dnaLogoEl = document.getElementById("bulk-dna-select-logo");
      const dnaIconEl = document.getElementById("bulk-dna-select-icon");

      if (uniqueBrands.length === 1) {
        // Single brand across all selected content: default to this brand!
        const brandName = uniqueBrands[0];
        if (dnaSelectEl) dnaSelectEl.value = brandName;
        if (dnaLogoEl && dnaIconEl) {
          dnaLogoEl.src = getDnaLogo(brandName);
          dnaLogoEl.classList.remove("hidden");
          dnaIconEl.classList.add("hidden");
        }
        populateBulkAccounts(brandName);
      } else {
        // Mixed brands: default is empty, user must choose!
        if (dnaSelectEl) dnaSelectEl.value = "";
        if (dnaLogoEl && dnaIconEl) {
          dnaLogoEl.classList.add("hidden");
          dnaIconEl.classList.remove("hidden");
        }
        clearBulkAccounts();
      }

      initBulkScheduleEvents();
      renderBulkCustomList();
      switchBulkScheduleTab("same-time");

      modal.classList.remove("hidden");
      modal.classList.add("flex");
    }

    function closeBulkScheduleModal() {
      const modal = document.getElementById("modal-bulk-schedule");
      if (modal) {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }
      bulkScheduleData.itemIds = [];
      bulkScheduleData.dailyAssignments = {};
    }

    function switchBulkScheduleTab(mode) {
      bulkScheduleMode = mode;

      document.querySelectorAll(".bulk-schedule-tab").forEach((btn) => {
        const isActive = btn.dataset.tab === mode;
        if (isActive) {
          btn.classList.add("bg-white", "text-[#18181b]", "shadow-xs");
          btn.classList.remove("text-[#71717a]", "hover:bg-white/60");
        } else {
          btn.classList.remove("bg-white", "text-[#18181b]", "shadow-xs");
          btn.classList.add("text-[#71717a]", "hover:bg-white/60");
        }
      });

      document
        .getElementById("bulk-panel-same-time")
        .classList.toggle("hidden", mode !== "same-time");
      document
        .getElementById("bulk-panel-daily-post")
        .classList.toggle("hidden", mode !== "daily-post");
      document
        .getElementById("bulk-panel-custom")
        .classList.toggle("hidden", mode !== "custom");

      // Hide preview timeline on custom tab
      const previewContainer = document.getElementById(
        "bulk-preview-timeline-container",
      );
      if (previewContainer) {
        previewContainer.classList.toggle("hidden", mode === "custom");
      }

      renderBulkSchedulePreview();
    }

    function renderBulkCustomList() {
