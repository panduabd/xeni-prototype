    // Universal helper to build shadcn-styled badge for selected social accounts
    function createShadcnAccountBadge(labelTxt, platform, onRemove) {
      const badge = document.createElement("div");
      badge.className = "inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-[#e4e4e7] bg-[#f4f4f5] text-[12px] font-medium text-[#18181b] transition-colors select-none group";
      badge.innerHTML = `
        ${getSocialIconSvg(platform, "13px")}
        <span class="truncate">${escapeHtml(labelTxt)}</span>
        <button type="button" aria-label="Remove ${escapeHtml(labelTxt)}" class="ml-0.5 w-4 h-4 rounded flex items-center justify-center text-[#71717a] hover:bg-[#e4e4e7] hover:text-[#18181b] transition-colors cursor-pointer">
          <i class="ti ti-x text-[10px]"></i>
        </button>
      `;
      const btn = badge.querySelector("button");
      if (btn && typeof onRemove === "function") {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          onRemove();
        });
      }
      return badge;
    }

