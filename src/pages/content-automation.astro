    window.toggleSummaryCardCheck = function (id) {
      const card = document.getElementById(`summary-card-${id}`);
      if (!card) return;
      const btn = card.querySelector(".summary-check-btn");
      const input = card.querySelector(".summary-item-check");
      const icon = card.querySelector(".summary-check-icon");
      if (!input) return;

      input.checked = !input.checked;
      if (input.checked) {
        if (btn)
          btn.className =
            "summary-check-btn absolute top-2 right-2 w-6 h-6 rounded-md bg-blue-600 text-white flex items-center justify-center shadow-xs transition-all cursor-pointer z-20 hover:scale-105 hover:bg-blue-700";
        if (icon) icon.classList.remove("opacity-0");
        card.classList.remove("opacity-60");
      } else {
        if (btn)
          btn.className =
            "summary-check-btn absolute top-2 right-2 w-6 h-6 rounded-md bg-white/90 backdrop-blur-xs border border-zinc-300 text-transparent flex items-center justify-center shadow-xs transition-all cursor-pointer z-20 hover:scale-105 hover:border-zinc-500";
        if (icon) icon.classList.add("opacity-0");
        card.classList.add("opacity-60");
      }
      updateSummarySelectedCount();
    };

    window.updateSummarySelectedCount = function () {
      const count = document.querySelectorAll(
        ".summary-item-check:checked",
      ).length;
      const countEl = document.getElementById("summary-count");
      if (countEl) countEl.textContent = count;
    };

    function getSummaryCheckedIds() {
      const boxes = document.querySelectorAll(".summary-item-check:checked");
      return Array.from(boxes).map((b) => b.value);
    }

    function closeSummaryPortal() {
      const sumModal = document.getElementById("modal-approval-summary");
      if (sumModal) {
        sumModal.classList.add("hidden");
        sumModal.classList.remove("flex");
      }
      sessionApprovedIds = []; // Safe reset upon final closure
    }

    function initSummaryFeatureEvents() {
      const selectAll = document.getElementById("summary-select-all");
      if (selectAll) {
        selectAll.checked = true;
        selectAll.addEventListener("change", (e) => {
          const isChecked = e.target.checked;
          document.querySelectorAll(".summary-item-check").forEach((cb) => {
            cb.checked = isChecked;
            const id = cb.value;
            const card = document.getElementById(`summary-card-${id}`);
            if (!card) return;
            const btn = card.querySelector(".summary-check-btn");
            const icon = card.querySelector(".summary-check-icon");
            if (isChecked) {
              if (btn)
                btn.className =
                  "summary-check-btn absolute top-2 right-2 w-6 h-6 rounded-md bg-blue-600 text-white flex items-center justify-center shadow-xs transition-all cursor-pointer z-20 hover:scale-105 hover:bg-blue-700";
              if (icon) icon.classList.remove("opacity-0");
              card.classList.remove("opacity-60");
            } else {
              if (btn)
                btn.className =
                  "summary-check-btn absolute top-2 right-2 w-6 h-6 rounded-md bg-white/90 backdrop-blur-xs border border-zinc-300 text-transparent flex items-center justify-center shadow-xs transition-all cursor-pointer z-20 hover:scale-105 hover:border-zinc-500";
              if (icon) icon.classList.add("opacity-0");
              card.classList.add("opacity-60");
            }
          });
          updateSummarySelectedCount();
        });
      }

      const btnLater = document.getElementById("summary-btn-later");
      const btnClose = document.getElementById("btn-close-summary");
      [btnLater, btnClose].forEach((btn) => {
        if (btn) btn.addEventListener("click", closeSummaryPortal);
      });

      const btnPublish = document.getElementById("summary-btn-publish");
      if (btnPublish) {
        btnPublish.addEventListener("click", () => {
          const ids = getSummaryCheckedIds();
          if (ids.length === 0)
            return showToast("Please select items to publish.");

          ids.forEach((id) => {
            const itm = generatedContent.find((g) => g.id === id);
            if (itm) {
              itm.status = "published";
              itm.publishedAt = new Date().toISOString();
            }
          });

          saveGenerated();
          renderGenerated();
          closeSummaryPortal();
          showToast(
            `🚀 Successfully published ${ids.length} item(s) directly!`,
          );
        });
      }

      const btnSchedule = document.getElementById("summary-btn-schedule");
      if (btnSchedule) {
        btnSchedule.addEventListener("click", () => {
          const ids = getSummaryCheckedIds();
          if (ids.length === 0)
            return showToast("Please select items to schedule.");

          // Handover directly into system's existing Bulk system
          selectedApprovedIds = ids;
          // Keep summary modal open underneath
          // Standard system invoke
          if (typeof openBulkScheduleModal === "function")
            openBulkScheduleModal();
        });
      }
    }

    function openPreviewScheduleModal() {
      if (!previewingContentId) return;
      selectedApprovedIds = [previewingContentId];

      const item = generatedContent.find((g) => g.id === previewingContentId);

      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      const dateStr = tomorrow.toISOString().split("T")[0];

      const dateInput = document.getElementById("preview-schedule-date");
      const timeInput = document.getElementById("preview-schedule-time");
      if (dateInput) dateInput.value = dateStr;
      if (timeInput) timeInput.value = "08:00";

      // Populate preview content image, caption, and auto-match Business DNA
      if (item) {
        const mainImg = document.getElementById("preview-schedule-main-image");
        const thumbImg = document.getElementById("preview-schedule-thumb");
        const captionArea = document.getElementById("preview-schedule-caption");
        const typeBadge = document.getElementById("preview-schedule-post-type-badge");
        const selectDna = document.getElementById("preview-select-business-dna");
        const socialContainer = document.getElementById("preview-social-accounts-container");

        const displayImg = item.imageUrl || item.image;
        if (mainImg && displayImg) mainImg.src = displayImg;
        if (thumbImg && displayImg) thumbImg.src = displayImg;
        if (captionArea && item.caption) captionArea.value = item.caption;
        if (typeBadge) typeBadge.textContent = item.contentType || item.format || "Single Post";

        // Map item brand to Select Business option
        if (selectDna) {
          const brandName = (item.brand || "").toLowerCase().trim();
          let matchedValue = "fresh-juice";
          if (brandName.includes("tech") || brandName.includes("startup")) {
            matchedValue = "tech-startup";
          } else if (brandName.includes("luxe") || brandName.includes("beauty")) {
            matchedValue = "luxe-beauty";
          } else if (brandName.includes("coffee") || brandName.includes("brew") || brandName.includes("urban")) {
            matchedValue = "urban-coffee";
          } else if (brandName.includes("horizon") || brandName.includes("finance")) {
            matchedValue = "horizon-finance";
          } else if (brandName.includes("nova") || brandName.includes("robotics")) {
            matchedValue = "nova-robotics";
          } else if (brandName.includes("bloom") || brandName.includes("florist")) {
            matchedValue = "bloom-studio";
          } else if (brandName.includes("peak") || brandName.includes("fit")) {
            matchedValue = "peak-performance";
          } else if (brandName.includes("aura") || brandName.includes("wellness") || brandName.includes("glow")) {
            matchedValue = "aura-wellness";
          } else if (brandName.includes("juice")) {
            matchedValue = "fresh-juice";
          }

          selectDna.value = matchedValue;
          if (socialContainer) {
            socialContainer.classList.remove("hidden");
          }
        }
      }

      closePreviewModal();
      const modal = document.getElementById("modal-preview-schedule");
      if (modal) {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
      }
    }

    function closePreviewScheduleModal() {
