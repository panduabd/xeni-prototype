      }
      const saveBtn = document.getElementById("btn-save-caption");
      if (saveBtn) {
        saveBtn.classList.add("hidden");
        saveBtn.classList.remove("inline-flex");
      }

      // Hide regenerate caption for published and scheduled items
      const btnRegenerate = document.getElementById("btn-regenerate-caption");
      if (btnRegenerate) {
        if (item.status === "published" || item.status === "scheduled") {
          btnRegenerate.classList.add("hidden");
        } else {
          btnRegenerate.classList.remove("hidden");
        }
