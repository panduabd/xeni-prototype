---

<AppLayout title="Content Automation - Xeni" activePage="content-automation">
  <div class="w-full min-h-full flex flex-col px-6 pb-32 -mt-12">
    <!-- Title + Controls Row -->
    <div
      class="w-full pt-1 pb-5 flex items-center justify-between gap-4 shrink-0"
    >
      <!-- Left: Title + Info -->
      <div class="flex items-center gap-2.5 shrink-0">
        <h1 class="text-[20px] font-semibold text-[#18181b] tracking-tight">
          Content Automation
        </h1>
        <i
          class="ti ti-info-circle text-[16px] text-[#71717a] cursor-help hover:text-[#18181b] transition-colors"
          title="Content is generated daily at 2:00 AM (UTC+7). Credits are only deducted when content is generated."
        ></i>
      </div>

      <!-- Right: Status Mini Badges -->
      <div class="hidden items-center gap-2">
        <span
          class="flex items-center gap-1.5 px-2.5 h-6 rounded-md bg-emerald-50 border border-emerald-200/60 text-[11px] font-medium text-emerald-700 shadow-2xs cursor-help"
          title="Active automations"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            fill="currentColor"
            viewBox="0 0 256 256"
            class="shrink-0"
            ><path
              d="M173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34ZM232,128A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z"
            ></path></svg
          >
          <span id="status-active">0</span> Active Automation
        </span>
        <span
          class="flex items-center gap-1.5 px-2.5 h-6 rounded-md bg-[#f4f4f5] border border-[#e4e4e7] text-[11px] font-medium text-[#18181b] shadow-2xs cursor-help"
          title="Draft contents"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-[#71717a]"></span>
          <span id="status-draft">0</span> Draft
        </span>
        <span
          class="flex items-center gap-1.5 px-2.5 h-6 rounded-md bg-purple-50 border border-purple-200/60 text-[11px] font-medium text-purple-700 shadow-2xs cursor-help"
          title="Scheduled contents"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
          <span id="status-scheduled">0</span> Scheduled
        </span>
      </div>
    </div>

    <!-- Tabs Row -->
    <div class="w-full mb-6 flex items-center gap-4">
      <div
        id="main-tabs-container"
        class="relative flex items-center gap-1 p-1 bg-white rounded-xl border border-[#eaecf0] shadow-xs w-fit"
      >
        <!-- Sliding active indicator pill -->
        <div
          id="main-tabs-indicator"
          class="absolute top-1 bottom-1 rounded-lg bg-[#18181b] shadow-xs pointer-events-none transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
          style="left: 4px; width: 0px;"
        >
        </div>

        <button
          id="tab-automations"
          class="tab-btn relative z-10 px-4 h-8 rounded-lg text-[13px] font-medium text-white transition-colors duration-200 cursor-pointer"
          data-tab="automations"
        >
          Automations
        </button>
        <button
          id="tab-generated"
          class="tab-btn relative z-10 px-4 h-8 rounded-lg text-[13px] font-medium text-[#71717a] hover:text-[#18181b] transition-colors duration-200 cursor-pointer"
          data-tab="generated"
        >
          Outputs
          <span
            id="generated-badge"
            class="ml-1.5 px-2 py-0.5 rounded-md bg-orange-500 text-white text-[10px] font-bold hidden shadow-xs"
            >0</span
          >
        </button>
        <button
          id="tab-scheduled"
          class="tab-btn relative z-10 px-4 h-8 rounded-lg text-[13px] font-medium text-[#71717a] hover:text-[#18181b] transition-colors duration-200 cursor-pointer"
          data-tab="scheduled"
        >
          Scheduled
          <span
            id="scheduled-badge"
            class="ml-1.5 px-2 py-0.5 rounded-md bg-blue-600 text-white text-[10px] font-bold hidden shadow-xs"
            >0</span
          >
        </button>
      </div>
    </div>

    <!-- TAB: AUTOMATIONS -->
    <div id="tab-content-automations" class="w-full flex-1 tab-pane-animate">
      <!-- Automation Filters -->
      <div class="flex items-center justify-between gap-2 mb-4">
        <div class="flex items-center gap-2">
          <div class="relative" id="business-filter-wrapper">
            <button
              id="btn-business-filter"
              class="flex items-center gap-1.5 px-4 h-9 rounded-xl border border-[#eaecf0] bg-white text-[13px] font-medium text-[#18181b] hover:bg-[#fafafa] shadow-2xs transition-all cursor-pointer"
            >
              <i class="ti ti-building text-[14px]"></i>
              <span id="business-filter-label">All Business</span>
              <i class="ti ti-chevron-down text-[12px] text-[#71717a]"></i>
            </button>
            <div
              id="business-filter-dropdown"
              class="hidden absolute top-full left-0 mt-1.5 w-56 bg-white rounded-xl border border-[#e4e4e7] shadow-lg z-30 overflow-hidden flex flex-col p-1"
            >
              <!-- Mini Search -->
              <div class="p-2 border-b border-[#eaecf0] bg-[#fafafa]">
                <div class="relative">
                  <i
                    class="ti ti-search absolute left-2.5 top-1/2 -translate-y-1/2 text-[#a1a1aa] text-[11px]"
                  ></i>
                  <input
                    type="text"
                    class="biz-search-input w-full h-8 pl-7 pr-2 text-[12px] bg-white border border-[#e4e4e7] rounded-lg focus:outline-none focus:ring-2 focus:ring-[#18181b]/10 focus:border-[#18181b] transition-all"
                    placeholder="Search..."
                  />
                </div>
              </div>
              <!-- List -->
              <div
                class="flex flex-col p-1 max-h-[220px] overflow-y-auto custom-scrollbar biz-options-container"
              >
                {
                  dnaList.map((item) => (
                    <button
                      class="business-filter-option w-full text-left px-3 py-1.5 rounded-lg text-[13px] font-medium text-[#71717a] hover:bg-[#f4f4f5] hover:text-[#18181b] transition-colors cursor-pointer flex items-center gap-2.5"
                      data-brand={item.id}
                      data-logo={item.logo}
                    >
                      {item.id === "all" ? (
                        <div class="w-5 h-5 rounded-md bg-[#f4f4f5] border border-[#eaecf0] flex items-center justify-center shrink-0 text-[#71717a]">
                          <i class="ti ti-building text-[12px]"></i>
                        </div>
                      ) : (
                        <img
                          src={item.logo}
                          alt={item.name}
                          class="w-5 h-5 rounded-md object-cover border border-[#eaecf0] shrink-0"
                        />
                      )}
                      <span class="truncate">{item.name}</span>
                    </button>
                  ))
                }
              </div>
            </div>
          </div>

          <!-- Search -->
          <div class="relative flex-1 max-w-xs">
            <i
              class="ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-[#a1a1aa] text-[14px] pointer-events-none"
            ></i>
            <input
              id="automation-search"
              type="text"
              placeholder="Search by campaign or business..."
              class="w-80 h-9 pl-8 pr-3 rounded-xl border border-[#eaecf0] bg-white text-[13px] font-medium text-[#18181b] placeholder:text-[#a1a1aa] outline-none focus:ring-2 focus:ring-[#18181b]/10 focus:border-[#18181b] shadow-2xs transition-all"
            />
          </div>
        </div>

        <!-- Create Button (only for Automations tab) -->
        <button
          id="btn-add-automation"
          class="px-4 h-9 rounded-xl bg-[#18181b] hover:bg-black text-white text-[13px] font-medium shadow-xs active:scale-98 transition-all cursor-pointer flex items-center gap-2 border-0"
        >
          <i class="ti ti-plus text-[14px]"></i>
          Create Automation
        </button>
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="w-full hidden">
        <div class="text-center space-y-4 py-16">
          <div
            class="w-14 h-14 rounded-2xl bg-[#f4f4f5] border border-[#e4e4e7] flex items-center justify-center mx-auto text-[#71717a]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-7 h-7 text-[#71717a] shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2V5M6 2V5"></path>
              <path d="M10.5 3.5H13.5C17.2712 3.5 19.1569 3.5 20.3284 4.67157C21.5 5.84315 21.5 7.72876 21.5 11.5V14C21.5 17.7712 21.5 19.6569 20.3284 20.8284C19.1569 22 17.2712 22 13.5 22H10.5C6.72876 22 4.84315 22 3.67157 20.8284C2.5 19.6569 2.5 17.7712 2.5 14V11.5C2.5 7.72876 2.5 5.84315 3.67157 4.67157C4.84315 3.5 6.72876 3.5 10.5 3.5Z"></path>
              <path d="M3 8H21"></path>
              <path d="M8.44356 14.5282C10.0526 14.3279 11.3279 13.0526 11.5282 11.4436C11.5585 11.2 11.7545 11 12 11C12.2455 11 12.4415 11.2 12.4718 11.4436C12.6721 13.0526 13.9474 14.3279 15.5564 14.5282C15.8 14.5585 16 14.7545 16 15C16 15.2455 15.8 15.4415 15.5564 15.4718C13.9474 15.6721 12.6721 16.9474 12.4718 18.5564C12.4415 18.8 12.2455 19 12 19C11.7545 19 11.5585 18.8 11.5282 18.5564C11.3279 16.9474 10.0526 15.6721 8.44356 15.4718C8.19998 15.4415 8 15.2455 8 15C8 14.7545 8.19998 14.5585 8.44356 14.5282Z"></path>
            </svg>
          </div>
          <div class="space-y-1">
            <h2 class="text-[16px] font-semibold text-[#18181b]">
              No automation yet
            </h2>
            <p class="text-[13px] text-[#71717a]">
              Create your first automation to start scheduling content.
            </p>
          </div>
          <button
            id="btn-empty-add"
            class="px-4 h-9 rounded-xl bg-[#18181b] hover:bg-black text-white text-[13px] font-medium shadow-xs active:scale-98 transition-all cursor-pointer flex items-center gap-2 mx-auto border-0"
          >
            <i class="ti ti-plus text-[14px]"></i>
            Add Automation
          </button>
        </div>
      </div>

      <!-- Table (HeroUI Table format) -->
      <div id="automations-table" class="w-full hidden">
        <div
          class="table-root w-full overflow-clip rounded-2xl border border-[#eaecf0] bg-white shadow-xs"
        >
          <div class="table__scroll-container overflow-x-auto custom-scrollbar">
            <table
              class="table__content w-full min-w-[760px] text-left border-separate border-spacing-0 text-sm"
            >
              <thead class="table__header bg-[#fafafa]">
                <tr class="border-b border-[#eaecf0]">
                  <th
                    class="table__column px-5 py-3 text-[11px] font-semibold text-[#71717a] uppercase tracking-wider border-b border-[#eaecf0]"
                    >Business</th
                  >
                  <th
                    class="table__column px-5 py-3 text-[11px] font-semibold text-[#71717a] uppercase tracking-wider border-b border-[#eaecf0]"
                    >Task Name</th
                  >
                  <th
                    class="table__column px-5 py-3 text-[11px] font-semibold text-[#71717a] uppercase tracking-wider border-b border-[#eaecf0]"
                    >Schedule</th
                  >
                  <th
                    class="table__column px-5 py-3 text-[11px] font-semibold text-[#71717a] uppercase tracking-wider border-b border-[#eaecf0]"
                    >Content Types</th
                  >
                  <th
                    class="table__column px-5 py-3 text-[11px] font-semibold text-[#71717a] uppercase tracking-wider border-b border-[#eaecf0]"
                    >Status</th
                  >
                  <th
                    class="table__column px-5 py-3 text-[11px] font-semibold text-[#71717a] uppercase tracking-wider border-b border-[#eaecf0] text-right"
                    >Actions</th
                  >
                </tr>
              </thead>
              <tbody
                id="automations-tbody"
                class="table__body divide-y divide-[#eaecf0]"
              >
                <!-- Rows injected via JS -->
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB: GENERATED -->
    <div id="tab-content-generated" class="w-full flex-1 hidden">
      <!-- Filter Bar -->
      <div
        class="flex items-center justify-between gap-4 mb-4 flex-wrap w-full"
      >
        <!-- Left Side: Filters & Search -->
        <div class="flex items-center gap-2">
          <!-- Business Filter -->
          <div class="relative">
            <button
              id="btn-output-business-filter"
              class="flex items-center gap-1.5 px-4 h-9 rounded-xl border border-[#eaecf0] bg-white text-[13px] font-medium text-[#18181b] hover:bg-[#fafafa] shadow-2xs transition-all cursor-pointer"
            >
              <i class="ti ti-building text-[14px]"></i>
              <span id="output-business-filter-label">All Business</span>
              <i class="ti ti-chevron-down text-[12px] text-[#71717a]"></i>
            </button>
            <div
              id="output-business-filter-dropdown"
              class="hidden absolute top-full left-0 mt-1.5 w-56 bg-white rounded-xl border border-[#eaecf0] shadow-lg z-30 overflow-hidden flex flex-col p-1"
            >
              <!-- Mini Search -->
              <div class="p-2 border-b border-[#eaecf0] bg-[#fafafa]">
                <div class="relative">
                  <i
                    class="ti ti-search absolute left-2.5 top-1/2 -translate-y-1/2 text-[#a1a1aa] text-[11px]"
                  ></i>
                  <input
                    type="text"
