          <!-- Title & Brand -->
          <div class="min-w-0 flex-1">
            <p class="text-[12px] font-medium text-[#18181b] truncate">${escapeHtml(item.title || "Untitled Post")}</p>
            <p class="text-[10px] text-[#71717a] truncate">${escapeHtml(item.brand || "")}${item.contentType ? ` · ${escapeHtml(item.contentType)}` : ""}</p>
          </div>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <!-- Date Input with Calendar Icon -->
          <div 
            class="relative cursor-pointer shrink-0"
            onclick="this.querySelector('input')?.showPicker?.()"
            onmousedown="event.stopPropagation()"
          >
            <input
              type="date"
              value="${curDate}"
              onchange="updateBulkCustomDate('${item.id}', this.value)"
              class="w-[125px] h-8 pl-2.5 pr-7 rounded-lg border border-[#eaecf0] bg-white text-[11px] text-[#18181b] outline-none focus:border-[#18181b] transition-all shadow-2xs cursor-pointer [&::-webkit-calendar-picker-indicator]:opacity-0 [&::-webkit-calendar-picker-indicator]:absolute [&::-webkit-calendar-picker-indicator]:inset-0 [&::-webkit-calendar-picker-indicator]:cursor-pointer"
              onclick="try{ this.showPicker() }catch(e){}"
            />
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-3.5 h-3.5 absolute right-2.5 top-1/2 -translate-y-1/2 text-[#71717a] pointer-events-none shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2V5M6 2V5"></path>
              <path d="M10.5 3.5H13.5C17.2712 3.5 19.1569 3.5 20.3284 4.67157C21.5 5.84315 21.5 7.72876 21.5 11.5V14C21.5 17.7712 21.5 19.6569 20.3284 20.8284C19.1569 22 17.2712 22 13.5 22H10.5C6.72876 22 4.84315 22 3.67157 20.8284C2.5 19.6569 2.5 17.7712 2.5 14V11.5C2.5 7.72876 2.5 5.84315 3.67157 4.67157C4.84315 3.5 6.72876 3.5 10.5 3.5Z"></path>
              <path d="M3 8H21"></path>
              <path d="M8.44356 14.5282C10.0526 14.3279 11.3279 13.0526 11.5282 11.4436C11.5585 11.2 11.7545 11 12 11C12.2455 11 12.4415 11.2 12.4718 11.4436C12.6721 13.0526 13.9474 14.3279 15.5564 14.5282C15.8 14.5585 16 14.7545 16 15C16 15.2455 15.8 15.4415 15.5564 15.4718C13.9474 15.6721 12.6721 16.9474 12.4718 18.5564C12.4415 18.8 12.2455 19 12 19C11.7545 19 11.5585 18.8 11.5282 18.5564C11.3279 16.9474 10.0526 15.6721 8.44356 15.4718C8.19998 15.4415 8 15.2455 8 15C8 14.7545 8.19998 14.5585 8.44356 14.5282Z"></path>
