    });

    function confirmBulkSchedule() {
      const items = getBulkActiveItems();

      const dnaSelectEl = document.getElementById("bulk-select-dna");
      const selectedDna = dnaSelectEl?.value;
      if (!selectedDna) {
        showToast("Please select a Business DNA", "error");
        return;
      }

      if (bulkSelectedAccounts.length === 0) {
        showToast("Please select at least one account to publish to", "error");
        return;
      }

      let tzVal = "GMT+7";
      if (bulkScheduleMode === "same-time") {
        tzVal = document.getElementById("bulk-same-tz")?.value || "GMT+7";
      } else if (bulkScheduleMode === "daily-post") {
        tzVal = document.getElementById("bulk-daily-tz")?.value || "GMT+7";
      } else if (bulkScheduleMode === "custom") {
        tzVal = document.getElementById("bulk-custom-tz")?.value || "GMT+7";
      }

      if (bulkScheduleMode === "same-time") {
        const dateVal = document.getElementById("bulk-same-date")?.value;
        const timeVal =
          document.getElementById("bulk-same-time")?.value || "08:00";
        const p = document.getElementById("bulk-same-period")?.value || "AM";
        if (!dateVal) {
          showToast("Please select date", "error");
          return;
        }
        const [hStr, mStr] = timeVal.split(":");
        const finalTime = get24HourTime(hStr, mStr, p);
        const baseDate = parseScheduleDate(dateVal);
        const [h24Str, m24Str] = finalTime.split(":");
        const hNum = parseInt(h24Str, 10) || 0;
        const mNum = parseInt(m24Str, 10) || 0;
        const d = new Date(baseDate.getFullYear(), baseDate.getMonth(), baseDate.getDate(), hNum, mNum, 0);
        const scheduledAt = d.toISOString();
        items.forEach((item) => {
          item.status = "scheduled";
          item.scheduledAt = scheduledAt;
          item.publishedTo = [...bulkSelectedAccounts];
          item.brand = selectedDna;
          item.timezone = tzVal;
        });
      } else if (bulkScheduleMode === "daily-post") {
        const startVal = document.getElementById("bulk-daily-start")?.value;
        const timeVal =
          document.getElementById("bulk-daily-time")?.value || "08:00";
        const p = document.getElementById("bulk-daily-period")?.value || "AM";
        const postsPerDay =
          parseInt(document.getElementById("bulk-daily-posts")?.value) || 1;

        if (!startVal) {
          showToast("Please select start date", "error");
          return;
        }

        const baseDate = parseScheduleDate(startVal);
        const startY = baseDate.getFullYear();
        const startM = baseDate.getMonth();
        const startD = baseDate.getDate();

        let currentIndex = 0;
        items.forEach((item) => {
          const dayOffset = Math.floor(currentIndex / postsPerDay);
          const postIndexInDay = currentIndex % postsPerDay;

          let itemH = 8;
          let itemM = 0;

          const assigned =
            bulkScheduleData.dailyAssignments &&
            bulkScheduleData.dailyAssignments[item.id];
          if (assigned && assigned.time24) {
            const [hPart, mPart] = assigned.time24.split(":");
            itemH = parseInt(hPart, 10) || 0;
            itemM = parseInt(mPart, 10) || 0;
          } else {
            const defaultTimeObj = getDefaultDailyTime(
              timeVal,
              p,
              postIndexInDay,
              postsPerDay,
            );
            const [hPart, mPart] = defaultTimeObj.time24.split(":");
            itemH = parseInt(hPart, 10) || 0;
            itemM = parseInt(mPart, 10) || 0;
          }

          const d = new Date(startY, startM, startD + dayOffset, itemH, itemM, 0);
          item.status = "scheduled";
          item.scheduledAt = d.toISOString();
          item.publishedTo = [...bulkSelectedAccounts];
          item.brand = selectedDna;
          item.timezone = tzVal;
          currentIndex++;
        });
      } else if (bulkScheduleMode === "custom") {
        items.forEach((item) => {
          const custom = bulkScheduleData.customAssignments[item.id] || {};
          const curDate = custom.date || new Date().toISOString().split("T")[0];
          const timeVal = custom.time || "08:00";
          const baseDate = parseScheduleDate(curDate);
          const [hStr, mStr] = timeVal.split(":");
          const hNum = parseInt(hStr, 10) || 0;
          const mNum = parseInt(mStr, 10) || 0;
          const d = new Date(baseDate.getFullYear(), baseDate.getMonth(), baseDate.getDate(), hNum, mNum, 0);
          item.status = "scheduled";
          item.scheduledAt = d.toISOString();
          item.publishedTo = [...bulkSelectedAccounts];
          item.brand = selectedDna;
          item.timezone = tzVal;
        });
      }

      saveGenerated();
      showToast(`Scheduled ${items.length} items successfully!`, "success");
      bulkScheduleData.itemIds = [];
      bulkScheduleData.dailyAssignments = {};
      selectedApprovedIds = [];
      updateBulkHeader();
      closeBulkScheduleModal();
      closeSummaryPortal();
      renderGenerated();
      renderScheduled();
    }

    function bulkDeleteSelected() {
      if (selectedApprovedIds.length === 0) return;
      if (!confirm(`Delete ${selectedApprovedIds.length} selected items?`))
        return;

      generatedContent = generatedContent.filter(
        (g) => !selectedApprovedIds.includes(g.id),
      );
      saveGenerated();
      showToast(`Deleted ${selectedApprovedIds.length} items`);
      bulkScheduleData.itemIds = [];
      selectedApprovedIds = [];
      updateBulkHeader();
      renderGenerated();
    }

