            >
              ${["01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12"].map((h) => `<option value="${h}" ${h === hStr ? "selected" : ""}>${h}</option>`).join("")}
            </select>
            <select
              onchange="updateBulkCustomTimePart('${item.id}')"
              id="custom-m-${item.id}"
              class="h-8 px-1.5 rounded-lg border border-[#eaecf0] bg-white text-[11px] text-[#18181b] outline-none shadow-2xs cursor-pointer"
            >
              ${["00", "05", "10", "15", "20", "25", "30", "35", "40", "45", "50", "55"].map((mn) => `<option value="${mn}" ${mn === (m || "00") ? "selected" : ""}>${mn}</option>`).join("")}
            </select>
            <select
              onchange="updateBulkCustomTimePart('${item.id}')"
              id="custom-p-${item.id}"
              class="h-8 px-1.5 rounded-lg border border-[#eaecf0] bg-white text-[11px] text-[#18181b] outline-none shadow-2xs cursor-pointer"
            >
              <option value="AM" ${p === "AM" ? "selected" : ""}>AM</option>
              <option value="PM" ${p === "PM" ? "selected" : ""}>PM</option>
            </select>
          </div>

          <!-- Drag Handle Icon -->
          <div 
            class="cursor-grab active:cursor-grabbing p-1 text-[#a1a1aa] hover:text-[#18181b] transition-colors shrink-0 drag-handle"
            title="Drag up or down to reorder"
          >
            <svg class="pointer-events-none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" color="currentColor" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 6C16 6.55228 15.5523 7 15 7C14.4477 7 14 6.55228 14 6C14 5.44772 14.4477 5 15 5C15.5523 5 16 5.44772 16 6Z"></path>
              <path d="M10 6C10 6.55228 9.55228 7 9 7C8.44772 7 8 6.55228 8 6C8 5.44772 8.44772 5 9 5C9.55228 5 10 5.44772 10 6Z"></path>
              <path d="M16 18C16 18.5523 15.5523 19 15 19C14.4477 19 14 18.5523 14 18C14 17.4477 14.4477 17 15 17C15.5523 17 16 17.4477 16 18Z"></path>
              <path d="M16 12C16 12.5523 15.5523 13 15 13C14.4477 13 14 12.5523 14 12C14 11.4477 11 15 11C15.5523 11 16 11.4477 16 12Z"></path>
              <path d="M10 18C10 18.5523 9.55228 19 9 19C8.44772 19 8 18.5523 8 18C8 17.4477 8.44772 17 9 17C9.55228 17 10 17.4477 10 18Z"></path>
              <path d="M10 12C10 12.5523 9.55228 13 9 13C8.44772 13 8 12.5523 8 12C8 11.4477 8.44772 11 9 11C9.55228 11 10 11.4477 10 12Z"></path>
            </svg>
          </div>
        </div>
      </div>
      `;
        })
        .join("");

      initBulkCustomDragDrop();
    }

    let draggedCustomIndex = null;

    function initBulkCustomDragDrop() {
      const container = document.getElementById("bulk-custom-list");
      if (!container) return;
      const items = container.querySelectorAll(".bulk-custom-item");

      items.forEach((item) => {
        item.addEventListener("dragstart", (e) => {
          draggedCustomIndex = parseInt(item.getAttribute("data-index"), 10);
          item.classList.add("opacity-40", "ring-2", "ring-indigo-500/50");
          if (e.dataTransfer) {
            e.dataTransfer.effectAllowed = "move";
            e.dataTransfer.setData("text/plain", String(draggedCustomIndex));
          }
        });

        item.addEventListener("dragend", () => {
          item.classList.remove("opacity-40", "ring-2", "ring-indigo-500/50");
          items.forEach((it) => it.classList.remove("bg-indigo-50/60", "border-indigo-300"));
          draggedCustomIndex = null;
        });

        item.addEventListener("dragover", (e) => {
          e.preventDefault();
          if (e.dataTransfer) {
            e.dataTransfer.dropEffect = "move";
          }
          const targetIndex = parseInt(item.getAttribute("data-index"), 10);
          if (draggedCustomIndex !== null && targetIndex !== draggedCustomIndex) {
            item.classList.add("bg-indigo-50/60", "border-indigo-300");
          }
        });

        item.addEventListener("dragleave", (e) => {
          if (!item.contains(e.relatedTarget)) {
            item.classList.remove("bg-indigo-50/60", "border-indigo-300");
          }
        });

        item.addEventListener("drop", (e) => {
          e.preventDefault();
          e.stopPropagation();
          item.classList.remove("bg-indigo-50/60", "border-indigo-300");
          const targetIndex = parseInt(item.getAttribute("data-index"), 10);
          if (draggedCustomIndex !== null && !isNaN(targetIndex) && targetIndex !== draggedCustomIndex) {
            if (bulkScheduleData && Array.isArray(bulkScheduleData.itemIds)) {
              const movedId = bulkScheduleData.itemIds.splice(draggedCustomIndex, 1)[0];
              bulkScheduleData.itemIds.splice(targetIndex, 0, movedId);
              selectedApprovedIds = [...bulkScheduleData.itemIds];
              renderBulkCustomList();
            }
          }
          draggedCustomIndex = null;
        });
      });
    }

    function updateBulkCustomDate(id, val) {
      if (!bulkScheduleData.customAssignments[id])
        bulkScheduleData.customAssignments[id] = {};
      bulkScheduleData.customAssignments[id].date = val;
      renderBulkSchedulePreview();
    }

    function updateBulkCustomTimePart(id) {
      const h = document.getElementById(`custom-h-${id}`)?.value || "08";
      const m = document.getElementById(`custom-m-${id}`)?.value || "00";
      const p = document.getElementById(`custom-p-${id}`)?.value || "AM";
      const timeVal = get24HourTime(h, m, p);
      if (!bulkScheduleData.customAssignments[id])
        bulkScheduleData.customAssignments[id] = {};
      bulkScheduleData.customAssignments[id].time = timeVal;
      bulkScheduleData.customAssignments[id].displayTime = `${h}:${m} ${p}`;
      renderBulkSchedulePreview();
    }

    function getDefaultDailyTime(baseTimeVal, period, postIndexInDay, totalPostsPerDay) {
      const [hStr, mStr] = (baseTimeVal || "08:00").split(":");
      let h = parseInt(hStr, 10) || 8;
      const m = parseInt(mStr, 10) || 0;
      let h24 = (h % 12) + (period === "PM" ? 12 : 0);

      if (totalPostsPerDay <= 1 || postIndexInDay === 0) {
        const time24Str = `${String(h24).padStart(2, "0")}:${String(m).padStart(2, "0")}`;
        let h12 = h24 % 12;
        if (h12 === 0) h12 = 12;
        const displayStr = `${String(h12).padStart(2, "0")}:${String(m).padStart(2, "0")} ${period || (h24 >= 12 ? "PM" : "AM")}`;
        return { time24: time24Str, display: displayStr };
      }

      // Intelligent spacing between posts within the same day
      let stepHours = 5;
      if (totalPostsPerDay === 3) stepHours = 4;
      else if (totalPostsPerDay >= 4) stepHours = Math.max(2, Math.floor(12 / totalPostsPerDay));

      let targetH24 = (h24 + (postIndexInDay * stepHours)) % 24;
      let targetM = m;

      const targetP = targetH24 >= 12 ? "PM" : "AM";
      let targetH12 = targetH24 % 12;
      if (targetH12 === 0) targetH12 = 12;

      const time24Str = `${String(targetH24).padStart(2, "0")}:${String(targetM).padStart(2, "0")}`;
      const displayStr = `${String(targetH12).padStart(2, "0")}:${String(targetM).padStart(2, "0")} ${targetP}`;

      return { time24: time24Str, display: displayStr };
    }

    function updateBulkPreviewItemTime(id, time24) {
      if (!time24) return;
      const [h24Str, mStr] = time24.split(":");
      let h24 = parseInt(h24Str, 10) || 0;
      const m = mStr || "00";
      const p = h24 >= 12 ? "PM" : "AM";
      let h12 = h24 % 12;
      if (h12 === 0) h12 = 12;
      const display = `${String(h12).padStart(2, "0")}:${m} ${p}`;

      if (!bulkScheduleData.dailyAssignments) bulkScheduleData.dailyAssignments = {};
      bulkScheduleData.dailyAssignments[id] = {
        time24,
        display,
        manual: true,
      };
      renderBulkSchedulePreview();
    }
    window.updateBulkPreviewItemTime = updateBulkPreviewItemTime;

    function adjustBulkDailyPosts(delta) {
      const input = document.getElementById("bulk-daily-posts");
      let val = parseInt(input.value) || 1;
      val = Math.max(1, Math.min(24, val + delta));
      input.value = val;
      bulkScheduleData.dailyPostsPerDay = val;
      if (bulkScheduleData.dailyAssignments) {
        Object.keys(bulkScheduleData.dailyAssignments).forEach((key) => {
          if (!bulkScheduleData.dailyAssignments[key]?.manual) {
            delete bulkScheduleData.dailyAssignments[key];
          }
        });
      }
      renderBulkSchedulePreview();
    }

    function renderBulkSchedulePreview() {
      const preview = document.getElementById("bulk-schedule-preview");
      if (!preview) return;

      if (bulkScheduleMode === "custom") {
        preview.innerHTML = "";
        return;
      }

      const items = getBulkActiveItems();

      if (items.length === 0) {
        preview.innerHTML = `
          <div class="py-3 text-center text-[12px] text-[#71717a] italic">
            No approved posts selected to preview.
          </div>
        `;
        return;
      }

      const assignments = [];

      if (bulkScheduleMode === "same-time") {
        let dateVal = document.getElementById("bulk-same-date")?.value;
        if (!dateVal) {
          const tmrw = new Date();
          tmrw.setDate(tmrw.getDate() + 1);
          dateVal = `${tmrw.getFullYear()}-${String(tmrw.getMonth() + 1).padStart(2, "0")}-${String(tmrw.getDate()).padStart(2, "0")}`;
          const el = document.getElementById("bulk-same-date");
          if (el) el.value = dateVal;
        }

        const timeVal =
          document.getElementById("bulk-same-time")?.value || "08:00";
        const p = document.getElementById("bulk-same-period")?.value || "AM";
        const parsedDate = parseScheduleDate(dateVal);
        const formattedDate = formatDisplayScheduleDate(parsedDate);

        items.forEach((item) => {
          const isStory = item.contentType === "Story";
          const fallbackImg = isStory
            ? (typeof SAMPLE_STORY_IMAGES !== "undefined" && SAMPLE_STORY_IMAGES[0]) || "/image/Sample Story 1.jpg"
            : (typeof SAMPLE_IMAGES !== "undefined" && SAMPLE_IMAGES[0]) || "/image/Sample Image 1.jpg";
          const imgUrl = item.imageUrl || item.image || fallbackImg;

          assignments.push({
            id: item.id,
            title: item.title,
            brand: item.brand,
            contentType: item.contentType,
            imageUrl: imgUrl,
            formattedDate,
            time24: get24HourTime(timeVal.split(":")[0], timeVal.split(":")[1] || "00", p),
            displayTime: `${timeVal} ${p}`,
            date: `${formattedDate} · ${timeVal} ${p}`,
            dayLabel: "All at Once",
          });
        });
      } else if (bulkScheduleMode === "daily-post") {
        let startVal = document.getElementById("bulk-daily-start")?.value;
        if (!startVal) {
          const tmrw = new Date();
          tmrw.setDate(tmrw.getDate() + 1);
          startVal = `${tmrw.getFullYear()}-${String(tmrw.getMonth() + 1).padStart(2, "0")}-${String(tmrw.getDate()).padStart(2, "0")}`;
          const el = document.getElementById("bulk-daily-start");
          if (el) el.value = startVal;
        }

        const timeVal =
          document.getElementById("bulk-daily-time")?.value || "08:00";
        const p = document.getElementById("bulk-daily-period")?.value || "AM";
        const postsPerDay = Math.max(
          1,
          parseInt(document.getElementById("bulk-daily-posts")?.value) || 1,
        );

        const baseDate = parseScheduleDate(startVal);
        const startY = baseDate.getFullYear();
        const startM = baseDate.getMonth();
        const startD = baseDate.getDate();

        let currentIndex = 0;
        items.forEach((item) => {
          const dayOffset = Math.floor(currentIndex / postsPerDay);
          const targetDate = new Date(startY, startM, startD + dayOffset);
          const formattedDate = formatDisplayScheduleDate(targetDate);
          const postIndexInDay = currentIndex % postsPerDay;
          const postInDay = postIndexInDay + 1;
          const dayLabel =
            postsPerDay > 1
              ? `Day ${dayOffset + 1} · Post ${postInDay}`
              : `Day ${dayOffset + 1}`;

          const isStory = item.contentType === "Story";
          const fallbackImg = isStory
            ? (typeof SAMPLE_STORY_IMAGES !== "undefined" && SAMPLE_STORY_IMAGES[0]) || "/image/Sample Story 1.jpg"
            : (typeof SAMPLE_IMAGES !== "undefined" && SAMPLE_IMAGES[0]) || "/image/Sample Image 1.jpg";
          const imgUrl = item.imageUrl || item.image || fallbackImg;

          if (!bulkScheduleData.dailyAssignments) bulkScheduleData.dailyAssignments = {};
          let timeInfo = bulkScheduleData.dailyAssignments[item.id];
          if (!timeInfo || !timeInfo.manual) {
            timeInfo = getDefaultDailyTime(timeVal, p, postIndexInDay, postsPerDay);
            bulkScheduleData.dailyAssignments[item.id] = { ...timeInfo, manual: false };
          }

          assignments.push({
            id: item.id,
            title: item.title,
            brand: item.brand,
            contentType: item.contentType,
            imageUrl: imgUrl,
            formattedDate,
            time24: timeInfo.time24,
            displayTime: timeInfo.display,
            date: `${formattedDate} · ${timeInfo.display}`,
            dayLabel,
          });
          currentIndex++;
        });
      }

      const isDailyPost = bulkScheduleMode === "daily-post";

      preview.innerHTML = assignments
        .map(
          (a, idx) => `
        <div 
