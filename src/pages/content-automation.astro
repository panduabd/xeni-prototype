    let draggedPreviewIndex = null;

    function initBulkPreviewDragDrop() {
      if (bulkScheduleMode !== "daily-post") return;
      const container = document.getElementById("bulk-schedule-preview");
      if (!container) return;
      const items = container.querySelectorAll(".bulk-preview-item");

      items.forEach((item) => {
        item.addEventListener("dragstart", (e) => {
          draggedPreviewIndex = parseInt(item.getAttribute("data-index"), 10);
          item.classList.add("opacity-40", "ring-2", "ring-indigo-500/50");
          if (e.dataTransfer) {
            e.dataTransfer.effectAllowed = "move";
            e.dataTransfer.setData("text/plain", String(draggedPreviewIndex));
          }
        });

        item.addEventListener("dragend", () => {
          item.classList.remove("opacity-40", "ring-2", "ring-indigo-500/50");
          items.forEach((it) => it.classList.remove("bg-indigo-50/60", "border-indigo-300"));
          draggedPreviewIndex = null;
        });

        item.addEventListener("dragover", (e) => {
          e.preventDefault();
          if (e.dataTransfer) {
            e.dataTransfer.dropEffect = "move";
          }
          const targetIndex = parseInt(item.getAttribute("data-index"), 10);
          if (draggedPreviewIndex !== null && targetIndex !== draggedPreviewIndex) {
            item.classList.add("bg-indigo-50/60", "border-indigo-300");
          }
        });

        item.addEventListener("dragleave", (e) => {
          if (!item.contains(e.relatedTarget)) {
            item.classList.remove("bg-indigo-50/60", "border-indigo-300");
          }
        });

        item.addEventListener("drop", (e) => {
          e.preventDefault();
          e.stopPropagation();
          item.classList.remove("bg-indigo-50/60", "border-indigo-300");
          const targetIndex = parseInt(item.getAttribute("data-index"), 10);
          if (draggedPreviewIndex !== null && !isNaN(targetIndex) && targetIndex !== draggedPreviewIndex) {
            if (bulkScheduleData && Array.isArray(bulkScheduleData.itemIds)) {
              const movedId = bulkScheduleData.itemIds.splice(draggedPreviewIndex, 1)[0];
              bulkScheduleData.itemIds.splice(targetIndex, 0, movedId);
              selectedApprovedIds = [...bulkScheduleData.itemIds];
              renderBulkSchedulePreview();
            }
          }
          draggedPreviewIndex = null;
        });
      });
    }

    function openFullscreenImage(imgUrl, title) {
      const modal = document.getElementById("modal-fullscreen-image");
      const img = document.getElementById("fullscreen-image-img");
      const titleEl = document.getElementById("fullscreen-image-title");
      if (!modal || !img) return;

      img.src = imgUrl;
      img.alt = title || "Post Preview";
      if (titleEl) titleEl.textContent = title || "Post Preview";

      modal.classList.remove("hidden");
      modal.classList.add("flex");
    }

    function closeFullscreenImage() {
      const modal = document.getElementById("modal-fullscreen-image");
      if (!modal) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      const img = document.getElementById("fullscreen-image-img");
      if (img) img.src = "";
    }

