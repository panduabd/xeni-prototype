        if (logo) {
          brandLogoEl.src = logo;
          brandLogoEl.classList.remove("hidden");
        } else {
          brandLogoEl.classList.add("hidden");
        }
      }
      if (pillarEl) pillarEl.textContent = item.pillar || "-";

      // Actions - show correct footer
      const actions = document.getElementById("preview-actions");
      const approvedActions = document.getElementById(
        "preview-approved-actions",
      );
      const rejectedActions = document.getElementById(
        "preview-rejected-actions",
      );
      const scheduledActions = document.getElementById(
        "preview-scheduled-actions",
      );
      const rejectAlert = document.getElementById("preview-reject-alert");
      if (actions) actions.classList.add("hidden");
      if (approvedActions) approvedActions.classList.add("hidden");
      if (rejectedActions) rejectedActions.classList.add("hidden");
      if (scheduledActions) scheduledActions.classList.add("hidden");
      if (rejectAlert) {
        rejectAlert.classList.add("hidden");
        rejectAlert.classList.remove("flex");
      }

      const isReadOnly = Boolean(options && (options.hideActions || options.readOnly));
      const footerWrapper = document.getElementById("preview-footer-wrapper");
      if (footerWrapper) {
        if (isReadOnly) {
          footerWrapper.classList.add("hidden");
        } else {
          footerWrapper.classList.remove("hidden");
        }
      }

      if (!isReadOnly) {
        if (item.status === "draft") {
          if (actions) {
            actions.classList.remove("hidden");
            actions.classList.add("flex");
          }
          if (rejectAlert) {
            rejectAlert.classList.remove("hidden");
            rejectAlert.classList.add("flex");
          }
        } else if (item.status === "approved") {
          if (approvedActions) {
            approvedActions.classList.remove("hidden");
            approvedActions.classList.add("flex");
          }
        } else if (item.status === "rejected") {
          if (rejectedActions) {
            rejectedActions.classList.remove("hidden");
            rejectedActions.classList.add("flex");
          }
        } else if (item.status === "scheduled") {
          if (scheduledActions) {
            scheduledActions.classList.remove("hidden");
            scheduledActions.classList.add("flex");
          }
        }
      }

      // Open modal
      const modal = document.getElementById("modal-preview");
      if (modal) {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
      }
    }

    function updateCarouselControls() {
      const prevBtn = document.getElementById("preview-carousel-prev");
      const nextBtn = document.getElementById("preview-carousel-next");
      const badge = document.getElementById("preview-carousel-badge");
      if (previewCarouselTotal <= 1) {
        if (prevBtn) prevBtn.classList.add("hidden");
        if (nextBtn) nextBtn.classList.add("hidden");
        if (badge) badge.classList.add("hidden");
        return;
      }
      if (badge) {
        badge.classList.remove("hidden");
        badge.textContent = `${previewCarouselIndex + 1}/${previewCarouselTotal}`;
      }
      const previewImg = document.getElementById("preview-image-main");
      if (previewImg) {
        previewImg.src =
          SAMPLE_IMAGES[previewCarouselIndex % SAMPLE_IMAGES.length];
      }
      if (prevBtn)
        prevBtn.classList.toggle("hidden", previewCarouselIndex === 0);
      if (nextBtn)
        nextBtn.classList.toggle(
          "hidden",
          previewCarouselIndex === previewCarouselTotal - 1,
        );
    }

    function switchPreviewTab(tab) {
      const contentTab = document.getElementById("preview-content-tab");
      if (contentTab) contentTab.classList.remove("hidden");
    }

    function closePreviewModal() {
      const modal = document.getElementById("modal-preview");
      if (modal) {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }
      previewingContentId = null;
    }

    function approveContent() {
      if (!previewingContentId) return;
      const item = generatedContent.find((g) => g.id === previewingContentId);
      if (!item) return;
      item.status = "approved";
      item.approvedAt = new Date().toISOString();
      saveGenerated();
      renderGenerated();

      // Track for summary
      if (!sessionApprovedIds.includes(item.id))
        sessionApprovedIds.push(item.id);

      // Find next draft in same automation group
      const nextDraft = findNextDraftInGroup(item);
      if (nextDraft) {
        transitionToNextDraft(nextDraft);
      } else {
        // ALL DONE - Transmit to summary portal instead of closing!
        const groupName = item.automationName || "Review Group";
        showBatchApprovalSummary(groupName);
        showToast("Session Completed!");
      }
    }

    function rejectContent() {
      if (!previewingContentId) return;
      const item = generatedContent.find((g) => g.id === previewingContentId);
      if (!item) return;
      item.status = "rejected";
      item.rejectedAt = new Date().toISOString();
      saveGenerated();
      renderGenerated();

      // Find next draft in same automation group
      const nextDraft = findNextDraftInGroup(item);
      if (nextDraft) {
        transitionToNextDraft(nextDraft);
      } else {
        // ALL DONE - Transmit to summary portal instead of closing!
        const groupName = item.automationName || "Review Group";
        showBatchApprovalSummary(groupName);
        showToast("Session Completed!");
      }
    }

    function findNextDraftInGroup(currentItem) {
      if (!currentItem.automationName) return null;
      const groupDrafts = generatedContent.filter(
        (g) =>
          g.automationName === currentItem.automationName &&
          g.status === "draft" &&
          g.id !== currentItem.id,
      );
      return groupDrafts.length > 0 ? groupDrafts[0] : null;
    }

    function transitionToNextDraft(nextItem) {
      const panel = document.getElementById("preview-panel");
      if (panel) {
        panel.classList.remove("fade-in-slide");
        panel.classList.add("fade-out-slide");
        setTimeout(() => {
          panel.classList.remove("fade-out-slide");
          openPreviewModal(nextItem.id);
          panel.classList.add("fade-in-slide");
          setTimeout(() => panel.classList.remove("fade-in-slide"), 230);
        }, 150);
      } else {
        openPreviewModal(nextItem.id);
      }
    }

    function unapproveContent() {
      if (!previewingContentId) return;
      const item = generatedContent.find((g) => g.id === previewingContentId);
      if (!item) return;
      item.status = "draft";
      saveGenerated();
      renderGenerated();
      closePreviewModal();
      showToast("Content moved back to draft.");
    }

    function recoverToDraft() {
      if (!previewingContentId) return;
      const item = generatedContent.find((g) => g.id === previewingContentId);
      if (!item) return;
      item.status = "draft";
      item.rejectedAt = null;
      saveGenerated();
      renderGenerated();
      closePreviewModal();
      showToast("Content recovered to draft!");
    }

    function publishSingleNow() {
      if (!previewingContentId) return;
      const item = generatedContent.find((g) => g.id === previewingContentId);
      if (!item) return;
      item.status = "published";
      if (!item.publishedAt) item.publishedAt = new Date().toISOString();
      saveGenerated();
      renderGenerated();
      renderScheduled();
      closePreviewModal();
      showToast("Content published!");
    }

    function openBulkScheduleModalSingle() {
      openPreviewScheduleModal();
    }
    // ═══════════════════════════════════════════
    // BATCH APPROVAL SUMMARY MODULE
    // ═══════════════════════════════════════════
    function showBatchApprovalSummary(groupTitle) {
      // Pull actual objects for relevant IDs from session memory
      const approvedItems = generatedContent.filter((g) =>
        sessionApprovedIds.includes(g.id),
      );

      closePreviewModal(); // Ensure clean exit of current view

      const gName = document.getElementById("summary-group-name");
      const countNum = document.getElementById("summary-count");
      if (gName) gName.textContent = groupTitle;
      if (countNum) countNum.textContent = approvedItems.length;

      const gridEl = document.getElementById("summary-grid");
      if (gridEl) {
        if (approvedItems.length === 0) {
          gridEl.innerHTML = `<div class="col-span-full text-center py-16 text-[#98A2B3] font-medium text-sm">No items available to display.</div>`;
        } else {
          gridEl.innerHTML = approvedItems
            .map((item) => {
              const isStory =
                item.contentType === "Story" ||
                (item.contentType &&
                  item.contentType.toLowerCase().includes("story"));
              const defaultStory =
                SAMPLE_STORY_IMAGES[
                  Math.abs(
                    item.id
                      .split("")
                      .reduce((acc, char) => acc + char.charCodeAt(0), 0),
                  ) % SAMPLE_STORY_IMAGES.length
                ];
              const defaultFeed =
                SAMPLE_IMAGES[
                  Math.abs(
                    item.id
                      .split("")
                      .reduce((acc, char) => acc + char.charCodeAt(0), 0),
                  ) % SAMPLE_IMAGES.length
                ];
              let imgSrc = item.imageUrl;
              if (isStory && (!imgSrc || imgSrc.includes("Sample Image"))) {
                imgSrc = defaultStory;
              } else if (!imgSrc) {
                imgSrc = defaultFeed;
              }

              return `
               <div id="summary-card-${item.id}" class="bg-white rounded-xl border border-zinc-200/90 p-2.5 flex flex-col justify-between hover:border-zinc-300 hover:shadow-xs transition-all relative group h-full">
                   <!-- Uniform Thumbnail with Click to Preview Full Screen -->
                   <div 
                     class="relative w-full aspect-[4/5] rounded-lg overflow-hidden bg-zinc-100 cursor-pointer group/img" 
                     onclick="openPreviewModal('${item.id}', { hideActions: true })" 
                     title="Click to preview full screen"
                   >
                       <img 
                         src="${imgSrc}" 
                         alt="${escapeHtml(item.title)}" 
                         class="w-full h-full object-cover group-hover/img:scale-105 transition-transform duration-300" 
                         loading="lazy" 
                       />
                       <!-- Format Badge on Bottom Left -->
                       <div class="absolute bottom-2 left-2 px-1.5 py-0.5 rounded text-[10px] font-medium bg-black/60 backdrop-blur-xs text-white tracking-wider pointer-events-none">
                         ${isStory ? "9:16" : "3:4"}
                       </div>

                       <!-- Preview Overlay on Hover -->
                       <div class="absolute inset-0 bg-black/25 opacity-0 group-hover/img:opacity-100 transition-opacity flex items-center justify-center pointer-events-none">
                         <span class="px-2 py-1 rounded-md bg-black/70 backdrop-blur-xs text-white text-[11px] font-medium flex items-center gap-1 shadow-sm">
                           <i class="ti ti-arrows-maximize text-[11px]"></i>
                           Preview
                         </span>
                       </div>

                       <!-- Checkbox button (strictly isolated to top right button only) -->
                       <button
                         type="button"
                         onclick="event.stopPropagation(); toggleSummaryCardCheck('${item.id}')"
                         class="summary-check-btn absolute top-2 right-2 w-6 h-6 rounded-md bg-blue-600 text-white flex items-center justify-center shadow-xs transition-all cursor-pointer z-20 hover:scale-105 hover:bg-blue-700"
                         data-id="${item.id}"
                         title="Toggle selection"
                       >
                         <input type="checkbox" value="${item.id}" checked class="summary-item-check sr-only" />
                         <i class="ti ti-check text-[13px] stroke-[2.5] summary-check-icon"></i>
                       </button>
                   </div>

                   <!-- Card Info -->
                   <div class="pt-2 flex flex-col gap-1">
                       <p 
