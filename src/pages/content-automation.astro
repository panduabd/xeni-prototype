    (function initToast() {
      // Inject persistent toast element once
      if (!document.getElementById("xeni-toast")) {
        const el = document.createElement("div");
        el.id = "xeni-toast";
        el.setAttribute("role", "alert");
        el.setAttribute("data-slot", "alert");
        el.className =
          "fixed bottom-6 right-6 translate-y-12 opacity-0 pointer-events-none transition-all duration-300 ease-out z-[9999] flex items-center gap-2.5 rounded-xl px-4 py-2.5 shadow-[0_10px_30px_-10px_rgba(16,185,129,0.2),0_4px_12px_rgba(0,0,0,0.05)] border border-emerald-500/30 bg-emerald-50/95 text-emerald-950 backdrop-blur-sm select-none";
        el.innerHTML = `
        <div id="xeni-toast-icon" data-slot="alert-icon" class="flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
        <span id="xeni-toast-title" data-slot="alert-title" class="text-[13px] font-medium tracking-tight text-emerald-950 leading-none whitespace-nowrap">Success</span>
        <button id="xeni-toast-close" class="text-emerald-700/60 hover:text-emerald-950 hover:bg-emerald-100/60 p-1 rounded-md transition-colors cursor-pointer shrink-0 ml-1.5" aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>`;
        document.body.appendChild(el);

        const closeBtn = document.getElementById("xeni-toast-close");
        if (closeBtn) {
          closeBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            clearTimeout(window._xeniToastTimeout);
            el.classList.add(
              "translate-y-12",
              "opacity-0",
              "pointer-events-none",
            );
            el.classList.remove(
              "translate-y-0",
              "opacity-100",
              "pointer-events-auto",
            );
          });
        }
      }
    })();

    function showToast(message, type = "success", title = "") {
      const toast = document.getElementById("xeni-toast");
      const iconEl = document.getElementById("xeni-toast-icon");
      const titleEl = document.getElementById("xeni-toast-title");
      const closeBtn = document.getElementById("xeni-toast-close");
      if (!toast) return;

      // Auto-detect variant from type or message text
      const lower = `${message} ${title}`.toLowerCase();
      let variant = type;
      if (
        lower.includes("fail") ||
        lower.includes("error") ||
        lower.includes("gagal") ||
        lower.includes("deleted") ||
        lower.includes("removed") ||
        lower.includes("permanently")
      ) {
        variant = "error";
      } else if (variant === "destructive") {
        variant = "error";
      } else if (
        variant === "warning" ||
        lower.includes("required") ||
        lower.includes("please select") ||
        lower.includes("please enter") ||
        lower.includes("please fill") ||
        lower.includes("missing") ||
        lower.includes("empty") ||
        lower.includes("warning") ||
        lower.includes("peringatan") ||
        lower.includes("paused")
      ) {
        variant = "warning";
      }
      if (
        !["success", "error", "destructive", "warning", "info"].includes(
          variant,
        )
      )
        variant = "success";

      const displayText = title || message;

      // Variant configs — identik dengan canvas + warning & info
      const variants = {
        success: {
          toast:
            "fixed bottom-6 right-6 transition-all duration-300 ease-out z-[9999] flex items-center gap-2.5 rounded-xl px-4 py-2.5 shadow-[0_10px_30px_-10px_rgba(16,185,129,0.2),0_4px_12px_rgba(0,0,0,0.05)] border border-emerald-500/30 bg-emerald-50/95 text-emerald-950 backdrop-blur-sm select-none",
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>`,
          title:
            "text-[13px] font-medium tracking-tight text-emerald-950 leading-none whitespace-nowrap",
          close:
            "text-emerald-700/60 hover:text-emerald-950 hover:bg-emerald-100/60 p-1 rounded-md transition-colors cursor-pointer shrink-0 ml-1.5",
        },
        error: {
          toast:
            "fixed bottom-6 right-6 transition-all duration-300 ease-out z-[9999] flex items-center gap-2.5 rounded-xl px-4 py-2.5 shadow-[0_10px_30px_-10px_rgba(239,68,68,0.2),0_4px_12px_rgba(0,0,0,0.05)] border border-red-500/30 bg-red-50/95 text-red-950 backdrop-blur-sm select-none",
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-red-600"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`,
          title:
            "text-[13px] font-medium tracking-tight text-red-950 leading-none whitespace-nowrap",
          close:
            "text-red-700/60 hover:text-red-950 hover:bg-red-100/60 p-1 rounded-md transition-colors cursor-pointer shrink-0 ml-1.5",
        },
        warning: {
          toast:
            "fixed bottom-6 right-6 transition-all duration-300 ease-out z-[9999] flex items-center gap-2.5 rounded-xl px-4 py-2.5 shadow-[0_10px_30px_-10px_rgba(245,158,11,0.2),0_4px_12px_rgba(0,0,0,0.05)] border border-amber-500/30 bg-amber-50/95 text-amber-950 backdrop-blur-sm select-none",
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-600"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
          title:
            "text-[13px] font-medium tracking-tight text-amber-950 leading-none whitespace-nowrap",
          close:
            "text-amber-700/60 hover:text-amber-950 hover:bg-amber-100/60 p-1 rounded-md transition-colors cursor-pointer shrink-0 ml-1.5",
        },
        info: {
          toast:
            "fixed bottom-6 right-6 transition-all duration-300 ease-out z-[9999] flex items-center gap-2.5 rounded-xl px-4 py-2.5 shadow-[0_10px_30px_-10px_rgba(59,130,246,0.2),0_4px_12px_rgba(0,0,0,0.05)] border border-blue-500/30 bg-blue-50/95 text-blue-950 backdrop-blur-sm select-none",
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>`,
          title:
            "text-[13px] font-medium tracking-tight text-blue-950 leading-none whitespace-nowrap",
          close:
            "text-blue-700/60 hover:text-blue-950 hover:bg-blue-100/60 p-1 rounded-md transition-colors cursor-pointer shrink-0 ml-1.5",
        },
      };

      const v = variants[variant] || variants.success;

      // Apply styles
      toast.className = v.toast;
      if (iconEl) iconEl.innerHTML = v.icon;
      if (titleEl) {
        titleEl.className = v.title;
        titleEl.textContent = displayText;
      }
      if (closeBtn) closeBtn.className = v.close;

      // Show
      toast.classList.remove(
        "translate-y-12",
        "opacity-0",
        "pointer-events-none",
      );
      toast.classList.add(
        "translate-y-0",
        "opacity-100",
        "pointer-events-auto",
      );

      // Auto-dismiss after 3s
      clearTimeout(window._xeniToastTimeout);
      window._xeniToastTimeout = setTimeout(() => {
        toast.classList.add(
          "translate-y-12",
          "opacity-0",
          "pointer-events-none",
        );
        toast.classList.remove(
          "translate-y-0",
          "opacity-100",
          "pointer-events-auto",
        );
      }, 3000);
    }

    // ═══════════════════════════════════════════
    // INIT
    // ═══════════════════════════════════════════
    function init() {
      loadAutomations();
      loadGenerated();
      renderAutomations();
      renderGenerated();
      renderScheduled();
      bindEvents();
      renderCalendar();
      renderWeeklyCalendar();

      // Check URL parameters or hash to switch to correct tab on load
      const urlParams = new URLSearchParams(window.location.search);
      const tabParam = urlParams.get("tab");
      if (tabParam === "generated") {
        switchTab("generated");
      } else if (tabParam === "scheduled") {
        switchTab("scheduled");
      } else if (
        window.location.hash === "#generated" ||
        window.location.hash === "#outputs"
      ) {
        switchTab("generated");
      }

      // Initial indicator position
      updateMainTabIndicator();
      window.addEventListener("resize", () => updateMainTabIndicator());
    }

    // ═══════════════════════════════════════════
    // TAB SWITCHING
    // ═══════════════════════════════════════════
    let currentMainTab = "automations";

    function updateMainTabIndicator(btn) {
      const indicator = document.getElementById("main-tabs-indicator");
      const target =
        btn ||
        (currentMainTab === "generated"
          ? els.tabGenerated
          : currentMainTab === "scheduled"
            ? els.tabScheduled
            : els.tabAutomations);
      if (!indicator || !target) return;
      indicator.style.left = `${target.offsetLeft}px`;
      indicator.style.width = `${target.offsetWidth}px`;
    }

    function switchTab(tab) {
      currentMainTab = tab;

      // Reset all tab buttons
      [els.tabAutomations, els.tabGenerated, els.tabScheduled].forEach(
        (btn) => {
          btn.classList.remove(
            "text-white",
            "bg-[#18181b]",
            "shadow-xs",
            "bg-white",
            "bg-[#111827]",
          );
          btn.classList.add("text-[#71717a]", "hover:text-[#18181b]");
        },
      );
      [
        els.tabContentAutomations,
        els.tabContentGenerated,
        els.tabContentScheduled,
      ].forEach((content) => {
        content.classList.add("hidden");
        content.classList.remove("tab-pane-animate");
      });

      // Ensure solid badge styling inside tabs
      if (els.generatedBadge) {
        els.generatedBadge.classList.remove(
          "bg-white/20",
          "border-transparent",
          "bg-[#f4f4f5]",
          "text-[#71717a]",
          "border-[#eaecf0]",
          "border",
          "bg-amber-100",
          "text-amber-800",
          "border-amber-300/80",
        );
        els.generatedBadge.classList.add(
          "bg-orange-500",
          "text-white",
          "font-bold",
        );
      }
      if (els.scheduledBadge) {
        els.scheduledBadge.classList.remove(
          "bg-white/20",
          "border-transparent",
          "bg-[#f4f4f5]",
          "text-[#71717a]",
          "border-[#eaecf0]",
          "border",
          "bg-amber-100",
          "text-amber-800",
          "border-amber-300/80",
        );
        els.scheduledBadge.classList.add(
          "bg-blue-600",
          "text-white",
          "font-bold",
        );
      }

      // Activate selected tab
      let selectedBtn = null;
      let selectedContent = null;
      if (tab === "automations") {
        selectedBtn = els.tabAutomations;
        selectedContent = els.tabContentAutomations;
        els.btnAdd.classList.remove("hidden");
        els.btnAdd.classList.add("flex");
      } else if (tab === "generated") {
        selectedBtn = els.tabGenerated;
        selectedContent = els.tabContentGenerated;
        els.btnAdd.classList.add("hidden");
        els.btnAdd.classList.remove("flex");
        draftLimit = 3;
      } else if (tab === "scheduled") {
        selectedBtn = els.tabScheduled;
        selectedContent = els.tabContentScheduled;
        els.btnAdd.classList.add("hidden");
        els.btnAdd.classList.remove("flex");
        renderScheduled();
      }

      if (selectedContent) {
        selectedContent.classList.remove("hidden");
        void selectedContent.offsetWidth; // trigger reflow for animation restart
        selectedContent.classList.add("tab-pane-animate");
      }

      if (selectedBtn) {
        selectedBtn.classList.add("text-white");
        selectedBtn.classList.remove("text-[#71717a]", "hover:text-[#18181b]");
        updateMainTabIndicator(selectedBtn);
      }
    }

    // ═══════════════════════════════════════════
    // GENERATED CONTENT
    // ═══════════════════════════════════════════
    function loadGenerated() {
      // Always use fresh mock data (deterministic, not from localStorage)
      generatedContent = createMockGenerated();
      saveGenerated();
    }

    function saveGenerated() {
      localStorage.setItem(
        GENERATED_STORAGE_KEY,
        JSON.stringify(generatedContent),
      );
    }

    function createMockGenerated() {
      const now = new Date();
      const brands = [
        "Daily Brew Cafe",
        "Byte Labs",
        "Glow Skincare",
        "Acme Corp",
        "TechFlow Systems",
      ];
      const platforms = ["Facebook", "Threads", "Instagram", "TikTok"];
      const types = ["Single Post", "Carousel", "Story", "Ad Creatives"];
      const titles = [
        "Summer Promo Collection",
        "Product Highlight 101",
        "Behind the Scenes Setup",
        "Customer Testimonial",
        "Flash Sale Alert",
        "5 Tips for Success",
        "Did You Know?",
        "Weekend Vibes",
        "New Feature Drop",
        "Top 5 List",
      ];

      const items = [];

      // Create 5 automation groups for drafts (each with 5 outputs = 25 drafts)
      for (let g = 0; g < 5; g++) {
        const brand = brands[g % brands.length];
        const autoName = `Campaign ${titles[g]}`;
        const createdAt = new Date(
          now.getTime() - (g + 1) * 2 * 60 * 60 * 1000,
        ).toISOString();
        for (let i = 0; i < 5; i++) {
          const cType = types[i % 4];
          const isStory = cType === "Story";
          items.push({
            id: `gen_draft_${g}_${i}`,
            title: `${titles[i % titles.length]} - Variation ${i + 1}`,
            brand,
            imageUrl: isStory
              ? SAMPLE_STORY_IMAGES[(g * 5 + i) % SAMPLE_STORY_IMAGES.length]
              : SAMPLE_IMAGES[(g * 5 + i) % SAMPLE_IMAGES.length],
            contentType: cType,
            platform: platforms[i % 3],
            caption: MOCK_CAPTIONS[i % 4],
            pillar: "Promo",
            carouselSlides: cType === "Carousel" ? 3 : 1,
            status: "draft",
            automationName: autoName,
            createdAt,
            scheduledAt: null,
            publishedAt: null,
            views: 0,
            likes: 0,
            comments: 0,
            failReason: null,
            rejectedAt: null,
            approvedAt: null,
            autoComment: { enabled: false, text: "", link: "", keywords: "" },
            autoDm: { enabled: false, text: "", link: "", keywords: "" },
          });
        }
      }

      // Create 35 other items (approved, rejected, scheduled, published) to populate the calendar beautifully
      for (let i = 0; i < 35; i++) {
        const statusPool = [
          "approved",
          "approved",
          "rejected",
          "scheduled",
          "scheduled",
          "published",
          "published",
        ];
        const status = statusPool[i % statusPool.length];
        const type = types[i % 4];
        const isStory = type === "Story";
        const createdAt = new Date(
          now.getTime() - (i + 1) * 8 * 60 * 60 * 1000,
        ).toISOString();

        // Published items get engagement data
        const isPublished = status === "published";
        const reach = isPublished ? Math.floor(Math.random() * 5000) + 500 : 0;
        const likes = isPublished ? Math.floor(Math.random() * 300) + 50 : 0;
        const comments = isPublished ? Math.floor(Math.random() * 50) + 5 : 0;
        const shares = isPublished ? Math.floor(Math.random() * 30) + 2 : 0;
        const saves = isPublished ? Math.floor(Math.random() * 80) + 10 : 0;
        const profileVisits = isPublished
          ? Math.floor(Math.random() * 200) + 20
          : 0;
        const follows = isPublished ? Math.floor(Math.random() * 15) + 1 : 0;
        const engagementRate = isPublished
          ? (((likes + comments + shares + saves) / reach) * 100).toFixed(1)
          : 0;

        // Distribute dates throughout the current month dynamically
        const targetYear = now.getFullYear();
        const targetMonth = now.getMonth();
        const currentDay = now.getDate();

        let itemDay;
        if (status === "scheduled") {
          // Scheduled items are in the FUTURE: from tomorrow up to 10 days out
          itemDay = currentDay + 1 + (i % 10);
        } else if (status === "published") {
          // Published items are in the PAST: from yesterday back to 10 days ago (capped at day 1)
          itemDay = Math.max(1, currentDay - 1 - (i % 10));
        } else {
          // Other items spread throughout the month
          itemDay = 1 + (i % 28);
        }

        const scheduledHour = 9 + (i % 8); // 9:00 to 16:00
        const scheduledMinute = (i * 15) % 60; // 0, 15, 30, 45

        items.push({
          id: `gen_${status}_${i}`,
          title: titles[i % titles.length],
          brand: brands[i % 3],
          imageUrl: isStory
            ? SAMPLE_STORY_IMAGES[i % SAMPLE_STORY_IMAGES.length]
            : SAMPLE_IMAGES[i % SAMPLE_IMAGES.length],
          contentType: type,
          platform: platforms[i % 3],
          caption: MOCK_CAPTIONS[i % 4],
          pillar: i % 2 === 0 ? "Educational" : "Promo",
          carouselSlides: type === "Carousel" ? 3 : 1,
          status,
          automationName: "General Campaign",
          createdAt,
          scheduledAt:
            status === "scheduled"
              ? new Date(
                  targetYear,
                  targetMonth,
                  itemDay,
                  scheduledHour,
                  scheduledMinute,
                ).toISOString()
              : status === "published"
                ? new Date(
                    targetYear,
                    targetMonth,
                    itemDay,
                    scheduledHour,
                    scheduledMinute,
                  ).toISOString()
                : null,
          publishedAt: isPublished
            ? new Date(
                targetYear,
                targetMonth,
                itemDay,
                scheduledHour,
                scheduledMinute,
              ).toISOString()
            : null,
          views: reach,
          likes,
          comments,
          shares,
          saves,
          profileVisits,
          follows,
          engagementRate,
          failReason: null,
          rejectedAt: null,
          approvedAt: null,
          autoComment: { enabled: false, text: "", link: "", keywords: "" },
          autoDm: { enabled: false, text: "", link: "", keywords: "" },
        });
      }

      return items;
    }

    function renderGenerated() {
      // Apply filters
      let filtered = generatedContent.filter((item) => {
        if (
          currentBusinessFilter !== "all" &&
          item.brand !== currentBusinessFilter
        )
          return false;
        if (searchQuery) {
          const q = searchQuery.toLowerCase();
          const haystack =
            `${item.title} ${item.brand} ${item.caption}`.toLowerCase();
          if (!haystack.includes(q)) return false;
        }
        return true;
      });

      filtered.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));

      const needsAttentionCount = generatedContent.filter(
        (g) => g.status === "draft",
      ).length;
      els.generatedBadge.textContent = needsAttentionCount;
      els.generatedBadge.classList.toggle("hidden", needsAttentionCount === 0);
      if (currentMainTab === "generated")
        setTimeout(() => updateMainTabIndicator(), 20);

      const drafts = filtered.filter((item) => item.status === "draft");
      const approved = filtered.filter((item) => item.status === "approved");
      const rejected = filtered.filter((item) => item.status === "rejected");

      // Render Draft Panel (Left)
      const draftList = document.getElementById("draft-list");
      const draftEmpty = document.getElementById("draft-empty");
      const draftCount = document.getElementById("draft-count");
      const draftShowMoreContainer = document.getElementById(
        "draft-show-more-container",
      );
      if (draftCount) draftCount.textContent = drafts.length;
      if (els.draftTopCount) els.draftTopCount.textContent = drafts.length;

      if (drafts.length === 0) {
        if (draftList) draftList.innerHTML = "";
        if (draftEmpty) draftEmpty.classList.remove("hidden");
        if (draftShowMoreContainer) {
          draftShowMoreContainer.classList.add("hidden");
          draftShowMoreContainer.classList.remove("flex");
        }
      } else {
        if (draftEmpty) draftEmpty.classList.add("hidden");
        if (draftList) {
          const slicedDrafts = drafts.slice(0, draftLimit);
          draftList.innerHTML = slicedDrafts
            .map((item) => renderDraftItem(item))
            .join("");
        }
        if (draftShowMoreContainer) {
          if (drafts.length > draftLimit) {
            draftShowMoreContainer.classList.remove("hidden");
            draftShowMoreContainer.classList.add("flex");
          } else {
            draftShowMoreContainer.classList.add("hidden");
            draftShowMoreContainer.classList.remove("flex");
          }
        }
      }

      // Toggle right panels based on status filter
      const rightApproved = document.getElementById("right-panel-approved");
      const rightRejected = document.getElementById("right-panel-rejected");

      if (outputStatusFilter === "rejected") {
        if (rightApproved) {
          rightApproved.classList.add("hidden");
          rightApproved.classList.remove("flex");
        }
        if (rightRejected) {
          rightRejected.classList.remove("hidden");
          rightRejected.classList.add("flex");
        }
        // Render rejected grid
        const rejectedGrid = document.getElementById("rejected-grid");
        const rejectedEmpty = document.getElementById("rejected-empty");
        const rejectedCount = document.getElementById("rejected-count");
        if (rejectedCount) rejectedCount.textContent = rejected.length;
        if (rejected.length === 0) {
          if (rejectedGrid) rejectedGrid.innerHTML = "";
          if (rejectedEmpty) rejectedEmpty.classList.remove("hidden");
        } else {
          if (rejectedEmpty) rejectedEmpty.classList.add("hidden");
          if (rejectedGrid)
            rejectedGrid.innerHTML = renderApprovedGrid(rejected, true);
        }
      } else {
        if (rightApproved) {
          rightApproved.classList.remove("hidden");
          rightApproved.classList.add("flex");
        }
        if (rightRejected) {
          rightRejected.classList.add("hidden");
          rightRejected.classList.remove("flex");
        }
        // Render Approved Panel
        const approvedGrid = document.getElementById("approved-grid");
        const approvedEmpty = document.getElementById("approved-empty");
        const approvedCount = document.getElementById("approved-count");
        if (approvedCount) approvedCount.textContent = approved.length;
        if (approved.length === 0) {
          if (approvedGrid) approvedGrid.innerHTML = "";
          if (approvedEmpty) approvedEmpty.classList.remove("hidden");
        } else {
          if (approvedEmpty) approvedEmpty.classList.add("hidden");
          if (approvedGrid)
            approvedGrid.innerHTML = renderApprovedGrid(approved);
        }
      }
    }

    function renderDraftItem(item) {
      const dateStr = formatRelativeDate(item.createdAt);
      const brandName = item.brand || "Default";
      const logoUrl = getDnaLogo(item.brand);

      return `
    <div class="group flex items-start gap-3 p-3 rounded-xl bg-white border border-[#eaecf0] hover:border-[#18181b] hover:shadow-2xs transition-all cursor-pointer" onclick="openPreviewModal('${item.id}')">
      <div class="w-9 h-9 rounded-lg overflow-hidden border border-[#eaecf0] flex items-center justify-center bg-[#f4f4f5] shrink-0">
        <img src="${logoUrl}" alt="${escapeHtml(brandName)}" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='${DEFAULT_DNA_LOGO}';" />
      </div>
      <div class="flex-1 min-w-0 space-y-1">
        <p class="text-[12px] font-medium text-[#18181b] truncate leading-tight">${escapeHtml(item.automationName)}</p>
        <div class="flex items-center gap-1.5">
          <span class="px-1.5 py-0.5 rounded-md bg-[#f4f4f5] border border-[#eaecf0] text-[10px] font-medium text-[#71717a]">${escapeHtml(brandName)}</span>
          <span class="text-[10px] text-[#71717a]">${dateStr}</span>
        </div>
      </div>
    </div>
  `;
    }

    function renderApprovedGrid(items, isRejected = false) {
      const sorted = [...items].sort(
        (a, b) => new Date(b.createdAt) - new Date(a.createdAt),
      );

      const typeIconMap = {
        "Single Post": "ti-photo",
        Carousel: "ti-carousel-horizontal",
        "Ad Creatives": "ti-speakerphone",
        Story: "ti-device-mobile",
      };

      const brandGradients = {
        "Daily Brew Cafe": "from-[#D97706] to-[#78350F]",
        "Byte Labs": "from-[#38BDF8] to-[#0F172A]",
        "Glow Skincare": "from-[#FB7185] to-[#E11D48]",
        "Acme Corp": "from-[#818CF8] to-[#4F46E5]",
