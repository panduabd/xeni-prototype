      if (e.key === "Escape") {
        const prevModal = document.getElementById("modal-preview");
        if (prevModal && !prevModal.classList.contains("hidden")) {
          closePreviewModal();
          return;
        }
        const modal = document.getElementById("modal-fullscreen-image");
        if (modal && !modal.classList.contains("hidden")) {
