    function renderManualPlatformTabs() {
      const wrapper = document.getElementById("manual-platform-config");
      const divider = document.getElementById("manual-platform-divider");
      const tabs = document.getElementById("manual-platform-tabs");
      const selected = [
        ...document.querySelectorAll(".manual-account-cb:checked"),
      ];
      const platforms = [
        ...new Set(selected.map((cb) => manualPlatformForAccount(cb.value))),
      ];
      if (!wrapper || !tabs) return;
      wrapper.classList.toggle("hidden", platforms.length === 0);
      divider?.classList.toggle("hidden", platforms.length === 0);
      if (!platforms.includes(manualScheduleState.currentPlatform))
        manualScheduleState.currentPlatform = platforms[0] || "instagram";
      tabs.innerHTML = platforms
        .map(
          (platform) =>
            `<button type="button" data-platform="${platform}" class="manual-platform-tab px-3 h-8 rounded-lg inline-flex items-center gap-2 text-[12px] font-medium ${platform === manualScheduleState.currentPlatform ? "bg-white text-[#111827] border border-[#eaecf0] shadow-xs" : "text-[#667085] hover:bg-white/70 cursor-pointer"}">${getSocialIconSvg(platform, "13px")}<span>${platform === "facebook" ? "Facebook" : platform === "threads" ? "Threads" : platform === "tiktok" ? "TikTok" : "Instagram"}</span></button>`,
        )
        .join("");
      tabs.querySelectorAll("[data-platform]").forEach((tab) =>
        tab.addEventListener("click", () => {
          manualScheduleState.currentPlatform = tab.dataset.platform;
          renderManualPlatformTabs();
          renderManualMedia();
          syncManualSimulator();
        }),
      );
    }

    function renderManualMedia() {
      const container = document.getElementById("manual-media-items");
      const config =
        manualScheduleState.platformConfigs[
          manualScheduleState.currentPlatform
        ];
      if (!container || !config) return;
      container.innerHTML =
        `<button type="button" id="manual-media-add-tile" class="w-16 h-16 shrink-0 rounded-lg border border-dashed border-[#D0D5DD] bg-[#F9FAFB] flex flex-col items-center justify-center gap-0.5 text-[#667085] hover:border-[#111827] cursor-pointer"><i class="ti ti-plus text-[16px]"></i><span class="text-[9px] font-medium text-[#111827]">Add</span></button>` +
        config.images
          .map(
            (src, index) =>
              `<div class="manual-media-item relative w-16 h-16 shrink-0 rounded-lg overflow-hidden border border-[#eaecf0] cursor-grab group" draggable="true" data-index="${index}"><img src="${src}" class="w-full h-full object-cover" alt="Media ${index + 1}"/><span class="absolute top-1 left-1 w-4 h-4 rounded bg-black/60 text-white text-[9px] flex items-center justify-center">${index + 1}</span><button type="button" data-remove-index="${index}" class="absolute top-1 right-1 w-4 h-4 rounded bg-black/60 text-white opacity-0 group-hover:opacity-100"><i class="ti ti-x text-[10px]"></i></button></div>`,
          )
          .join("");
      document
        .getElementById("manual-media-add-tile")
        ?.addEventListener("click", () =>
          document.getElementById("manual-media-input")?.click(),
        );
      container.querySelectorAll("[data-remove-index]").forEach((button) =>
        button.addEventListener("click", () => {
          config.images.splice(Number(button.dataset.removeIndex), 1);
          renderManualMedia();
          syncManualSimulator();
        }),
      );
      let dragged = null;
      container.querySelectorAll(".manual-media-item").forEach((item) => {
        item.addEventListener("dragstart", () => {
          dragged = Number(item.dataset.index);
        });
        item.addEventListener("dragover", (event) => event.preventDefault());
        item.addEventListener("drop", (event) => {
          event.preventDefault();
          const target = Number(item.dataset.index);
          if (dragged === null || dragged === target) return;
          const [moved] = config.images.splice(dragged, 1);
          config.images.splice(target, 0, moved);
          renderManualMedia();
          syncManualSimulator();
        });
      });
      syncManualCarousel();
    }

    function syncManualCarousel() {
      const config = manualScheduleState.platformConfigs[manualScheduleState.currentPlatform];
      const image = document.getElementById("sim-primary-image");
      const prev = document.getElementById("sim-carousel-prev");
      const next = document.getElementById("sim-carousel-next");
      const dots = document.getElementById("sim-carousel-dots");
      if (!config || !image || !prev || !next || !dots) return;
      const total = config.images.length;
      manualScheduleState.previewIndex = Math.min(manualScheduleState.previewIndex || 0, Math.max(0, total - 1));
      if (total) image.src = config.images[manualScheduleState.previewIndex];
      [prev, next].forEach((button) => { button.classList.toggle("hidden", total < 2); button.classList.toggle("flex", total >= 2); });
      dots.innerHTML = total > 1 ? config.images.map((_, index) => `<span class="w-1.5 h-1.5 rounded-full ${index === manualScheduleState.previewIndex ? "bg-[#111827]" : "bg-[#d0d5dd]"}"></span>`).join("") : "";
      prev.onclick = () => { manualScheduleState.previewIndex = (manualScheduleState.previewIndex - 1 + total) % total; syncManualCarousel(); };
      next.onclick = () => { manualScheduleState.previewIndex = (manualScheduleState.previewIndex + 1) % total; syncManualCarousel(); };
    }

    function openManualSchedule() {
      const m = document.getElementById("modal-manual-schedule");
      if (m) {
        m.classList.remove("hidden");
        m.classList.add("flex");
      }
      document.body.style.overflow = "hidden";
      rebuildManualAccountState();
      renderManualPlatformTabs();
      renderManualMedia();

      // Reset date to today
      const dateInput = document.getElementById("manual-schedule-date");
      const timeInput = document.getElementById("manual-schedule-time");
      if (dateInput && !dateInput.value) {
        const now = new Date();
        dateInput.value = now.toISOString().split("T")[0];
      }
      if (timeInput && !timeInput.value) {
        timeInput.value = "12:00";
      }
    }

    function closeManualSchedule() {
      const m = document.getElementById("modal-manual-schedule");
      if (m) {
        m.classList.add("hidden");
        m.classList.remove("flex");
      }
      document.body.style.overflow = "";
    }

    function rebuildManualAccountState() {
      const checkboxes = document.querySelectorAll(
        ".manual-account-cb:checked",
      );
      const badgeContainer = document.getElementById(
        "selected-accounts-badges",
      );
      const label = document.getElementById("manual-publish-label");

      badgeContainer.innerHTML = "";
      const selected = [];

      checkboxes.forEach((cb) => {
        selected.push(cb.value);
        const labelTxt = cb.nextElementSibling.nextElementSibling.innerText;
        const platform = manualPlatformForAccount(cb.value);

        const badge = createShadcnAccountBadge(labelTxt, platform, () => {
          cb.checked = false;
          rebuildManualAccountState();
          renderManualPlatformTabs();
          if (typeof syncManualSimulator === "function") {
            syncManualSimulator();
          }
        });

        badgeContainer.appendChild(badge);
      });

      manualScheduleState.platforms = selected;

      if (selected.length > 0) {
        label.textContent = `${selected.length} account(s) selected`;
        label.className = "text-[#111827] font-medium";
      } else {
        label.textContent = "Select destination accounts...";
        label.className = "text-[#98a2b3]";
      }
    }

    function initManualScheduleEvents() {
      const triggerBtn = document.getElementById("btn-open-manual-schedule");
      const modal = document.getElementById("modal-manual-schedule");
      const closeBtn = document.getElementById("btn-close-manual-schedule");
      const pubTrigger = document.getElementById("manual-publish-trigger");
      const pubDropdown = document.getElementById("manual-publish-dropdown");
      const dnaSelect = document.getElementById("manual-select-dna");
      const captionInput = document.getElementById("manual-caption-input");
      const confirmBtn = document.getElementById("btn-manual-confirm-schedule");

      if (triggerBtn)
        triggerBtn.addEventListener("click", () => openManualSchedule());
      if (closeBtn)
        closeBtn.addEventListener("click", () => closeManualSchedule());

      // Dna Watch
      if (dnaSelect) {
        dnaSelect.addEventListener("change", (e) => {
          manualScheduleState.dna = e.target.value;
          const enabled = Boolean(manualScheduleState.dna);
          if (pubTrigger) {
            pubTrigger.setAttribute("aria-disabled", String(!enabled));
            pubTrigger.classList.toggle("cursor-not-allowed", !enabled);
            pubTrigger.classList.toggle("cursor-pointer", enabled);
            pubTrigger.classList.toggle("opacity-60", !enabled);
            pubTrigger.classList.toggle("opacity-100", enabled);
          }
          syncManualSimulator();
        });
      }

      const mediaInput = document.getElementById("manual-media-input");
      const mediaDropzone = document.getElementById("manual-media-dropzone");
      mediaDropzone?.addEventListener("click", () => mediaInput?.click());
      if (mediaInput) {
        mediaInput.addEventListener("change", (e) => {
          const config =
            manualScheduleState.platformConfigs[
              manualScheduleState.currentPlatform
            ];
          [...(e.target.files || [])]
            .filter(
              (file) =>
                file.type.startsWith("image/") && file.size <= 10 * 1024 * 1024,
            )
            .slice(0, Math.max(0, 10 - config.images.length))
            .forEach((file) => config.images.push(URL.createObjectURL(file)));
          renderManualMedia();
          syncManualSimulator();
          e.target.value = "";
        });
      }
      mediaDropzone?.addEventListener("dragover", (e) => {
        e.preventDefault();
        mediaDropzone.classList.add("border-[#111827]");
      });
      mediaDropzone?.addEventListener("dragleave", () =>
        mediaDropzone.classList.remove("border-[#111827]"),
      );
      mediaDropzone?.addEventListener("drop", (e) => {
        e.preventDefault();
        mediaDropzone.classList.remove("border-[#111827]");
        if (mediaInput) {
          mediaInput.files = e.dataTransfer.files;
          mediaInput.dispatchEvent(new Event("change", { bubbles: true }));
        }
      });

      // Publish Multi-select toggle
      if (pubTrigger && pubDropdown) {
        pubTrigger.addEventListener("click", (e) => {
          e.stopPropagation();
          if (!manualScheduleState.dna) {
            showToast("Please select a Business DNA first");
            return;
          }
          pubDropdown.classList.toggle("hidden");
        });
        document.addEventListener("click", () => {
          if (pubDropdown) pubDropdown.classList.add("hidden");
        });
        pubDropdown.addEventListener("click", (e) => e.stopPropagation());
      }

      // AI Prompt Modal Handlers
      const aiTriggerBtn = document.getElementById("btn-manual-ai-gen");
      const aiPromptModal = document.getElementById("manual-ai-prompt-modal");
      const aiCloseBtn = document.getElementById("btn-close-ai-prompt");
      const aiFinalGenBtn = document.getElementById(
        "btn-manual-ai-generate-final",
      );
      const aiPromptInput = document.getElementById(
        "ai-additional-prompt-input",
      );

      if (aiTriggerBtn && aiPromptModal) {
        aiTriggerBtn.addEventListener("click", () => {
          if (captionInput && captionInput.disabled) return; // Prevent when disabled (e.g. story)
          aiPromptModal.classList.remove("hidden");
          aiPromptModal.classList.add("flex");
          if (aiPromptInput) {
            aiPromptInput.value = "";
            aiPromptInput.focus();
          }
        });
      }

      if (aiCloseBtn && aiPromptModal) {
        aiCloseBtn.addEventListener("click", () => {
          aiPromptModal.classList.add("hidden");
          aiPromptModal.classList.remove("flex");
        });
      }

      if (aiFinalGenBtn && aiPromptModal) {
        aiFinalGenBtn.addEventListener("click", () => {
          // Simulated AI Generation flow
          aiFinalGenBtn.innerHTML = `<i class="ti ti-loader-2 animate-spin"></i> Generating...`;
          aiFinalGenBtn.classList.add("opacity-75", "pointer-events-none");

          setTimeout(() => {
            aiFinalGenBtn.innerHTML = `Generate Caption`;
            aiFinalGenBtn.classList.remove("opacity-75", "pointer-events-none");
            aiPromptModal.classList.add("hidden");
            aiPromptModal.classList.remove("flex");

            if (captionInput) {
              const promptText = aiPromptInput
                ? aiPromptInput.value.trim()
                : "";
              const dnaText = manualScheduleState.dna || "Our Brand";
              const generatedText =
                `✨ Fresh inspiration arrived for ${dnaText}! ` +
                (promptText ? `Incorporating: "${promptText}". ` : "") +
                `Explore this season's trendsetters and see why we're redefining modern living. 🌟 Link in bio #Inspiration #Innovation`;

              captionInput.value = generatedText;

              const plat = manualScheduleState.currentPlatform;
              if (!manualScheduleState.platformConfigs[plat]) {
                manualScheduleState.platformConfigs[plat] = {
                  type: "Feeds",
                  caption: "",
                  images: [],
                };
              }
              manualScheduleState.platformConfigs[plat].caption = generatedText;

              // AUTO SYNC PREVIEW IMMEDIATELY IF AI GENERATED
              syncManualSimulator();

              showToast("AI caption generated successfully!");
            }
          }, 1200);
        });
      }

      // Live input syncing with memory isolation
      if (captionInput) {
        captionInput.addEventListener("input", (e) => {
          const plat = manualScheduleState.currentPlatform;
          if (!manualScheduleState.platformConfigs[plat]) {
            manualScheduleState.platformConfigs[plat] = {
              type: "Feeds",
              caption: "",
              images: [],
            };
          }
          manualScheduleState.platformConfigs[plat].caption = e.target.value;
          syncManualSimulator(); // LIVE PREVIEW SYNC
        });
      }

      // Post Type Radio triggers
      document
        .querySelectorAll('input[name="manualPostType"]')
        .forEach((radio) => {
          radio.addEventListener("change", (e) => {
            const plat = manualScheduleState.currentPlatform;
            if (!manualScheduleState.platformConfigs[plat]) {
              manualScheduleState.platformConfigs[plat] = {
                type: "Feeds",
                caption: "",
                images: [],
              };
            }
            manualScheduleState.platformConfigs[plat].type = e.target.value;
            syncManualSimulator(); // SYNC ON TYPE CHANGE

            // Handle Caption Disable on Story
            if (captionInput) {
              if (e.target.value === "Story") {
                captionInput.disabled = true;
                captionInput.classList.add("bg-gray-50", "text-gray-400");
                captionInput.placeholder = "Caption not available for Stories";
              } else {
                captionInput.disabled = false;
                captionInput.classList.remove("bg-gray-50", "text-gray-400");
                captionInput.placeholder =
                  "Write what you want to share... Each platform has isolated memory!";
              }
            }
          });
        });

      // Account Checkboxes logic
      const manualAccCheckboxes =
        document.querySelectorAll(".manual-account-cb");
      manualAccCheckboxes.forEach((cb) => {
        cb.addEventListener("change", () => {
          rebuildManualAccountState();
          renderManualPlatformTabs();
          syncManualSimulator(); // RE-SYNC BRAND ON ACCOUNT CHANGE
        });
      });

      // Initial sync upon first bind
      renderManualPlatformTabs();
      renderManualMedia();
      syncManualSimulator();

      // Confirm btn simulation
      if (confirmBtn) {
        confirmBtn.addEventListener("click", () => submitManualSchedule());
      }
    }

    function submitManualSchedule() {
      const confirmBtn = document.getElementById("btn-manual-confirm-schedule");
      if (!confirmBtn) return;

      // Form Check
      if (!manualScheduleState.dna) {
        showToast("Please select a Business DNA", "error");
        return;
      }
      if (manualScheduleState.platforms.length === 0) {
        showToast("Please select at least 1 publish destination", "error");
        return;
      }

      confirmBtn.innerHTML = `<i class="ti ti-loader-2 animate-spin"></i> Scheduling...`;
      confirmBtn.classList.add("opacity-75", "pointer-events-none");

      setTimeout(() => {
        confirmBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-3.5 h-3.5 text-current shrink-0 inline-block align-text-bottom" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2V5M6 2V5"></path><path d="M10.5 3.5H13.5C17.2712 3.5 19.1569 3.5 20.3284 4.67157C21.5 5.84315 21.5 7.72876 21.5 11.5V14C21.5 17.7712 21.5 19.6569 20.3284 20.8284C19.1569 22 17.2712 22 13.5 22H10.5C6.72876 22 4.84315 22 3.67157 20.8284C2.5 19.6569 2.5 17.7712 2.5 14V11.5C2.5 7.72876 2.5 5.84315 3.67157 4.67157C4.84315 3.5 6.72876 3.5 10.5 3.5Z"></path><path d="M3 8H21"></path><path d="M8.44356 14.5282C10.0526 14.3279 11.3279 13.0526 11.5282 11.4436C11.5585 11.2 11.7545 11 12 11C12.2455 11 12.4415 11.2 12.4718 11.4436C12.6721 13.0526 13.9474 14.3279 15.5564 14.5282C15.8 14.5585 16 14.7545 16 15C16 15.2455 15.8 15.4415 15.5564 15.4718C13.9474 15.6721 12.6721 16.9474 12.4718 18.5564C12.4415 18.8 12.2455 19 12 19C11.7545 19 11.5585 18.8 11.5282 18.5564C11.3279 16.9474 10.0526 15.6721 8.44356 15.4718C8.19998 15.4415 8 15.2455 8 15C8 14.7545 8.19998 14.5585 8.44356 14.5282Z"></path></svg> Schedule`;
        confirmBtn.classList.remove("opacity-75", "pointer-events-none");
        closeManualSchedule();

        // Simulated add to feed
        const newItem = {
          id: "gen-manual-" + Date.now(),
          title:
            "Manual Post (" +
            manualScheduleState.platformConfigs[
              manualScheduleState.currentPlatform
            ].type +
            ")",
          brand: manualScheduleState.dna,
          status: "scheduled",
          type: manualScheduleState.platformConfigs[
            manualScheduleState.currentPlatform
          ].type,
          scheduledAt:
            document.getElementById("manual-schedule-date").value +
            " " +
            document.getElementById("manual-schedule-time").value +
            ":00",
          thumbnail:
            manualScheduleState.platformConfigs[
              manualScheduleState.currentPlatform
            ].images[0] ||
            "/image/Sample Image 1.jpg",
          caption:
            manualScheduleState.platformConfigs[
              manualScheduleState.currentPlatform
            ].caption || "Manually composed schedule item.",
        };

        generatedContent.unshift(newItem);
        renderScheduled();
        showToast("Post successfully scheduled!");
      }, 1500);
    }

    function syncManualSimulator() {
      const config =
        manualScheduleState.platformConfigs[
          manualScheduleState.currentPlatform
        ];
      if (!config) return;

      const simBrandName = document.getElementById("sim-brand-name");
      const simBrandBody = document.getElementById("sim-brand-body");
      const simCaptionText = document.getElementById("sim-caption-text");
      const simPrimaryImage = document.getElementById("sim-primary-image");
      const simImagePlaceholder = document.getElementById(
        "sim-image-placeholder",
      );
      const simPlatformIcon = document.getElementById("sim-platform-icon");
      const simNetworkName = document.getElementById("sim-network-name");

      // Determine Display Name based on selected DNA OR first checked checkbox
      let brandName = "Your Brand";
      if (manualScheduleState.dna) {
        brandName = manualScheduleState.dna;
      } else {
        const firstChecked = document.querySelector(
          ".manual-account-cb:checked",
        );
        if (firstChecked) {
          brandName =
            firstChecked.nextElementSibling.nextElementSibling.innerText;
        }
      }

      if (simBrandName) simBrandName.innerText = brandName;
      const simBrandLogo = document.getElementById("sim-brand-logo");
      if (simBrandLogo) simBrandLogo.src = getDnaLogo(brandName);
      if (simBrandBody)
        simBrandBody.innerText =
          brandName.toLowerCase().replace(/\s+/g, "") + " ";

      // Update Caption OR type indicator for stories
      if (simCaptionText) {
        if (config.type === "Story") {
          simCaptionText.innerText =
            config.type === "Reels"
              ? "Reels preview · caption appears below the video."
              : "Story preview · captions appear as on-screen text.";
          simCaptionText.className = "text-[#667085] italic text-[11px]";
        } else {
          simCaptionText.innerText =
            config.caption || "Your caption will render beautifully here.";
          simCaptionText.className =
            "text-[#344054] whitespace-pre-wrap break-words";
        }
      }

      // Image Isolation check
      if (simPrimaryImage && simImagePlaceholder) {
        if (config.images && config.images.length > 0) {
          simPrimaryImage.src = config.images[0];
          simPrimaryImage.classList.remove("hidden");
          simImagePlaceholder.classList.add("hidden");
        } else {
          simPrimaryImage.classList.add("hidden");
          simImagePlaceholder.classList.remove("hidden");
        }
        syncManualCarousel();
      }

      // Update Network Meta
      if (simNetworkName && simPlatformIcon) {
        simPlatformIcon.innerHTML = getSocialIconSvg(manualScheduleState.currentPlatform, "14px");
        simNetworkName.innerText = `${manualScheduleState.currentPlatform === "facebook" ? "Facebook" : manualScheduleState.currentPlatform === "threads" ? "Threads" : manualScheduleState.currentPlatform === "tiktok" ? "TikTok" : "Instagram"} ${config.type} Preview`;
      }

      const previewCanvas = document.getElementById("sim-preview-canvas");
      const previewTitle = document.getElementById("sim-preview-title");
      const previewCard = document.getElementById("sim-preview-card");
      const feedHeader = document.getElementById("sim-header-feed");
      const feedFooter = document.getElementById("sim-footer-feed");
      const storyOverlay = document.getElementById("sim-story-overlay");
      const reelsOverlay = document.getElementById("sim-reels-overlay");

      const storyLogo = document.getElementById("sim-story-brand-logo");
      const storyName = document.getElementById("sim-story-brand-name");
      const reelsLogo = document.getElementById("sim-reels-brand-logo");
      const reelsName = document.getElementById("sim-reels-brand-name");
      const reelsCaption = document.getElementById("sim-reels-caption");

      if (storyLogo) storyLogo.src = getDnaLogo(brandName);
      if (storyName) storyName.innerText = brandName;
      if (reelsLogo) reelsLogo.src = getDnaLogo(brandName);
      if (reelsName) reelsName.innerText = brandName;
      if (reelsCaption) reelsCaption.innerText = config.caption || "Your caption will render here.";

      const type = config.type || "Feeds";
      const platformLabel =
        manualScheduleState.currentPlatform === "facebook"
          ? "Facebook"
          : manualScheduleState.currentPlatform === "threads"
            ? "Threads"
            : manualScheduleState.currentPlatform === "tiktok"
              ? "TikTok"
              : "Instagram";

      if (previewCanvas && previewCard) {
        previewCanvas.classList.remove(
          "aspect-square",
          "aspect-[9/16]",
          "aspect-[4/5]",
        );
        previewCard.classList.remove("rounded-2xl", "rounded-3xl");

        if (type === "Story") {
          previewCanvas.classList.add("aspect-[9/16]");
          previewCard.classList.add("rounded-3xl");
          if (feedHeader) feedHeader.classList.add("hidden");
          if (feedFooter) feedFooter.classList.add("hidden");
          if (storyOverlay) storyOverlay.classList.remove("hidden");
          if (reelsOverlay) reelsOverlay.classList.add("hidden");
        } else if (type === "Reels") {
          previewCanvas.classList.add("aspect-[9/16]");
          previewCard.classList.add("rounded-3xl");
          if (feedHeader) feedHeader.classList.add("hidden");
          if (feedFooter) feedFooter.classList.add("hidden");
          if (storyOverlay) storyOverlay.classList.add("hidden");
          if (reelsOverlay) reelsOverlay.classList.remove("hidden");
        } else {
          previewCanvas.classList.add("aspect-square");
          previewCard.classList.add("rounded-2xl");
          if (feedHeader) feedHeader.classList.remove("hidden");
          if (feedFooter) feedFooter.classList.remove("hidden");
          if (storyOverlay) storyOverlay.classList.add("hidden");
          if (reelsOverlay) reelsOverlay.classList.add("hidden");
        }
      }
      if (previewTitle)
        previewTitle.innerText = `${platformLabel} ${type === "Feeds" ? "Feed" : type}`;
    }

    function openCalendarDayModal(dateString) {
      // dateString format can be "2026-05-12"
      const targetDate = new Date(dateString);
      const titleEl = document.getElementById("cal-day-modal-title");
      const containerEl = document.getElementById("cal-day-items-container");
      const modal = document.getElementById("modal-calendar-day");

      if (!titleEl || !containerEl || !modal) return;

      // Set header title formatted nicely
      titleEl.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-4 h-4 text-[#667085] shrink-0 inline-block align-text-bottom" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2V5M6 2V5"></path><path d="M10.5 3.5H13.5C17.2712 3.5 19.1569 3.5 20.3284 4.67157C21.5 5.84315 21.5 7.72876 21.5 11.5V14C21.5 17.7712 21.5 19.6569 20.3284 20.8284C19.1569 22 17.2712 22 13.5 22H10.5C6.72876 22 4.84315 22 3.67157 20.8284C2.5 19.6569 2.5 17.7712 2.5 14V11.5C2.5 7.72876 2.5 5.84315 3.67157 4.67157C4.84315 3.5 6.72876 3.5 10.5 3.5Z"></path><path d="M3 8H21"></path><path d="M8.44356 14.5282C10.0526 14.3279 11.3279 13.0526 11.5282 11.4436C11.5585 11.2 11.7545 11 12 11C12.2455 11 12.4415 11.2 12.4718 11.4436C12.6721 13.0526 13.9474 14.3279 15.5564 14.5282C15.8 14.5585 16 14.7545 16 15C16 15.2455 15.8 15.4415 15.5564 15.4718C13.9474 15.6721 12.6721 16.9474 12.4718 18.5564C12.4415 18.8 12.2455 19 12 19C11.7545 19 11.5585 18.8 11.5282 18.5564C11.3279 16.9474 10.0526 15.6721 8.44356 15.4718C8.19998 15.4415 8 15.2455 8 15C8 14.7545 8.19998 14.5585 8.44356 14.5282Z"></path></svg> ${targetDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}`;

      // Filter scheduled content for THIS SPECIFIC DAY
      const dayItems = generatedContent.filter((item) => {
        const itemDate = new Date(
          item.status === "published" ? item.publishedAt : item.scheduledAt,
        );
        return itemDate.toDateString() === targetDate.toDateString();
      });

      containerEl.innerHTML = "";

      if (dayItems.length === 0) {
        containerEl.innerHTML = `
         <div class="flex flex-col items-center justify-center py-8 px-4 text-center">
            <div class="w-10 h-10 rounded-full bg-gray-50 flex items-center justify-center border border-[#eaecf0] mb-2">
               <i class="ti ti-calendar-x text-[#98a2b3]"></i>
            </div>
            <p class="text-[11px] font-medium text-[#667085]">No items scheduled for this day.</p>
         </div>
       `;
      } else {
        dayItems.forEach((item) => {
          const isPublished = item.status === "published";
          const timeStr = new Date(
            isPublished ? item.publishedAt : item.scheduledAt,
          ).toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit" });

          const row = document.createElement("div");
          row.className =
            "p-2.5 bg-[#F9FAFB] hover:bg-white border border-[#eaecf0] rounded-xl flex items-center gap-3 transition-all group cursor-pointer";
          row.onclick = (e) => {
            modal.classList.add("hidden");
            openPreviewModal(item.id);
          };

          row.innerHTML = `
             <div class="w-8 h-8 rounded-lg bg-[#111827] overflow-hidden flex items-center justify-center shrink-0 border border-[#374151]">
                <i class="ti ti-photo text-white opacity-40 text-[12px]"></i>
             </div>
             <div class="flex-1 min-w-0">
                <div class="text-[11px] font-bold text-[#111827] truncate">${escapeHtml(item.title || "Schedule Item")}</div>
                <div class="text-[10px] font-medium ${isPublished ? "text-[#667085]" : "text-[#18181b]"} flex items-center gap-1">
                   <i class="ti ti-clock text-[9px]"></i> ${timeStr}
                </div>
             </div>
             <div class="w-6 h-6 rounded-md flex items-center justify-center text-[#98a2b3] group-hover:text-[#111827] group-hover:bg-white transition-colors border border-transparent group-hover:border-[#eaecf0]">
                <i class="ti ti-chevron-right text-[13px]"></i>
             </div>
          `;
          containerEl.appendChild(row);
        });
      }

      // Open
      modal.classList.remove("hidden");
      modal.classList.add("flex");

      // Pre-fill manual schedule inputs just in case they click Create New Post
      const mDate = document.getElementById("manual-schedule-date");
      if (mDate) {
        mDate.value = dateString;
      }
    }

    // Register system initializing callback
    setTimeout(() => {
      initManualScheduleEvents();
    }, 500);

    window.openManualSchedule = openManualSchedule;
    window.openCalendarDayModal = openCalendarDayModal;
    window.syncManualSimulator = syncManualSimulator;

    // ═══════════════════════════════════════════
    // Universal logic for all business filter dynamic search inputs
    // ═══════════════════════════════════════════
    document.querySelectorAll(".biz-search-input").forEach((input) => {
      input.addEventListener("click", (e) => e.stopPropagation());
      input.addEventListener("input", (e) => {
        const term = e.target.value.toLowerCase();
        const dropdown = input.closest(".absolute");
        if (dropdown) {
          const buttons = dropdown.querySelectorAll("button[data-brand]");
          buttons.forEach((btn) => {
            const match = btn.textContent.toLowerCase().includes(term);
            btn.style.display = match ? "block" : "none";
          });
        }
      });
    });

    // ═══════════════════════════════════════════
    // ENGAGEMENT TEMPLATE MODULE
    // ═══════════════════════════════════════════
    function initEngagementTemplateEvents() {
      const trigger = document.getElementById("btn-eng-template-trigger");
      const dropdown = document.getElementById("dropdown-eng-template");
      const btnSave = document.getElementById("btn-eng-save-tmpl");
      const btnLoad = document.getElementById("btn-eng-load-tmpl");

      const modalSave = document.getElementById("modal-eng-save-tmpl");
      const modalLoad = document.getElementById("modal-eng-load-tmpl");

      // Dropdown Toggle
      if (trigger && dropdown) {
        trigger.addEventListener("click", (e) => {
          e.stopPropagation();
          dropdown.classList.toggle("hidden");
        });
        document.addEventListener("click", () => {
          if (dropdown) dropdown.classList.add("hidden");
        });
      }

      // Open Save
      if (btnSave && modalSave) {
        btnSave.addEventListener("click", () => {
          modalSave.classList.remove("hidden");
          modalSave.classList.add("flex");
          if (dropdown) dropdown.classList.add("hidden");
        });
      }

      // Close Save handlers
      const btnCloseSave = document.getElementById("btn-close-eng-save-tmpl");
      const btnConfirmSave = document.getElementById(
        "btn-confirm-eng-save-tmpl",
      );
      if (btnCloseSave) {
        btnCloseSave.addEventListener("click", () => {
          modalSave.classList.add("hidden");
          modalSave.classList.remove("flex");
        });
      }
      if (btnConfirmSave) {
        btnConfirmSave.addEventListener("click", () => {
          const inp = document.getElementById("inp-eng-tmpl-name");
          const val = inp ? inp.value.trim() : "New Template";
          if (!val) return;
          modalSave.classList.add("hidden");
          modalSave.classList.remove("flex");
          showToast(`Template "${val}" saved successfully!`);
          if (inp) inp.value = "";
        });
      }

      // Open Load
      if (btnLoad && modalLoad) {
        btnLoad.addEventListener("click", () => {
          modalLoad.classList.remove("hidden");
          modalLoad.classList.add("flex");
          if (dropdown) dropdown.classList.add("hidden");
        });
      }

      // Close Load handlers
      const btnCloseLoad = document.getElementById("btn-close-eng-load-tmpl");
      const btnConfirmLoad = document.getElementById(
        "btn-confirm-eng-load-tmpl",
      );
      if (btnCloseLoad) {
        btnCloseLoad.addEventListener("click", () => {
          modalLoad.classList.add("hidden");
          modalLoad.classList.remove("flex");
        });
      }
      if (btnConfirmLoad) {
        btnConfirmLoad.addEventListener("click", () => {
          modalLoad.classList.add("hidden");
          modalLoad.classList.remove("flex");

          // Apply mock preset settings
          const tcDelete = document.getElementById("toggle-delete-comment");
          const tcReply = document.getElementById("toggle-reply-comment");
          const tcLike = document.getElementById("toggle-like-comment");
          const tcDm = document.getElementById("toggle-dm-comment");

          if (tcDelete) tcDelete.checked = false;
          if (tcReply) tcReply.checked = true;
          if (tcLike) tcLike.checked = false;
          if (tcDm) tcDm.checked = true;

          showToast("Engagement template applied successfully!");
        });
      }
    }

    // Initialize new module
    initEngagementTemplateEvents();
    initSummaryFeatureEvents();

    // Start
    init();
  </script>
</AppLayout>
