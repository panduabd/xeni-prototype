        data-id="${item.id}"
        data-index="${idx}"
        draggable="true"
      >
        <div class="flex items-center gap-2.5 min-w-0 flex-1">
          <!-- Thumbnail with click to preview modal detail (read-only) -->
          <div 
            class="relative w-9 h-9 rounded-lg overflow-hidden bg-[#18181b] shrink-0 border border-[#eaecf0] cursor-pointer group/thumb shadow-2xs hover:ring-2 hover:ring-[#18181b]/20 transition-all"
            onclick="event.stopPropagation(); openPreviewModal('${item.id}', { hideActions: true })"
            title="Click to view details"
            draggable="false"
