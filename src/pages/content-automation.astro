          const curDate = existing.date || defaultDate;
          const curTime = existing.time || "08:00";
          if (!bulkScheduleData.customAssignments[item.id]) {
            bulkScheduleData.customAssignments[item.id] = {
              date: curDate,
              time: curTime,
              displayTime: "08:00 AM",
            };
          }
          const [h24, m] = curTime.split(":");
          let hNum = parseInt(h24, 10);
          const p = hNum >= 12 ? "PM" : "AM";
          if (hNum === 0) hNum = 12;
          else if (hNum > 12) hNum -= 12;
          const hStr = String(hNum).padStart(2, "0");

          const isStory = item.contentType === "Story";
          const fallbackImg = isStory
            ? (typeof SAMPLE_STORY_IMAGES !== "undefined" && SAMPLE_STORY_IMAGES[0]) || "/image/Sample Story 1.jpg"
