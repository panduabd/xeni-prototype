    function saveEngagement() {
      if (!editingAutomationId) return;
      const item = generatedContent.find((g) => g.id === editingAutomationId);
      if (!item) return;

      item.autoComment = {
        enabled: els.commentToggle.checked,
        text: els.commentText.value.trim(),
        link: els.commentLink.value.trim(),
        keywords: els.commentKeywords.value.trim(),
      };
      item.autoDm = {
        enabled: els.dmToggle.checked,
        text: els.dmText.value.trim(),
        link: els.dmLink.value.trim(),
        keywords: els.dmKeywords.value.trim(),
      };

      saveGenerated();
      renderGenerated();
      closeEngagementModalFn();
      showToast("Engagement settings saved successfully.", "success");
    }

    function loadAutomations() {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored) automations = JSON.parse(stored);
      } catch (e) {
        automations = [];
      }
    }

    function saveAutomations() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(automations));
    }

    // ═══════════════════════════════════════════
    // RENDER AUTOMATIONS TABLE
    // ═══════════════════════════════════════════
    function renderAutomations(list = automations) {
      const activeCount = automations.filter(
        (a) => a.status === "active",
      ).length;
      const scheduledCount = automations.filter(
        (a) => a.status === "paused",
      ).length;
      els.activeCount.textContent = activeCount;
      els.scheduledCount.textContent = scheduledCount;

      if (list.length === 0) {
        els.emptyState.classList.remove("hidden");
        els.emptyState.classList.add(
          "flex",
          "flex-col",
          "items-center",
          "justify-center",
          "py-24",
        );
        els.table.classList.add("hidden");
        return;
      }

      els.emptyState.classList.add("hidden");
      els.emptyState.classList.remove(
        "flex",
        "flex-col",
        "items-center",
        "justify-center",
        "py-24",
      );
      els.table.classList.remove("hidden");

      els.tbody.innerHTML = list
        .map((auto) => {
          const dateCount = Object.keys(auto.selectedDates).length;
          const contentTypes = [
            ...new Set(
              Object.values(auto.selectedDates)
                .flat()
                .map((s) => s.contentType),
            ),
          ];
          const typeLabels = contentTypes
            .map((t) => {
              return `<span class="inline-flex items-center px-2 h-5 rounded-md bg-[#f4f4f5] border border-[#eaecf0] text-[11px] font-medium text-[#71717a]">
                ${t}
              </span>`;
            })
            .join("");

          const logoUrl = auto.dna?.logo || getDnaLogo(auto.dna?.name);

          return `
        <tr class="table__row border-b border-[#eaecf0] last:border-b-0 hover:bg-[#f4f4f5]/60 transition-colors group">
          <td class="table__cell px-5 py-3.5 align-middle">
            <div class="flex items-center gap-3">
              <img src="${logoUrl}" alt="${escapeHtml(auto.dna?.name || "")}" class="w-8 h-8 rounded-lg object-cover border border-[#eaecf0] shrink-0 shadow-2xs" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1622483767028-3f66f32aef97?w=100&auto=format&fit=crop&q=80';" />
              <span class="text-xs font-semibold text-[#18181b]">${escapeHtml(auto.dna?.name || "-")}</span>
            </div>
          </td>
          <td class="table__cell px-5 py-3.5 align-middle">
            <span class="text-xs font-medium text-[#18181b]">${escapeHtml(auto.name)}</span>
          </td>
          <td class="table__cell px-5 py-3.5 align-middle">
            <span class="text-xs text-[#71717a]">${dateCount} ${dateCount === 1 ? "date" : "dates"} · ${recurringLabel(auto.recurring)}</span>
          </td>
          <td class="table__cell px-5 py-3.5 align-middle">
            <div class="flex items-center gap-1.5 flex-wrap">
              ${typeLabels}
            </div>
          </td>
          <td class="table__cell px-5 py-3.5 align-middle">
            ${
              auto.status === "active"
                ? `<span class="inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-medium bg-emerald-600 text-white shadow-xs">
                  Active
                </span>`
                : `<span class="inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-medium bg-amber-500 text-white shadow-xs">
                  Paused
                </span>`
            }
          </td>
          <td class="table__cell px-5 py-3.5 align-middle">
            <div class="flex items-center justify-end gap-1">
              <button
                class="action-btn w-8 h-8 rounded-lg hover:bg-[#f4f4f5] flex items-center justify-center text-[#71717a] hover:text-[#18181b] transition-colors cursor-pointer"
                title="View details"
                onclick="openPreviewAutomation('${auto.id}')"
              >
                <i class="ti ti-eye text-[15px]"></i>
              </button>
              <button
                class="action-btn w-8 h-8 rounded-lg ${auto.status === "active" ? "hover:bg-amber-50 hover:text-amber-700" : "hover:bg-emerald-50 hover:text-emerald-700"} flex items-center justify-center text-[#71717a] transition-colors cursor-pointer"
                title="${auto.status === "active" ? "Pause automation" : "Resume automation"}"
                onclick="toggleAutomationStatus('${auto.id}')"
              >
                <i class="ti ${auto.status === "active" ? "ti-player-pause" : "ti-player-play"} text-[15px]"></i>
              </button>
              <button
                class="action-btn w-8 h-8 rounded-lg hover:bg-rose-50 flex items-center justify-center text-[#71717a] hover:text-rose-600 transition-colors cursor-pointer"
                title="Delete automation"
                onclick="deleteAutomation('${auto.id}')"
              >
                <i class="ti ti-trash text-[15px]"></i>
              </button>
            </div>
          </td>
        </tr>
      `;
        })
        .join("");
    }

    function recurringLabel(value) {
      const labels = {
        once: "One Time Only",
        monthly: "Same Dates Every Month",
        weekly: "Same Days Every Week",
      };
      return labels[value] || value;
    }

    function escapeHtml(text) {
      const div = document.createElement("div");
      div.textContent = text;
      return div.innerHTML;
    }

    function addAutomationRefTag(name) {
      const container = els.automationRefTags;
      if (!container) return;
      const tag = document.createElement("span");
      tag.className =
        "inline-flex items-center gap-1 px-2 h-6 rounded-full bg-white border border-[#D0D5DD] text-[11px] font-bold text-[#344054] shadow-sm";
      tag.innerHTML = `
      <span class="w-4 h-4 rounded-full bg-[#d1d5db] shrink-0"></span>
      <span class="truncate max-w-[120px]">${escapeHtml(name)}</span>
      <button class="flex items-center justify-center text-[#98a2b3] hover:text-[#d92d20] transition-colors"><i class="ti ti-x text-[12px]"></i></button>
    `;
      tag.querySelector("button").addEventListener("click", () => tag.remove());
      container.appendChild(tag);
    }

    // ═══════════════════════════════════════════
    // WIZARD NAVIGATION
    // ═══════════════════════════════════════════
    function goToStep(step) {
      currentStep = step;
      els.stepPanels.forEach((p) => p.classList.add("hidden"));
      document.getElementById(`step-${step}`).classList.remove("hidden");

      els.stepDots.forEach((dot) => {
        const num = parseInt(dot.dataset.step);
        const circle = dot.querySelector("div");
        const label = dot.querySelector("span");
        if (num === step) {
          circle.className =
            "w-7 h-7 rounded-full bg-[#111827] text-white text-[12px] font-bold flex items-center justify-center";
          label.className = "text-[12px] font-semibold text-[#111827]";
        } else if (num < step) {
          circle.className =
            "w-7 h-7 rounded-full bg-[#111827] text-white text-[12px] font-bold flex items-center justify-center";
          label.className = "text-[12px] font-semibold text-[#667085]";
        } else {
          circle.className =
            "w-7 h-7 rounded-full bg-[#F3F4F6] text-[#667085] text-[12px] font-bold flex items-center justify-center";
          label.className = "text-[12px] font-semibold text-[#667085]";
        }
      });

      els.btnBack.classList.toggle("hidden", step === 1);
      els.btnNext.classList.toggle("hidden", step === 3);
      els.btnStart.classList.toggle("hidden", step !== 3);

      if (step === 3) {
        // Sync recurring radio availability with schedule mode from Step 2
        if (wizardData.scheduleMode === "weekly") {
          // Weekly mode in Step 2: enable Weekly radio option
          if (els.radioRecurringWeekly) {
            els.radioRecurringWeekly.disabled = false;
          }
          if (els.labelRecurringWeekly)
            els.labelRecurringWeekly.classList.remove("opacity-60");
          if (els.divRecurringWeekly)
            els.divRecurringWeekly.classList.remove("opacity-60");
          if (els.recurringModeInfo)
            els.recurringModeInfo.textContent =
              "Weekly mode active. Choose Weekly repetition to repeat content every week on the same days.";
        } else {
          // Monthly mode in Step 2: disable weekly radio
          if (els.radioRecurringWeekly) {
            els.radioRecurringWeekly.disabled = true;
            els.radioRecurringWeekly.checked = false;
          }
          if (els.labelRecurringWeekly)
            els.labelRecurringWeekly.classList.add("opacity-60");
          if (els.divRecurringWeekly)
            els.divRecurringWeekly.classList.add("opacity-60");
          if (els.recurringModeInfo)
            els.recurringModeInfo.textContent =
              "Weekly repetition is disabled because Monthly mode is selected in Step 2. Choose One Time Only or Monthly.";
          // If weekly was selected, switch to once
          if (wizardData.recurring === "weekly") {
            wizardData.recurring = "once";
            const onceRadio = document.querySelector(
              'input[name="recurring"][value="once"]',
            );
            if (onceRadio) onceRadio.checked = true;
          }
        }
        updateReview();
      }
    }

    function setScheduleMode(mode) {
      wizardData.scheduleMode = mode;
      const isMonthly = mode === "monthly";

      if (els.btnModeMonthly && els.btnModeWeekly) {
        if (isMonthly) {
          els.btnModeMonthly.className =
            "schedule-mode-btn px-3 h-7 rounded-lg text-[11px] font-medium bg-white text-[#18181b] shadow-xs transition-all cursor-pointer";
          els.btnModeWeekly.className =
            "schedule-mode-btn px-3 h-7 rounded-lg text-[11px] font-medium text-[#71717a] hover:text-[#18181b] hover:bg-white/60 transition-all cursor-pointer";
        } else {
          els.btnModeWeekly.className =
            "schedule-mode-btn px-3 h-7 rounded-lg text-[11px] font-medium bg-white text-[#18181b] shadow-xs transition-all cursor-pointer";
          els.btnModeMonthly.className =
            "schedule-mode-btn px-3 h-7 rounded-lg text-[11px] font-medium text-[#71717a] hover:text-[#18181b] hover:bg-white/60 transition-all cursor-pointer";
        }
      }

      if (els.monthlyCalendar && els.weeklyCalendar) {
        if (isMonthly) {
          els.monthlyCalendar.classList.remove("hidden");
          els.weeklyCalendar.classList.add("hidden");
          renderCalendar();
        } else {
          els.weeklyCalendar.classList.remove("hidden");
          els.monthlyCalendar.classList.add("hidden");
          renderWeeklyCalendar();
        }
      }
    }

    function validateStep(step) {
      if (step === 1) {
        if (!wizardData.name.trim()) {
          showToast(
            "Campaign name is required",
            "warning",
            "Missing Information",
          );
          return false;
        }
        if (!wizardData.dna) {
          showToast(
            "Please select a Business DNA",
            "warning",
            "Missing Information",
          );
          return false;
        }
      }
      if (step === 2) {
        if (Object.keys(wizardData.selectedDates).length === 0) {
          showToast(
            "Please select at least 1 date",
            "warning",
            "Schedule Empty",
          );
          return false;
        }
      }
      return true;
    }

    function updateReview() {
      els.reviewName.textContent = wizardData.name || "-";
      els.reviewDna.textContent = wizardData.dna?.name || "-";
      if (els.reviewDnaLogo) {
        if (wizardData.dna?.name) {
          els.reviewDnaLogo.src =
            wizardData.dna.logo || getDnaLogo(wizardData.dna.name);
          els.reviewDnaLogo.classList.remove("hidden");
        } else {
          els.reviewDnaLogo.classList.add("hidden");
        }
      }

      // Render recurring preview
      renderRecurringPreview();

      // Render schedule cards
      const dates = Object.keys(wizardData.selectedDates).sort();
      const monthNames = [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec",
      ];

      if (dates.length === 0) {
        els.reviewScheduleCards.innerHTML = `<div class="col-span-2 text-center py-4 text-[12px] text-[#98a2b3]">No dates selected</div>`;
      } else {
        const grouped = {};
        dates.forEach((dk) => {
          const [y, m, d] = dk.split("-");
          const dayName = new Date(dk).toLocaleDateString("en-US", {
            weekday: "short",
          });
          const key = `${d} ${monthNames[parseInt(m) - 1]}`;
          if (!grouped[key]) {
            grouped[key] = { dayName, automations: [] };
          }
          wizardData.selectedDates[dk].forEach((slot) => {
            grouped[key].automations.push(slot);
          });
        });

        els.reviewScheduleCards.innerHTML = Object.entries(grouped)
          .map(
            ([dateLabel, data]) => `
        <div class="p-3 rounded-xl bg-white border border-[#eaecf0] space-y-2">
          <div class="flex items-center gap-2">
            <span class="text-[12px] font-bold text-[#111827]">${dateLabel}</span>
            <span class="text-[10px] text-[#667085]">${data.dayName}</span>
          </div>
          <div class="space-y-1.5">
            ${data.automations
              .map(
                (a) => `
              <div class="flex items-center gap-2">
                <i class="ti ${CONTENT_ICONS[a.contentType] || "ti-file"} text-[12px] text-[#667085]"></i>
                <span class="text-[11px] text-[#667085]">${a.contentType}${a.category ? " · " + escapeHtml(a.category) : ""}${a.variations > 1 ? " · " + a.variations + "x" : ""}</span>
              </div>
            `,
              )
              .join("")}
          </div>
        </div>
      `,
          )
          .join("");
      }

      // Update footer credit — Single Post & Story counts as 2
      // For recurring (monthly/weekly), multiply by repeat count
      const baseVariations = Object.values(wizardData.selectedDates).reduce(
        (total, slots) => {
          return (
            total +
            slots.reduce((sum, s) => {
              const multiplier =
                s.contentType === "Single Post & Story" ? 2 : 1;
              return sum + (s.variations || 1) * multiplier;
            }, 0)
          );
        },
        0,
      );
      const recurringMultiplier =
        wizardData.recurring === "monthly" || wizardData.recurring === "weekly"
          ? wizardData.repeatFor || 1
          : 1;
      els.footerCredit.textContent = baseVariations * recurringMultiplier;

      // Update selected dates count label
      if (els.selectedDatesCount) {
        const dateCount = Object.keys(wizardData.selectedDates).length;
        els.selectedDatesCount.textContent = `${dateCount} date${dateCount !== 1 ? "s" : ""} selected`;
      }
    }

    // ═══════════════════════════════════════════
    // RECURRING PREVIEW
    // ═══════════════════════════════════════════
    function renderRecurringPreview() {
      const isMonthly = wizardData.recurring === "monthly";
      const isWeekly = wizardData.recurring === "weekly";

      els.repeatForWrapper.classList.toggle("hidden", !isMonthly && !isWeekly);
      els.weeklyRepeatWrapper.classList.toggle("hidden", !isWeekly);
      els.recurringPreview.classList.toggle("hidden", !isMonthly && !isWeekly);

      if (!isMonthly && !isWeekly) {
        els.recurringInfo.textContent =
          "Content will be generated once on selected dates.";
        return;
      }

      const selectedDateKeys = Object.keys(wizardData.selectedDates).sort();
      if (selectedDateKeys.length === 0) {
        els.recurringPreviewGrid.innerHTML = "";
        return;
      }

      const monthNames = [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec",
      ];
      const dayNames = ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"];

      // Parse first date reliably
      const [fy, fm, fd] = selectedDateKeys[0].split("-").map(Number);
      const firstDate = new Date(fy, fm - 1, fd);
      const repeatCount = parseInt(wizardData.repeatFor) || 3;
      let previewHTML = "";

      if (isMonthly) {
        els.recurringInfo.textContent =
          "Selected dates will repeat every month. If a date doesn't exist in a month, it will be scheduled on the last day of that month.";

        const selectedDays = selectedDateKeys.map((dk) =>
          parseInt(dk.split("-")[2]),
        );

        for (let i = 1; i <= repeatCount; i++) {
          const previewMonth = new Date(
            firstDate.getFullYear(),
            firstDate.getMonth() + i,
            1,
          );
          const monthLabel = monthNames[previewMonth.getMonth()];
          const yearLabel = previewMonth.getFullYear();

          const datePills = selectedDays
            .map((day) => {
              const daysInMonth = new Date(
                previewMonth.getFullYear(),
                previewMonth.getMonth() + 1,
                0,
              ).getDate();
              const actualDay = Math.min(day, daysInMonth);
              const dateObj = new Date(
                previewMonth.getFullYear(),
                previewMonth.getMonth(),
                actualDay,
              );
              const dow = dayNames[dateObj.getDay()];

              return `
            <div class="flex flex-col items-center gap-0.5">
              <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-[#EFF6FF] border border-[#dbeafe] text-[11px] font-bold text-[#2563EB]">
                ${actualDay}
              </span>
              <span class="text-[9px] text-[#98a2b3]">${dow}</span>
            </div>
          `;
            })
            .join("");

          previewHTML += `
          <div class="p-2.5 rounded-xl bg-[#F9FAFB] border border-[#eaecf0] space-y-1.5">
            <div class="text-[11px] font-bold text-[#111827] text-center">${monthLabel} ${yearLabel}</div>
            <div class="flex flex-wrap items-center justify-center gap-1.5">
              ${datePills}
            </div>
          </div>
        `;
        }
      } else if (isWeekly) {
        // Get unique day-of-week from selected dates
        const selectedDays = new Set();
        const fullDayNames = [
          "Sunday",
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday",
        ];
        selectedDateKeys.forEach((dk) => {
          const d = new Date(dk);
          selectedDays.add(d.getDay());
        });
        const sortedDays = Array.from(selectedDays).sort((a, b) => a - b);
        const dayNamesList = sortedDays.map((d) => fullDayNames[d]).join(", ");

        els.recurringInfo.textContent = `Content will repeat every week on ${dayNamesList}.`;

        // Update weekly days info box
        if (els.weeklyDaysInfo) {
          els.weeklyDaysInfo.textContent = `Every ${dayNamesList}`;
        }

        // Generate weekly preview: show next N weeks
        // Find the Sunday of the week containing the first selected date
        const firstSelectedDate = new Date(selectedDateKeys[0]);
        const firstWeekSunday = new Date(firstSelectedDate);
        firstWeekSunday.setDate(
          firstWeekSunday.getDate() - firstWeekSunday.getDay(),
        );
        firstWeekSunday.setHours(0, 0, 0, 0);

        for (let i = 1; i <= repeatCount; i++) {
          const weekStart = new Date(firstWeekSunday);
          weekStart.setDate(weekStart.getDate() + i * 7);
          const weekLabelStart = weekStart.toLocaleDateString("en-US", {
            month: "short",
            day: "numeric",
          });
          const weekEnd = new Date(weekStart);
          weekEnd.setDate(weekEnd.getDate() + 6);
          const weekLabelEnd = weekEnd.toLocaleDateString("en-US", {
            month: "short",
            day: "numeric",
          });

          // Find matching dates in this week
          const weekDatePills = [];
          sortedDays.forEach((dow) => {
            const matchDate = new Date(weekStart);
            matchDate.setDate(matchDate.getDate() + dow);
            const actualDay = matchDate.getDate();
            const dowShort = dayNames[matchDate.getDay()];
            weekDatePills.push(`
            <div class="flex flex-col items-center gap-0.5">
              <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-[#EFF6FF] border border-[#dbeafe] text-[11px] font-bold text-[#2563EB]">
                ${actualDay}
              </span>
              <span class="text-[9px] text-[#98a2b3]">${dowShort}</span>
            </div>
          `);
          });

          previewHTML += `
          <div class="p-2.5 rounded-xl bg-[#F9FAFB] border border-[#eaecf0] space-y-1.5">
            <div class="text-[11px] font-bold text-[#111827] text-center">Week ${i} · ${weekLabelStart} – ${weekLabelEnd}</div>
            <div class="flex flex-wrap items-center justify-center gap-1.5">
              ${weekDatePills.join("")}
            </div>
          </div>
        `;
        }
      }

      els.recurringPreviewGrid.innerHTML = previewHTML;
    }

    // ═══════════════════════════════════════════
    // AI SUGGESTION
    // ═══════════════════════════════════════════
    function applyAiSuggestion() {
      const year = currentCalendarDate.getFullYear();
      const month = currentCalendarDate.getMonth();
      const daysInMonth = new Date(year, month + 1, 0).getDate();

      // Get all weekdays in current month
      const weekdays = [];
      for (let day = 1; day <= daysInMonth; day++) {
        const date = new Date(year, month, day);
        const dayOfWeek = date.getDay();
        if (dayOfWeek !== 0 && dayOfWeek !== 6) {
          const dateKey = `${year}-${String(month + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
          weekdays.push({ day, dateKey });
        }
      }

      // Clear current month weekdays to allow generating fresh random sets on repeated clicks
      weekdays.forEach(({ dateKey }) => {
        delete wizardData.selectedDates[dateKey];
      });

      // Pick random dates spaced naturally (2-4 days apart)
      const targetCount = Math.floor(Math.random() * 3) + 7; // 7 to 9 dates
      const chosen = [];
      let currentIdx = Math.floor(Math.random() * 2); // start at index 0 or 1

      while (currentIdx < weekdays.length && chosen.length < targetCount) {
        chosen.push(weekdays[currentIdx].dateKey);
        const step = Math.floor(Math.random() * 3) + 2; // gap of 2 to 4 days
        currentIdx += step;
      }

      chosen.forEach((dateKey) => {
        wizardData.selectedDates[dateKey] = [
          {
            contentType: "Single Post",
            category: "",
            prompt: "",
            variations: 1,
          },
        ];
      });

      renderCalendar();
      showToast(`AI randomly selected ${chosen.length} optimal posting dates!`);
    }

    // ═══════════════════════════════════════════
    // AI SUGGESTION WEEKLY
    // ═══════════════════════════════════════════
    function applyAiSuggestionWeekly() {
      const weekStart = new Date(wizardData.currentWeekDate);
      weekStart.setDate(weekStart.getDate() - weekStart.getDay());
      weekStart.setHours(0, 0, 0, 0);

      // Weekdays (Mon - Fri) candidate dates
      const weekdays = [];
      for (let i = 1; i <= 5; i++) {
        const weekDate = new Date(weekStart);
        weekDate.setDate(weekDate.getDate() + i);
        const dateKey = `${weekDate.getFullYear()}-${String(weekDate.getMonth() + 1).padStart(2, "0")}-${String(weekDate.getDate()).padStart(2, "0")}`;
        weekdays.push(dateKey);
      }

      // Clear previous week selections so multiple clicks generate fresh random sets
      for (let i = 0; i < 7; i++) {
        const weekDate = new Date(weekStart);
        weekDate.setDate(weekDate.getDate() + i);
        const dateKey = `${weekDate.getFullYear()}-${String(weekDate.getMonth() + 1).padStart(2, "0")}-${String(weekDate.getDate()).padStart(2, "0")}`;
        delete wizardData.selectedDates[dateKey];
      }

      // Shuffle and pick 3 or 4 random weekdays
      const shuffled = [...weekdays].sort(() => Math.random() - 0.5);
      const pickCount = Math.floor(Math.random() * 2) + 3; // 3 or 4
      const chosen = shuffled.slice(0, pickCount).sort();

      chosen.forEach((dateKey) => {
        wizardData.selectedDates[dateKey] = [
          {
            contentType: "Single Post",
            category: "",
            prompt: "",
            variations: 1,
          },
        ];
      });

      renderWeeklyCalendar();
      showToast(`AI randomly selected ${chosen.length} optimal posting dates!`);
    }

    // ═══════════════════════════════════════════
    // CALENDAR
    // ═══════════════════════════════════════════
    function renderCalendar() {
      const year = currentCalendarDate.getFullYear();
      const month = currentCalendarDate.getMonth();
      const monthNames = [
        "January",
        "February",
        "March",
        "April",
        "May",
        "June",
        "July",
        "August",
        "September",
        "October",
        "November",
        "December",
      ];
      els.calMonthYear.textContent = `${monthNames[month]} ${year}`;

      const firstDay = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();

      let html = "";
      // Empty cells before first day
      for (let i = 0; i < firstDay; i++) {
        html += "<div></div>";
      }
      // Days
      for (let day = 1; day <= daysInMonth; day++) {
        const dateKey = `${year}-${String(month + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
        const isSelected = wizardData.selectedDates[dateKey];
        const hasSlots = isSelected && isSelected.length > 0;
        const slotCount = hasSlots ? isSelected.length : 0;
        const isWeekend = [0, 6].includes(new Date(year, month, day).getDay());
        const totalVariations = isSelected
          ? isSelected.reduce((sum, s) => {
              const multiplier =
                s.contentType === "Single Post & Story" ? 2 : 1;
              return sum + (s.variations || 1) * multiplier;
            }, 0)
          : 0;

        html += `
        <button
          class="cal-day relative w-full aspect-square rounded-lg flex flex-col items-center justify-center text-[12px] font-medium transition-all cursor-pointer
            ${isSelected ? "bg-[#111827] text-white" : isWeekend ? "text-[#D92D20] hover:bg-[#FEF3F2]" : "text-[#111827] hover:bg-[#F9FAFB]"}"
          data-date="${dateKey}"
        >
          <span>${day}</span>
          ${
            isSelected
              ? `
            <span class="cal-counter absolute -top-2 -right-2 w-7 h-7 rounded-full bg-[#2563EB] text-white text-[11px] font-bold flex items-center justify-center gap-0.5 shadow-sm hover:bg-[#1d4ed8] transition-colors cursor-pointer" data-date="${dateKey}">
              ${totalVariations}
              <i class="ti ti-chevron-right text-[9px]"></i>
            </span>
          `
              : ""
          }
        </button>
      `;
      }
      els.calGrid.innerHTML = html;

      // Update monthly selected dates count
      if (els.selectedDatesCount) {
        const dateCount = Object.keys(wizardData.selectedDates).length;
        els.selectedDatesCount.textContent = `${dateCount} date${dateCount !== 1 ? "s" : ""} selected`;
      }

      // Calendar day clicks
      els.calGrid.querySelectorAll(".cal-day").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const dateKey = btn.dataset.date;
          // If clicking the counter badge, open detail dropdown
          if (e.target.closest(".cal-counter")) {
            e.stopPropagation();
            openDateDetailPopover(dateKey, btn);
          } else if (wizardData.selectedDates[dateKey]?.length > 0) {
            // Date has automations - open detail dropdown
            openDateDetailPopover(dateKey, btn);
          } else {
            // Empty date - open form popover
            openAutomationPopover(dateKey, btn);
          }
        });
      });
    }

    // ═══════════════════════════════════════════
    // WEEKLY CALENDAR
    // ═══════════════════════════════════════════
    function renderWeeklyCalendar() {
      const weekStart = new Date(wizardData.currentWeekDate);
      weekStart.setDate(weekStart.getDate() - weekStart.getDay());
      weekStart.setHours(0, 0, 0, 0);

      const weekEnd = new Date(weekStart);
      weekEnd.setDate(weekEnd.getDate() + 6);
      weekEnd.setHours(23, 59, 59, 999);

      els.calWeekLabel.textContent = `${weekStart.toLocaleDateString("en-US", { month: "short", day: "numeric" })} – ${weekEnd.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}`;

      const today = new Date();
      today.setHours(0, 0, 0, 0);

      let html = "";
      const dayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

      for (let i = 0; i < 7; i++) {
        const dayDate = new Date(weekStart);
        dayDate.setDate(dayDate.getDate() + i);
        const isToday = dayDate.toDateString() === new Date().toDateString();
        const isPast = dayDate < today;
        const isWeekend = i === 0 || i === 6;
        const dateKey = `${dayDate.getFullYear()}-${String(dayDate.getMonth() + 1).padStart(2, "0")}-${String(dayDate.getDate()).padStart(2, "0")}`;
        const isSelected = wizardData.selectedDates[dateKey];
        const hasSlots = isSelected && isSelected.length > 0;
        const totalVariations = isSelected
          ? isSelected.reduce((sum, s) => {
              const multiplier =
                s.contentType === "Single Post & Story" ? 2 : 1;
              return sum + (s.variations || 1) * multiplier;
            }, 0)
          : 0;

        html += `
        <button
          class="cal-day relative w-full aspect-square rounded-lg flex flex-col items-center justify-center text-[12px] font-medium transition-all cursor-pointer
            ${isSelected ? "bg-[#111827] text-white" : isWeekend ? "text-[#D92D20] hover:bg-[#FEF3F2]" : "text-[#111827] hover:bg-[#F9FAFB]"}"
          data-date="${dateKey}"
        >
          <span>${dayDate.getDate()}</span>
          ${
            isSelected
              ? `
            <span class="cal-counter absolute -top-2 -right-2 w-7 h-7 rounded-full bg-[#2563EB] text-white text-[11px] font-bold flex items-center justify-center gap-0.5 shadow-sm hover:bg-[#1d4ed8] transition-colors cursor-pointer" data-date="${dateKey}">
              ${totalVariations}
              <i class="ti ti-chevron-right text-[9px]"></i>
            </span>
          `
              : ""
          }
        </button>
      `;
      }

      els.calWeekGrid.innerHTML = html;

      // Update weekly selected dates count
      if (els.selectedWeeklyDatesCount) {
        const dateCount = Object.keys(wizardData.selectedDates).length;
        els.selectedWeeklyDatesCount.textContent = `${dateCount} date${dateCount !== 1 ? "s" : ""} selected`;
      }

      // Calendar day clicks
      els.calWeekGrid.querySelectorAll(".cal-day").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const dateKey = btn.dataset.date;
          if (e.target.closest(".cal-counter")) {
            e.stopPropagation();
            openDateDetailPopover(dateKey, btn);
          } else if (wizardData.selectedDates[dateKey]?.length > 0) {
            openDateDetailPopover(dateKey, btn);
          } else {
            openAutomationPopover(dateKey, btn);
          }
        });
      });
    }

    // ═══════════════════════════════════════════
    // CALENDAR BUTTON HELPER
    // ═══════════════════════════════════════════
    function getDayButton(dateKey) {
      if (wizardData.scheduleMode === "weekly" && els.calWeekGrid) {
        const btn = els.calWeekGrid.querySelector(
          `.cal-day[data-date="${dateKey}"]`,
        );
        if (btn && btn.offsetParent !== null) return btn;
      }
      if (els.calGrid) {
        const btn = els.calGrid.querySelector(
          `.cal-day[data-date="${dateKey}"]`,
        );
        if (btn && btn.offsetParent !== null) return btn;
      }
      return (
        Array.from(
          document.querySelectorAll(`.cal-day[data-date="${dateKey}"]`),
        ).find((el) => el.offsetParent !== null) ||
        document.querySelector(`.cal-day[data-date="${dateKey}"]`)
      );
    }

    // ═══════════════════════════════════════════
    // AUTOMATION POPOVER
    // ═══════════════════════════════════════════
    function openAutomationPopover(dateKey, targetBtn, editIndex = -1) {
      activePopoverDate = dateKey;
      const slots = wizardData.selectedDates[dateKey] || [];
      const [y, m, d] = dateKey.split("-");
      els.slotPopoverDate.textContent = `${d} ${["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"][parseInt(m) - 1]} ${y}`;

      // If editing, populate fields
      if (editIndex >= 0 && slots[editIndex]) {
        const slot = slots[editIndex];
        els.slotContentType.value = slot.contentType;
        els.slotCategory.value = slot.category || "";
        els.slotPrompt.value = slot.prompt || "";
        els.automationVariations.value = slot.variations || 1;
        els.btnAddSlot.textContent = "Update Automation";
        els.btnAddSlot.dataset.editIndex = editIndex;
        if (els.contentTypeDesc) {
          els.contentTypeDesc.textContent =
            CONTENT_TYPE_DESCS[slot.contentType] || "";
        }
      } else {
        // Reset inputs
        els.slotContentType.value = "Single Post";
        els.slotCategory.value = "";
        els.slotPrompt.value = "";
        els.automationVariations.value = 1;
        els.btnAddSlot.textContent = "Add";
        els.btnAddSlot.dataset.editIndex = "";
        if (els.contentTypeDesc) {
          els.contentTypeDesc.textContent =
            CONTENT_TYPE_DESCS["Single Post"] || "";
        }
      }

      // Update count
      const slotCount = slots.length;
      const totalVars = slots.reduce((sum, s) => sum + (s.variations || 1), 0);
      document.getElementById("automation-remaining").textContent =
        `${slotCount} automation${slotCount !== 1 ? "s" : ""} · ${totalVars} total`;
      els.btnAddSlot.disabled = false;
      els.btnAddSlot.style.opacity = "1";

      // Show first to measure actual dimensions
      els.slotPopover.classList.remove("hidden");

      let btn = targetBtn;
      let rect = btn
        ? btn.getBoundingClientRect()
        : { top: 0, left: 0, right: 0, bottom: 0, width: 0, height: 0 };
      if (rect.width === 0 && rect.height === 0) {
        const properBtn = getDayButton(dateKey);
        if (properBtn) {
          btn = properBtn;
          rect = btn.getBoundingClientRect();
        }
      }

      const popoverWidth = els.slotPopover.offsetWidth || 288;
      const popoverHeight = els.slotPopover.offsetHeight || 520;
      const gap = 12;

      // Modal container boundary if open inside modal-add-automation
      const modalCard =
        els.modalAdd && !els.modalAdd.classList.contains("hidden")
          ? els.modalAdd.querySelector(".bg-white")
          : null;
      const modalRect = modalCard ? modalCard.getBoundingClientRect() : null;
      const minTop = modalRect ? modalRect.top + 16 : 16;
      const maxBottom = modalRect
        ? Math.min(modalRect.bottom - 16, window.innerHeight - 16)
        : window.innerHeight - 16;

      // Default: place to the right of the clicked button
      let left = rect.right + gap;

      // If too far right, clamp so it stays docked at the right side of the screen
      if (left + popoverWidth > window.innerWidth - 16) {
        left = window.innerWidth - popoverWidth - 16;
      }
      if (left < 16) left = 16;

      // Vertically center with the clicked button
      let top = rect.top + rect.height / 2 - popoverHeight / 2;

      // Clamp vertically so it stops flush and never sinks below ("mentok tidak tenggelam kebawah")
      if (top + popoverHeight > maxBottom) {
        top = maxBottom - popoverHeight;
      }
      if (top < minTop) {
        top = minTop;
      }

      const availableHeight = maxBottom - minTop;
      if (availableHeight > 0) {
        els.slotPopover.style.maxHeight = `${availableHeight}px`;
        els.slotPopover.style.overflowY = "auto";
      }

      els.slotPopover.style.left = `${left}px`;
      els.slotPopover.style.top = `${top}px`;
    }

    function closeAutomationPopover() {
      els.slotPopover.classList.add("hidden");
      activePopoverDate = null;
    }

    // ═══════════════════════════════════════════
    // DATE DETAIL POPOVER (dropdown list)
    // ═══════════════════════════════════════════
    function openDateDetailPopover(dateKey, targetBtn) {
      activePopoverDate = dateKey;
      const slots = wizardData.selectedDates[dateKey] || [];
      const [y, m, d] = dateKey.split("-");
      const monthNames = [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec",
      ];
      els.dateDetailDate.textContent = `${d} ${monthNames[parseInt(m) - 1]} ${y}`;

      // Build automation list
      if (slots.length === 0) {
        els.dateDetailList.innerHTML = `
        <div class="text-center py-3 text-[12px] text-[#98a2b3]">No automations yet</div>
      `;
      } else {
        els.dateDetailList.innerHTML = slots
          .map(
            (slot, idx) => `
        <div class="flex items-center justify-between p-2.5 rounded-xl bg-[#F9FAFB] border border-[#eaecf0] group">
          <div class="flex items-center gap-2 min-w-0">
            <i class="ti ${CONTENT_ICONS[slot.contentType] || "ti-file"} text-[13px] text-[#667085] shrink-0"></i>
            <div class="min-w-0">
              <div class="text-[12px] font-medium text-[#111827] truncate">${escapeHtml(slot.contentType)}</div>
              <div class="text-[11px] text-[#667085] truncate">${slot.category ? escapeHtml(slot.category) + " · " : ""}${slot.variations || 1}x variations</div>
            </div>
          </div>
          <div class="flex items-center gap-0.5 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">
            <button onclick="editAutomation('${dateKey}', ${idx})" class="w-7 h-7 rounded-lg hover:bg-white flex items-center justify-center text-[#98a2b3] hover:text-[#2563EB] cursor-pointer transition-colors" title="Edit">
              <i class="ti ti-pencil text-[12px]"></i>
            </button>
            <button onclick="removeAutomation('${dateKey}', ${idx})" class="w-7 h-7 rounded-lg hover:bg-white flex items-center justify-center text-[#98a2b3] hover:text-[#D92D20] cursor-pointer transition-colors" title="Remove">
              <i class="ti ti-trash text-[12px]"></i>
            </button>
          </div>
        </div>
      `,
          )
          .join("");
      }

      // Show first to measure actual dimensions
      els.dateDetailPopover.classList.remove("hidden");

      let btn = targetBtn;
      let rect = btn
        ? btn.getBoundingClientRect()
        : { top: 0, left: 0, right: 0, bottom: 0, width: 0, height: 0 };
      if (rect.width === 0 && rect.height === 0) {
        const properBtn = getDayButton(dateKey);
        if (properBtn) {
          btn = properBtn;
          rect = btn.getBoundingClientRect();
        }
      }

      const popoverWidth = els.dateDetailPopover.offsetWidth || 288;
      const popoverHeight = els.dateDetailPopover.offsetHeight || 160;
      const gap = 8;

      // Modal container boundary if open inside modal-add-automation
      const modalCard =
        els.modalAdd && !els.modalAdd.classList.contains("hidden")
          ? els.modalAdd.querySelector(".bg-white")
          : null;
      const modalRect = modalCard ? modalCard.getBoundingClientRect() : null;
      const minTop = modalRect ? modalRect.top + 16 : 16;
      const maxBottom = modalRect
        ? Math.min(modalRect.bottom - 16, window.innerHeight - 16)
        : window.innerHeight - 16;
      const minLeft = modalRect ? modalRect.left + 16 : 16;
      const maxRight = modalRect
        ? Math.min(modalRect.right - 16, window.innerWidth - 16)
        : window.innerWidth - 16;

      // Horizontally center with the clicked button
      let left = rect.left + rect.width / 2 - popoverWidth / 2;
      if (left < minLeft) left = minLeft;
      if (left + popoverWidth > maxRight) left = maxRight - popoverWidth;

      // Position directly above the date ("di atas tanggalnya")
      let top = rect.top - popoverHeight - gap;

      // If not enough room above within modal/viewport, place it below the date
      if (top < minTop) {
        top = rect.bottom + gap;
      }

      // Ensure it stops flush and never sinks below the bottom ("mentok tidak tenggelam kebawah")
      if (top + popoverHeight > maxBottom) {
        top = maxBottom - popoverHeight;
      }
      if (top < minTop) {
        top = minTop;
      }

      const availableHeight = maxBottom - minTop;
      if (availableHeight > 0) {
        els.dateDetailPopover.style.maxHeight = `${availableHeight}px`;
        els.dateDetailPopover.style.overflowY = "auto";
      }

      els.dateDetailPopover.style.left = `${left}px`;
      els.dateDetailPopover.style.top = `${top}px`;
    }

    function closeDateDetailPopover() {
      els.dateDetailPopover.classList.add("hidden");
      activePopoverDate = null;
    }

    function addAutomation() {
      if (!activePopoverDate) return;

      // Create date array if doesn't exist
      if (!wizardData.selectedDates[activePopoverDate]) {
        wizardData.selectedDates[activePopoverDate] = [];
      }

      const slots = wizardData.selectedDates[activePopoverDate];
      const variations = parseInt(els.automationVariations.value) || 1;
      const editIndex = parseInt(els.btnAddSlot.dataset.editIndex);

      if (!isNaN(editIndex) && editIndex >= 0 && slots[editIndex]) {
        // Update existing
        slots[editIndex] = {
          contentType: els.slotContentType.value,
          category: els.slotCategory.value.trim(),
          prompt: els.slotPrompt.value.trim(),
          variations: Math.max(1, Math.min(10, variations)),
        };
      } else {
        // Add new
        slots.push({
          contentType: els.slotContentType.value,
          category: els.slotCategory.value.trim(),
          prompt: els.slotPrompt.value.trim(),
          variations: Math.max(1, Math.min(10, variations)),
        });
      }

      renderCalendar();
      renderWeeklyCalendar();
      closeAutomationPopover();
    }

    function removeDate(dateKey) {
      delete wizardData.selectedDates[dateKey];
      renderCalendar();
      renderWeeklyCalendar();
    }

    function editDate(dateKey) {
      closeDateDetailPopover();
      const targetBtn = getDayButton(dateKey);
      if (targetBtn) {
        openAutomationPopover(dateKey, targetBtn);
      }
    }

    function removeAutomation(dateKey, index) {
      wizardData.selectedDates[dateKey].splice(index, 1);
      if (wizardData.selectedDates[dateKey].length === 0) {
        delete wizardData.selectedDates[dateKey];
        closeDateDetailPopover();
      } else {
        const targetBtn = getDayButton(dateKey);
        if (targetBtn) openDateDetailPopover(dateKey, targetBtn);
      }
      renderCalendar();
      renderWeeklyCalendar();
    }

    function editAutomation(dateKey, index) {
      closeDateDetailPopover();
      const targetBtn = getDayButton(dateKey);
      if (targetBtn) {
        openAutomationPopover(dateKey, targetBtn, index);
      }
    }

    function renderSelectedDates() {
      const dates = Object.keys(wizardData.selectedDates).sort();
      if (dates.length === 0) {
        els.selectedDatesContainer.innerHTML = "";
        return;
      }

      els.selectedDatesContainer.innerHTML = dates
        .map((dateKey) => {
          const slots = wizardData.selectedDates[dateKey];
          const [y, m, d] = dateKey.split("-");
          const monthNames = [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "Mei",
            "Jun",
            "Jul",
            "Agu",
            "Sep",
            "Okt",
            "Nov",
            "Des",
          ];
          const displayDate = `${d} ${monthNames[parseInt(m) - 1]} ${y}`;

          return `
        <div class="p-3 rounded-xl bg-[#F9FAFB] border border-[#eaecf0] space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-[12px] font-bold text-[#111827]">${displayDate}</span>
            <span class="text-[11px] text-[#667085]">${slots.length} automation${slots.length > 1 ? "s" : ""}</span>
          </div>
          <div class="space-y-1.5">
            ${slots
              .map(
                (slot, idx) => `
              <div class="flex items-center justify-between p-2 rounded-lg bg-white border border-[#eaecf0]">
                <div class="flex items-center gap-2">
                  <i class="ti ${CONTENT_ICONS[slot.contentType] || "ti-file"} text-[12px] text-[#667085]"></i>
                  <span class="text-[11px] text-[#667085]">${slot.contentType}${slot.category ? " · " + escapeHtml(slot.category) : ""}${slot.variations > 1 ? " · " + slot.variations + "x" : ""}</span>
                </div>
                <div class="flex items-center gap-1">
                  <button onclick="editAutomation('${dateKey}', ${idx})" class="w-5 h-5 rounded hover:bg-[#EFF6FF] flex items-center justify-center text-[#98a2b3] hover:text-[#2563EB] cursor-pointer transition-colors" title="Edit">
                    <i class="ti ti-pencil text-[11px]"></i>
                  </button>
                  <button onclick="removeAutomation('${dateKey}', ${idx})" class="w-5 h-5 rounded hover:bg-[#FEF3F2] flex items-center justify-center text-[#98a2b3] hover:text-[#D92D20] cursor-pointer transition-colors" title="Remove">
                    <i class="ti ti-x text-[11px]"></i>
                  </button>
                </div>
              </div>
            `,
              )
              .join("")}
          </div>
        </div>
      `;
        })
        .join("");
    }

    // ═══════════════════════════════════════════
    // AUTO COMMENT MODAL
    // ═══════════════════════════════════════════
    function openCommentModal(autoId) {
      editingAutomationId = autoId;
      // We can be opening this from an automation or from generated content
      let source =
        automations.find((a) => a.id === autoId) ||
        generatedContent.find((g) => g.id === autoId);
      if (!source) return;

      const eng = source.autoEngagement || {
        deleteComment: false,
        replyComment: false,
        likeComment: false,
        dmComment: false,
        replyStory: false,
        replyDm: false,
      };

      document.getElementById("toggle-delete-comment").checked =
        eng.deleteComment;
      document.getElementById("toggle-reply-comment").checked =
        eng.replyComment;
      document.getElementById("toggle-like-comment").checked = eng.likeComment;
      document.getElementById("toggle-dm-comment").checked = eng.dmComment;
      document.getElementById("toggle-reply-story").checked = eng.replyStory;
      document.getElementById("toggle-reply-dm").checked = eng.replyDm;

      const modal = document.getElementById("modal-auto-engagement");
      if (modal) {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
      }
    }

    function closeCommentModal() {
      const modal = document.getElementById("modal-auto-engagement");
      if (modal) {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }

      // Contextual Back: If we came from preview, reopen it!
      const wasFromPrev = engOpenedFromPreview;
      const prevId = editingAutomationId;

      editingAutomationId = null;
      engOpenedFromPreview = false; // reset

      if (wasFromPrev && prevId) {
        // Small delay to ensure transition feels seamless replacement
        setTimeout(() => {
          if (typeof openPreviewModal === "function") {
            openPreviewModal(prevId);
          }
        }, 10);
      }
    }

    function saveComment() {
      if (!editingAutomationId) return;

      const eng = {
        deleteComment: document.getElementById("toggle-delete-comment").checked,
        replyComment: document.getElementById("toggle-reply-comment").checked,
        likeComment: document.getElementById("toggle-like-comment").checked,
        dmComment: document.getElementById("toggle-dm-comment").checked,
        replyStory: document.getElementById("toggle-reply-story").checked,
        replyDm: document.getElementById("toggle-reply-dm").checked,
      };

      const auto = automations.find((a) => a.id === editingAutomationId);
      if (auto) {
        auto.autoEngagement = eng;
        saveAutomations();
        renderAutomations();
      }

      const gen = generatedContent.find((g) => g.id === editingAutomationId);
      if (gen) {
        gen.autoEngagement = eng;
        saveGenerated();
        // Update preview modal indicator
        const indicator = document.getElementById(
          "preview-engagement-indicator",
        );
        if (indicator) {
          const isActive = Object.values(eng).some((v) => v);
          indicator.classList.toggle("hidden", !isActive);
          indicator.classList.toggle("flex", isActive);
        }
      }

      // Update single schedule engagement state and indicator
      singleScheduleEngagement = { ...eng };
      updateSingleScheduleEngagementIndicator();

      // Update bulk schedule engagement state and indicator
      bulkScheduleEngagement = { ...eng };
      updateBulkScheduleEngagementIndicator();

      closeCommentModal();
      showToast("Engagement settings saved successfully.", "success");
    }

    // ═══════════════════════════════════════════
    // AUTOMATION ACTIONS
    // ═══════════════════════════════════════════
    let pendingPauseAutoId = null;
    let pendingResumeAutoId = null;
    let pendingDeleteAutoId = null;

    function toggleAutomationStatus(id) {
      const auto = automations.find((a) => a.id === id);
      if (!auto) return;

      if (auto.status === "active") {
        // Prompt modal confirmation to pause
        pendingPauseAutoId = id;
        const modal = document.getElementById("modal-confirm-pause-automation");
        const nameEl = document.getElementById("confirm-pause-auto-name");
        if (nameEl) nameEl.textContent = auto.name || "this automation";
        if (modal) {
          modal.classList.remove("hidden");
          modal.classList.add("flex");
        }
      } else {
        // Prompt modal confirmation to resume
        pendingResumeAutoId = id;
        const modal = document.getElementById(
          "modal-confirm-resume-automation",
        );
        const nameEl = document.getElementById("confirm-resume-auto-name");
        if (nameEl) nameEl.textContent = auto.name || "this automation";
        if (modal) {
          modal.classList.remove("hidden");
          modal.classList.add("flex");
        }
      }
    }

    function closePauseModal() {
      pendingPauseAutoId = null;
      const modal = document.getElementById("modal-confirm-pause-automation");
      if (modal) {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }
    }

    function confirmPauseAutomation() {
      if (!pendingPauseAutoId) return;
      const auto = automations.find((a) => a.id === pendingPauseAutoId);
      if (auto) {
        auto.status = "paused";
        saveAutomations();
        renderAutomations();
        showToast(
          `Automation "${auto.name}" has been paused.`,
          "warning",
          "Automation Paused",
        );
      }
      closePauseModal();
    }

    function closeResumeModal() {
      pendingResumeAutoId = null;
      const modal = document.getElementById("modal-confirm-resume-automation");
      if (modal) {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }
    }

    function confirmResumeAutomation() {
      if (!pendingResumeAutoId) return;
      const auto = automations.find((a) => a.id === pendingResumeAutoId);
      if (auto) {
        auto.status = "active";
        saveAutomations();
        renderAutomations();
        showToast(
          `Automation "${auto.name}" is now active and running.`,
          "success",
          "Automation Resumed",
        );
      }
      closeResumeModal();
    }

    function deleteAutomation(id) {
      const auto = automations.find((a) => a.id === id);
      if (!auto) return;

      pendingDeleteAutoId = id;
      const modal = document.getElementById("modal-confirm-delete-automation");
      const nameEl = document.getElementById("confirm-delete-auto-name");
      if (nameEl) nameEl.textContent = auto.name || "this automation";
      if (modal) {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
      }
    }

    function closeDeleteModal() {
      pendingDeleteAutoId = null;
      const modal = document.getElementById("modal-confirm-delete-automation");
      if (modal) {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }
    }

    function confirmDeleteAutomation() {
      if (!pendingDeleteAutoId) return;
      const auto = automations.find((a) => a.id === pendingDeleteAutoId);
      const autoName = auto ? auto.name : "Automation";
      automations = automations.filter((a) => a.id !== pendingDeleteAutoId);
      saveAutomations();
      renderAutomations();
      closeDeleteModal();
      showToast(
        `Automation "${autoName}" has been permanently removed.`,
        "destructive",
        "Automation Deleted",
      );
    }

    function startAutomation() {
      if (!wizardData.name) {
        showToast(
          "Please enter a task name.",
          "warning",
          "Missing Information",
        );
        return;
      }
      if (!wizardData.dna) {
        showToast(
          "Please select a Business DNA.",
          "warning",
          "Missing Information",
        );
        return;
      }
      if (Object.keys(wizardData.selectedDates).length === 0) {
        showToast(
          "Please select at least one date in the schedule.",
          "warning",
          "Schedule Empty",
        );
        return;
      }

      if (editingAutoId) {
        const idx = automations.findIndex((a) => a.id === editingAutoId);
        if (idx !== -1) {
          automations[idx].name = wizardData.name;
          automations[idx].dna = wizardData.dna;
          automations[idx].recurring = wizardData.recurring;
          automations[idx].selectedDates = JSON.parse(
            JSON.stringify(wizardData.selectedDates),
          );
        }
        showToast(
          `Changes to automation "${wizardData.name}" have been saved successfully.`,
          "success",
          "Automation Saved",
        );
      } else {
        const newAuto = {
          id: "auto_" + Date.now(),
          name: wizardData.name,
          dna: wizardData.dna,
          recurring: wizardData.recurring,
          selectedDates: JSON.parse(JSON.stringify(wizardData.selectedDates)),
          status: "active",
          createdAt: new Date().toISOString(),
        };
        automations.push(newAuto);
        showToast(
          `Automation "${wizardData.name}" has been created and scheduled.`,
          "success",
          "Automation Created",
        );
      }
      saveAutomations();
      renderAutomations();
      closeAddModal();
    }

    // ═══════════════════════════════════════════
    // MODAL OPEN/CLOSE
    // ═══════════════════════════════════════════
    function openAddModal() {
      editingAutoId = null;
      const titleEl = document.getElementById("wizard-title");
      if (titleEl) titleEl.textContent = "Create Automation";
      const btnStart = document.getElementById("btn-start-automation");
      if (btnStart) btnStart.textContent = "Start Automation";
      // Reset wizard
      wizardData = {
        name: "",
        dna: null,
        selectedDates: {},
        recurring: "once",
        repeatFor: 3,
        scheduleMode: "monthly",
        currentWeekDate: (() => {
          const d = new Date();
          d.setDate(d.getDate() - d.getDay());
          d.setHours(0, 0, 0, 0);
          return d;
        })(),
      };
      currentStep = 1;
      currentCalendarDate = new Date(
        new Date().getFullYear(),
        new Date().getMonth(),
        1,
      );

      // Reset inputs
      els.inputName.value = "";
      els.dnaSelectedName.textContent = "Select Business DNA";
      els.dnaSelectedDesc.textContent =
        "Choose a business profile for AI grounding";
      if (els.dnaSelectedLogo) els.dnaSelectedLogo.classList.add("hidden");
      if (els.dnaSelectedIcon) els.dnaSelectedIcon.classList.remove("hidden");
      els.recurringRadios.forEach((r) => {
        r.checked = r.value === "once";
      });
      els.recurringInfo.textContent =
        "Content will be generated once on selected dates.";
      if (els.repeatForSelect) els.repeatForSelect.value = "3";
      els.repeatForWrapper.classList.add("hidden");
      els.weeklyRepeatWrapper.classList.add("hidden");
      els.recurringPreview.classList.add("hidden");

      // Reset schedule mode toggle
      setScheduleMode("monthly");

      renderCalendar();
      renderWeeklyCalendar();
      goToStep(1);

      els.modalAdd.classList.remove("hidden");
      els.modalAdd.classList.add("flex");
    }

    function closeAddModal() {
      els.modalAdd.classList.add("hidden");
      els.modalAdd.classList.remove("flex");
      closeAutomationPopover();
      closeDateDetailPopover();
    }

    // ═══════════════════════════════════════════
    // EVENT BINDING
    // ═══════════════════════════════════════════
    function bindEvents() {
      // Open modal
      els.btnAdd.addEventListener("click", openAddModal);
      els.btnEmptyAdd.addEventListener("click", openAddModal);

      // Resume Confirmation Modal
      const btnCancelResume = document.getElementById("btn-cancel-resume-auto");
      if (btnCancelResume)
        btnCancelResume.addEventListener("click", closeResumeModal);
      const btnConfirmResume = document.getElementById(
        "btn-confirm-resume-auto",
      );
      if (btnConfirmResume)
        btnConfirmResume.addEventListener("click", confirmResumeAutomation);
      const modalResume = document.getElementById(
        "modal-confirm-resume-automation",
      );
      if (modalResume) {
        modalResume.addEventListener("click", (e) => {
          if (e.target === modalResume) closeResumeModal();
        });
      }

      // Pause Confirmation Modal
      const btnCancelPause = document.getElementById("btn-cancel-pause-auto");
      if (btnCancelPause)
        btnCancelPause.addEventListener("click", closePauseModal);
      const btnConfirmPause = document.getElementById("btn-confirm-pause-auto");
      if (btnConfirmPause)
        btnConfirmPause.addEventListener("click", confirmPauseAutomation);
      const modalPause = document.getElementById(
        "modal-confirm-pause-automation",
      );
      if (modalPause) {
        modalPause.addEventListener("click", (e) => {
          if (e.target === modalPause) closePauseModal();
        });
      }

      // Delete Confirmation Modal
      const btnCancelDelete = document.getElementById("btn-cancel-delete-auto");
      if (btnCancelDelete)
        btnCancelDelete.addEventListener("click", closeDeleteModal);
      const btnConfirmDelete = document.getElementById(
        "btn-confirm-delete-auto",
      );
      if (btnConfirmDelete)
        btnConfirmDelete.addEventListener("click", confirmDeleteAutomation);
      const modalDelete = document.getElementById(
        "modal-confirm-delete-automation",
      );
      if (modalDelete) {
        modalDelete.addEventListener("click", (e) => {
          if (e.target === modalDelete) closeDeleteModal();
        });
      }

      // Preview Schedule Business DNA selector listener for social accounts visibility
      const previewSelectBusinessDna = document.getElementById(
        "preview-select-business-dna",
      );
      const previewSocialAccountsContainer = document.getElementById(
        "preview-social-accounts-container",
      );
      if (previewSelectBusinessDna && previewSocialAccountsContainer) {
        previewSelectBusinessDna.addEventListener("change", () => {
          if (previewSelectBusinessDna.value !== "none") {
            previewSocialAccountsContainer.classList.remove("hidden");
          } else {
            previewSocialAccountsContainer.classList.add("hidden");
          }
        });
      }

      // Close modal
      els.closeAddModal.addEventListener("click", closeAddModal);
      els.modalAdd.addEventListener("click", (e) => {
        if (e.target === els.modalAdd) closeAddModal();
      });

      // Wizard navigation
      els.btnBack.addEventListener("click", () => {
        if (currentStep > 1) goToStep(currentStep - 1);
      });
      els.btnNext.addEventListener("click", () => {
        if (validateStep(currentStep) && currentStep < 3)
          goToStep(currentStep + 1);
      });
      els.btnStart.addEventListener("click", () => {
        if (validateStep(3)) startAutomation();
      });

      // Step 1 inputs
      els.inputName.addEventListener("input", (e) => {
        wizardData.name = e.target.value;
      });

      // DNA dropdown
      els.btnSelectDna.addEventListener("click", (e) => {
        e.stopPropagation();
        els.dnaDropdown.classList.toggle("hidden");
      });
      document.addEventListener("click", (e) => {
        if (
          !els.dnaDropdown.contains(e.target) &&
          e.target !== els.btnSelectDna
        ) {
          els.dnaDropdown.classList.add("hidden");
        }
      });
      document.querySelectorAll(".dna-option").forEach((opt) => {
        opt.addEventListener("click", () => {
          const logo = opt.dataset.logo || getDnaLogo(opt.dataset.name);
          wizardData.dna = {
            name: opt.dataset.name,
            desc: opt.dataset.desc,
            logo,
          };
          els.dnaSelectedName.textContent = opt.dataset.name;
          els.dnaSelectedDesc.textContent = opt.dataset.desc;
          if (els.dnaSelectedLogo) {
            els.dnaSelectedLogo.src = logo;
            els.dnaSelectedLogo.classList.remove("hidden");
          }
          if (els.dnaSelectedIcon) {
            els.dnaSelectedIcon.classList.add("hidden");
          }
          els.dnaDropdown.classList.add("hidden");
        });
      });

      // Calendar navigation
      els.calPrev.addEventListener("click", () => {
        currentCalendarDate.setMonth(currentCalendarDate.getMonth() - 1);
        renderCalendar();
      });
      els.calNext.addEventListener("click", () => {
        currentCalendarDate.setMonth(currentCalendarDate.getMonth() + 1);
        renderCalendar();
      });

      // Schedule mode toggle (Monthly / Weekly)
      if (els.btnModeMonthly && els.btnModeWeekly) {
        els.btnModeMonthly.addEventListener("click", () => {
          setScheduleMode("monthly");
        });
        els.btnModeWeekly.addEventListener("click", () => {
          setScheduleMode("weekly");
        });
      }

      // Weekly calendar navigation
      if (els.calWeekPrev) {
        els.calWeekPrev.addEventListener("click", () => {
          wizardData.currentWeekDate.setDate(
            wizardData.currentWeekDate.getDate() - 7,
          );
          renderWeeklyCalendar();
        });
      }
      if (els.calWeekNext) {
        els.calWeekNext.addEventListener("click", () => {
          wizardData.currentWeekDate.setDate(
            wizardData.currentWeekDate.getDate() + 7,
          );
          renderWeeklyCalendar();
        });
      }

      // AI Suggestion
      if (els.btnAiSuggestion) {
        els.btnAiSuggestion.addEventListener("click", applyAiSuggestion);
      }
      if (els.btnAiSuggestionWeekly) {
        els.btnAiSuggestionWeekly.addEventListener(
          "click",
          applyAiSuggestionWeekly,
        );
      }

      // Recurring
      els.recurringRadios.forEach((radio) => {
        radio.addEventListener("change", (e) => {
          wizardData.recurring = e.target.value;
          if (e.target.value === "once") {
            els.recurringInfo.textContent =
              "Content will be generated once on selected dates.";
            els.repeatForWrapper.classList.add("hidden");
            els.weeklyRepeatWrapper.classList.add("hidden");
            els.recurringPreview.classList.add("hidden");
          } else if (e.target.value === "monthly") {
            els.recurringInfo.textContent =
              "Selected dates will repeat every month. If a date doesn't exist in a month, it will be scheduled on the last day of that month.";
            els.repeatForWrapper.classList.remove("hidden");
            els.weeklyRepeatWrapper.classList.add("hidden");
            els.recurringPreview.classList.remove("hidden");
            renderRecurringPreview();
          } else if (e.target.value === "weekly") {
            els.recurringInfo.textContent =
              "Content will repeat every week on the selected days.";
            els.repeatForWrapper.classList.remove("hidden");
            els.weeklyRepeatWrapper.classList.remove("hidden");
            els.recurringPreview.classList.remove("hidden");
            renderRecurringPreview();
          }
        });
      });

      // Repeat for input
      if (els.repeatForSelect) {
        els.repeatForSelect.addEventListener("change", (e) => {
          let val = parseInt(e.target.value) || 3;
          val = Math.max(1, Math.min(12, val));
          wizardData.repeatFor = val;
          e.target.value = val;
          renderRecurringPreview();
        });
      }

      // Content type description
      if (els.slotContentType && els.contentTypeDesc) {
        els.slotContentType.addEventListener("change", (e) => {
          els.contentTypeDesc.textContent =
            CONTENT_TYPE_DESCS[e.target.value] || "";
        });
      }

      // Automation popover
      if (els.closeSlotPopover)
        els.closeSlotPopover.addEventListener("click", closeAutomationPopover);
      if (els.btnAddSlot)
        els.btnAddSlot.addEventListener("click", addAutomation);

      // Automation References Dropdown
      if (els.btnAutomationReferences && els.automationReferencesDropdown) {
        els.btnAutomationReferences.addEventListener("click", (e) => {
          e.stopPropagation();
          els.automationReferencesDropdown.classList.toggle("hidden");
        });
        document.addEventListener("click", (e) => {
          if (
            !els.automationReferencesDropdown.contains(e.target) &&
            e.target !== els.btnAutomationReferences
          ) {
            els.automationReferencesDropdown.classList.add("hidden");
          }
        });
      }
      if (els.btnAutomationAddLocal && els.automationLocalFileInput) {
        els.btnAutomationAddLocal.addEventListener("click", () => {
          els.automationLocalFileInput.click();
          els.automationReferencesDropdown.classList.add("hidden");
        });
        els.automationLocalFileInput.addEventListener("change", () => {
          if (
            els.automationLocalFileInput.files &&
            els.automationLocalFileInput.files.length > 0
          ) {
            Array.from(els.automationLocalFileInput.files).forEach((file) => {
              addAutomationRefTag(file.name);
            });
            els.automationLocalFileInput.value = "";
          }
        });
      }
      if (els.btnAutomationAddCatalog) {
        els.btnAutomationAddCatalog.addEventListener("click", () => {
          const referencesModal = document.getElementById("references-modal");
          if (referencesModal) {
            referencesModal.classList.remove("hidden");
            els.automationReferencesDropdown.classList.add("hidden");
          }
        });
      }

      // Catalog modal submit handler for automation popover
      const referencesModal = document.getElementById("references-modal");
      if (referencesModal) {
        const submitRefsBtn = referencesModal.querySelector(".btn-active-dark");
        const selectedRefs = new Set();
        const refItems = referencesModal.querySelectorAll(".ref-item");

        refItems.forEach((item) => {
          item.addEventListener("click", () => {
            const id = item.getAttribute("data-id");
            const overlay = item.querySelector(".selected-overlay");
            if (selectedRefs.has(id)) {
              selectedRefs.delete(id);
              overlay.classList.add("hidden");
            } else {
              selectedRefs.add(id);
              overlay.classList.remove("hidden");
            }
          });
        });

        if (submitRefsBtn) {
          submitRefsBtn.addEventListener("click", () => {
            selectedRefs.forEach((id) => {
              const item = referencesModal.querySelector(
                `.ref-item[data-id="${id}"]`,
              );
              if (item) {
                const name = item.getAttribute("data-name");
                addAutomationRefTag(name);
              }
            });
            selectedRefs.clear();
            refItems.forEach((i) =>
              i.querySelector(".selected-overlay").classList.add("hidden"),
            );
            referencesModal.classList.add("hidden");
          });
        }

        const closeRefs = document.getElementById("close-references");
        const cancelRefs = document.getElementById("cancel-references");
        const closeModal = () => {
          referencesModal.classList.add("hidden");
          selectedRefs.clear();
          refItems.forEach((i) =>
            i.querySelector(".selected-overlay").classList.add("hidden"),
          );
        };
        if (closeRefs) closeRefs.addEventListener("click", closeModal);
        if (cancelRefs) cancelRefs.addEventListener("click", closeModal);
        referencesModal.addEventListener("click", (e) => {
          if (e.target === referencesModal) closeModal();
        });
      }

      // Date detail popover
      if (els.closeDateDetailPopover)
        els.closeDateDetailPopover.addEventListener(
          "click",
          closeDateDetailPopover,
        );
      if (els.btnAddNewAutomation)
        els.btnAddNewAutomation.addEventListener("click", () => {
          const dKey = activePopoverDate;
          closeDateDetailPopover();
          if (dKey) {
            const btn = getDayButton(dKey);
            if (btn) openAutomationPopover(dKey, btn);
          }
        });

      // Dismiss popovers on outside click
      document.addEventListener("click", (e) => {
        if (
          els.dateDetailPopover &&
          !els.dateDetailPopover.classList.contains("hidden") &&
          !els.dateDetailPopover.contains(e.target) &&
          !e.target.closest(".cal-day") &&
          !e.target.closest(".cal-week-day")
        ) {
          closeDateDetailPopover();
        }

        if (
          els.slotPopover &&
          !els.slotPopover.classList.contains("hidden") &&
          !els.slotPopover.contains(e.target) &&
          (!els.dateDetailPopover ||
            !els.dateDetailPopover.contains(e.target)) &&
          !e.target.closest(".cal-day") &&
          !e.target.closest(".cal-week-day")
        ) {
          closeAutomationPopover();
        }
      });

      // Variations +/-
      els.btnVarMinus.addEventListener("click", () => {
        const val = parseInt(els.automationVariations.value) || 1;
        els.automationVariations.value = Math.max(1, val - 1);
      });
      els.btnVarPlus.addEventListener("click", () => {
        const val = parseInt(els.automationVariations.value) || 1;
        els.automationVariations.value = Math.min(10, val + 1);
      });
      els.automationVariations.addEventListener("change", () => {
        const val = parseInt(els.automationVariations.value) || 1;
        els.automationVariations.value = Math.max(1, Math.min(10, val));
      });

      // Engagement / Auto Comment Modal Listeners (Enhanced flow)
      if (els.closeEngagementModal)
        els.closeEngagementModal.addEventListener("click", closeCommentModal);
      if (els.btnCancelEngagement)
        els.btnCancelEngagement.addEventListener("click", closeCommentModal);
      if (els.btnSaveEngagement)
        els.btnSaveEngagement.addEventListener("click", saveComment);

      // Back buttons in engagement modal (properly routed to support back tracking)
      const btnBackEngagement = document.getElementById("btn-back-engagement");
      const btnBackEngagementFooter = document.getElementById(
        "btn-back-engagement-footer",
      );

      if (btnBackEngagement) {
        btnBackEngagement.addEventListener("click", closeCommentModal);
      }
      if (btnBackEngagementFooter) {
        btnBackEngagementFooter.addEventListener("click", closeCommentModal);
      }

      if (els.modalEngagement) {
        els.modalEngagement.addEventListener("click", (e) => {
          if (e.target === els.modalEngagement) closeCommentModal();
        });
      }
      if (els.commentToggle) {
        els.commentToggle.addEventListener("change", (e) => {
          if (els.commentFields)
            els.commentFields.classList.toggle("hidden", !e.target.checked);
        });
      }
      if (els.dmToggle) {
        els.dmToggle.addEventListener("change", (e) => {
          if (els.dmFields)
            els.dmFields.classList.toggle("hidden", !e.target.checked);
        });
      }

      // Schedule modal
      if (els.closeScheduleModal)
        els.closeScheduleModal.addEventListener("click", closeScheduleModalFn);
      if (els.btnCancelScheduleModal)
        els.btnCancelScheduleModal.addEventListener(
          "click",
          closeScheduleModalFn,
        );
      if (els.btnConfirmSchedule)
        els.btnConfirmSchedule.addEventListener("click", confirmSchedule);
      if (els.btnPublishNow)
        els.btnPublishNow.addEventListener("click", publishNow);
      if (els.btnPublish1h)
        els.btnPublish1h.addEventListener("click", publishIn1Hour);
      if (els.modalSchedule) {
        els.modalSchedule.addEventListener("click", (e) => {
          if (e.target === els.modalSchedule) closeScheduleModalFn();
        });
      }

      // Business filter dropdown
      const btnBusinessFilter = document.getElementById("btn-business-filter");
      const businessFilterDropdown = document.getElementById(
        "business-filter-dropdown",
      );
      if (btnBusinessFilter && businessFilterDropdown) {
        btnBusinessFilter.addEventListener("click", (e) => {
          e.stopPropagation();
          businessFilterDropdown.classList.toggle("hidden");
        });
        document.addEventListener("click", (e) => {
          if (
            !businessFilterDropdown.contains(e.target) &&
            e.target !== btnBusinessFilter
          ) {
            businessFilterDropdown.classList.add("hidden");
          }
        });
        document.querySelectorAll(".business-filter-option").forEach((opt) => {
          opt.addEventListener("click", () => {
            const brand = opt.dataset.brand;
            document.getElementById("business-filter-label").textContent =
              brand === "all" ? "All Business" : brand;
            businessFilterDropdown.classList.add("hidden");
            // Filter automations
            if (brand === "all") {
              renderAutomations();
            } else {
              const filtered = automations.filter((a) => a.dna?.name === brand);
              renderAutomations(filtered);
            }
          });
        });
      }

      // Automation search
      const automationSearch = document.getElementById("automation-search");
      if (automationSearch) {
        automationSearch.addEventListener("input", (e) => {
          const query = e.target.value.toLowerCase();
          const rows = els.tbody.querySelectorAll("tr");
          rows.forEach((row) => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(query) ? "" : "none";
          });
        });
      }

      // Tab switching
      els.tabAutomations.addEventListener("click", () =>
        switchTab("automations"),
      );
      els.tabGenerated.addEventListener("click", () => switchTab("generated"));
      els.tabScheduled.addEventListener("click", () => switchTab("scheduled"));

      const btnDraftShowMore = document.getElementById("btn-draft-show-more");
      if (btnDraftShowMore) {
        btnDraftShowMore.addEventListener("click", () => {
          draftLimit += 10;
          renderGenerated();
        });
      }

      // ── Scheduled Tab: Filter ──
      if (els.btnScheduledFilter && els.scheduledFilterDropdown) {
        els.btnScheduledFilter.addEventListener("click", (e) => {
          e.stopPropagation();
          els.scheduledFilterDropdown.classList.toggle("hidden");
        });
        document.addEventListener("click", (e) => {
          if (
            !els.scheduledFilterDropdown.contains(e.target) &&
            e.target !== els.btnScheduledFilter
          ) {
            els.scheduledFilterDropdown.classList.add("hidden");
          }
        });
        document.querySelectorAll(".scheduled-filter-option").forEach((opt) => {
          opt.addEventListener("click", () => {
            scheduledFilter = opt.dataset.filter;
            els.scheduledFilterLabel.textContent = opt.textContent;
            els.scheduledFilterDropdown.classList.add("hidden");
            renderScheduled();
          });
        });
      }

      // ── Scheduled Tab: Search ──
      if (els.scheduledSearch) {
        els.scheduledSearch.addEventListener("input", (e) => {
