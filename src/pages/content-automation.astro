    // ═══════════════════════════════════════════
    // SCHEDULED TAB
    // ═══════════════════════════════════════════
    function renderScheduled() {
      // Get scheduled/published items from generatedContent based on status filter
      let scheduled = generatedContent.filter((item) => {
        if (scheduledStatusFilter === "all") {
          return item.status === "scheduled" || item.status === "published";
        }
        return item.status === scheduledStatusFilter;
      });

      // Apply search
      if (scheduledSearchQuery) {
        const q = scheduledSearchQuery.toLowerCase();
        scheduled = scheduled.filter((item) => {
          const haystack =
            `${item.title} ${item.brand} ${item.platform} ${item.contentType}`.toLowerCase();
          return haystack.includes(q);
        });
      }

      // Sort by scheduledAt / publishedAt ascending
      scheduled.sort((a, b) => {
        const dateA = new Date(
          a.status === "published"
            ? a.publishedAt || a.scheduledAt
            : a.scheduledAt || a.publishedAt,
        );
        const dateB = new Date(
          b.status === "published"
            ? b.publishedAt || b.scheduledAt
            : b.scheduledAt || b.publishedAt,
        );
        return dateA - dateB;
      });

      // Update badge
      const now = new Date();
      const upcomingCount = generatedContent.filter(
        (g) => g.status === "scheduled" && new Date(g.scheduledAt) >= now,
      ).length;
      els.scheduledBadge.textContent = upcomingCount;
      els.scheduledBadge.classList.toggle("hidden", upcomingCount === 0);
      if (currentMainTab === "scheduled")
        setTimeout(() => updateMainTabIndicator(), 20);
      if (els.scheduledCountDisplay)
        els.scheduledCountDisplay.textContent = scheduled.length;

      // Toggle visibility of view containers
      const hasItems = scheduled.length > 0;
      const isListView =
        scheduledViewMode === "list" || scheduledViewMode === "daily";
      els.scheduledTimeline.classList.toggle(
        "hidden",
        !hasItems || !isListView,
      );
      els.scheduledMonthly.classList.toggle(
        "hidden",
        !hasItems || scheduledViewMode !== "monthly",
      );
      els.scheduledWeekly.classList.toggle(
        "hidden",
        !hasItems || scheduledViewMode !== "weekly",
      );
      els.scheduledEmpty.classList.toggle("hidden", hasItems);

      if (!hasItems) return;

      if (isListView) {
        renderScheduledList(scheduled);
      } else if (scheduledViewMode === "monthly") {
        renderScheduledMonthly(scheduled);
      } else if (scheduledViewMode === "weekly") {
        renderScheduledWeekly(scheduled);
      }
    }

    function renderScheduledList(scheduled) {
      // Group by date (use publishedAt for published items, scheduledAt for others)
      const grouped = {};
      scheduled.forEach((item) => {
        const dateField =
          item.status === "published"
            ? item.publishedAt || item.scheduledAt
            : item.scheduledAt || item.publishedAt;
        if (!dateField) return;
        const dateKey = new Date(dateField).toLocaleDateString("en-US", {
          weekday: "long",
          year: "numeric",
          month: "long",
          day: "numeric",
        });
        if (!grouped[dateKey]) grouped[dateKey] = [];
        grouped[dateKey].push(item);
      });

      const platformIconMap = {
        Facebook: "ti-brand-facebook",
        Threads: "ti-brand-threads",
        Instagram: "ti-brand-instagram",
        TikTok: "ti-brand-tiktok",
      };

      const contentTypeIconMap = {
        "Single Post": "ti-photo",
        Carousel: "ti-carousel-horizontal",
        "Ad Creatives": "ti-speakerphone",
        Story: "ti-device-mobile",
      };

      const now = new Date();

      els.scheduledTimeline.innerHTML = Object.entries(grouped)
        .map(([dateKey, items]) => {
          const firstDateVal =
            items[0].status === "published"
              ? items[0].publishedAt || items[0].scheduledAt
              : items[0].scheduledAt || items[0].publishedAt;
          const dateObj = new Date(firstDateVal);
          const isToday = dateObj.toDateString() === new Date().toDateString();
          const isTomorrow =
            dateObj.toDateString() ===
            new Date(now.getTime() + 24 * 60 * 60 * 1000).toDateString();

          let dateLabel = dateKey;
          if (isToday) dateLabel = "Today";
          if (isTomorrow) dateLabel = "Tomorrow";

          const timeStr = dateObj.toLocaleTimeString("en-US", {
            hour: "2-digit",
            minute: "2-digit",
          });

          return `
        <div class="pb-5 last:pb-0">
          <div class="flex items-center gap-3 mb-2">
            <h3 class="text-[13px] font-semibold text-[#18181b]">${dateLabel}</h3>
            ${isToday ? `<span class="px-2 h-4.5 rounded-md bg-purple-50 text-purple-700 text-[10px] font-medium flex items-center border border-purple-200">Today</span>` : ""}
          </div>
          <div class="space-y-2">
            ${items
              .map((item) => {
                const platformIcon =
                  platformIconMap[item.platform] || "ti-file";
                const typeIcon =
                  contentTypeIconMap[item.contentType] || "ti-file";
                const itemDateVal =
                  item.status === "published"
                    ? item.publishedAt || item.scheduledAt
                    : item.scheduledAt || item.publishedAt;
                const timeItem = new Date(itemDateVal).toLocaleTimeString(
                  "en-US",
                  {
                    hour: "2-digit",
                    minute: "2-digit",
                  },
                );
                const isPublished = item.status === "published";

                const isStory = item.contentType === "Story";
                const aspectClass = isStory ? "aspect-[9/16]" : "aspect-[3/4]";

                return `
              <div class="group flex items-center gap-3 bg-white rounded-xl border border-[#eaecf0] p-2.5 hover:shadow-2xs hover:border-[#18181b] transition-all cursor-pointer relative" onclick="openPreviewModal('${item.id}')">
                <!-- Tiny Image Placeholder -->
                <div class="w-10 h-10 shrink-0 bg-[#18181b] rounded-lg flex items-center justify-center overflow-hidden">
                   <i class="ti ${typeIcon} text-[16px] text-white/50"></i>
                </div>
                
                <!-- Info -->
                <div class="flex-1 min-w-0 flex flex-col justify-center gap-0.5">
                  <div class="flex items-center gap-2">
                     <span class="text-[12px] font-semibold text-[#18181b] truncate">${escapeHtml(item.brand)}</span>
                     <span class="w-1 h-1 rounded-full bg-[#eaecf0]"></span>
                     <span class="text-[11px] font-medium text-[#71717a] flex items-center gap-1">
                       <i class="ti ${platformIcon} text-[12px]"></i> ${item.platform}
                     </span>
                     <span class="w-1 h-1 rounded-full bg-[#eaecf0]"></span>
                     <span class="text-[11px] font-medium text-[#71717a]">${escapeHtml(item.contentType)}</span>
                     ${
                       item.autoEngagement &&
                       Object.values(item.autoEngagement).some((v) => v)
                         ? `
                     <span class="inline-flex items-center gap-1 px-1.5 h-4 rounded-md bg-emerald-600 text-[9px] font-medium text-white shadow-xs" title="Engagement settings active">
                       ${STATUS_ICON_CHECK} Engagement
                     </span>
                     `
                         : ""
                     }
                  </div>
                  <p class="text-[11px] text-[#71717a] line-clamp-1">${escapeHtml(item.caption || "No caption")}</p>
                </div>
                
                <!-- Right Actions: Time on left, buttons on hover -->
                <div class="flex items-center gap-2 shrink-0">
                  <div class="flex items-center gap-1.5 opacity-0 group-hover:opacity-100 transition-opacity">
                    <button class="w-7 h-7 rounded-lg border border-[#eaecf0] bg-white text-[#71717a] hover:text-[#18181b] hover:bg-[#f4f4f5] flex items-center justify-center transition-all cursor-pointer shadow-2xs" onclick="event.stopPropagation(); openPreviewModal('${item.id}')" title="Preview">
                      <i class="ti ti-eye text-[14px]"></i>
                    </button>
                    ${
                      !isPublished
                        ? `
                    <button class="w-7 h-7 rounded-lg border border-[#eaecf0] bg-white text-[#71717a] hover:text-red-600 hover:bg-red-50 hover:border-red-200 flex items-center justify-center transition-all cursor-pointer shadow-2xs" onclick="event.stopPropagation(); cancelScheduleItem('${item.id}')" title="Cancel Schedule">
                      <i class="ti ti-x text-[14px]"></i>
                    </button>
                    `
                        : ""
                    }
                  </div>
                  <span class="text-[11px] font-medium text-[#18181b] whitespace-nowrap">${timeItem}</span>
                </div>
              </div>
            `;
              })
              .join("")}
          </div>
        </div>
      `;
        })
        .join("");
    }

    function renderScheduledMonthly(scheduled) {
      const year = scheduledMonthDate.getFullYear();
      const month = scheduledMonthDate.getMonth();

      els.calMonthLabel.textContent = scheduledMonthDate.toLocaleDateString(
        "en-US",
        {
          month: "long",
          year: "numeric",
        },
      );

      const firstDay = new Date(year, month, 1);
      const lastDay = new Date(year, month + 1, 0);
      const daysInMonth = lastDay.getDate();
      const startDayOfWeek = firstDay.getDay();

      // Build a map of scheduled and published items by day
      const itemsByDay = {};
      scheduled.forEach((item) => {
        const dateField =
          item.status === "published"
            ? item.publishedAt || item.scheduledAt
            : item.scheduledAt || item.publishedAt;
        if (!dateField) return;
        const d = new Date(dateField);
        if (d.getFullYear() === year && d.getMonth() === month) {
          const day = d.getDate();
          if (!itemsByDay[day]) itemsByDay[day] = [];
          itemsByDay[day].push(item);
        }
      });

      const today = new Date();
      const isCurrentMonth =
        today.getFullYear() === year && today.getMonth() === month;

      let html = "";
      // Empty cells before the first day
      for (let i = 0; i < startDayOfWeek; i++) {
        html += `<div class="aspect-square rounded-xl"></div>`;
      }

      for (let day = 1; day <= daysInMonth; day++) {
        const isToday = isCurrentMonth && day === today.getDate();
        const dayItems = itemsByDay[day] || [];
        const hasItems = dayItems.length > 0;
        const dateKey = `${year}-${String(month + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;

        html += `
        <div class="aspect-square p-2 rounded-xl border ${isToday ? "border-[#18181b] bg-[#fafafa]" : "border-[#eaecf0] bg-white"} flex flex-col gap-1 cursor-pointer hover:shadow-2xs hover:border-[#18181b] transition-all" onclick="event.preventDefault(); event.stopPropagation(); openCalendarDayModal('${dateKey}'); return false;">
          <div class="flex items-center justify-between">
            <span class="text-[13px] font-semibold ${isToday ? "text-[#18181b]" : "text-[#71717a]"}">${day}</span>
            ${
              hasItems
                ? (() => {
                    const allPublished = dayItems.every(
                      (i) => i.status === "published",
                    );
                    const dotColor = allPublished
                      ? "bg-emerald-500"
                      : "bg-[#18181b]";
                    return `<span class="w-2 h-2 rounded-full ${dotColor}"></span>`;
                  })()
                : ""
            }
          </div>
          ${dayItems
            .slice(0, 2)
            .map((item) => {
              const isPublished = item.status === "published";
              return `
            <div class="px-1.5 py-0.5 rounded-md ${isPublished ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-[#18181b] text-white border border-[#18181b]"} text-[9px] font-medium truncate leading-tight">
              ${escapeHtml(item.title)}
            </div>
          `;
            })
            .join("")}
          ${dayItems.length > 2 ? `<div class="px-1.5 py-0.5 text-[9px] text-[#71717a]">+${dayItems.length - 2} more</div>` : ""}
        </div>
      `;
      }

      els.calMonthGrid.innerHTML = html;
    }

    function renderScheduledWeekly(scheduled) {
      // Get the start of the week (Sunday)
      const weekStart = getStartOfWeek(scheduledWeekDate);

      const weekEnd = new Date(weekStart);
      weekEnd.setDate(weekEnd.getDate() + 6);
      weekEnd.setHours(23, 59, 59, 999);

      els.schedCalWeekLabel.textContent = `${weekStart.toLocaleDateString("en-US", { month: "short", day: "numeric" })} – ${weekEnd.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}`;

      const today = new Date();
      today.setHours(0, 0, 0, 0);

      // Build a map of scheduled items by day
      const itemsByDay = {};
      scheduled.forEach((item) => {
        const dateField =
          item.status === "published"
            ? item.publishedAt || item.scheduledAt
            : item.scheduledAt || item.publishedAt;
        if (!dateField) return;
        const d = new Date(dateField);
        // Find which day of this week it belongs to
        for (let i = 0; i < 7; i++) {
          const checkDay = new Date(weekStart);
          checkDay.setDate(checkDay.getDate() + i);
          if (d.toDateString() === checkDay.toDateString()) {
            if (!itemsByDay[i]) itemsByDay[i] = [];
            itemsByDay[i].push(item);
            break;
          }
        }
      });

      const dayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

      let html = "";
      for (let i = 0; i < 7; i++) {
        const dayDate = new Date(weekStart);
        dayDate.setDate(dayDate.getDate() + i);
        const isToday = dayDate.toDateString() === new Date().toDateString();
        const isPast = dayDate < today;
        const dayItems = itemsByDay[i] || [];
        const hasItems = dayItems.length > 0;
        const dateKey = `${dayDate.getFullYear()}-${String(dayDate.getMonth() + 1).padStart(2, "0")}-${String(dayDate.getDate()).padStart(2, "0")}`;

        html += `
        <div class="flex flex-col gap-2">
          <!-- Date Header -->
          <div class="text-center p-3 rounded-xl bg-white border ${isToday ? "border-[#18181b] ring-1 ring-[#18181b]" : "border-[#eaecf0]"} ${isPast ? "opacity-70" : ""} cursor-pointer hover:bg-[#fafafa] hover:border-[#18181b] hover:shadow-2xs transition-all active:scale-[0.98]" onclick="event.preventDefault(); event.stopPropagation(); openCalendarDayModal('${dateKey}'); return false;">
            <div class="text-[11px] font-medium ${isToday ? "text-[#18181b]" : "text-[#71717a]"}">${dayNames[i]}</div>
            <div class="text-[18px] font-semibold text-[#18181b]">${dayDate.getDate()}</div>
          </div>
          <!-- Items column -->
          <div class="flex flex-col gap-2 min-h-[200px]">
            ${
              hasItems
                ? dayItems
                    .map((item) => {
                      const timeStr = new Date(
                        item.status === "published"
                          ? item.publishedAt
                          : item.scheduledAt,
                      ).toLocaleTimeString("en-US", {
                        hour: "2-digit",
                        minute: "2-digit",
                      });
                      const isItemPast =
                        new Date(
                          item.status === "published"
                            ? item.publishedAt
                            : item.scheduledAt,
                        ) < new Date();
                      const isPublished = item.status === "published";
                      const cardStyle = isPublished
                        ? "bg-[#f4f4f5] border-[#eaecf0]"
                        : "bg-white border-[#eaecf0] shadow-2xs";
                      return `
                <div class="group p-2.5 rounded-xl ${cardStyle} border hover:border-[#18181b] hover:shadow-2xs transition-all cursor-pointer ${isItemPast ? "opacity-60 grayscale-[0.3]" : ""}" onclick="openPreviewModal('${item.id}')">
                  <!-- Unified Dark Image Thumbnail -->
                  <div class="w-full ${item.contentType === "Story" ? "aspect-[9/16]" : "aspect-[3/4]"} bg-[#18181b] rounded-lg flex items-center justify-center mb-2 relative overflow-hidden shadow-inner">
                    <img 
                      src="${item.imageUrl || (item.contentType === "Story" ? SAMPLE_STORY_IMAGES[Math.abs(item.id.split("").reduce((acc, char) => acc + char.charCodeAt(0), 0)) % SAMPLE_STORY_IMAGES.length] : SAMPLE_IMAGES[Math.abs(item.id.split("").reduce((acc, char) => acc + char.charCodeAt(0), 0)) % SAMPLE_IMAGES.length])}" 
                      alt="" 
                      class="w-full h-full object-cover" 
                      loading="lazy" 
                    />
                    <span class="absolute bottom-1.5 right-1.5 px-1.5 h-4 rounded-md bg-black/60 backdrop-blur-xs text-[8px] font-medium text-white tracking-wider flex items-center z-10">
                      ${item.contentType === "Story" ? "9:16" : "3:4"}
                    </span>
                  </div>
                  
                  <!-- Info -->
                  <div class="text-[10px] font-medium ${isPublished ? "text-[#71717a]" : "text-[#18181b]"} mb-1 flex items-center gap-1">
                    <i class="ti ${PLATFORM_ICONS[item.platform] || "ti-brand-instagram"} text-[10px]"></i>
                    <span>${timeStr}</span>
                  </div>
                  
                  <div class="text-[11px] font-medium text-[#18181b] truncate leading-tight mb-1">${escapeHtml(item.brand)}</div>
                  
                  <div class="flex items-center gap-1 mb-1">
                    <span class="px-1.5 h-4 rounded-md ${isPublished ? "bg-[#f4f4f5] text-[#71717a] border-[#eaecf0]" : "bg-[#f4f4f5] text-[#18181b] border-[#eaecf0]"} text-[8px] font-medium border flex items-center">
                      ${escapeHtml(item.contentType)}
                    </span>
                    ${
                      item.autoEngagement &&
                      Object.values(item.autoEngagement).some((v) => v)
                        ? `
                    <span class="inline-flex items-center gap-1 px-1.5 h-4 rounded-md bg-emerald-600 text-[8px] font-medium text-white shadow-xs" title="Engagement settings active">
                      ${STATUS_ICON_CHECK} Engagement
                    </span>
                    `
                        : ""
                    }
                  </div>
                  
                  <div class="text-[9px] text-[#71717a] line-clamp-2 leading-tight">${escapeHtml(item.caption || "")}</div>
                </div>
              `;
                    })
                    .join("")
                : `<div class="flex-1 flex flex-col items-center justify-center text-[11px] text-[#a1a1aa] py-8">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-6 h-6 text-[#a1a1aa] mb-1 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2V5M6 2V5"></path><path d="M10.5 3.5H13.5C17.2712 3.5 19.1569 3.5 20.3284 4.67157C21.5 5.84315 21.5 7.72876 21.5 11.5V14C21.5 17.7712 21.5 19.6569 20.3284 20.8284C19.1569 22 17.2712 22 13.5 22H10.5C6.72876 22 4.84315 22 3.67157 20.8284C2.5 19.6569 2.5 17.7712 2.5 14V11.5C2.5 7.72876 2.5 5.84315 3.67157 4.67157C4.84315 3.5 6.72876 3.5 10.5 3.5Z"></path><path d="M3 8H21"></path><path d="M8.44356 14.5282C10.0526 14.3279 11.3279 13.0526 11.5282 11.4436C11.5585 11.2 11.7545 11 12 11C12.2455 11 12.4415 11.2 12.4718 11.4436C12.6721 13.0526 13.9474 14.3279 15.5564 14.5282C15.8 14.5585 16 14.7545 16 15C16 15.2455 15.8 15.4415 15.5564 15.4718C13.9474 15.6721 12.6721 16.9474 12.4718 18.5564C12.4415 18.8 12.2455 19 12 19C11.7545 19 11.5585 18.8 11.5282 18.5564C11.3279 16.9474 10.0526 15.6721 8.44356 15.4718C8.19998 15.4415 8 15.2455 8 15C8 14.7545 8.19998 14.5585 8.44356 14.5282Z"></path></svg>
              <span>No items</span>
            </div>`
            }
          </div>
        </div>
      `;
      }

      els.schedCalWeekGrid.innerHTML = html;
    }

    function cancelScheduleContent() {
      if (!previewingContentId) return;
      const item = generatedContent.find((g) => g.id === previewingContentId);
      if (!item) return;
      item.status = "approved";
      item.scheduledAt = null;
      saveGenerated();
      renderGenerated();
      renderScheduled();
      closePreviewModal();
      showToast(
        "Schedule dibatalkan. Konten dikembalikan ke Approved di Outputs.",
      );
    }

    function cancelScheduleItem(id) {
      const item = generatedContent.find((g) => g.id === id);
      if (!item) return;
      item.status = "approved";
      item.scheduledAt = null;
      saveGenerated();
      renderScheduled();
      renderGenerated();
      showToast(
        "Schedule dibatalkan. Konten dikembalikan ke Approved di Outputs.",
      );
    }

    function formatRelativeDate(dateStr) {
      const now = new Date();
      now.setHours(0, 0, 0, 0);
      const date = new Date(dateStr);
      date.setHours(0, 0, 0, 0);
      const diffMs = now - date;
      const diffDays = Math.floor(diffMs / (24 * 60 * 60 * 1000));

      if (diffDays === 0) return "Today";
      return date.toLocaleDateString("en-GB", {
        day: "numeric",
        month: "short",
      });
    }

    function formatScheduledTime(dateStr) {
      const date = new Date(dateStr);
      const now = new Date();
      const diffMs = date - now;
      const diffMins = Math.floor(diffMs / (60 * 1000));
      const diffHours = Math.floor(diffMs / (60 * 60 * 1000));

      if (diffMins <= 0) return "Publishing now";
      if (diffMins < 60) return `${diffMins}m`;
      if (diffHours < 24) return `${diffHours}h`;
      return date.toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      });
    }

    // ═══════════════════════════════════════════
    // PREVIEW MODAL (2-Panel)
    // ═══════════════════════════════════════════
    function openPreviewModal(genId, options = {}) {
      previewingContentId = genId;

      // If the modal is currently hidden, this is a fresh entry point. Reset iteration history if not in summary.
      const pm = document.getElementById("modal-preview");
      const sumModal = document.getElementById("modal-approval-summary");
      const isSummaryOpen = sumModal && !sumModal.classList.contains("hidden");
      if (pm && pm.classList.contains("hidden") && !isSummaryOpen) {
        sessionApprovedIds = [];
      }

      const item = generatedContent.find((g) => g.id === genId);
      if (!item) return;

      const statusConfig = {
        draft: {
          bg: "bg-orange-500",
          text: "text-white",
          border: "border-transparent",
          label: "Draft",
          icon: "",
        },
        approved: {
          bg: "bg-emerald-600",
          text: "text-white",
          border: "border-transparent",
          label: "Approved",
          icon: "",
        },
        rejected: {
          bg: "bg-rose-600",
          text: "text-white",
          border: "border-transparent",
          label: "Rejected",
          icon: "",
        },
        scheduled: {
          bg: "bg-blue-600",
          text: "text-white",
          border: "border-transparent",
          label: "Scheduled",
          icon: "",
        },
        published: {
          bg: "bg-emerald-600",
          text: "text-white",
          border: "border-transparent",
          label: "Published",
          icon: "",
        },
      };
      const cfg = statusConfig[item.status] || statusConfig.draft;

      // Header
      const titleHeader = document.getElementById("preview-title-header");
      const statusBadge = document.getElementById("preview-status-badge");
      const draftCounter = document.getElementById("preview-draft-counter");
      if (titleHeader) {
        titleHeader.textContent = item.title;
        titleHeader.title = item.title;
      }
      if (statusBadge) {
        statusBadge.className = `inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold ${cfg.bg} ${cfg.text} border ${cfg.border} shrink-0`;
        statusBadge.innerHTML = `<span>${cfg.label}</span>`;
      }
      // Draft counter: show for draft items with automation group
      if (draftCounter) {
        if (item.status === "draft" && item.automationName) {
          const allGroupItems = generatedContent.filter(
            (g) => g.automationName === item.automationName,
          );
          let position = 1;
          let total = allGroupItems.length > 0 ? allGroupItems.length : 5;
          const varMatch = item.title
            ? item.title.match(/Variation\s+(\d+)/i)
            : null;
          if (varMatch) {
            position = parseInt(varMatch[1], 10);
          } else {
            const currentIndex = allGroupItems.findIndex(
              (g) => g.id === item.id,
            );
            position = currentIndex >= 0 ? currentIndex + 1 : 1;
          }
          draftCounter.textContent = `Review design ${position} of ${total}`;
          draftCounter.classList.remove("hidden");
        } else if (item.status === "draft") {
          draftCounter.textContent = "Review design";
          draftCounter.classList.remove("hidden");
        } else {
          draftCounter.textContent = "Preview Design";
          draftCounter.classList.remove("hidden");
        }
      }

      // Image - set aspect ratio based on type
      const imgContainer = document.getElementById("preview-image-container");
      const isStory =
        item.contentType === "Story" ||
        item.type === "Story" ||
        (item.contentType &&
          item.contentType.toLowerCase().includes("story")) ||
        (item.title && item.title.toLowerCase().includes("story"));
      const isCarousel = item.contentType === "Carousel";
      previewCarouselTotal = item.carouselSlides || 1;
      previewCarouselIndex = 0;

      if (imgContainer) {
        if (isStory) {
          imgContainer.style.aspectRatio = "9 / 16";
          imgContainer.classList.remove("feed-aspect");
          imgContainer.classList.add("story-aspect");
        } else {
          imgContainer.style.aspectRatio = "3 / 4";
          imgContainer.classList.remove("story-aspect");
          imgContainer.classList.add("feed-aspect");
        }
        imgContainer.style.maxHeight = "calc(85vh - 120px)";
        imgContainer.className = `w-full ${isStory ? "story-aspect" : "feed-aspect"} flex items-center justify-center relative overflow-hidden rounded-xl bg-[#18181b] shadow-inner transition-all duration-300`;
        const defaultStory =
          SAMPLE_STORY_IMAGES[
            Math.abs(
              item.id
                .split("")
                .reduce((acc, char) => acc + char.charCodeAt(0), 0),
            ) % SAMPLE_STORY_IMAGES.length
          ];
        const defaultFeed =
          SAMPLE_IMAGES[
            Math.abs(
              item.id
                .split("")
                .reduce((acc, char) => acc + char.charCodeAt(0), 0),
            ) % SAMPLE_IMAGES.length
          ];
        let imgSrc = item.imageUrl;
        if (isStory && (!imgSrc || imgSrc.includes("Sample Image"))) {
          imgSrc = defaultStory;
        } else if (!imgSrc) {
          imgSrc = defaultFeed;
        }
        imgContainer.innerHTML = `
        <img id="preview-image-main" src="${imgSrc}" alt="${escapeHtml(item.title)}" class="w-full h-full object-cover" />
      `;
      }

      // Carousel controls
      updateCarouselControls();

      // Caption
      const captionInput = document.getElementById("preview-caption-input");
      if (captionInput) {
        captionInput.value = item.caption || "";
        originalCaption = item.caption || "";
        const isPublished = item.status === "published";
        captionInput.disabled = isPublished;
        if (isPublished) {
          captionInput.classList.add(
            "bg-[#f4f4f5]",
            "text-[#71717a]",
            "cursor-not-allowed",
            "border-[#e4e4e7]",
