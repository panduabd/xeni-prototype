                  </div>
                  
                  <button type="button" class="btn-add-dm-keyword w-full py-2.5 rounded-lg border border-dashed border-[#d4d4d8] hover:border-[#18181b] bg-white hover:bg-[#fafafa] text-xs font-medium text-[#18181b] flex items-center justify-center gap-1.5 transition-colors cursor-pointer">
                    <i class="ti ti-plus text-[12px]"></i>
