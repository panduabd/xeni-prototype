                <div class="dm-view-section dm-view-ai hidden space-y-3">
                  <textarea class="dm-ai-prompt-input w-full rounded-lg border border-[#e4e4e7] p-3 text-xs text-[#18181b] outline-none focus:border-[#18181b] focus:ring-1 focus:ring-[#18181b] placeholder:text-[#a1a1aa] min-h-[85px] resize-y bg-white shadow-2xs" placeholder="Masukan prompt"></textarea>
                  <div class="space-y-2 pt-1">
                    <!-- Jeda Select directly -->
                    <div class="flex items-center justify-between py-1.5 border-b border-[#eaecf0]">
                      <span class="text-xs font-medium text-[#18181b]">Jeda</span>
                      <select class="dm-delay-select h-8 rounded-lg border border-[#e4e4e7] bg-white px-2.5 text-xs font-medium text-[#18181b] outline-none focus:border-[#18181b] focus:ring-1 focus:ring-[#18181b] shadow-2xs">
                        <option value="instant">Instant</option>
                        <option value="10s">10 Seconds</option>
                        <option value="30s">30 Seconds</option>
                        <option value="1min">1 Minute</option>
                        <option value="5min">5 Minutes</option>
                        <option value="15min">15 Minutes</option>
                        <option value="30min">30 Minutes</option>
                      </select>
                    </div>

                    <!-- Pencocokan Keyword Toggle & Content -->
                    <div class="keyword-matching-section space-y-2.5 pt-1">
                      <div class="flex items-center justify-between py-1">
                        <span class="text-xs font-medium text-[#18181b]">Pencocokan Keyword</span>
                        <button
                          class="sub-toggle-switch relative inline-flex h-4.5 w-8 shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-gray-200 transition-colors duration-200 ease-in-out focus:outline-none"
                          role="switch"
                          data-field="keywordMatching"
                          aria-checked="false"
                        >
                          <span class="toggle-handle pointer-events-none inline-block h-3.5 w-3.5 transform rounded-full bg-white shadow-xs transition duration-200 ease-in-out translate-x-0"></span>
                        </button>
                      </div>

                      <!-- Collapsible content -->
                      <div class="keyword-matching-content hidden space-y-3 p-3 bg-white border border-[#e4e4e7] rounded-xl shadow-2xs">
                        <div class="flex items-center gap-2">
                          <button
                            class="sub-toggle-switch relative inline-flex h-4.5 w-8 shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-gray-200 transition-colors duration-200 ease-in-out focus:outline-none"
                            role="switch"
                            data-field="precisionMatching"
                            aria-checked="false"
                          >
                            <span class="toggle-handle pointer-events-none inline-block h-3.5 w-3.5 transform rounded-full bg-white shadow-xs transition duration-200 ease-in-out translate-x-0"></span>
                          </button>
                          <span class="text-xs font-medium text-[#18181b]">Pencocokan Persis</span>
                          <div class="relative group flex items-center">
                            <i class="ti ti-info-circle text-[13px] text-[#71717a] cursor-help"></i>
                            <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:flex flex-col items-center pointer-events-none z-50 w-52">
                              <div class="bg-[#18181b] text-white text-[10px] font-normal px-2.5 py-1.5 rounded-md shadow-lg w-full text-center leading-normal whitespace-normal">
                                Aktifkan agar balasan hanya dikirim jika komentar sama persis dengan kata kunci.
                              </div>
                              <div class="w-1.5 h-1.5 bg-[#18181b] rotate-45 -mt-0.75"></div>
                            </div>
                          </div>
                        </div>
                        <div class="matching-keywords-container tag-input-container flex flex-wrap gap-1.5 p-1.5 rounded-lg border border-[#e4e4e7] bg-white min-h-9 shadow-2xs">
                          <input type="text" class="tag-input flex-1 min-w-[80px] text-xs outline-none placeholder:text-[#a1a1aa] bg-transparent text-[#18181b]" placeholder="Masukan keyword...">
                        </div>
                        <p class="text-[10px] text-[#71717a] leading-normal">
