  <!-- Save Template Sub-Modal -->
  <div id="save-template-modal" class="hidden transition-opacity duration-200 ease-out opacity-0"
    style="position: fixed; inset: 0; z-index: 10001;"
  >
    <div class="absolute inset-0 bg-black/50 backdrop-blur-xs"
      onclick="window.closeSaveTemplateModal();"
    ></div>
    <div class="absolute inset-0 flex items-center justify-center p-4"
      onclick="if(event.target === this) window.closeSaveTemplateModal();"
    >
      <div class="relative bg-white w-full max-w-[380px] rounded-xl shadow-xl border border-[#eaecf0] p-5 flex flex-col gap-4 transition-transform duration-200 ease-out scale-95"
        onclick="event.stopPropagation();"
      >
        <div>
          <h3 class="text-sm font-semibold text-[#18181b]">Save as Template</h3>
        </div>
        
        <div>
          <label class="text-xs font-medium text-[#18181b] block mb-1.5">Template Name</label>
          <input type="text" id="save-template-name-input" class="w-full h-9 rounded-lg border border-[#e4e4e7] px-3 text-xs font-medium text-[#18181b] placeholder:text-[#a1a1aa] outline-none focus:border-[#18181b] focus:ring-1 focus:ring-[#18181b] bg-white shadow-2xs" placeholder="e.g. Ramadhan Promo, CS Standard...">
        </div>

        <div class="flex items-center justify-end gap-2 mt-1">
          <button onclick="window.closeSaveTemplateModal();" type="button" class="inline-flex items-center justify-center rounded-lg font-medium px-3.5 h-8.5 text-[12px] bg-white text-[#18181b] border border-[#e4e4e7] hover:bg-[#f4f4f5] shadow-xs cursor-pointer active:scale-98">
            Cancel
          </button>
          <button id="btn-save-template-submit" type="button" class="inline-flex items-center justify-center rounded-lg font-medium px-4 h-8.5 text-[12px] bg-[#18181b] text-white hover:bg-black shadow-xs cursor-pointer active:scale-98">
            Save
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Load Template Sub-Modal -->
  <div id="load-template-modal" class="hidden transition-opacity duration-200 ease-out opacity-0"
    style="position: fixed; inset: 0; z-index: 10001;"
  >
    <div class="absolute inset-0 bg-black/50 backdrop-blur-xs"
      onclick="window.closeLoadTemplateModal();"
    ></div>
    <div class="absolute inset-0 flex items-center justify-center p-4"
      onclick="if(event.target === this) window.closeLoadTemplateModal();"
    >
      <div class="relative bg-white w-full max-w-[420px] rounded-xl shadow-xl border border-[#eaecf0] p-5 flex flex-col gap-4 transition-transform duration-200 ease-out scale-95"
        onclick="event.stopPropagation();"
      >
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-sm font-semibold text-[#18181b]">Load Template</h3>
          </div>
          <button onclick="window.closeLoadTemplateModal();" class="w-8 h-8 rounded-md flex items-center justify-center text-[#71717a] hover:text-[#18181b] hover:bg-[#f4f4f5] transition-colors cursor-pointer">
            <i class="ti ti-x text-[16px]"></i>
          </button>
        </div>

        <!-- Default Templates Accordion -->
        <div class="border border-[#e4e4e7] rounded-xl overflow-hidden bg-white shadow-2xs">
          <button type="button" id="accordion-default-trigger" class="w-full flex items-center justify-between p-3 bg-[#fafafa] hover:bg-[#f4f4f5] transition-colors text-left cursor-pointer border-none outline-none">
            <div class="flex items-center gap-2">
              <i class="ti ti-template text-[15px] text-[#71717a]"></i>
              <span class="text-xs font-medium text-[#18181b]">Default Templates</span>
            </div>
            <i id="accordion-default-icon" class="ti ti-chevron-down text-[13px] text-[#71717a] transition-transform duration-200"></i>
          </button>
          
          <div id="accordion-default-content" class="hidden border-t border-[#eaecf0] p-3 space-y-2 bg-[#fafafa]">
            <!-- Default templates list populated dynamically -->
          </div>
        </div>

        <!-- Custom Templates Section -->
        <div class="flex flex-col gap-2">
          <p class="text-xs font-medium text-[#71717a] uppercase tracking-wider">Custom Templates</p>
          <div id="modal-template-list" class="space-y-2 max-h-[170px] overflow-y-auto pr-1 custom-scrollbar">
            <!-- Dynamically populated custom template options -->
          </div>
        </div>

        <div class="flex items-center justify-end mt-1">
          <button onclick="window.closeLoadTemplateModal();" type="button" class="inline-flex items-center justify-center rounded-lg font-medium px-3.5 h-8.5 text-[12px] bg-white text-[#18181b] border border-[#e4e4e7] hover:bg-[#f4f4f5] shadow-xs cursor-pointer active:scale-98">
            Close
          </button>
        </div>
      </div>
    </div>
  </div>
</AppLayout>
