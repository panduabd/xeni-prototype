          nameInput.classList.add('border-red-500');
          setTimeout(() => nameInput.classList.remove('border-red-500'), 1500);
          return;
        }

        const config = collectModalConfig();
        const stored = localStorage.getItem('xeni_automation_templates');
        let templates = {};
        if (stored) {
          try {
            templates = JSON.parse(stored);
          } catch (e) {
            templates = defaultTemplates;
          }
        } else {
          templates = defaultTemplates;
        }

        templates[name] = config;
        localStorage.setItem('xeni_automation_templates', JSON.stringify(templates));
        activeTemplateName = name;

        // Success animation
        const originalText = btnSaveTemplateSubmit.textContent;
        btnSaveTemplateSubmit.textContent = 'Saved! ✓';
        btnSaveTemplateSubmit.classList.remove('bg-[#111827]', 'hover:bg-black');
        btnSaveTemplateSubmit.classList.add('bg-green-600');
        setTimeout(() => {
          btnSaveTemplateSubmit.textContent = originalText;
          btnSaveTemplateSubmit.classList.remove('bg-green-600');
          btnSaveTemplateSubmit.classList.add('bg-[#111827]', 'hover:bg-black');
          window.closeSaveTemplateModal();
        }, 800);
      });

    });
  </script>

