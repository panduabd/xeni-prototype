---
import AppLayout from "../layouts/AppLayout.astro";
import SocialIcon from "../components/icons/SocialIcon.astro";

const dnaList = [
  { id: "all", name: "All Business" },
  { id: "1", name: "Fresh Juice Co." },
  { id: "2", name: "Acme Corp" },
  { id: "3", name: "Luxe Beauty" },
  { id: "4", name: "TechStart Inc" },
  { id: "tech", name: "TechFlow Systems" },
  { id: "brew", name: "Daily Brew Cafe" },
  { id: "fit", name: "FitLife Gym" },
  { id: "eco", name: "EcoGreen Solutions" },
  { id: "urban", name: "Urban Outfitters" },
  { id: "pixel", name: "Pixel Perfect Studio" },
  { id: "nova", name: "Nova Logistics" },
  { id: "summit", name: "Summit Outdoors" },
  { id: "glow", name: "Glow Skincare" },
  { id: "byte", name: "Byte Labs" },
  { id: "vista", name: "Vista Real Estate" },
  { id: "peak", name: "Peak Performance" },
  { id: "swift", name: "Swift Delivery" },
  { id: "bloom", name: "Bloom Florist" },
  { id: "ocean", name: "Oceanic Seafood" },
  { id: "apex", name: "Apex Consulting" }
];

const platforms = [
  { id: "facebook", name: "Facebook", icon: "ti-brand-facebook", color: "#1877F2" },
  { id: "threads", name: "Threads", icon: "ti-brand-threads", color: "#000000" },
  { id: "instagram", name: "Instagram", icon: "ti-brand-instagram", color: "#E4405F" },
  { id: "tiktok", name: "TikTok", icon: "ti-brand-tiktok", color: "#000000" },
];


const accounts = [
  {
    id: "ig-1",
    handle: "@freshjuice.co",
    platformId: "instagram",
    dnaId: "1",
    status: "connected",
    automations: {
      reply_comment: { enabled: true, mode: "text", text: "Terima kasih atas masukannya!", keywordMatching: false, delay: "instant" },
      like_comment: { enabled: true }
    }
  },
  {
    id: "ig-2",
    handle: "@acmecorp.official",
    platformId: "instagram",
    dnaId: "2",
    status: "connected",
    automations: {}
  },
  {
    id: "tt-1",
    handle: "@freshjuice",
    platformId: "tiktok",
    dnaId: "1",
    status: "connected",
    automations: {
      delete_comment: { enabled: true, filterMode: "keyword", keywords: ["spam", "promo", "scam"] }
    }
  },
  {
    id: "tt-2",
    handle: "@acmecorp",
    platformId: "tiktok",
    dnaId: "2",
    status: "error",
    automations: {}
  },
  {
    id: "fb-1",
    handle: "Fresh Juice Co.",
    platformId: "facebook",
    dnaId: "1",
    status: "connected",
    automations: {
      reply_comment: { enabled: true, mode: "text", text: "Kami sangat menghargai feedback Anda.", keywordMatching: false, delay: "30s" },
      dm_comment: { enabled: true, mode: "text", text: "Hi {name}! Silakan cek detail promonya di sini: https://freshjuice.co/promo", delay: "instant", keywordMatching: true, matchingKeywords: ["promo", "diskon"] }
    }
  },
  {
    id: "fb-2",
    handle: "Acme Corp",
    platformId: "facebook",
    dnaId: "2",
    status: "connected",
    automations: {}
  },
  {
    id: "fb-3",
    handle: "Luxe Beauty Official",
    platformId: "facebook",
    dnaId: "3",
    status: "connected",
    automations: {
      like_comment: { enabled: true },
      reply_story: { enabled: true, mode: "text", text: "Terima kasih sudah mention kami!", keywordMatching: false, delay: "instant" }
    }
  },
  {
    id: "th-1",
    handle: "@freshjuice",
    platformId: "threads",
    dnaId: "1",
    status: "connected",
    automations: {
      reply_comment: { enabled: true, mode: "text", text: "Halo! Terima kasih ya.", keywordMatching: false, delay: "10s" }
    }
  },
  {
    id: "th-2",
    handle: "@acmecorp.threads",
    platformId: "threads",
    dnaId: "2",
    status: "connected",
    automations: {}
  },
];

const totalConnected = accounts.filter((a) => a.status === "connected").length;
const totalError = accounts.filter((a) => a.status === "error").length;
---

<AppLayout title="Integrations - Xeni" activePage="integrations">
  <div class="w-full min-h-full flex flex-col px-6 pb-32 -mt-12">
    <!-- Title + Controls Row -->
    <div class="w-full pt-1 pb-5 flex items-center justify-between gap-4 shrink-0">
      <!-- Left: Title -->
      <div class="flex items-center gap-2.5 shrink-0">
        <h1 class="text-[20px] font-semibold text-[#18181b] tracking-tight">
          Integrations
        </h1>
      </div>

      <!-- Right: Add Account -->
      <button
        onclick="document.getElementById('add-account-modal').hidden = false;"
        class="inline-flex items-center gap-2 rounded-xl font-medium transition-colors cursor-pointer select-none whitespace-nowrap justify-center px-4 h-9 text-[13px] bg-[#18181b] text-white hover:bg-black shadow-xs active:scale-98"
      >
        <i class="ti ti-plus text-[14px]"></i>
        Add Account
      </button>
    </div>

    <!-- Stats + Filters -->
    <div class="w-full pb-6 flex flex-col gap-4">
      <!-- Stats Cards -->
      <div class="grid grid-cols-2 gap-4">
        <div class="flex items-center gap-3.5 p-4 rounded-xl bg-white border border-[#eaecf0] shadow-xs">
          <div class="w-9 h-9 rounded-xl bg-emerald-600 flex items-center justify-center shrink-0 shadow-xs">
            <i class="ti ti-plug text-[18px] text-white"></i>
          </div>
          <div>
            <p class="text-xl font-semibold text-[#111827] tracking-tight">{totalConnected}</p>
            <p class="text-xs text-[#71717a] font-medium">Connected</p>
          </div>
        </div>
        <div class="flex items-center gap-3.5 p-4 rounded-xl bg-white border border-[#eaecf0] shadow-xs">
          <div class="w-9 h-9 rounded-xl bg-amber-500 flex items-center justify-center shrink-0 shadow-xs">
            <i class="ti ti-alert-triangle text-[18px] text-white"></i>
          </div>
          <div>
            <p class="text-xl font-semibold text-[#111827] tracking-tight">{totalError}</p>
            <p class="text-xs text-[#71717a] font-medium">Error</p>
          </div>
        </div>
      </div>

      <!-- Filters Bar: Dropdowns Left, Search Right (fills remaining) -->
      <div class="flex items-center gap-2">
        <!-- Platform Filter -->
        <div class="relative" id="platform-filter-wrapper">
          <button
            id="btn-platform-filter"
            class="flex items-center gap-2 px-4 h-10 rounded-xl border border-[#e4e4e7] bg-white text-[13px] font-medium text-[#18181b] hover:bg-[#fafafa] transition-colors cursor-pointer shadow-xs"
          >
            <i class="ti ti-apps text-[14px] text-[#71717a]"></i>
            <span id="platform-filter-label">All Platforms</span>
            <i class="ti ti-chevron-down text-[12px] text-[#a1a1aa]"></i>
          </button>
          <div
            id="platform-filter-dropdown"
            class="hidden absolute top-full left-0 mt-1.5 w-52 bg-white rounded-xl border border-[#eaecf0] shadow-md z-30 overflow-hidden p-1 animate-in fade-in zoom-in-95 duration-150"
          >
            <div class="flex flex-col">
              <button class="platform-option w-full text-left px-3 py-2 rounded-lg text-xs font-medium text-[#18181b] hover:bg-[#f4f4f5] transition-colors cursor-pointer bg-[#f4f4f5]" data-value="all">
                All Platforms
              </button>
              {platforms.map((p) => (
                <button class="platform-option w-full text-left px-3 py-2 rounded-lg text-xs font-medium text-[#71717a] hover:bg-[#f4f4f5] hover:text-[#18181b] transition-colors cursor-pointer flex items-center gap-2.5" data-value={p.id}>
                  <div class="w-5 h-5 rounded flex items-center justify-center bg-white border border-[#eaecf0] shrink-0 shadow-2xs">
                    <SocialIcon platform={p.id} size="sm" />
                  </div>
                  <span>{p.name}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- DNA Filter -->
        <div class="relative" id="dna-filter-wrapper">
          <button
            id="btn-dna-filter"
            class="flex items-center gap-2 px-4 h-10 rounded-xl border border-[#e4e4e7] bg-white text-[13px] font-medium text-[#18181b] hover:bg-[#fafafa] transition-colors cursor-pointer shadow-xs"
          >
            <i class="ti ti-building text-[14px] text-[#71717a]"></i>
            <span id="dna-filter-label">All Business</span>
            <i class="ti ti-chevron-down text-[12px] text-[#a1a1aa]"></i>
          </button>
          <div id="dna-filter-dropdown" class="hidden absolute top-full left-0 mt-1.5 w-56 bg-white rounded-xl border border-[#eaecf0] shadow-md z-30 overflow-hidden flex flex-col p-1 animate-in fade-in zoom-in-95 duration-150">
            <!-- Mini Search Bar for Filter -->
            <div class="p-1.5 border-b border-[#eaecf0]">
              <div class="relative">
                <i class="ti ti-search absolute left-2.5 top-1/2 -translate-y-1/2 text-[#a1a1aa] text-[11px]"></i>
                <input type="text" class="biz-search-input w-full h-8 pl-7 pr-2 text-xs bg-[#fafafa] border border-[#e4e4e7] rounded-lg focus:outline-none focus:border-[#18181b] focus:ring-1 focus:ring-[#18181b] transition-colors placeholder:text-[#a1a1aa]" placeholder="Search..." />
              </div>
            </div>
            <!-- Scrollable List -->
            <div class="flex flex-col pt-1 max-h-[220px] overflow-y-auto custom-scrollbar biz-options-container">
              {dnaList.map((dna) => (
                <button class="dna-option w-full text-left px-3 py-2 rounded-lg text-xs font-medium text-[#71717a] hover:bg-[#f4f4f5] hover:text-[#18181b] transition-colors cursor-pointer" data-value={dna.id}>
                  {dna.name}
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- Status Tabs -->
        <div class="flex items-center gap-1 p-1 h-10 rounded-xl border border-[#e4e4e7] bg-[#fafafa] shrink-0 shadow-xs">
          <button class="status-tab active px-3.5 h-full rounded-lg text-[13px] font-medium transition-all cursor-pointer bg-white text-[#18181b] shadow-xs" data-status="all">All</button>
          <button class="status-tab px-3.5 h-full rounded-lg text-[13px] font-medium transition-all cursor-pointer text-[#71717a] hover:text-[#18181b]" data-status="connected">Connected</button>
          <button class="status-tab px-3.5 h-full rounded-lg text-[13px] font-medium transition-all cursor-pointer text-[#71717a] hover:text-[#18181b]" data-status="error">Error</button>
        </div>

        <!-- Search (fills remaining space) -->
        <div class="relative flex-1 min-w-50">
          <i class="ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-[#a1a1aa] text-[14px] pointer-events-none"></i>
          <input
            id="integration-search"
            type="text"
            placeholder="Search accounts, platforms..."
            class="w-full h-10 pl-9 pr-3 rounded-xl border border-[#e4e4e7] bg-white text-[13px] font-medium text-[#111827] placeholder:text-[#a1a1aa] outline-none shadow-xs focus:border-[#18181b] focus:ring-1 focus:ring-[#18181b] transition-colors"
          />
        </div>
      </div>
    </div>

    <!-- Accounts Table (HeroUI Table format) -->
    <div class="w-full flex-1 pb-16">
      <div class="table-root w-full overflow-clip rounded-2xl border border-[#eaecf0] bg-white shadow-xs">
        <div class="table__scroll-container overflow-x-auto custom-scrollbar">
          <table class="table__content w-full min-w-[850px] text-left border-separate border-spacing-0 text-sm">
            <!-- Table Header -->
            <thead class="table__header bg-[#fafafa]">
              <tr class="border-b border-[#eaecf0]">
                <th class="table__column px-5 py-3 text-[11px] font-semibold text-[#71717a] uppercase tracking-wider border-b border-[#eaecf0]">Account</th>
                <th class="table__column px-5 py-3 text-[11px] font-semibold text-[#71717a] uppercase tracking-wider border-b border-[#eaecf0] w-[130px]">Platform</th>
                <th class="table__column px-5 py-3 text-[11px] font-semibold text-[#71717a] uppercase tracking-wider border-b border-[#eaecf0] w-[140px]">Business DNA</th>
                <th class="table__column px-5 py-3 text-[11px] font-semibold text-[#71717a] uppercase tracking-wider border-b border-[#eaecf0] w-[100px]">Status</th>
                <th class="table__column px-5 py-3 text-[11px] font-semibold text-[#71717a] uppercase tracking-wider border-b border-[#eaecf0] w-[170px]">Automations</th>
                <th class="table__column px-5 py-3 text-[11px] font-semibold text-[#71717a] uppercase tracking-wider border-b border-[#eaecf0] text-right w-[200px]">Action</th>
              </tr>
            </thead>

            <!-- Table Body -->
            <tbody id="accounts-list" class="table__body divide-y divide-[#eaecf0]">
              {accounts.map((account) => {
                const platform = platforms.find((p) => p.id === account.platformId);
                const dna = dnaList.find((d) => d.id === account.dnaId);
                return (
                  <tr
                    class="account-row table__row hover:bg-[#f4f4f5]/60 transition-colors"
                    data-id={account.id}
                    data-platform={account.platformId}
                    data-dna={account.dnaId}
                    data-status={account.status}
                    data-handle={account.handle.toLowerCase()}
                    data-automations={JSON.stringify(account.automations)}
                  >
                    <!-- Account -->
                    <td class="table__cell px-5 py-3.5 align-middle">
                      <div class="flex items-center gap-3 min-w-0">
                        <div class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 bg-white border border-[#eaecf0] shadow-2xs">
                          <SocialIcon platform={account.platformId} size="md" />
                        </div>
                        <span class="text-xs font-semibold text-[#111827] truncate">{account.handle}</span>
                      </div>
                    </td>

                    <!-- Platform -->
                    <td class="table__cell px-5 py-3.5 align-middle">
                      <span class="text-xs text-[#71717a] font-medium">{platform?.name}</span>
                    </td>

                    <!-- DNA -->
                    <td class="table__cell px-5 py-3.5 align-middle">
                      <span class="text-xs text-[#71717a] font-medium truncate">{dna?.name}</span>
                    </td>

                    <!-- Status -->
                    <td class="table__cell px-5 py-3.5 align-middle">
                      {account.status === "connected" ? (
                        <div class="inline-flex items-center px-2.5 py-1 rounded-md bg-emerald-600 text-white text-[11px] font-medium shadow-xs">
                          Connected
                        </div>
                      ) : (
                        <div class="inline-flex items-center px-2.5 py-1 rounded-md bg-amber-500 text-white text-[11px] font-medium shadow-xs">
                          Error
                        </div>
                      )}
                    </td>

                    <!-- Automations Badges -->
                    <td class="table__cell px-5 py-3.5 align-middle">
                      {(() => {
                        const iconMap = {
                          delete_comment: { label: "Delete Comment", icon: "ti-trash" },
                          reply_comment: { label: "Reply Comment", icon: "ti-message-dots" },
                          like_comment: { label: "Like Comment", icon: "ti-thumb-up" },
                          dm_comment: { label: "DM Comment", icon: "ti-message-share" },
                          reply_story: { label: "Reply Story", icon: "ti-history" },
                          reply_dm: { label: "Reply DM", icon: "ti-messages" },
                        };

                        const activeKeys = Object.keys(account.automations).filter(
                          (key) => account.automations[key]?.enabled === true
                        );

                        return (
                          <div class="automations-badges flex flex-wrap gap-1.5 max-w-full">
                            {activeKeys.length > 0 ? (
                              activeKeys.map((key) => {
                                const config = iconMap[key];
                                if (!config) return null;
                                return (
                                  <div class="relative group flex items-center">
                                    <div class="w-7 h-7 rounded-lg flex items-center justify-center border border-[#eaecf0] bg-white text-[#71717a] transition-colors hover:text-[#18181b] hover:bg-[#fafafa] shadow-2xs cursor-help">
                                      <i class={`ti ${config.icon} text-[14px]`}></i>
                                    </div>
                                    <!-- Tooltip -->
                                    <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-1.5 hidden group-hover:flex flex-col items-center pointer-events-none z-50">
                                      <div class="bg-[#18181b] text-white text-[10px] font-medium px-2 py-1 rounded-md shadow-md whitespace-nowrap">
                                        {config.label}
                                      </div>
                                      <div class="w-1.5 h-1.5 bg-[#18181b] rotate-45 -mt-0.75"></div>
                                    </div>
                                  </div>
                                );
                              })
                            ) : (
                              <span class="text-xs text-[#a1a1aa] italic font-normal">None active</span>
                            )}
                          </div>
                        );
                      })()}
                    </td>

                    <!-- Action -->
                    <td class="table__cell px-5 py-3.5 align-middle text-right">
                      <div class="flex items-center justify-end gap-2">
                        <button
                          class="btn-set-automation inline-flex items-center gap-1.5 rounded-lg font-medium transition-colors cursor-pointer select-none whitespace-nowrap justify-center px-3.5 h-8.5 text-[12px] bg-white text-[#18181b] border border-[#e4e4e7] hover:bg-[#f4f4f5] shadow-xs active:scale-98"
                          onclick={`window.openSettingsModal('${account.id}')`}
                        >
                          <i class="ti ti-settings text-[14px]"></i>
                          Set Automation
                        </button>
                        <div class="relative action-dropdown-wrapper text-left">
                          <button
                            class="btn-action-dropdown w-8.5 h-8.5 rounded-lg border border-[#e4e4e7] bg-white flex items-center justify-center text-[#71717a] hover:text-[#18181b] hover:bg-[#f4f4f5] transition-colors cursor-pointer shadow-xs"
                          >
                            <i class="ti ti-dots-vertical text-[15px]"></i>
                          </button>
                          <!-- Dropdown -->
                          <div class="action-dropdown hidden absolute right-0 top-full mt-1.5 w-36 bg-white rounded-xl border border-[#eaecf0] shadow-md p-1 z-40 text-left animate-in fade-in zoom-in-95 duration-150">
                            <button
                              class="w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs font-medium text-[#18181b] hover:bg-[#f4f4f5] transition-colors cursor-pointer text-left"
                              onclick="window.showAlert ? window.showAlert({ title: 'Integrations', message: 'Reconnecting account...', variant: 'info' }) : null"
                            >
                              <i class="ti ti-refresh text-[13px] text-[#71717a]"></i>
                              Reconnect
                            </button>
                            <button
                              class="w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs font-medium text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer text-left"
                              onclick={`if(confirm('Are you sure you want to delete this integration?')) { this.closest('.account-row').remove(); }`}
                            >
                              <i class="ti ti-trash text-[13px] text-rose-600"></i>
                              Delete
                            </button>
                          </div>
                        </div>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <!-- Empty State -->
        <div id="accounts-empty-state" class="hidden py-16 flex-col items-center justify-center text-center px-4">
          <div class="w-12 h-12 rounded-full bg-[#f4f4f5] flex items-center justify-center mb-3">
            <i class="ti ti-search text-[20px] text-[#71717a]"></i>
          </div>
          <p class="text-sm font-semibold text-[#18181b]">No integrations found</p>
          <p class="text-xs text-[#71717a] mt-1">Try adjusting your platform, DNA, or status filters.</p>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    // --- Global Filter Elements ---
    const searchInput = document.getElementById('integration-search');
    const accountRows = document.querySelectorAll('.account-row');

    // Filter Dropdown Toggles
    function setupFilterDropdown(btnId, dropdownId, optionClass, labelId, onSelect) {
      const btn = document.getElementById(btnId);
      const dropdown = document.getElementById(dropdownId);
      const label = document.getElementById(labelId);
      if (!btn || !dropdown) return;

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdown.classList.toggle('hidden');
      });

      const bizSearchInput = dropdown.querySelector('.biz-search-input');
      if (bizSearchInput) {
        bizSearchInput.addEventListener('click', (e) => e.stopPropagation());
        bizSearchInput.addEventListener('input', (e) => {
          const term = e.target.value.toLowerCase();
          dropdown.querySelectorAll('.' + optionClass).forEach(opt => {
            const text = opt.textContent.toLowerCase();
            opt.style.display = text.includes(term) ? 'block' : 'none';
          });
        });
      }

      dropdown.querySelectorAll('.' + optionClass).forEach((opt) => {
        opt.addEventListener('click', () => {
          const value = opt.dataset.value;
          const text = opt.textContent.trim();
          label.textContent = text;
          dropdown.querySelectorAll('.' + optionClass).forEach((o) => o.classList.remove('bg-[#F9FAFB]', 'text-[#111827]'));
          opt.classList.add('bg-[#F9FAFB]', 'text-[#111827]');
          dropdown.classList.add('hidden');
          onSelect(value);
        });
      });
    }

    let activePlatform = 'all';
    let activeDNA = 'all';
    let activeStatus = 'all';
    let searchQuery = '';

    function applyFilters() {
      let visibleCount = 0;
      accountRows.forEach((row) => {
        const platform = row.dataset.platform;
        const dna = row.dataset.dna;
        const status = row.dataset.status;
        const handle = row.dataset.handle || '';

        const matchPlatform = activePlatform === 'all' || platform === activePlatform;
        const matchDNA = activeDNA === 'all' || dna === activeDNA;
        const matchStatus = activeStatus === 'all' || status === activeStatus;
        const matchSearch = !searchQuery || handle.includes(searchQuery);

        if (matchPlatform && matchDNA && matchStatus && matchSearch) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      const emptyState = document.getElementById('accounts-empty-state');
      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
          emptyState.classList.add('flex');
        } else {
          emptyState.classList.add('hidden');
          emptyState.classList.remove('flex');
        }
      }
    }

    setupFilterDropdown('btn-platform-filter', 'platform-filter-dropdown', 'platform-option', 'platform-filter-label', (val) => {
      activePlatform = val;
      applyFilters();
    });

    setupFilterDropdown('btn-dna-filter', 'dna-filter-dropdown', 'dna-option', 'dna-filter-label', (val) => {
      activeDNA = val;
      applyFilters();
    });

    // Status tabs
    const statusTabs = document.querySelectorAll('.status-tab');
    statusTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        statusTabs.forEach((t) => {
          t.classList.remove('active', 'bg-white', 'text-[#18181b]', 'shadow-xs');
          t.classList.add('text-[#71717a]');
        });
        tab.classList.add('active', 'bg-white', 'text-[#18181b]', 'shadow-xs');
        tab.classList.remove('text-[#71717a]');
        activeStatus = tab.dataset.status || 'all';
        applyFilters();
      });
    });

    // Search
    searchInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value.toLowerCase().trim();
      applyFilters();
    });

    // Add Account Modal Functions
    const addAccountModal = document.getElementById('add-account-modal');
    const btnConnect = document.getElementById('btn-connect');
    const selectedPlatformLabel = document.getElementById('selected-platform-label');
    let selectedPlatform = null;
