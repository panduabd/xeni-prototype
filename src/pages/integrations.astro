        <!-- Footer -->
        <div class="px-6 py-3.5 flex items-center justify-end gap-2.5 bg-white shrink-0">
          <button
            onclick="window.closeSettingsModal();"
            class="inline-flex items-center justify-center rounded-lg font-medium transition-all duration-100 cursor-pointer select-none whitespace-nowrap px-4 h-9.5 text-[13px] bg-white text-[#18181b] border border-[#e4e4e7] hover:bg-[#f4f4f5] shadow-xs active:scale-98"
          >
            Cancel
          </button>
          <button
            id="btn-save-automation-settings"
            class="inline-flex items-center justify-center rounded-lg font-medium transition-all duration-100 cursor-pointer select-none whitespace-nowrap px-4.5 h-9.5 text-[13px] bg-[#18181b] text-white hover:bg-black shadow-xs active:scale-98"
          >
            Save Settings
          </button>
        </div>
      </div>
