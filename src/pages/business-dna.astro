        <div>
          <label class="block text-[12px] font-bold text-[#111827] mb-1.5">Tipe Produk</label>
          <select
            id="product-category-select"
            class="w-full h-9.5 px-3 rounded-xl border border-[#eaecf0] bg-white text-[12.5px] font-medium text-[#111827] shadow-xs outline-none focus:border-[#111827] focus:ring-1 focus:ring-[#111827] transition-all cursor-pointer"
          >
            <option value="physical">Physical Product (Botol, Kemasan, Box)</option>
            <option value="digital">Digital Asset / E-Book / Layanan</option>
