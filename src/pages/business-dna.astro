---
import AppLayout from "../layouts/AppLayout.astro";
import BusinessDnaBucket from "../components/business-dna/BusinessDnaBucket.astro";
---

<AppLayout title="Business DNA - Xeni" activePage="business-dna">
  <div class="w-full min-h-[calc(100vh-80px)] flex flex-col px-6 pb-12 -mt-12 text-zinc-900 font-sans antialiased">
    <!-- Title Row (Clean, No Subtitle, No Top-Right Button) -->
    <div class="w-full pt-1 pb-5 flex items-center justify-between gap-4 shrink-0">
      <div class="flex items-center gap-2.5 shrink-0">
        <h1 class="text-[20px] font-semibold text-[#18181b] tracking-tight">
          Business DNA
        </h1>
      </div>
    </div>

    <!-- Notification Toast -->
    <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- VIEW A: EMPTY STATE (Direct on Main Background)          -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <section id="dna-empty-state" class="hidden flex-1 flex flex-col items-center justify-center py-6 px-4 animate-in fade-in duration-300">
      <div class="mx-auto flex w-full max-w-[510px] flex-col items-center">
        <!-- Animated 3D Bucket Illustration with integrated Left Title -->
        <div class="w-full flex items-center justify-center">
          <BusinessDnaBucket />
        </div>

        <!-- Action Button Centered Below Box -->
        <div class="mt-7 flex justify-center w-full">
          <button
            id="btn-empty-create"
            type="button"
            class="px-5 h-10 rounded-xl bg-zinc-900 hover:bg-black text-white text-[13px] font-medium shadow-xs hover:shadow-md transition-all cursor-pointer active:scale-95 flex items-center gap-2"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 5v14M5 12h14" />
            </svg>
            <span>Create Business DNA</span>
          </button>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- VIEW B: WORKSPACE (When 1+ DNAs exist in localStorage)   -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <section id="dna-workspace" class="hidden flex-1 flex flex-col lg:flex-row gap-5 min-h-0 animate-in fade-in duration-200">
      <!-- ═══ BENTO 1: SECTION KIRI (Sidebar) ═══ -->
      <aside class="w-full lg:w-[320px] xl:w-[340px] flex flex-col rounded-3xl border border-[#eaecf0] bg-white shadow-xs overflow-hidden shrink-0 min-h-[550px]">
        <!-- Search & Create Area (No break line) -->
        <div class="p-4 pb-3 flex flex-col gap-3 shrink-0">
          <div class="relative w-full">
            <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-[#98a2b3] pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" />
            </svg>
            <input
              id="dna-search-input"
              type="text"
              placeholder="Search Business DNA..."
              class="w-full h-9.5 pl-9 pr-3 rounded-xl border border-[#eaecf0] bg-white text-[12.5px] text-[#111827] placeholder:text-[#98a2b3] shadow-2xs outline-none focus:border-[#111827] focus:ring-1 focus:ring-[#111827] transition-all"
            />
          </div>

          <!-- Create Business DNA Button -->
          <button
            id="btn-sidebar-create-brand-kit"
            type="button"
            class="w-full h-12 rounded-2xl border border-dashed border-[#D0D5DD] hover:border-[#98a2b3] bg-white hover:bg-[#F9FAFB] flex items-center justify-center gap-2 text-[#667085] hover:text-[#344054] transition-all cursor-pointer shadow-2xs group"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-4 h-4 text-[#667085] group-hover:text-[#344054] shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M9 15C9 12.1716 9 10.7574 9.87868 9.87868C10.7574 9 12.1716 9 15 9L16 9C18.8284 9 20.2426 9 21.1213 9.87868C22 10.7574 22 12.1716 22 15V16C22 18.8284 22 20.2426 21.1213 21.1213C20.2426 22 18.8284 22 16 22H15C12.1716 22 10.7574 22 9.87868 21.1213C9 20.2426 9 18.8284 9 16L9 15Z" stroke-linejoin="round"></path>
              <path d="M16.9999 9C16.9975 6.04291 16.9528 4.51121 16.092 3.46243C15.9258 3.25989 15.7401 3.07418 15.5376 2.90796C14.4312 2 12.7875 2 9.5 2C6.21252 2 4.56878 2 3.46243 2.90796C3.25989 3.07417 3.07418 3.25989 2.90796 3.46243C2 4.56878 2 6.21252 2 9.5C2 12.7875 2 14.4312 2.90796 15.5376C3.07417 15.7401 3.25989 15.9258 3.46243 16.092C4.51121 16.9528 6.04291 16.9975 9 16.9999" stroke-linejoin="round"></path>
              <path d="M18 15.5L13 15.5M15.5 13V18"></path>
            </svg>
            <span class="text-[13px] font-medium text-[#667085] group-hover:text-[#344054]">Create Business DNA</span>
          </button>
        </div>

        <!-- Scrollable DNA Cards List -->
        <div id="dna-cards-container" class="flex-1 overflow-y-auto px-4 pb-4 pt-1 flex flex-col gap-3 custom-scrollbar">
          <!-- Dynamically populated via JavaScript -->
        </div>
      </aside>

      <!-- ═══ BENTO 2: SECTION KANAN (Workspace Detail, 70%) ═══ -->
      <main class="flex-1 flex flex-col rounded-3xl border border-[#eaecf0] bg-white shadow-xs overflow-hidden min-h-0 min-w-0">
        <!-- Panel Header (No break line) -->
        <div class="px-6 pt-5 pb-3.5 flex items-center justify-between shrink-0 bg-white">
          <div class="flex items-center gap-2.5 min-w-0">
            <h2 id="active-brand-name" class="text-[16px] font-bold text-[#111827] truncate">
              Untitled
            </h2>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <!-- Three Dot Menu -->
            <div class="relative" id="dna-menu-container">
              <button
                id="btn-dna-menu"
                type="button"
                title="More options"
                class="w-8.5 h-8.5 rounded-xl hover:bg-[#F4F4F6] text-[#121212] flex items-center justify-center transition-all cursor-pointer"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" color="#121212" fill="none" stroke="#121212" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 12V11.5M12 5V4.5M12 19V18.5M13 12C13 11.4477 12.5523 11 12 11C11.4477 11 11 11.4477 11 12C11 12.5523 11.4477 13 12 13C12.5523 13 13 12.5523 13 12ZM13 5C13 4.44772 12.5523 4 12 4C11.4477 4 11 4.44772 11 5C11 5.55228 11.4477 6 12 6C12.5523 6 13 5.55228 13 5ZM13 19C13 18.4477 12.5523 18 12 18C11.4477 18 11 18.4477 11 19C11 19.5523 11.4477 20 12 20C12.5523 20 13 19.5523 13 19Z"></path>
                </svg>
              </button>

              <!-- Dropdown Menu: Duplicate, Rename, Delete -->
              <div
                id="dna-dropdown-menu"
                class="hidden absolute right-0 top-full mt-1.5 z-40 w-44 rounded-2xl bg-white border border-[#eaecf0] shadow-xl py-1.5 animate-in fade-in zoom-in-95 duration-150 overflow-hidden"
              >
                <button
                  type="button"
                  id="menu-dna-duplicate"
                  class="w-full px-3.5 py-2 text-left text-[12.5px] font-medium text-[#111827] hover:bg-[#F9FAFB] flex items-center gap-2.5 transition-colors cursor-pointer"
                >
                  <svg class="w-4 h-4 text-[#667085]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                  <span>Duplicate</span>
                </button>
                <button
                  type="button"
                  id="menu-dna-rename"
                  class="w-full px-3.5 py-2 text-left text-[12.5px] font-medium text-[#111827] hover:bg-[#F9FAFB] flex items-center gap-2.5 transition-colors cursor-pointer"
                >
                  <svg class="w-4 h-4 text-[#667085]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                  <span>Rename</span>
                </button>
                <div class="h-px bg-[#eaecf0] my-1"></div>
                <button
                  type="button"
                  id="menu-dna-delete"
                  class="w-full px-3.5 py-2 text-left text-[12.5px] font-medium text-rose-600 hover:bg-rose-50 flex items-center gap-2.5 transition-colors cursor-pointer"
                >
                  <svg class="w-4 h-4 text-rose-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M19.5 5.5 18.8 17.1a3 3 0 0 1-3 2.9H8.2a3 3 0 0 1-3-2.9L4.5 5.5M3 5.5h18M9 5.5V3.5a1.5 1.5 0 0 1 1.5-1.5h3a1.5 1.5 0 0 1 1.5 1.5v2M10 10v5M14 10v5" /></svg>
                  <span>Delete</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Underline Tabs Navigation (White background with bottom line) -->
        <div class="shrink-0 px-6 pt-1 pb-0 bg-white border-b border-[#eaecf0]">
          <div class="flex items-center gap-6 -mb-px overflow-x-auto custom-scrollbar" aria-label="Business DNA Tabs">
            <button
              type="button"
              class="dna-tab-btn pb-3 text-[13px] font-semibold text-[#111827] border-b-2 border-[#111827] cursor-pointer select-none transition-colors shrink-0 whitespace-nowrap"
              data-tab="identity"
            >
              Identity
            </button>
            <button
              type="button"
              class="dna-tab-btn pb-3 text-[13px] font-medium text-[#667085] border-b-2 border-transparent hover:text-[#111827] cursor-pointer select-none transition-colors shrink-0 whitespace-nowrap"
              data-tab="products"
            >
              Product References
            </button>
            <button
              type="button"
              class="dna-tab-btn pb-3 text-[13px] font-medium text-[#667085] border-b-2 border-transparent hover:text-[#111827] cursor-pointer select-none transition-colors shrink-0 whitespace-nowrap"
              data-tab="knowledge"
            >
              Knowledge
            </button>
            <button
              type="button"
              class="dna-tab-btn pb-3 text-[13px] font-medium text-[#667085] border-b-2 border-transparent hover:text-[#111827] cursor-pointer select-none transition-colors shrink-0 whitespace-nowrap"
              data-tab="integration"
            >
              Integration
            </button>
          </div>
        </div>

        <!-- Scrollable Tab Content Area (Clean Form Flow, NOT chopped into bento boxes) -->
        <div class="flex-1 overflow-y-auto custom-scrollbar px-6 py-6">
          <div class="max-w-3xl space-y-6">
            
            <!-- ═══════════ TAB 1: IDENTITY ═══════════ -->
            <div id="tab-panel-identity" class="dna-tab-panel space-y-6">
              <!-- Import Business DNA Banner -->
              <button
                type="button"
                id="btn-import-dna-banner"
                class="w-full py-3.5 px-4.5 rounded-2xl border border-dashed border-[#D0D5DD] hover:border-[#98a2b3] bg-white hover:bg-[#FAFAFB] flex items-center gap-3.5 text-left transition-all cursor-pointer shadow-2xs group"
              >
                <div class="w-10 h-10 rounded-xl bg-[#F4F4F6] flex items-center justify-center shrink-0 text-[#98a2b3] group-hover:text-[#667085] transition-colors">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 16v1a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-1" />
                    <path d="M12 4v12" />
                    <path d="m16 8-4-4-4 4" />
                  </svg>
                </div>
                <div class="min-w-0 flex-1">
                  <h4 class="text-[13px] font-normal text-[#98a2b3] group-hover:text-[#667085] leading-tight transition-colors">Import Your Business DNA</h4>
                  <p class="text-[11.5px] font-normal text-[#98a2b3] mt-0.5 leading-snug">Analyze your website to build my Business DNA</p>
                </div>
              </button>

              <!-- Logo -->
              <div class="space-y-2.5">
                <label class="block text-[13px] font-bold text-[#111827]">Logo</label>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5">
                  <label class="aspect-square rounded-2xl border-2 border-dashed border-[#eaecf0] hover:border-[#98a2b3] bg-white hover:bg-[#F9FAFB] flex flex-col items-center justify-center gap-1.5 text-[#98a2b3] hover:text-[#111827] transition-all cursor-pointer shadow-2xs group text-center p-3">
                    <svg class="w-5 h-5 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 5v14M5 12h14"/></svg>
                    <span class="text-[11.5px] font-medium text-[#111827]">Upload logo</span>
                    <span class="text-[9.5px] text-[#98a2b3]">SVG, PNG, or JPG</span>
                    <input type="file" id="logo-file-input" accept="image/*" class="hidden" />
                  </label>
                  <div
                    id="logo-display-area"
                    class="hidden aspect-square rounded-2xl bg-white border border-[#eaecf0] flex items-center justify-center overflow-hidden shadow-2xs relative group"
                  ></div>
                </div>
                <p class="text-[11px] text-[#98a2b3]">Max file size 2MB.</p>
              </div>

              <!-- Business Overview -->
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <label class="block text-[13px] font-bold text-[#111827]">Business Overview</label>
                  <button
                    type="button"
                    id="btn-apply-overview"
                    class="hidden h-6 px-2.5 rounded-lg bg-[#111827] hover:bg-black text-white text-[11px] font-medium transition-all shadow-2xs cursor-pointer animate-in fade-in zoom-in-95 duration-150"
                  >
                    Apply
                  </button>
                </div>
                <textarea
                  id="field-brand-overview"
                  rows="2"
                  placeholder="Describe what your business does, key products, and target audience..."
                  class="w-full px-4 py-3.5 rounded-xl border border-transparent bg-[#F4F4F6] text-[13.5px] text-[#111827] placeholder:text-[#98a2b3] outline-none focus:bg-white focus:border-[#d0d5dd] focus:ring-2 focus:ring-black/5 transition-all resize-y min-h-[64px] leading-relaxed"
                ></textarea>
              </div>

              <!-- Design Guidance -->
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <label class="block text-[13px] font-bold text-[#111827]">Design Guidance</label>
                  <button
                    type="button"
                    id="btn-apply-guidance"
                    class="hidden h-6 px-2.5 rounded-lg bg-[#111827] hover:bg-black text-white text-[11px] font-medium transition-all shadow-2xs cursor-pointer animate-in fade-in zoom-in-95 duration-150"
                  >
                    Apply
                  </button>
                </div>
                <textarea
                  id="field-design-guidance"
                  rows="2"
                  placeholder="Describe your brand's design guidelines..."
                  class="w-full px-4 py-3.5 rounded-xl border border-transparent bg-[#F4F4F6] text-[13.5px] text-[#111827] placeholder:text-[#98a2b3] outline-none focus:bg-white focus:border-[#d0d5dd] focus:ring-2 focus:ring-black/5 transition-all resize-y min-h-[64px] leading-relaxed"
                ></textarea>
              </div>

              <!-- Color Palette -->
              <div class="space-y-2.5">
                <div class="flex items-center justify-between">
                  <label class="block text-[13px] font-bold text-[#111827]">Color Palette</label>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 items-start">
                  <!-- Add Color Card -->
                  <button
                    type="button"
                    id="btn-open-add-color-modal"
                    class="aspect-square rounded-2xl border-2 border-dashed border-[#eaecf0] hover:border-[#98a2b3] bg-white hover:bg-[#F9FAFB] flex flex-col items-center justify-center gap-1.5 text-[#98a2b3] hover:text-[#111827] transition-all cursor-pointer shadow-2xs group"
                  >
                    <svg class="w-5 h-5 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 5v14M5 12h14"/></svg>
                    <span class="text-[11.5px] font-medium text-[#111827]">Add color</span>
                  </button>
                  <div id="swatches-container" class="contents">
                    <!-- Populated by JS -->
                  </div>
                </div>
              </div>

              <!-- Fonts -->
              <div class="space-y-2.5">
                <label class="block text-[13px] font-bold text-[#111827]">Fonts</label>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 items-start relative">
                  <!-- Single Upload Font or Image Card -->
                  <label
                    for="font-file-input"
                    class="aspect-square rounded-2xl border-2 border-dashed border-[#eaecf0] hover:border-[#98a2b3] bg-white hover:bg-[#F9FAFB] flex flex-col items-center justify-center gap-1 text-[#98a2b3] hover:text-[#111827] transition-all cursor-pointer shadow-2xs p-2.5 text-center group"
                  >
                    <svg class="w-5 h-5 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 5v14M5 12h14"/></svg>
                    <span class="text-[11.5px] font-medium text-[#111827]">Upload font</span>
                    <span class="text-[9.5px] text-[#98a2b3] leading-tight px-1">Upload file font or reference</span>
                    <input type="file" id="font-file-input" accept=".ttf,.otf,.woff,.woff2,image/png,image/jpeg,image/jpg" class="hidden" />
                  </label>

                  <div id="fonts-cards-container" class="contents">
                    <!-- Populated by JS -->
                  </div>
                </div>
              </div>

              <!-- Photography -->
              <div class="space-y-2.5">
                <label class="block text-[13px] font-bold text-[#111827]">Photography</label>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 items-start">
                  <label for="photo-file-input" class="aspect-square rounded-2xl border-2 border-dashed border-[#eaecf0] hover:border-[#98a2b3] bg-white hover:bg-[#F9FAFB] flex flex-col items-center justify-center gap-1 text-[#98a2b3] hover:text-[#111827] transition-all cursor-pointer shadow-2xs p-2.5 text-center group">
                    <svg class="w-5 h-5 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 5v14M5 12h14"/></svg>
                    <span class="text-[11.5px] font-medium text-[#111827]">Add photo</span>
                    <span class="text-[9.5px] text-[#98a2b3] leading-tight px-1">JPG, PNG max 2MB</span>
                    <input type="file" id="photo-file-input" multiple accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="hidden" />
                  </label>
                  <div id="photography-grid" class="contents">
                    <!-- Populated by JS -->
                  </div>
                </div>
              </div>

              <!-- Moodboard -->
              <div class="space-y-2.5">
                <label class="block text-[13px] font-bold text-[#111827]">Moodboard</label>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 items-start">
                  <label for="moodboard-file-input" class="aspect-square rounded-2xl border-2 border-dashed border-[#eaecf0] hover:border-[#98a2b3] bg-white hover:bg-[#F9FAFB] flex flex-col items-center justify-center gap-1 text-[#98a2b3] hover:text-[#111827] transition-all cursor-pointer shadow-2xs p-2.5 text-center group">
                    <svg class="w-5 h-5 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 5v14M5 12h14"/></svg>
                    <span class="text-[11.5px] font-medium text-[#111827]">Add asset</span>
                    <span class="text-[9.5px] text-[#98a2b3] leading-tight px-1">JPG, PNG max 2MB</span>
                    <input type="file" id="moodboard-file-input" multiple accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="hidden" />
                  </label>
                  <div id="moodboard-grid" class="contents">
                    <!-- Populated by JS -->
                  </div>
                </div>
              </div>
            </div>

            <!-- ═══════════ TAB 2: PRODUCT REFERENCES ═══════════ -->
            <div id="tab-panel-products" class="dna-tab-panel hidden space-y-4">
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 items-start">
                <button
                  type="button"
                  id="btn-open-add-product-modal"
                  class="aspect-square rounded-2xl border-2 border-dashed border-[#eaecf0] hover:border-[#98a2b3] bg-white hover:bg-[#F9FAFB] flex flex-col items-center justify-center gap-1.5 text-[#98a2b3] hover:text-[#111827] transition-all cursor-pointer shadow-2xs p-3 text-center group"
                >
                  <svg class="w-5 h-5 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 5v14M5 12h14"/></svg>
                  <span class="text-[11.5px] font-medium text-[#111827]">Add product</span>
                  <span class="text-[9.5px] text-[#98a2b3] leading-tight">Details & photos</span>
                </button>
                <div id="product-cards-grid" class="contents">
                  <!-- Populated by JS -->
                </div>
              </div>
            </div>

            <!-- ═══════════ TAB 3: KNOWLEDGE ═══════════ -->
            <div id="tab-panel-knowledge" class="dna-tab-panel hidden space-y-3">
              <button
                type="button"
                id="btn-trigger-add-knowledge"
                class="w-full p-3.5 rounded-2xl border-2 border-dashed border-[#eaecf0] hover:border-[#98a2b3] bg-white hover:bg-[#F9FAFB] flex items-center justify-center gap-2 text-[#98a2b3] hover:text-[#111827] transition-all cursor-pointer shadow-2xs group"
              >
                <svg class="w-4 h-4 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 5v14M5 12h14"/></svg>
                <span class="text-[12px] font-medium text-[#111827]">Add knowledge</span>
                <span class="text-[11px] text-[#98a2b3]">— Add brand rules, background, or guidelines</span>
              </button>

              <div id="knowledge-items-container" class="space-y-2.5">
                <!-- Populated by JS -->
              </div>
            </div>

            <!-- ═══════════ TAB 4: INTEGRATION ═══════════ -->
            <div id="tab-panel-integration" class="dna-tab-panel hidden">
              <div id="connected-accounts-container">
                <!-- Populated by JS -->
              </div>
            </div>

          </div>
        </div>
      </main>
    </section>
  </div>

  <!-- ═══════════════════════════════════════════════════════ -->
  <!-- MODAL: CREATE BUSINESS DNA                                -->
