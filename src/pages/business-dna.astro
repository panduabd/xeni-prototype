  <!-- ═══════════════════════════════════════════════════════ -->
  <!-- CLIENT JAVASCRIPT: LOCAL STORAGE & WORKSPACE CONTROLLER  -->
  <!-- ═══════════════════════════════════════════════════════ -->
  <script is:inline>
    // Storage Keys
    const STORAGE_KEY_DNA_LIST = "xeni_business_dna_v2";
    const STORAGE_KEY_ACTIVE_ID = "xeni_active_business_dna_id";

    // Default DNA Icon SVG (Grey icon on light grey background)
    const DEFAULT_DNA_ICON_SVG = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-6 h-6 text-[#98A2B3]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 16.5C11 19.5376 13.4624 22 16.5 22C19.5376 22 22 19.5376 22 16.5C22 13.4624 19.5376 11 16.5 11C13.4624 11 11 13.4624 11 16.5Z"></path><path d="M7 16H3.54895C2.69349 16 2 15.3065 2 14.4511C2 14.1565 2.08401 13.868 2.24216 13.6195L8.46312 3.84366C8.79751 3.3182 9.37717 3 10 3C10.6228 3 11.2025 3.3182 11.5369 3.84366L14 7.71429"></path><path d="M19.5 2.9375V4.5M19.5 4.5V6.0625M19.5 4.5H18.25M19.5 4.5H20.75M22 4.5L20.9156 4.13852C20.4179 3.97263 20.0274 3.58211 19.8615 3.08443L19.5 2L19.1385 3.08443C18.9726 3.58211 18.5821 3.97263 18.0844 4.13852L17 4.5L18.0844 4.86148C18.5821 5.02737 18.9726 5.41789 19.1385 5.91557L19.5 7L19.8615 5.91557C20.0274 5.41789 20.4179 5.02737 20.9156 4.86148L22 4.5Z"></path></svg>`;

    // Application State
    let dnaList = [];
    let activeDnaId = null;
    let selectedCategoryFilter = "all";
    let viewedImageContext = null; // { type: 'photo'|'moodboard', index: 0 }

    // Toast Notification
    function showToast(message, type = "success") {
      const container = document.getElementById("toast-container");
      if (!container) return;

      const toast = document.createElement("div");
      toast.className = `pointer-events-auto px-4 py-2.5 rounded-xl text-[12.5px] font-medium shadow-md border flex items-center gap-2 animate-in slide-in-from-bottom-2 duration-200 ${
        type === "success"
          ? "bg-zinc-900 text-white border-zinc-800"
          : type === "error"
          ? "bg-rose-600 text-white border-rose-700"
          : "bg-white text-zinc-900 border-zinc-200"
      }`;

      toast.innerHTML = `
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          ${type === "success" ? '<path d="m4 12.5 5.5 5.5L20 6" />' : '<path d="m18 6-12 12M6 6l12 12" />'}
        </svg>
        <span>${message}</span>
      `;

      container.appendChild(toast);
      setTimeout(() => {
        toast.classList.add("opacity-0", "transition-opacity", "duration-200");
        setTimeout(() => toast.remove(), 200);
      }, 3000);
    }

    // ─── Initialize ───
    function init() {
      loadDataFromStorage();
      bindEventListeners();
      renderUI();
    }

    // ─── LocalStorage Persistence ───
    function loadDataFromStorage() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY_DNA_LIST);
        if (raw) {
          dnaList = JSON.parse(raw);
        } else {
          // CONDITION: Default is completely EMPTY!
          dnaList = [];
        }

        activeDnaId = localStorage.getItem(STORAGE_KEY_ACTIVE_ID);
        if (!dnaList.find((d) => d.id === activeDnaId)) {
          activeDnaId = dnaList.length > 0 ? dnaList[0].id : null;
        }
      } catch (e) {
        console.error("Failed loading from localStorage", e);
        dnaList = [];
        activeDnaId = null;
      }
    }

    function saveDataToStorage() {
      try {
        localStorage.setItem(STORAGE_KEY_DNA_LIST, JSON.stringify(dnaList));
        if (activeDnaId) {
          localStorage.setItem(STORAGE_KEY_ACTIVE_ID, activeDnaId);
        } else {
          localStorage.removeItem(STORAGE_KEY_ACTIVE_ID);
        }
      } catch (e) {
        console.error("Failed saving to localStorage", e);
        showToast("Storage quota exceeded", "error");
      }
    }

    // ─── UI Router ───
    function renderUI() {
      const emptyView = document.getElementById("dna-empty-state");
      const workspaceView = document.getElementById("dna-workspace");

      if (!dnaList || dnaList.length === 0) {
        emptyView?.classList.remove("hidden");
        workspaceView?.classList.add("hidden");
        return;
      }

      emptyView?.classList.add("hidden");
      workspaceView?.classList.remove("hidden");

      renderSidebarList();
      renderActiveWorkspace();
    }

    // ─── Sidebar Render ───
    function renderSidebarList() {
      const container = document.getElementById("dna-cards-container");
      if (!container) return;

      const searchQuery = (document.getElementById("dna-search-input")?.value || "").toLowerCase().trim();

      const filtered = dnaList.filter((dna) => {
        const name = dna.name || "Untitled";
        return !searchQuery || name.toLowerCase().includes(searchQuery);
      });

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="py-8 text-center text-[12.5px] text-[#98a2b3]">
            No Business DNA found.
          </div>
        `;
        return;
      }

      container.innerHTML = filtered.map((dna) => {
        const isActive = dna.id === activeDnaId;
        const displayName = dna.name || "Untitled";

        return `
          <div
            class="dna-card-item relative group p-4 rounded-2xl transition-all cursor-pointer select-none flex flex-col gap-3.5 border ${
              isActive
                ? "bg-[#F4F4F6] border-[#EAECF0]"
                : "bg-white border-[#F2F4F7] hover:border-[#EAECF0] hover:bg-[#FAFAFA]"
            }"
            data-id="${dna.id}"
          >
            <!-- Top Row: Title + Dropdown Options -->
            <div class="flex items-center justify-between gap-2">
              <h4 class="text-[14px] font-semibold text-[#111827] truncate leading-tight">${escapeHtml(displayName)}</h4>
              
              <div class="relative">
                <button
                  type="button"
                  class="btn-card-menu w-6.5 h-6.5 rounded-lg border-0 border-none outline-none flex items-center justify-center text-[#667085] hover:text-[#121212] hover:bg-black/5 transition-colors cursor-pointer shrink-0"
                  data-id="${dna.id}"
                  title="More options"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" color="#121212" fill="none" stroke="#121212" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 12H12.5M19 12H19.5M5 12H5.5M12 13C12.5523 13 13 12.5523 13 12C13 11.4477 12.5523 11 12 11C11.4477 11 11 11.4477 11 12C11 12.5523 11.4477 13 12 13ZM19 13C19.5523 13 20 12.5523 20 12C20 11.4477 19.5523 11 19 11C18.4477 11 18 11.4477 18 12C18 12.5523 18.4477 13 19 13ZM5 13C5.55228 13 6 12.5523 6 12C6 11.4477 5.55228 11 5 11C4.44772 11 4 11.4477 4 12C4 12.5523 4.44772 13 5 13Z"></path>
                  </svg>
                </button>

                <!-- Dropdown Popup -->
                <div
                  class="card-dropdown-menu hidden absolute right-0 top-full mt-1 z-40 w-32 rounded-xl bg-white border border-[#eaecf0] shadow-lg py-1 overflow-hidden text-left animate-in fade-in zoom-in-95 duration-100"
                  data-id="${dna.id}"
                >
                  <button
                    type="button"
                    class="btn-card-duplicate w-full px-3 py-1.5 text-left text-[12px] font-medium text-[#111827] hover:bg-[#F9FAFB] flex items-center gap-2 transition-colors cursor-pointer"
                    data-id="${dna.id}"
                  >
                    <svg class="w-3.5 h-3.5 text-[#667085]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                    <span>Duplicate</span>
                  </button>
                  <div class="h-px bg-[#eaecf0] my-1"></div>
                  <button
                    type="button"
                    class="btn-card-delete w-full px-3 py-1.5 text-left text-[12px] font-medium text-rose-600 hover:bg-rose-50 flex items-center gap-2 transition-colors cursor-pointer"
                    data-id="${dna.id}"
                  >
                    <svg class="w-3.5 h-3.5 text-rose-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M19.5 5.5 18.8 17.1a3 3 0 0 1-3 2.9H8.2a3 3 0 0 1-3-2.9L4.5 5.5M3 5.5h18M9 5.5V3.5a1.5 1.5 0 0 1 1.5-1.5h3a1.5 1.5 0 0 1 1.5 1.5v2M10 10v5M14 10v5" /></svg>
                    <span>Delete</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Bottom: Logo / Placeholder Box -->
            <div class="w-16 h-16 rounded-xl bg-[#E5E7EB] flex items-center justify-center overflow-hidden shrink-0 p-3.5">
              ${
                dna.logoUrl
                  ? `<img src="${dna.logoUrl}" alt="${escapeHtml(displayName)}" class="w-full h-full object-contain" />`
                  : DEFAULT_DNA_ICON_SVG
              }
            </div>
          </div>
        `;
      }).join("");

      // Card Selection Click
      container.querySelectorAll(".dna-card-item").forEach((el) => {
        el.addEventListener("click", (e) => {
          if (e.target.closest(".btn-card-menu") || e.target.closest(".card-dropdown-menu")) return;
          const id = el.getAttribute("data-id");
          if (id && id !== activeDnaId) {
            activeDnaId = id;
            saveDataToStorage();
            renderUI();
          }
        });
      });

      // Card Dropdown Toggle
      container.querySelectorAll(".btn-card-menu").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const menu = btn.nextElementSibling;
          document.querySelectorAll(".card-dropdown-menu").forEach((m) => {
            if (m !== menu) m.classList.add("hidden");
          });
          menu?.classList.toggle("hidden");
        });
      });

      // Card Duplicate
      container.querySelectorAll(".btn-card-duplicate").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const id = btn.getAttribute("data-id");
          const targetDna = dnaList.find((d) => d.id === id);
          if (!targetDna) return;

          const duplicated = JSON.parse(JSON.stringify(targetDna));
          duplicated.id = `dna_${Date.now()}`;
          duplicated.name = `${targetDna.name || "Untitled"} (Copy)`;
          dnaList.unshift(duplicated);
          activeDnaId = duplicated.id;
          saveDataToStorage();
          renderUI();
          showToast(`Duplicated as "${duplicated.name}"`);
        });
      });

      // Card Delete
      container.querySelectorAll(".btn-card-delete").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const id = btn.getAttribute("data-id");
          const targetDna = dnaList.find((d) => d.id === id);
          if (!targetDna) return;

          if (confirm(`Are you sure you want to delete "${targetDna.name || 'Untitled'}"?`)) {
            const idx = dnaList.findIndex((d) => d.id === id);
            if (idx > -1) {
              dnaList.splice(idx, 1);
              activeDnaId = dnaList.length > 0 ? dnaList[0].id : null;
              saveDataToStorage();
              renderUI();
              showToast("Business DNA deleted");
            }
          }
        });
      });
    }

    function getActiveDNA() {
      return dnaList.find((d) => d.id === activeDnaId) || null;
    }

    function renderActiveAvatar(active) {
      const brandAvatar = document.getElementById("active-brand-avatar");
      if (!brandAvatar || !active) return;
      if (active.logoUrl) {
        brandAvatar.className = "w-8 h-8 rounded-xl flex items-center justify-center shrink-0 overflow-hidden shadow-2xs border border-[#eaecf0] bg-white";
        brandAvatar.style.backgroundColor = "";
        brandAvatar.innerHTML = `<img src="${active.logoUrl}" alt="${escapeHtml(active.name || 'Untitled')}" class="w-full h-full object-cover" />`;
      } else {
        brandAvatar.className = "w-8 h-8 rounded-xl flex items-center justify-center shrink-0 overflow-hidden shadow-2xs border border-[#eaecf0] bg-[#F4F4F6] p-1.5";
        brandAvatar.style.backgroundColor = "";
        brandAvatar.innerHTML = DEFAULT_DNA_ICON_SVG;
      }
    }

    // ─── Active Workspace Render ───
    function renderActiveWorkspace() {
      const active = getActiveDNA();
      if (!active) return;

      // Header bar
      renderActiveAvatar(active);

      const brandNameEl = document.getElementById("active-brand-name");
      if (brandNameEl) brandNameEl.textContent = active.name || "Untitled";

      // Tab 1: Identity fields
      const fieldOverview = document.getElementById("field-brand-overview");
      if (fieldOverview) fieldOverview.value = active.overview || "";
      document.getElementById("btn-apply-overview")?.classList.add("hidden");

      const fieldGuidance = document.getElementById("field-design-guidance");
      if (fieldGuidance) fieldGuidance.value = active.guidance || "";
      document.getElementById("btn-apply-guidance")?.classList.add("hidden");

      // Logo
      renderLogoArea(active);

      // Colors
      renderColorsTab(active);

      // Typography
      renderTypographyTab(active);

      // Photos & Moodboard
      renderPhotosAndMoodboard(active);

      // Tab 2: Products
      renderProductsTab(active);

      // Tab 3: Knowledge
      renderKnowledgeTab(active);

      // Tab 4: Integration
      renderIntegrationTab(active);
    }

    function checkOverviewDirty() {
      const active = getActiveDNA();
      const btn = document.getElementById("btn-apply-overview");
      if (!active || !btn) return;

      const curOverview = (document.getElementById("field-brand-overview")?.value ?? "").trim();
      const savedOverview = (active.overview || "").trim();

      if (curOverview !== savedOverview) {
        btn.classList.remove("hidden");
      } else {
        btn.classList.add("hidden");
      }
    }

    function checkGuidanceDirty() {
      const active = getActiveDNA();
      const btn = document.getElementById("btn-apply-guidance");
      if (!active || !btn) return;

      const curGuidance = (document.getElementById("field-design-guidance")?.value ?? "").trim();
      const savedGuidance = (active.guidance || "").trim();

      if (curGuidance !== savedGuidance) {
        btn.classList.remove("hidden");
      } else {
        btn.classList.add("hidden");
      }
    }

    // ─── Logo Render ───
    function renderLogoArea(active) {
      const area = document.getElementById("logo-display-area");
      if (!area) return;

      if (active.logoUrl) {
        area.classList.remove("hidden");
        area.className = "aspect-square rounded-2xl bg-white border border-[#eaecf0] flex items-center justify-center overflow-hidden shadow-2xs relative group";
        area.onclick = null;
        area.title = "";
        area.innerHTML = `
          <img src="${active.logoUrl}" alt="Logo" class="w-full h-full object-contain p-2" />
          <button type="button" id="btn-remove-logo" class="absolute top-2 right-2 p-1.5 rounded-lg bg-black/60 hover:bg-black text-white opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer" title="Remove logo">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        `;

        document.getElementById("btn-remove-logo")?.addEventListener("click", (e) => {
          e.stopPropagation();
          active.logoUrl = "";
          saveDataToStorage();
          renderLogoArea(active);
          renderActiveAvatar(active);
          renderSidebarList();
          showToast("Logo removed");
        });
      } else {
        area.classList.add("hidden");
        area.innerHTML = "";
      }
    }

    // ─── Colors Render ───
    function renderColorsTab(active) {
      const container = document.getElementById("swatches-container");
      if (!container) return;

      const colors = active.colors || {};
      const customCols = active.customColors || [];

      const roleDefinitions = [
        { key: "primary", label: "Primary" },
        { key: "secondary", label: "Secondary" },
        { key: "accent", label: "Accent" },
        { key: "dark", label: "Dark" },
        { key: "light", label: "Light" },
      ];

      // Only render colors that are actually defined in active.colors
      const activeRoles = roleDefinitions.filter((role) => Boolean(colors[role.key] && colors[role.key].trim()));

      let html = activeRoles.map((role) => {
        const val = colors[role.key];
        return `
          <div class="flex flex-col group cursor-pointer color-card-item" data-role="${role.key}" data-label="${escapeHtml(role.label)}" data-hex="${val}">
            <div class="aspect-square rounded-2xl border border-[#eaecf0] shadow-2xs relative overflow-hidden transition-all hover:scale-[1.02] flex items-end justify-between p-2.5" style="background-color: ${val};">
              <button type="button" class="btn-delete-role-color text-white bg-black/40 hover:bg-rose-600 rounded-lg p-1.5 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer" data-role="${role.key}" title="Delete color">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 6-12 12M6 6l12 12"/></svg>
              </button>
              <span class="opacity-0 group-hover:opacity-100 transition-opacity bg-black/40 hover:bg-black/60 text-white rounded-lg p-1.5 shadow-sm">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
              </span>
            </div>
            <div class="mt-1.5 text-center">
              <span class="block text-[12px] font-semibold text-[#111827] truncate">${escapeHtml(role.label)}</span>
              <span class="block text-[10.5px] font-mono text-[#667085] uppercase">${val}</span>
            </div>
          </div>
        `;
      }).join("");

      customCols.forEach((c, idx) => {
        html += `
          <div class="flex flex-col group cursor-pointer color-custom-card-item" data-index="${idx}" data-name="${escapeHtml(c.name || 'Custom')}" data-hex="${c.hex}">
            <div class="aspect-square rounded-2xl border border-[#eaecf0] shadow-2xs relative overflow-hidden transition-all hover:scale-[1.02] flex items-end justify-between p-2.5" style="background-color: ${c.hex};">
              <button type="button" class="btn-delete-custom-color text-white bg-black/40 hover:bg-rose-600 rounded-lg p-1.5 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer" data-index="${idx}" title="Delete color">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 6-12 12M6 6l12 12"/></svg>
              </button>
              <span class="opacity-0 group-hover:opacity-100 transition-opacity bg-black/40 hover:bg-black/60 text-white rounded-lg p-1.5 shadow-sm">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
              </span>
            </div>
            <div class="mt-1.5 text-center">
              <span class="block text-[12px] font-semibold text-[#111827] truncate">${escapeHtml(c.name || 'Custom')}</span>
              <span class="block text-[10.5px] font-mono text-[#667085] uppercase">${c.hex}</span>
            </div>
          </div>
        `;
      });

      container.innerHTML = html;

      // Click on role color card to edit via modal
      container.querySelectorAll(".color-card-item").forEach((el) => {
        el.addEventListener("click", (e) => {
          if (e.target.closest(".btn-delete-role-color")) return;
          const role = el.getAttribute("data-role") || "primary";
          const hex = el.getAttribute("data-hex") || "#34D399";
          const label = el.getAttribute("data-label") || "Brand Color";
          openColorModal({ role, hex, name: label, isCustom: false });
        });
      });

      // Delete role color button
      container.querySelectorAll(".btn-delete-role-color").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const role = btn.getAttribute("data-role");
          if (role && active.colors) {
            delete active.colors[role];
            saveDataToStorage();
            renderColorsTab(active);
            showToast("Color removed");
          }
        });
      });

      // Click on custom color card to edit
      container.querySelectorAll(".color-custom-card-item").forEach((el) => {
        el.addEventListener("click", (e) => {
          if (e.target.closest(".btn-delete-custom-color")) return;
          const idx = parseInt(el.getAttribute("data-index") || "0", 10);
          const hex = el.getAttribute("data-hex") || "#34D399";
          const name = el.getAttribute("data-name") || "Custom Accent";
          openColorModal({ role: "custom", hex, name, isCustom: true, customIndex: idx });
        });
      });

      container.querySelectorAll(".btn-delete-custom-color").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const idx = parseInt(btn.getAttribute("data-index") || "0", 10);
          if (active.customColors) {
            active.customColors.splice(idx, 1);
            saveDataToStorage();
            renderColorsTab(active);
            showToast("Color removed");
          }
        });
      });
    }

    // ─── Typography Render ───
    function renderTypographyTab(active) {
      const container = document.getElementById("fonts-cards-container");
      if (!container) return;

      const heading = active.fonts?.heading || "";
      const body = active.fonts?.body || "";

      let html = "";

      if (heading && heading.trim()) {
        const hClean = heading.split(",")[0].replace(/['"]/g, "").trim();
        html += `
          <div class="flex flex-col group cursor-pointer font-card-item" data-role="heading" data-font="${escapeHtml(heading)}" data-name="${escapeHtml(hClean)}">
            <div class="aspect-square rounded-2xl bg-[#F9FAFB] border border-[#eaecf0] flex items-center justify-center text-[#111827] font-bold text-[36px] shadow-2xs group-hover:bg-white group-hover:border-[#d0d5dd] transition-all relative overflow-hidden">
              <button type="button" class="btn-delete-font absolute top-2 right-2 text-[#98a2b3] hover:text-rose-600 bg-white/90 hover:bg-white rounded-lg p-1.5 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer shadow-2xs border border-[#eaecf0]" data-role="heading" title="Delete font">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 6-12 12M6 6l12 12"/></svg>
              </button>
              <span style="font-family: ${escapeHtml(heading)};">Aa</span>
            </div>
            <div class="mt-1.5 text-center">
              <span class="block text-[12px] font-semibold text-[#111827] truncate">${escapeHtml(hClean)}</span>
              <span class="block text-[10.5px] text-[#98a2b3]">Primary Font</span>
            </div>
          </div>
        `;
      }

      if (body && body.trim()) {
        const bClean = body.split(",")[0].replace(/['"]/g, "").trim();
        html += `
          <div class="flex flex-col group cursor-pointer font-card-item" data-role="body" data-font="${escapeHtml(body)}" data-name="${escapeHtml(bClean)}">
            <div class="aspect-square rounded-2xl bg-[#F9FAFB] border border-[#eaecf0] flex items-center justify-center text-[#111827] font-bold text-[36px] shadow-2xs group-hover:bg-white group-hover:border-[#d0d5dd] transition-all relative overflow-hidden">
              <button type="button" class="btn-delete-font absolute top-2 right-2 text-[#98a2b3] hover:text-rose-600 bg-white/90 hover:bg-white rounded-lg p-1.5 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer shadow-2xs border border-[#eaecf0]" data-role="body" title="Delete font">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 6-12 12M6 6l12 12"/></svg>
              </button>
              <span style="font-family: ${escapeHtml(body)};">Aa</span>
            </div>
            <div class="mt-1.5 text-center">
              <span class="block text-[12px] font-semibold text-[#111827] truncate">${escapeHtml(bClean)}</span>
              <span class="block text-[10.5px] text-[#98a2b3]">Secondary Font</span>
            </div>
          </div>
        `;
      }

      container.innerHTML = html;

      // Click card to view font details modal
      container.querySelectorAll(".font-card-item").forEach((card) => {
        card.addEventListener("click", (e) => {
          if (e.target.closest(".btn-delete-font")) return;
          const role = card.getAttribute("data-role") || "heading";
          const font = card.getAttribute("data-font") || "";
          const name = card.getAttribute("data-name") || "";
          openFontViewModal(role, name, font);
        });
      });

      // Delete font button
      container.querySelectorAll(".btn-delete-font").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const role = btn.getAttribute("data-role");
          if (role && active.fonts) {
            delete active.fonts[role];
            saveDataToStorage();
            renderTypographyTab(active);
            showToast("Font removed");
          }
        });
      });
    }

    // ─── Color Modal State & Logic ───
    let colorModalContext = null;

    function openColorModal(ctx = null) {
      const modal = document.getElementById("modal-add-color");
      if (!modal) return;

      colorModalContext = ctx || { role: "accent", hex: "#34D399", name: "Accent Color", isCustom: false };

      const titleEl = document.getElementById("modal-color-title");
      const hexInput = document.getElementById("modal-color-hex-input");
      const nativePicker = document.getElementById("modal-color-native-picker");
      const roleSelect = document.getElementById("modal-color-role-select");
      const nameInput = document.getElementById("modal-color-name-input");

      if (titleEl) titleEl.textContent = ctx ? (ctx.isCustom || ctx.role ? "Edit Brand Color" : "Add Brand Color") : "Add Brand Color";
      if (hexInput) hexInput.value = colorModalContext.hex.toUpperCase();
      if (nativePicker) nativePicker.value = colorModalContext.hex;
      if (roleSelect) roleSelect.value = colorModalContext.role || "accent";
      if (nameInput) nameInput.value = colorModalContext.name || "";

      syncColorModalPreview(colorModalContext.hex);
      modal.classList.remove("hidden");
    }

    function closeColorModal() {
      document.getElementById("modal-add-color")?.classList.add("hidden");
      colorModalContext = null;
    }

    function syncColorModalPreview(hex) {
      const previewBox = document.getElementById("modal-color-preview-box");
      const previewHex = document.getElementById("modal-color-preview-hex");
      const indicator = document.getElementById("modal-color-picker-indicator");

      if (previewBox) previewBox.style.backgroundColor = hex;
      if (previewHex) previewHex.textContent = hex.toUpperCase();
      if (indicator) indicator.style.backgroundColor = hex;
    }

    function saveColorFromModal() {
      const active = getActiveDNA();
      if (!active) return;

      const hexInput = document.getElementById("modal-color-hex-input");
      const roleSelect = document.getElementById("modal-color-role-select");
      const nameInput = document.getElementById("modal-color-name-input");

      let hex = hexInput?.value.trim() || "#34D399";
      if (!hex.startsWith("#")) hex = "#" + hex;
      const role = roleSelect?.value || "accent";
      const name = nameInput?.value.trim() || (role.charAt(0).toUpperCase() + role.slice(1));

      if (colorModalContext && colorModalContext.isCustom && typeof colorModalContext.customIndex === "number") {
        if (!active.customColors) active.customColors = [];
        active.customColors[colorModalContext.customIndex] = { name, hex };
      } else if (role === "custom") {
        if (!active.customColors) active.customColors = [];
        active.customColors.push({ name, hex });
      } else {
        if (!active.colors) active.colors = {};
        active.colors[role] = hex;
      }

      saveDataToStorage();
      renderColorsTab(active);
      closeColorModal();
      showToast("Color saved to Business DNA!");
    }

    // ─── Font View Modal Logic ───
    let currentViewedFontRole = null;

    function openFontViewModal(role, name, fontFamily) {
      currentViewedFontRole = role;
      const modal = document.getElementById("modal-font-view");
      if (!modal) return;

      const nameEl = document.getElementById("font-view-name");
      const roleEl = document.getElementById("font-view-role");
      const largeEl = document.getElementById("font-view-display-large");
      const alphaEl = document.getElementById("font-view-alphabet");
      const previewEl = document.getElementById("font-view-preview-sample");

      if (nameEl) nameEl.textContent = name;
      if (roleEl) roleEl.textContent = role === "heading" ? "Primary Font" : "Secondary Font";
      if (largeEl) largeEl.style.fontFamily = fontFamily;
      if (alphaEl) alphaEl.style.fontFamily = fontFamily;
      if (previewEl) previewEl.style.fontFamily = fontFamily;

      modal.classList.remove("hidden");
    }

    function closeFontViewModal() {
      document.getElementById("modal-font-view")?.classList.add("hidden");
      currentViewedFontRole = null;
    }

    // ─── Add / Edit Product Reference Logic ───
    let stagedProductImages = [];
    let editingProductIndex = null;

    function renderStagedProductImages() {
      const grid = document.getElementById("product-staged-images-grid");
      const badge = document.getElementById("product-images-count-badge");
      if (badge) badge.textContent = `${stagedProductImages.length} / 25 uploaded`;

      if (!grid) return;
      if (stagedProductImages.length === 0) {
        grid.classList.add("hidden");
        grid.innerHTML = "";
        return;
      }

      grid.classList.remove("hidden");
      grid.innerHTML = stagedProductImages.map((img, idx) => `
        <div class="relative group/staged aspect-square rounded-xl overflow-hidden bg-zinc-100 border border-[#EAECF0]">
          <img src="${img.url}" alt="${escapeHtml(img.name || 'preview')}" class="w-full h-full object-cover" />
          <button
            type="button"
            data-remove-idx="${idx}"
            class="btn-remove-staged-img absolute top-1 right-1 w-5 h-5 rounded-full bg-black/70 hover:bg-red-600 text-white flex items-center justify-center opacity-0 group-hover/staged:opacity-100 transition-all cursor-pointer"
            title="Remove image"
          >
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
      `).join("");

      grid.querySelectorAll(".btn-remove-staged-img").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const idx = parseInt(btn.getAttribute("data-remove-idx") || "0", 10);
          stagedProductImages.splice(idx, 1);
          renderStagedProductImages();
        });
      });
    }

    function updateCategorySpecsVisibility() {
      const cat = document.getElementById("input-product-category")?.value;
      const specs = document.getElementById("product-physical-specs");
      if (specs) {
        if (cat === "Physical Product") {
          specs.classList.remove("hidden");
        } else {
          specs.classList.add("hidden");
        }
      }
    }

    function openAddProductModal() {
      editingProductIndex = null;
      const modal = document.getElementById("modal-add-product");
      const form = document.getElementById("form-add-product");
      if (form) form.reset();
      stagedProductImages = [];
      renderStagedProductImages();
      updateCategorySpecsVisibility();

      const titleEl = document.getElementById("modal-product-title");
      if (titleEl) titleEl.textContent = "Add Product Reference";
      const submitBtn = document.getElementById("btn-submit-product");
      if (submitBtn) submitBtn.textContent = "Add Product";
      const delBtn = document.getElementById("btn-delete-product-in-modal");
      if (delBtn) delBtn.classList.add("hidden");

      if (modal) {
        modal.classList.remove("hidden");
        document.getElementById("input-product-name")?.focus();
      }
    }

    function openEditProductModal(idx) {
      const active = getActiveDNA();
      if (!active || !active.products || !active.products[idx]) return;
      const prod = active.products[idx];
      editingProductIndex = idx;

      const modal = document.getElementById("modal-add-product");
      const form = document.getElementById("form-add-product");
      if (form) form.reset();

      const titleEl = document.getElementById("modal-product-title");
      if (titleEl) titleEl.textContent = "Edit Product Reference";
      const submitBtn = document.getElementById("btn-submit-product");
      if (submitBtn) submitBtn.textContent = "Save";
      const delBtn = document.getElementById("btn-delete-product-in-modal");
      if (delBtn) delBtn.classList.remove("hidden");

      const nameInput = document.getElementById("input-product-name");
      const catInput = document.getElementById("input-product-category");
      const descInput = document.getElementById("input-product-desc");
      const widthInput = document.getElementById("input-product-width");
      const heightInput = document.getElementById("input-product-height");
      const weightInput = document.getElementById("input-product-weight");

      if (nameInput) nameInput.value = prod.name || "";
      if (catInput) catInput.value = prod.category || "Physical Product";
      if (descInput) descInput.value = prod.description || "";
      if (widthInput) widthInput.value = prod.width || "";
      if (heightInput) heightInput.value = prod.height || "";
      if (weightInput) weightInput.value = prod.weight || "";

      const images = prod.images || (prod.url ? [prod.url] : (prod.image ? [prod.image] : []));
      stagedProductImages = images.map((u, i) => ({
        id: `img_${Date.now()}_${i}`,
        url: u,
        name: `Image ${i + 1}`
      }));

      renderStagedProductImages();
      updateCategorySpecsVisibility();

      if (modal) {
        modal.classList.remove("hidden");
        document.getElementById("input-product-name")?.focus();
      }
    }

    function closeAddProductModal() {
      document.getElementById("modal-add-product")?.classList.add("hidden");
      stagedProductImages = [];
      editingProductIndex = null;
    }

    function openProductViewModal(prod, idx) {
      openEditProductModal(idx);
    }

    function closeProductViewModal() {
      closeAddProductModal();
    }

    // ─── Add / Edit Knowledge Modal Logic ───
    let editingKnowledgeIndex = null;

    function countWords(str) {
      if (!str) return 0;
      const matches = str.trim().match(/\S+/g);
      return matches ? matches.length : 0;
    }

    function updateKnowledgeWordCount() {
      const contentInput = document.getElementById("input-knowledge-content");
      const countEl = document.getElementById("knowledge-word-count");
      const submitBtn = document.getElementById("btn-submit-knowledge");
      if (!contentInput || !countEl) return;

      const words = countWords(contentInput.value);
      const maxWords = 1000;

      if (words > maxWords) {
        countEl.textContent = `${words.toLocaleString()} / ${maxWords.toLocaleString()} words (Max 1,000 words)`;
        countEl.classList.remove("text-[#98A2B3]");
        countEl.classList.add("text-rose-500", "font-semibold");
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.classList.add("opacity-50", "cursor-not-allowed");
        }
      } else {
        countEl.textContent = `${words.toLocaleString()} / ${maxWords.toLocaleString()} words`;
        countEl.classList.add("text-[#98A2B3]");
        countEl.classList.remove("text-rose-500", "font-semibold");
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.classList.remove("opacity-50", "cursor-not-allowed");
        }
      }
    }

    function openAddKnowledgeModal() {
      editingKnowledgeIndex = null;
      const modal = document.getElementById("modal-add-knowledge");
      const form = document.getElementById("form-add-knowledge");
      if (form) form.reset();

      const titleEl = document.getElementById("modal-knowledge-title");
      if (titleEl) titleEl.textContent = "Add Knowledge";
      const submitBtn = document.getElementById("btn-submit-knowledge");
      if (submitBtn) submitBtn.textContent = "Save";
      const delBtn = document.getElementById("btn-delete-knowledge-in-modal");
      if (delBtn) delBtn.classList.add("hidden");

      updateKnowledgeWordCount();

      if (modal) {
        modal.classList.remove("hidden");
        document.getElementById("input-knowledge-title")?.focus();
      }
    }

    function openEditKnowledgeModal(idx) {
      const active = getActiveDNA();
      if (!active || !active.knowledge || !active.knowledge[idx]) return;
      const item = active.knowledge[idx];
      editingKnowledgeIndex = idx;

      const modal = document.getElementById("modal-add-knowledge");
      const form = document.getElementById("form-add-knowledge");
      if (form) form.reset();

      const titleEl = document.getElementById("modal-knowledge-title");
      if (titleEl) titleEl.textContent = "Edit Knowledge";
      const submitBtn = document.getElementById("btn-submit-knowledge");
      if (submitBtn) submitBtn.textContent = "Save";
      const delBtn = document.getElementById("btn-delete-knowledge-in-modal");
      if (delBtn) delBtn.classList.remove("hidden");

      const titleInput = document.getElementById("input-knowledge-title");
      const contentInput = document.getElementById("input-knowledge-content");

      if (titleInput) titleInput.value = item.title || "";
      if (contentInput) contentInput.value = item.content || "";

      updateKnowledgeWordCount();

      if (modal) {
        modal.classList.remove("hidden");
        document.getElementById("input-knowledge-title")?.focus();
      }
    }

    function closeAddKnowledgeModal() {
      document.getElementById("modal-add-knowledge")?.classList.add("hidden");
      editingKnowledgeIndex = null;
    }

    function openKnowledgeViewModal(item, idx) {
      openEditKnowledgeModal(idx);
    }

    function closeKnowledgeViewModal() {
      closeAddKnowledgeModal();
    }

