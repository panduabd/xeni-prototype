      });

      document.getElementById("form-import-dna")?.addEventListener("submit", (e) => {
        e.preventDefault();
        const urlInput = document.getElementById("input-import-url");
        const url = urlInput?.value.trim();
        if (!url) return;

        const submitBtn = document.getElementById("btn-submit-import-dna");
        if (submitBtn) {
          submitBtn.innerHTML = `
            <svg class="w-3.5 h-3.5 animate-spin text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12a9 9 0 1 1-6.219-8.56" />
            </svg>
            <span>Analyzing...</span>
          `;
          submitBtn.disabled = true;
        }

        setTimeout(() => {
          let brandName = "My Brand";
          try {
            const parsed = new URL(url.startsWith("http") ? url : `https://${url}`);
            const host = parsed.hostname.replace(/^www\./, "").split(".")[0];
            if (host) brandName = host.charAt(0).toUpperCase() + host.slice(1);
          } catch (_) {}

          const active = getActiveDNA();
          if (active) {
            if (!active.name || active.name === "Untitled") {
              active.name = brandName;
            }
            if (!active.overview) {
              active.overview = `Analyzed from ${url}. Premium brand offering innovative products and dedicated to high craftsmanship and distinctive customer experiences.`;
            }
            if (!active.guidance) {
              active.guidance = "Maintain clean, modern, and confident messaging across digital channels.";
            }
            saveDataToStorage();
            renderUI();
          }

          if (submitBtn) {
            submitBtn.innerHTML = `<span>Analyze</span>`;
            submitBtn.disabled = false;
          }

          if (urlInput) urlInput.value = "";
          document.getElementById("modal-import-dna")?.classList.add("hidden");
          showToast(`Website analyzed! Business DNA updated.`);
        }, 1200);
      });
    }

    function openNewDnaModal() {
      const modal = document.getElementById("modal-new-dna");
      modal?.classList.remove("hidden");
      document.getElementById("modal-input-name")?.focus();
    }

    function closeNewDnaModal() {
      document.getElementById("modal-new-dna")?.classList.add("hidden");
    }

    function openRenameModal() {
      const active = getActiveDNA();
      if (!active) return;
      const modal = document.getElementById("modal-rename-dna");
      const input = document.getElementById("modal-rename-input");
      if (input) input.value = active.name || "";
      modal?.classList.remove("hidden");
      input?.focus();
      input?.select();
    }

    function closeRenameModal() {
      document.getElementById("modal-rename-dna")?.classList.add("hidden");
    }

    function createNewDnaFromModal() {
      const name = document.getElementById("modal-input-name")?.value.trim() || "Untitled";
      const category = document.getElementById("modal-input-category")?.value || "General";
      const overview = document.getElementById("modal-input-overview")?.value.trim() || "";

      const newDNA = {
        id: `dna_${Date.now()}`,
        name,
        category,
        tagline: "",
        overview,
        guidance: "",
        logoUrl: "",
        colors: {},
        customColors: [],
        fonts: {},
        photography: [],
        moodboard: [],
        products: [],
        knowledge: [],
        connectedAccounts: []
      };

      dnaList.unshift(newDNA);
      activeDnaId = newDNA.id;
      saveDataToStorage();
      closeNewDnaModal();
      renderUI();
      showToast(`Business DNA "${name}" created!`);
    }

    // Create Business DNA (Directly creates a new Untitled DNA without modal)
    function createUntitledDNA() {
      const blankDNA = {
        id: `dna_${Date.now()}`,
        name: "Untitled",
        category: "General",
        tagline: "",
        overview: "",
        guidance: "",
        logoUrl: "",
        colors: {},
        customColors: [],
        fonts: {},
        photography: [],
        moodboard: [],
        products: [],
        knowledge: [],
        connectedAccounts: []
      };

      if (!Array.isArray(dnaList)) dnaList = [];
      dnaList.unshift(blankDNA);
      activeDnaId = blankDNA.id;
      saveDataToStorage();
      renderUI();
      showToast("Untitled Business DNA created!");
    }

    function handleCreateBrandKit() {
      createUntitledDNA();
    }

    function loadSampleData() {
      handleCreateBrandKit();
    }

    function escapeHtml(str) {
      if (!str) return "";
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    document.addEventListener("DOMContentLoaded", init);
    if (document.readyState === "complete" || document.readyState === "interactive") {
      init();
    }
  </script>
</AppLayout>
