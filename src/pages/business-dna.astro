  {/* 9. Add Knowledge Dialog */}
  <div id="modal-knowledge" class="hidden fixed inset-0 z-[200] flex items-center justify-center bg-black/50 backdrop-blur-xs p-4 animate-in fade-in duration-200">
    <div class="bg-white w-full max-w-md rounded-3xl border border-[#eaecf0] shadow-2xl p-6 relative animate-in zoom-in-95 duration-200">
      <button type="button" id="close-knowledge" class="absolute top-4 right-4 w-8 h-8 rounded-full flex items-center justify-center text-[#667085] hover:text-[#111827] hover:bg-[#F3F4F6] transition-colors cursor-pointer">
        <i class="ti ti-x text-[16px]"></i>
