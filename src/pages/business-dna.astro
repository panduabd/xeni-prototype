---
import AppLayout from "../layouts/AppLayout.astro";
import SocialIcon from "../components/icons/SocialIcon.astro";

const businessDNAList = [
  {
    id: "1",
    name: "Fresh Juice Co.",
    category: "Food & Beverage",
    color: "#34D399",
    updatedAt: "2h ago",
    overview: "Fresh Juice Co. is a healthy juice brand focused on organic ingredients and sustainable packaging.",
    guidance: "Clean and minimal layouts. Use ample white space. Avoid clutter. Prioritize readability and accessibility.",
  },
  {
    id: "2",
    name: "Acme Corp",
    category: "Technology",
    color: "#2563EB",
    updatedAt: "5h ago",
    overview: "Enterprise software solutions powering modern automated workflows.",
    guidance: "Bold technical aesthetic with crisp borders and high-contrast typography.",
  },
  {
    id: "3",
    name: "Luxe Beauty",
    category: "Beauty & Cosmetics",
    color: "#F472B6",
    updatedAt: "1d ago",
    overview: "High-end skincare and beauty products with natural essence.",
    guidance: "Soft pastel gradients, serif headlines, and elegant lifestyle imagery.",
  },
  {
    id: "4",
    name: "TechStart Inc",
    category: "Technology",
    color: "#8B5CF6",
    updatedAt: "2d ago",
    overview: "Incubator and acceleration platform for innovative tech startups.",
    guidance: "Futuristic, vibrant purple accents with clean UI components.",
  },
  {
    id: "5",
    name: "GreenLeaf Organics",
    category: "Retail",
    color: "#10B981",
    updatedAt: "3d ago",
    overview: "Direct-to-consumer organic farm produce and pantry essentials.",
    guidance: "Earthy tones, warm photography, and clear nutritional callouts.",
  },
];

const colorPalette = [
  { name: "Primary", hex: "#34D399", usage: "CTA, Links" },
  { name: "Secondary", hex: "#10B981", usage: "Accents" },
  { name: "Neutral", hex: "#6B7280", usage: "Body Text" },
  { name: "Dark", hex: "#111827", usage: "Headings" },
  { name: "Light", hex: "#F9FAFB", usage: "Backgrounds" },
];

const fonts = [
  { name: "Inter", role: "Primary Font", weights: "400, 500, 600, 700", preview: "Aa" },
  { name: "Playfair Display", role: "Accent Serif", weights: "400, 700", preview: "Aa" },
];

const knowledgeItems = [
  {
    id: "k1",
    title: "Company History",
    content: "Founded in 2018 in Bali, started as a small artisan juice bar and expanded nationally.",
  },
  {
    id: "k2",
    title: "Product Lines",
    content: "Cold-pressed juices, smoothies, wellness shots, and immune booster cleanses.",
  },
  {
    id: "k3",
    title: "Competitors",
    content: "Pressed Juicery, Suja Juice, Blueprint Cleanse.",
  },
  {
    id: "k4",
    title: "Unique Selling Points",
    content: "100% organic raw ingredients, locally sourced from farmers, zero-waste compostable packaging.",
  },
];

const productItems = [
  { id: "p1", name: "Cold Pressed Juice Box", category: "Physical Product" },
  { id: "p2", name: "Ginger Wellness Shot", category: "Physical Product" },
  { id: "p3", name: "7-Day Detox Plan", category: "Digital Asset" },
];

const connectedAccounts = [
  { id: "a1", handle: "@freshjuice.co", platform: "Instagram Business", type: "instagram", active: true },
  { id: "a2", handle: "@freshjuice", platform: "TikTok", type: "tiktok", active: true },
];
---

<AppLayout title="Business DNA - Xeni" activePage="business-dna">
  <div class="w-full min-h-full flex flex-col px-6 pb-8 -mt-12">
    <!-- Title + Controls Row -->
    <div class="w-full pt-1 pb-5 flex items-center justify-between gap-4 shrink-0">
      <!-- Left: Title -->
      <div class="flex items-center gap-2.5 shrink-0">
        <h1 class="text-[20px] font-semibold text-[#18181b] tracking-tight">
          Business DNA
        </h1>
      </div>

      <!-- Save Success Toast -->
      <div id="save-toast" class="hidden items-center gap-2 px-3.5 py-1.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-[12px] font-medium shadow-xs animate-in fade-in duration-200">
        <i class="ti ti-circle-check text-[16px] text-emerald-600"></i>
        <span id="save-toast-msg">Perubahan berhasil disimpan!</span>
      </div>
    </div>

    {/* ═══════════ BENTO GRID: 2 PANELS (30% / 70%) ═══════════ */}
    <div class="w-full flex-1 flex gap-4 min-h-0">
      {/* ═══ LEFT PANEL: DNA List (30%) ═══ */}
      <div class="w-[30%] min-w-[280px] max-w-[350px] flex flex-col gap-3 h-full overflow-hidden">
        {/* Sticky Top Bar: Search + New DNA Button */}
        <div class="shrink-0 flex flex-col gap-2">
          {/* shadcn Input with Search Icon */}
          <div class="relative w-full">
            <i class="ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-[#98a2b3] text-[14px] pointer-events-none"></i>
            <input
              id="dna-search"
              type="text"
              placeholder="Search business DNA..."
              class="w-full h-9.5 pl-9 pr-3 rounded-xl border border-[#eaecf0] bg-white text-[12.5px] font-medium text-[#111827] placeholder:text-[#98a2b3] shadow-xs outline-none focus:border-[#111827] focus:ring-1 focus:ring-[#111827] transition-all"
            />
          </div>

          {/* New Business DNA Button (shadcn Dark Button) */}
          <button
            id="btn-new-dna"
            type="button"
            class="w-full h-9.5 inline-flex items-center justify-center gap-2 rounded-xl text-[12.5px] font-semibold bg-[#111827] hover:bg-black text-white shadow-xs transition-all active:scale-[0.98] cursor-pointer select-none"
          >
            <i class="ti ti-plus text-[14px]"></i>
            <span>New Business DNA</span>
          </button>
        </div>

        {/* DNA Cards List */}
        <div
          id="dna-list"
          class="flex-1 overflow-y-auto flex flex-col gap-2.5 pr-0.5 custom-scrollbar"
          style="scrollbar-width: thin;"
        >
          {
            businessDNAList.map((dna, index) => (
              <button
                type="button"
                class={`dna-card group w-full text-left p-3.5 rounded-2xl border transition-all cursor-pointer select-none ${
                  index === 0
                    ? "border-[#111827] bg-[#F9FAFB] shadow-xs ring-1 ring-[#111827]/10"
                    : "border-[#eaecf0] bg-white hover:bg-[#F9FAFB] hover:border-[#d0d5dd]"
                }`}
                data-id={dna.id}
                data-name={dna.name}
                data-category={dna.category}
                data-color={dna.color}
                data-updated={dna.updatedAt}
                data-overview={dna.overview}
                data-guidance={dna.guidance}
              >
                <div class="flex items-center gap-3">
                  {/* Color Avatar Badge */}
                  <div
                    class="w-10 h-10 rounded-xl shrink-0 flex items-center justify-center font-bold text-[14px] shadow-2xs"
                    style={`background-color: ${dna.color}15; color: ${dna.color}; border: 1px solid ${dna.color}35;`}
                  >
                    {dna.name.charAt(0)}
                  </div>
                  {/* Info */}
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-1">
                      <h4 class="text-[12.5px] font-bold text-[#111827] truncate dna-card-title">
                        {dna.name}
                      </h4>
                      <span class="text-[10.5px] text-[#98a2b3] shrink-0 font-normal">
                        {dna.updatedAt}
                      </span>
                    </div>
                    <div class="flex items-center gap-1.5 mt-1">
                      <span class="px-2 py-0.5 rounded-md text-[10px] font-medium bg-[#f3f4f6] text-[#4b5563] border border-[#eaecf0]">
                        {dna.category}
                      </span>
                    </div>
                  </div>
                </div>
              </button>
            ))
          }
        </div>
      </div>

      {/* ═══ RIGHT PANEL: DNA Detail & Studio (70%) ═══ */}
      <div class="flex-1 flex flex-col rounded-3xl border border-[#eaecf0] bg-white shadow-xs overflow-hidden min-h-0">
        {/* Panel Header */}
        <div class="px-6 pt-5 pb-4 flex items-center justify-between shrink-0 border-b border-[#eaecf0]/60 bg-white">
          <div class="flex items-center gap-2.5">
            <div
              id="detail-avatar"
              class="w-7 h-7 rounded-lg flex items-center justify-center font-bold text-[12px] bg-[#34D399]/20 text-[#34D399]"
            >
              F
            </div>
            <h2 id="detail-name" class="text-[15px] font-bold text-[#111827]">
              Fresh Juice Co.
            </h2>
            <span class="px-2 py-0.5 rounded-md text-[10.5px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200 ml-1">
              Active Profile
            </span>
          </div>

          <div class="flex items-center gap-2">
            {/* Save Changes Button */}
            <button
              id="btn-save-dna"
              type="button"
              disabled
              class="h-8 px-3.5 inline-flex items-center gap-1.5 rounded-xl text-[12px] font-medium bg-[#111827] text-white shadow-xs hover:bg-black transition-all active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
            >
              <i class="ti ti-device-floppy text-[13px]"></i>
              <span>Save Changes</span>
            </button>

            {/* shadcn Dropdown Menu */}
            <div class="relative">
              <button
                id="btn-more-actions"
                type="button"
                class="w-8 h-8 rounded-xl border border-[#eaecf0] bg-white hover:bg-[#F9FAFB] flex items-center justify-center text-[#667085] hover:text-[#111827] transition-all shadow-xs cursor-pointer"
              >
                <i class="ti ti-dots text-[16px]"></i>
              </button>

              <div
                id="more-actions-dropdown"
                class="hidden absolute right-0 top-full mt-1.5 w-40 rounded-xl border border-[#eaecf0] bg-white shadow-lg p-1 z-30 animate-in fade-in zoom-in-95 duration-150"
              >
                <button
                  id="btn-rename-action"
                  type="button"
                  class="w-full text-left px-2.5 py-1.5 text-[12px] font-medium text-[#344054] hover:text-[#111827] hover:bg-[#F9FAFB] rounded-lg transition-colors flex items-center gap-2 cursor-pointer"
                >
                  <i class="ti ti-pencil text-[13px] text-[#667085]"></i>
                  <span>Rename</span>
                </button>
                <button
                  id="btn-duplicate-action"
                  type="button"
                  class="w-full text-left px-2.5 py-1.5 text-[12px] font-medium text-[#344054] hover:text-[#111827] hover:bg-[#F9FAFB] rounded-lg transition-colors flex items-center gap-2 cursor-pointer"
                >
                  <i class="ti ti-copy text-[13px] text-[#667085]"></i>
                  <span>Duplicate</span>
                </button>
                <div class="h-px bg-[#eaecf0] my-1"></div>
                <button
                  id="btn-delete-action"
                  type="button"
                  class="w-full text-left px-2.5 py-1.5 text-[12px] font-medium text-red-600 hover:bg-red-50 rounded-lg transition-colors flex items-center gap-2 cursor-pointer"
                >
                  <i class="ti ti-trash text-[13px]"></i>
                  <span>Delete</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        {/* shadcn Tabs Navigation */}
        <div class="shrink-0 px-6 pt-2 pb-0 border-b border-[#eaecf0] bg-[#F9FAFB]/50">
          <div class="flex items-center gap-2 -mb-px">
            <button
              type="button"
              class="tab-btn px-4 py-2.5 text-[12.5px] font-bold text-[#111827] border-b-2 border-[#111827] transition-all cursor-pointer select-none"
              data-tab="identity"
            >
              Identity
            </button>
            <button
              type="button"
              class="tab-btn px-4 py-2.5 text-[12.5px] font-medium text-[#667085] border-b-2 border-transparent hover:text-[#111827] transition-all cursor-pointer select-none"
              data-tab="product-references"
            >
              Product References
            </button>
            <button
              type="button"
              class="tab-btn px-4 py-2.5 text-[12.5px] font-medium text-[#667085] border-b-2 border-transparent hover:text-[#111827] transition-all cursor-pointer select-none"
              data-tab="knowledge"
            >
              Knowledge
            </button>
            <button
              type="button"
              class="tab-btn px-4 py-2.5 text-[12.5px] font-medium text-[#667085] border-b-2 border-transparent hover:text-[#111827] transition-all cursor-pointer select-none"
              data-tab="integration"
            >
              Integration
            </button>
          </div>
        </div>

        {/* Scrollable Tab Content Area */}
        <div class="flex-1 overflow-y-auto custom-scrollbar px-6 py-5">
          <div class="max-w-3xl space-y-6">
            {/* ═══════════ TAB 1: IDENTITY ═══════════ */}
            <div id="tab-identity" class="tab-content space-y-6">
              {/* Quick Upload Banner */}
              <div class="p-4 rounded-2xl border border-[#eaecf0] bg-[#F9FAFB] flex items-center justify-between gap-4 shadow-xs">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-white border border-[#eaecf0] flex items-center justify-center shrink-0 shadow-2xs">
                    <i class="ti ti-file-text text-[20px] text-[#667085]"></i>
                  </div>
                  <div>
                    <h3 class="text-[12.5px] font-bold text-[#111827]">
                      Build your Business DNA with one upload
                    </h3>
                    <p class="text-[11.5px] text-[#667085] mt-0.5">
                      Auto-fill logos, colors, fonts, and more. <a href="/studio" class="text-[#2563EB] font-semibold hover:underline">Or create in Studio</a>
                    </p>
                  </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                  <button
                    type="button"
                    id="btn-extract-file"
                    class="h-8 px-3 inline-flex items-center gap-1.5 rounded-xl border border-[#eaecf0] bg-white hover:bg-[#F9FAFB] text-[#344054] hover:text-[#111827] text-[12px] font-medium shadow-xs transition-all cursor-pointer active:scale-[0.98]"
                  >
                    <i class="ti ti-upload text-[13px]"></i>
                    <span>Extract from file</span>
                  </button>
                  <button
                    type="button"
                    id="btn-analyze-website"
                    class="h-8 px-3 inline-flex items-center gap-1.5 rounded-xl bg-[#111827] hover:bg-black text-white text-[12px] font-medium shadow-xs transition-all cursor-pointer active:scale-[0.98]"
                  >
                    <i class="ti ti-world text-[13px]"></i>
                    <span>Analyze Website</span>
                  </button>
                </div>
              </div>

              {/* Logo Section */}
              <div class="space-y-2.5">
                <label class="block text-[12px] font-bold text-[#111827]">Logo</label>
                <div class="grid grid-cols-4 gap-3">
                  <label class="aspect-square rounded-2xl border-2 border-dashed border-[#eaecf0] hover:border-[#98a2b3] bg-[#F9FAFB] hover:bg-white transition-all flex flex-col items-center justify-center gap-1.5 cursor-pointer group">
                    <i class="ti ti-plus text-[18px] text-[#98a2b3] group-hover:text-[#111827] transition-colors"></i>
                    <span class="text-[11px] font-medium text-[#667085] group-hover:text-[#111827]">Upload</span>
                    <input type="file" accept="image/*" class="hidden" />
                  </label>
                  <div class="aspect-square rounded-2xl bg-[#F9FAFB] border border-[#eaecf0] flex items-center justify-center p-3">
                    <div id="logo-preview-box" class="w-12 h-12 rounded-xl flex items-center justify-center font-bold text-[18px] bg-[#34D399]/20 text-[#34D399]">
                      F
                    </div>
                  </div>
                </div>
                <p class="text-[11px] text-[#98a2b3]">SVG, PNG, or JPG. Max 2MB.</p>
              </div>

              {/* Business Overview */}
              <div class="space-y-2">
                <label class="block text-[12px] font-bold text-[#111827]">Business Overview</label>
                <textarea
                  id="dna-overview-input"
                  rows="3"
                  placeholder="Describe what your business does, key products, and target audience..."
                  class="w-full px-3.5 py-2.5 rounded-xl border border-[#eaecf0] bg-white text-[12.5px] font-medium text-[#111827] placeholder:text-[#98a2b3] shadow-xs outline-none focus:border-[#111827] focus:ring-1 focus:ring-[#111827] transition-all resize-none"
                >Fresh Juice Co. is a healthy juice brand focused on organic ingredients and sustainable packaging.</textarea>
              </div>

              {/* Design Guidance */}
              <div class="space-y-2">
                <label class="block text-[12px] font-bold text-[#111827]">Design Guidance</label>
                <textarea
                  id="dna-guidance-input"
                  rows="3"
                  placeholder="Describe your brand's visual identity, layout guidelines, and aesthetic rules..."
                  class="w-full px-3.5 py-2.5 rounded-xl border border-[#eaecf0] bg-white text-[12.5px] font-medium text-[#111827] placeholder:text-[#98a2b3] shadow-xs outline-none focus:border-[#111827] focus:ring-1 focus:ring-[#111827] transition-all resize-none"
                >Clean and minimal layouts. Use ample white space. Avoid clutter. Prioritize readability and accessibility.</textarea>
              </div>

              {/* Color Palette */}
              <div class="space-y-2.5">
                <div class="flex items-center justify-between">
                  <label class="block text-[12px] font-bold text-[#111827]">Color Palette</label>
                  <span class="text-[11px] text-[#98a2b3]">5 theme tokens</span>
                </div>
                <div class="flex items-start gap-3">
                  <button
                    type="button"
                    class="w-16 h-16 rounded-2xl border-2 border-dashed border-[#eaecf0] hover:border-[#98a2b3] flex flex-col items-center justify-center text-[#98a2b3] hover:text-[#111827] transition-all cursor-pointer"
                    onclick="window.showAlert ? window.showAlert({ title: 'Color Palette', message: 'Color picker integration coming soon.', variant: 'info' }) : null"
                  >
                    <i class="ti ti-plus text-[16px]"></i>
                    <span class="text-[10px] mt-0.5">Add</span>
                  </button>
                  {
                    colorPalette.map((c) => (
                      <div class="flex flex-col items-center gap-1.5">
                        <div
                          class="w-16 h-16 rounded-2xl border border-[#eaecf0] shadow-2xs hover:scale-105 transition-transform cursor-pointer"
                          style={`background-color: ${c.hex};`}
                        />
                        <span class="text-[10px] font-mono text-[#667085] font-medium">
                          {c.hex}
                        </span>
                      </div>
                    ))
                  }
                </div>
              </div>

              {/* Fonts */}
              <div class="space-y-2.5">
                <label class="block text-[12px] font-bold text-[#111827]">Fonts</label>
                <div class="flex items-start gap-3">
                  <button
                    type="button"
                    class="w-16 h-16 rounded-2xl border-2 border-dashed border-[#eaecf0] hover:border-[#98a2b3] flex flex-col items-center justify-center text-[#98a2b3] hover:text-[#111827] transition-all cursor-pointer"
                    onclick="window.showAlert ? window.showAlert({ title: 'Typography', message: 'Custom font upload integration coming soon.', variant: 'info' }) : null"
                  >
                    <i class="ti ti-plus text-[16px]"></i>
                    <span class="text-[10px] mt-0.5">Add</span>
                  </button>
                  {
                    fonts.map((f) => (
                      <div class="flex flex-col items-center gap-1">
                        <div class="w-16 h-16 rounded-2xl bg-[#F9FAFB] border border-[#eaecf0] flex items-center justify-center text-[#111827] font-bold text-[16px] shadow-2xs">
                          {f.preview}
                        </div>
                        <span class="text-[11px] font-medium text-[#111827]">{f.name}</span>
                        <span class="text-[9.5px] text-[#98a2b3]">{f.role}</span>
                      </div>
                    ))
                  }
                </div>
              </div>

              {/* Photography Reference */}
              <div class="space-y-2.5">
                <div class="flex items-center justify-between">
                  <label class="block text-[12px] font-bold text-[#111827]">Photography</label>
                  <button
                    type="button"
                    id="btn-add-photography"
                    class="h-7 px-2.5 inline-flex items-center gap-1 rounded-lg border border-[#eaecf0] bg-white hover:bg-[#F9FAFB] text-[#344054] text-[11px] font-medium shadow-xs transition-all cursor-pointer"
                  >
                    <i class="ti ti-camera text-[12px]"></i>
                    <span>Add Photos</span>
                  </button>
                </div>
                <div class="grid grid-cols-4 gap-3">
                  <div
                    id="trigger-add-photo-box"
                    class="aspect-square rounded-2xl border-2 border-dashed border-[#eaecf0] hover:border-[#98a2b3] bg-[#F9FAFB] flex flex-col items-center justify-center gap-1 text-[#98a2b3] hover:text-[#111827] transition-all cursor-pointer"
                  >
                    <i class="ti ti-plus text-[18px]"></i>
                    <span class="text-[10px]">Add photo</span>
                  </div>
                  <div class="aspect-square rounded-2xl bg-[#F9FAFB] border border-[#eaecf0] flex items-center justify-center relative group overflow-hidden">
                    <i class="ti ti-photo text-[24px] text-[#98a2b3]"></i>
                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                      <span class="text-[11px] text-white font-medium">Preview</span>
                    </div>
                  </div>
                  <div class="aspect-square rounded-2xl bg-[#F9FAFB] border border-[#eaecf0] flex items-center justify-center relative group overflow-hidden">
                    <i class="ti ti-photo text-[24px] text-[#98a2b3]"></i>
                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                      <span class="text-[11px] text-white font-medium">Preview</span>
                    </div>
                  </div>
                </div>
              </div>

              {/* Moodboard */}
              <div class="space-y-2.5">
                <div class="flex items-center justify-between">
                  <label class="block text-[12px] font-bold text-[#111827]">Moodboard</label>
                  <button
                    type="button"
                    id="btn-add-moodboard"
                    class="h-7 px-2.5 inline-flex items-center gap-1 rounded-lg border border-[#eaecf0] bg-white hover:bg-[#F9FAFB] text-[#344054] text-[11px] font-medium shadow-xs transition-all cursor-pointer"
                  >
                    <i class="ti ti-layout-grid text-[12px]"></i>
                    <span>Add Moodboard</span>
                  </button>
                </div>
                <div class="grid grid-cols-4 gap-3">
                  <div
                    id="trigger-add-moodboard-box"
                    class="aspect-square rounded-2xl border-2 border-dashed border-[#eaecf0] hover:border-[#98a2b3] bg-[#F9FAFB] flex flex-col items-center justify-center gap-1 text-[#98a2b3] hover:text-[#111827] transition-all cursor-pointer"
                  >
                    <i class="ti ti-plus text-[18px]"></i>
                    <span class="text-[10px]">Add asset</span>
                  </div>
                  {
                    [1, 2, 3].map(() => (
                      <div class="aspect-square rounded-2xl bg-[#F9FAFB] border border-[#eaecf0] flex items-center justify-center relative group overflow-hidden cursor-pointer">
                        <i class="ti ti-photo text-[24px] text-[#98a2b3] group-hover:scale-110 transition-transform"></i>
                        <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                          <span class="text-[11px] text-white font-medium">View</span>
                        </div>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>

            {/* ═══════════ TAB 2: PRODUCT REFERENCES ═══════════ */}
            <div id="tab-product-references" class="tab-content hidden space-y-6">
