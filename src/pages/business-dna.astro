        </div>
        <input type="file" multiple accept="image/*" class="hidden" />
      </label>

      <div class="flex items-center justify-end gap-2 pt-2">
        <button type="button" id="cancel-moodboard" class="h-9 px-4 rounded-xl border border-[#eaecf0] bg-white hover:bg-[#F9FAFB] text-[12.5px] font-medium text-[#344054] shadow-xs transition-all cursor-pointer">
