            <input type="number" defaultValue="7" class="w-full h-8 px-2.5 rounded-lg border border-[#eaecf0] bg-white text-[12px]" />
          </div>
          <div>
            <label class="block text-[11px] text-[#667085] mb-1">Tinggi (cm)</label>
            <input type="number" defaultValue="22" class="w-full h-8 px-2.5 rounded-lg border border-[#eaecf0] bg-white text-[12px]" />
