        <div class="flex items-center justify-end gap-2 pt-2">
          <button type="button" id="cancel-add-product" class="h-9 px-4 rounded-xl border border-[#eaecf0] bg-white hover:bg-[#F9FAFB] text-[12.5px] font-medium text-[#344054] shadow-xs transition-all cursor-pointer">
            Cancel
          </button>
          <button type="submit" class="h-9 px-5 rounded-xl bg-[#111827] hover:bg-black text-white text-[12.5px] font-medium shadow-xs transition-all cursor-pointer">
            Add Product
          </button>
        </div>
      </form>
    </div>
  </div>

  {/* 11. Add Social Integration Dialog */}
  <div id="modal-add-integration" class="hidden fixed inset-0 z-[200] flex items-center justify-center bg-black/50 backdrop-blur-xs p-4 animate-in fade-in duration-200">
    <div class="bg-white w-full max-w-md rounded-3xl border border-[#eaecf0] shadow-2xl p-6 relative animate-in zoom-in-95 duration-200">
      <button type="button" id="close-add-integration" class="absolute top-4 right-4 w-8 h-8 rounded-full flex items-center justify-center text-[#667085] hover:text-[#111827] hover:bg-[#F3F4F6] transition-colors cursor-pointer">
        <i class="ti ti-x text-[16px]"></i>
      </button>

      <div class="w-10 h-10 rounded-2xl bg-[#F9FAFB] border border-[#eaecf0] flex items-center justify-center mb-3 shadow-2xs">
        <i class="ti ti-share text-[18px] text-[#111827]"></i>
      </div>
      <h2 class="text-[17px] font-bold text-[#111827] mb-4">Link Social Account</h2>

      <div class="space-y-3 my-3">
        <div class="relative">
          <i class="ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-[#98a2b3] text-[14px] pointer-events-none"></i>
          <input
            id="search-add-integration"
            type="text"
            placeholder="Search accounts..."
            class="w-full h-9.5 pl-9 pr-3 rounded-xl border border-[#eaecf0] bg-white text-[12.5px] font-medium text-[#111827] placeholder:text-[#98a2b3] shadow-xs outline-none focus:border-[#111827] focus:ring-1 focus:ring-[#111827] transition-all"
          />
