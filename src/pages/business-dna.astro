</AppLayout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // ─── State & DOM Elements ───
    let currentDnaId = "1";
    let isDirty = false;

    const dnaCards = document.querySelectorAll(".dna-card");
    const detailName = document.getElementById("detail-name");
    const detailAvatar = document.getElementById("detail-avatar");
    const logoPreviewBox = document.getElementById("logo-preview-box");
    const searchInput = document.getElementById("dna-search");
    const dnaListContainer = document.getElementById("dna-list");

    const overviewInput = document.getElementById("dna-overview-input");
    const guidanceInput = document.getElementById("dna-guidance-input");
    const btnSaveDna = document.getElementById("btn-save-dna");
    const saveToast = document.getElementById("save-toast");
    const saveToastMsg = document.getElementById("save-toast-msg");

    const btnMoreActions = document.getElementById("btn-more-actions");
    const moreActionsDropdown = document.getElementById("more-actions-dropdown");

    function setDirty() {
      isDirty = true;
      if (btnSaveDna) {
        btnSaveDna.removeAttribute("disabled");
        btnSaveDna.classList.remove("opacity-50", "cursor-not-allowed");
      }
    }

    function showToast(msg = "Perubahan berhasil disimpan!", variant = "success", title = "") {
      if (typeof window.showAlert === "function") {
        let displayTitle = title;
        if (!displayTitle) {
          if (variant === "destructive" || msg.toLowerCase().includes("hapus") || msg.toLowerCase().includes("putus")) displayTitle = "Dihapus";
          else if (variant === "warning") displayTitle = "Peringatan";
          else if (variant === "info") displayTitle = "Informasi";
          else displayTitle = "Berhasil";
        }
        window.showAlert({
          variant: (msg.toLowerCase().includes("hapus") || msg.toLowerCase().includes("putus")) ? "destructive" : variant,
          title: displayTitle,
          message: msg,
          duration: 3500,
        });
      }
      if (!saveToast) return;
      if (saveToastMsg) saveToastMsg.textContent = msg;
      saveToast.classList.remove("hidden");
      saveToast.classList.add("flex");
      setTimeout(() => {
        saveToast.classList.remove("flex");
        saveToast.classList.add("hidden");
      }, 3000);
    }

    // ─── DNA Selection ───
    function selectDNA(card) {
      if (!card) return;
      currentDnaId = card.dataset.id;

      dnaCards.forEach((c) => {
        c.classList.remove("border-[#111827]", "bg-[#F9FAFB]", "ring-1", "ring-[#111827]/10");
        c.classList.add("border-[#eaecf0]", "bg-white");
      });
      card.classList.add("border-[#111827]", "bg-[#F9FAFB]", "ring-1", "ring-[#111827]/10");
      card.classList.remove("border-[#eaecf0]", "bg-white");

      const name = card.dataset.name || "Brand";
      const color = card.dataset.color || "#34D399";
      const overview = card.dataset.overview || "";
      const guidance = card.dataset.guidance || "";

      if (detailName) detailName.textContent = name;
      if (detailAvatar) {
        detailAvatar.textContent = name.charAt(0);
        detailAvatar.style.backgroundColor = `${color}20`;
        detailAvatar.style.color = color;
      }
      if (logoPreviewBox) {
        logoPreviewBox.textContent = name.charAt(0);
        logoPreviewBox.style.backgroundColor = `${color}20`;
        logoPreviewBox.style.color = color;
      }
      if (overviewInput) overviewInput.value = overview;
      if (guidanceInput) guidanceInput.value = guidance;

      if (btnSaveDna) {
        btnSaveDna.setAttribute("disabled", "true");
        btnSaveDna.classList.add("opacity-50", "cursor-not-allowed");
        isDirty = false;
      }
    }

    dnaCards.forEach((card) => {
      card.addEventListener("click", () => selectDNA(card));
    });

    // ─── DNA Search Filtering ───
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        const q = e.target.value.toLowerCase().trim();
        dnaCards.forEach((card) => {
          const name = (card.dataset.name || "").toLowerCase();
          const cat = (card.dataset.category || "").toLowerCase();
          if (name.includes(q) || cat.includes(q)) {
            card.style.display = "";
          } else {
            card.style.display = "none";
          }
        });
      });
    }

    // ─── Save Changes ───
    if (overviewInput) overviewInput.addEventListener("input", setDirty);
    if (guidanceInput) guidanceInput.addEventListener("input", setDirty);

    if (btnSaveDna) {
      btnSaveDna.addEventListener("click", () => {
        const activeCard = document.querySelector(`.dna-card[data-id="${currentDnaId}"]`);
        if (activeCard) {
          activeCard.dataset.overview = overviewInput ? overviewInput.value : "";
          activeCard.dataset.guidance = guidanceInput ? guidanceInput.value : "";
        }
        btnSaveDna.setAttribute("disabled", "true");
        btnSaveDna.classList.add("opacity-50", "cursor-not-allowed");
        isDirty = false;
        showToast("Perubahan Business DNA berhasil disimpan!");
      });
    }

    // ─── Dropdown Menu ───
    if (btnMoreActions && moreActionsDropdown) {
      btnMoreActions.addEventListener("click", (e) => {
        e.stopPropagation();
        moreActionsDropdown.classList.toggle("hidden");
      });

      document.addEventListener("click", (e) => {
        if (!moreActionsDropdown.contains(e.target) && e.target !== btnMoreActions) {
          moreActionsDropdown.classList.add("hidden");
        }
      });
    }

    const btnRename = document.getElementById("btn-rename-action");
    if (btnRename) {
      btnRename.addEventListener("click", () => {
        if (moreActionsDropdown) moreActionsDropdown.classList.add("hidden");
        const activeCard = document.querySelector(`.dna-card[data-id="${currentDnaId}"]`);
        const currentName = activeCard ? activeCard.dataset.name : "Brand";
        const newName = prompt("Ubah Nama Business DNA:", currentName);
        if (newName && newName.trim()) {
          const trimmed = newName.trim();
          if (activeCard) {
            activeCard.dataset.name = trimmed;
            const titleEl = activeCard.querySelector(".dna-card-title");
            if (titleEl) titleEl.textContent = trimmed;
          }
          if (detailName) detailName.textContent = trimmed;
          showToast(`Nama brand diubah menjadi "${trimmed}"`);
        }
      });
    }

    const btnDuplicate = document.getElementById("btn-duplicate-action");
    if (btnDuplicate) {
      btnDuplicate.addEventListener("click", () => {
        if (moreActionsDropdown) moreActionsDropdown.classList.add("hidden");
        const activeCard = document.querySelector(`.dna-card[data-id="${currentDnaId}"]`);
        if (!activeCard) return;

        const copyName = `${activeCard.dataset.name} (Copy)`;
        const newId = "dna_" + Date.now();
        const color = activeCard.dataset.color || "#8B5CF6";
        const cat = activeCard.dataset.category || "General";

        const newCard = document.createElement("button");
        newCard.type = "button";
        newCard.className = "dna-card group w-full text-left p-3.5 rounded-2xl border border-[#eaecf0] bg-white hover:bg-[#F9FAFB] hover:border-[#d0d5dd] transition-all cursor-pointer select-none animate-in fade-in duration-200";
        newCard.dataset.id = newId;
        newCard.dataset.name = copyName;
        newCard.dataset.category = cat;
        newCard.dataset.color = color;
        newCard.dataset.updated = "Just now";
        newCard.dataset.overview = activeCard.dataset.overview || "";
        newCard.dataset.guidance = activeCard.dataset.guidance || "";

        newCard.innerHTML = `
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl shrink-0 flex items-center justify-center font-bold text-[14px] shadow-2xs" style="background-color: ${color}15; color: ${color}; border: 1px solid ${color}35;">
              ${copyName.charAt(0)}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-1">
                <h4 class="text-[12.5px] font-bold text-[#111827] truncate dna-card-title">${copyName}</h4>
                <span class="text-[10.5px] text-[#98a2b3] shrink-0 font-normal">Just now</span>
              </div>
              <div class="flex items-center gap-1.5 mt-1">
                <span class="px-2 py-0.5 rounded-md text-[10px] font-medium bg-[#f3f4f6] text-[#4b5563] border border-[#eaecf0]">${cat}</span>
              </div>
            </div>
          </div>
        `;

        newCard.addEventListener("click", () => selectDNA(newCard));
        if (dnaListContainer) dnaListContainer.insertBefore(newCard, dnaListContainer.firstChild);
        selectDNA(newCard);
        showToast(`Profil duplikat "${copyName}" berhasil dibuat!`);
      });
    }

    const btnDelete = document.getElementById("btn-delete-action");
    if (btnDelete) {
      btnDelete.addEventListener("click", () => {
        if (moreActionsDropdown) moreActionsDropdown.classList.add("hidden");
        const allCards = document.querySelectorAll(".dna-card");
        if (allCards.length <= 1) {
          window.showAlert({
            variant: "warning",
            title: "Peringatan",
            message: "Anda harus memiliki minimal 1 profil Business DNA."
          });
          return;
        }
        const activeCard = document.querySelector(`.dna-card[data-id="${currentDnaId}"]`);
        if (!activeCard) return;
        const brandName = activeCard.dataset.name;
        if (confirm(`Hapus Business DNA "${brandName}"?`)) {
          activeCard.remove();
          const nextCard = document.querySelector(".dna-card");
          if (nextCard) selectDNA(nextCard);
          showToast(`Profil "${brandName}" berhasil dihapus.`);
        }
      });
    }

    // ─── Tabs Switching ───
    const tabBtns = document.querySelectorAll(".tab-btn");
    const tabContents = document.querySelectorAll(".tab-content");

    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetTab = btn.dataset.tab;
        tabBtns.forEach((b) => {
          b.classList.remove("text-[#111827]", "font-bold", "border-[#111827]");
          b.classList.add("text-[#667085]", "font-medium", "border-transparent");
        });
        btn.classList.add("text-[#111827]", "font-bold", "border-[#111827]");
        btn.classList.remove("text-[#667085]", "font-medium", "border-transparent");

        tabContents.forEach((tc) => tc.classList.add("hidden"));
        const targetContent = document.getElementById(`tab-${targetTab}`);
        if (targetContent) targetContent.classList.remove("hidden");
      });
    });

    // ─── Modal Helpers ───
    function openModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.remove("hidden");
    }
    function closeModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.add("hidden");
    }
    function bindClose(modalId, ...closeBtnIds) {
      const modal = document.getElementById(modalId);
      if (!modal) return;
      closeBtnIds.forEach((cid) => {
        const btn = document.getElementById(cid);
        if (btn) btn.addEventListener("click", () => closeModal(modalId));
      });
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal(modalId);
      });
    }

    // ─── Modal Wiring ───
    // 1. New DNA Modal
    const btnNewDna = document.getElementById("btn-new-dna");
    if (btnNewDna) btnNewDna.addEventListener("click", () => openModal("modal-new-dna"));
    bindClose("modal-new-dna", "close-new-dna");

    const newDnaExtract = document.getElementById("new-dna-extract");
    if (newDnaExtract) {
      newDnaExtract.addEventListener("click", () => {
        closeModal("modal-new-dna");
        openModal("modal-extract-file");
      });
    }

    const newDnaWebsite = document.getElementById("new-dna-website");
    if (newDnaWebsite) {
      newDnaWebsite.addEventListener("click", () => {
        closeModal("modal-new-dna");
        openModal("modal-analyze-website");
      });
    }

    // 2. Extract File Flow
    const btnExtractFile = document.getElementById("btn-extract-file");
    if (btnExtractFile) btnExtractFile.addEventListener("click", () => openModal("modal-extract-file"));
    bindClose("modal-extract-file", "close-extract-file", "cancel-extract-file");

    const btnSubmitExtractFile = document.getElementById("btn-submit-extract-file");
    if (btnSubmitExtractFile) {
      btnSubmitExtractFile.addEventListener("click", () => {
        closeModal("modal-extract-file");
        openModal("modal-extract-loading");
        setTimeout(() => {
          closeModal("modal-extract-loading");
          showToast("Brand DNA berhasil diekstrak dari dokumen!");
        }, 1500);
      });
    }

    // 3. Analyze Website Flow
    const btnAnalyzeWebsite = document.getElementById("btn-analyze-website");
    if (btnAnalyzeWebsite) btnAnalyzeWebsite.addEventListener("click", () => openModal("modal-analyze-website"));
    bindClose("modal-analyze-website", "close-analyze-website", "cancel-analyze-website");

    const btnSubmitAnalyzeWebsite = document.getElementById("btn-submit-analyze-website");
    const websiteUrlInput = document.getElementById("website-url-input");
    const scanningUrlText = document.getElementById("scanning-url-text");

    if (btnSubmitAnalyzeWebsite) {
      btnSubmitAnalyzeWebsite.addEventListener("click", () => {
        const url = websiteUrlInput ? websiteUrlInput.value.trim() : "";
        if (!url) {
          window.showAlert({
            variant: "warning",
            title: "URL Diperlukan",
            message: "Silakan masukkan URL website terlebih dahulu."
          });
          return;
        }
        if (scanningUrlText) scanningUrlText.textContent = `Memindai CSS, font, dan identitas dari ${url}...`;
        closeModal("modal-analyze-website");
        openModal("modal-analyze-scanning");

        setTimeout(() => {
          closeModal("modal-analyze-scanning");
          openModal("modal-analyze-preview");
        }, 1500);
      });
    }

    bindClose("modal-analyze-preview", "cancel-analyze-preview");
    const confirmAnalyzePreview = document.getElementById("confirm-analyze-preview");
    if (confirmAnalyzePreview) {
      confirmAnalyzePreview.addEventListener("click", () => {
        closeModal("modal-analyze-preview");
        showToast("Identitas website Kopi Senja Roastery diterapkan!");
      });
    }

    // 4. Photography Modal
    const btnAddPhoto = document.getElementById("btn-add-photography");
    const triggerAddPhotoBox = document.getElementById("trigger-add-photo-box");
    if (btnAddPhoto) btnAddPhoto.addEventListener("click", () => openModal("modal-photography"));
    if (triggerAddPhotoBox) triggerAddPhotoBox.addEventListener("click", () => openModal("modal-photography"));
    bindClose("modal-photography", "close-photography", "cancel-photography");

    const btnSubmitPhoto = document.getElementById("btn-submit-photography");
    if (btnSubmitPhoto) {
      btnSubmitPhoto.addEventListener("click", () => {
        closeModal("modal-photography");
        showToast("Foto referensi berhasil ditambahkan!");
      });
    }

    // 5. Moodboard Modal
    const btnAddMoodboard = document.getElementById("btn-add-moodboard");
    const triggerAddMoodboardBox = document.getElementById("trigger-add-moodboard-box");
    if (btnAddMoodboard) btnAddMoodboard.addEventListener("click", () => openModal("modal-moodboard"));
    if (triggerAddMoodboardBox) triggerAddMoodboardBox.addEventListener("click", () => openModal("modal-moodboard"));
    bindClose("modal-moodboard", "close-moodboard", "cancel-moodboard");

    const btnSubmitMoodboard = document.getElementById("btn-submit-moodboard");
    if (btnSubmitMoodboard) {
      btnSubmitMoodboard.addEventListener("click", () => {
        closeModal("modal-moodboard");
        showToast("Asset moodboard berhasil ditambahkan!");
      });
    }

    // 6. Knowledge Modal
    const btnAddKnowledge = document.getElementById("btn-add-knowledge");
    if (btnAddKnowledge) btnAddKnowledge.addEventListener("click", () => openModal("modal-knowledge"));
    bindClose("modal-knowledge", "close-knowledge", "cancel-knowledge");

    const formKnowledge = document.getElementById("form-knowledge");
    const knowledgeTitleInput = document.getElementById("knowledge-title-input");
    const knowledgeContentInput = document.getElementById("knowledge-content-input");
    const knowledgeItemsList = document.getElementById("knowledge-items-list");

    if (formKnowledge) {
      formKnowledge.addEventListener("submit", (e) => {
        e.preventDefault();
        const title = knowledgeTitleInput ? knowledgeTitleInput.value.trim() : "";
        const content = knowledgeContentInput ? knowledgeContentInput.value.trim() : "";
        if (!title || !content) return;

        const newCard = document.createElement("div");
        newCard.className = "p-4 rounded-2xl border border-[#eaecf0] bg-white hover:border-[#d0d5dd] transition-all shadow-xs group animate-in fade-in duration-200";
        newCard.innerHTML = `
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
              <h4 class="text-[12.5px] font-bold text-[#111827]">${title}</h4>
              <p class="text-[12px] text-[#667085] mt-1 leading-relaxed">${content}</p>
            </div>
            <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity shrink-0">
              <button type="button" class="btn-delete-knowledge w-7 h-7 rounded-lg flex items-center justify-center text-[#667085] hover:text-red-600 hover:bg-red-50 transition-all cursor-pointer">
                <i class="ti ti-trash text-[13px]"></i>
              </button>
            </div>
          </div>
        `;

        newCard.querySelector(".btn-delete-knowledge")?.addEventListener("click", () => newCard.remove());
        if (knowledgeItemsList) knowledgeItemsList.insertBefore(newCard, knowledgeItemsList.firstChild);

        if (knowledgeTitleInput) knowledgeTitleInput.value = "";
        if (knowledgeContentInput) knowledgeContentInput.value = "";
        closeModal("modal-knowledge");
        showToast("Fakta pengetahuan baru ditambahkan ke Knowledge Base!");
      });
    }

    // Bind existing knowledge item delete & edit buttons
    document.querySelectorAll(".btn-delete-knowledge").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const card = btn.closest(".group");
        if (card) card.remove();
        showToast("Fakta dihapus dari Knowledge Base.");
      });
    });

    document.querySelectorAll(".btn-edit-knowledge").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const currentCont = btn.dataset.content || "";
        const newCont = prompt(`Edit "${btn.dataset.title}":`, currentCont);
        if (newCont !== null) {
          const card = btn.closest(".group");
          const p = card ? card.querySelector("p") : null;
          if (p) p.textContent = newCont;
          btn.dataset.content = newCont;
          showToast("Fakta berhasil diperbarui!");
        }
      });
    });

    // 7. Product Modal
    const btnAddProduct = document.getElementById("btn-add-product");
    const triggerAddProductBox = document.getElementById("trigger-add-product-box");
    if (btnAddProduct) btnAddProduct.addEventListener("click", () => openModal("modal-add-product"));
    if (triggerAddProductBox) triggerAddProductBox.addEventListener("click", () => openModal("modal-add-product"));
    bindClose("modal-add-product", "close-add-product", "cancel-add-product");

    const formProduct = document.getElementById("form-product");
    const productNameInput = document.getElementById("product-name-input");
    const productCatSelect = document.getElementById("product-category-select");
    const productDimSection = document.getElementById("product-dimensions-section");
    const productCardsGrid = document.getElementById("product-cards-grid");

    if (productCatSelect && productDimSection) {
      productCatSelect.addEventListener("change", (e) => {
        if (e.target.value === "digital") {
          productDimSection.classList.add("hidden");
        } else {
          productDimSection.classList.remove("hidden");
        }
      });
    }

    if (formProduct) {
      formProduct.addEventListener("submit", (e) => {
        e.preventDefault();
        const name = productNameInput ? productNameInput.value.trim() : "";
        const type = productCatSelect ? (productCatSelect.value === "digital" ? "Digital Asset" : "Physical Product") : "Physical Product";
        if (!name) return;

        const newProdCard = document.createElement("div");
        newProdCard.className = "p-4 rounded-2xl border border-[#eaecf0] bg-white hover:border-[#d0d5dd] transition-all flex flex-col justify-between group cursor-pointer shadow-xs animate-in fade-in duration-200";
        newProdCard.innerHTML = `
          <div class="aspect-video rounded-xl bg-[#F9FAFB] border border-[#eaecf0] flex items-center justify-center mb-3 group-hover:bg-white transition-colors">
            <i class="ti ti-package text-[24px] text-[#98a2b3]"></i>
          </div>
          <div>
            <h4 class="text-[12.5px] font-bold text-[#111827] truncate">${name}</h4>
            <span class="inline-block mt-1 px-2 py-0.5 rounded-md text-[10px] font-medium bg-[#f3f4f6] text-[#4b5563] border border-[#eaecf0]">
              ${type}
            </span>
          </div>
        `;

        if (productCardsGrid && triggerAddProductBox) {
          productCardsGrid.insertBefore(newProdCard, triggerAddProductBox);
        }

        if (productNameInput) productNameInput.value = "";
        closeModal("modal-add-product");
        showToast(`Produk "${name}" berhasil ditambahkan!`);
      });
    }

    // 8. Social Integration Modal
    const btnAddIntegration = document.getElementById("btn-add-integration");
    if (btnAddIntegration) btnAddIntegration.addEventListener("click", () => openModal("modal-add-integration"));
    bindClose("modal-add-integration", "close-add-integration", "cancel-add-integration");

    const searchIntegration = document.getElementById("search-add-integration");
    if (searchIntegration) {
      searchIntegration.addEventListener("input", (e) => {
        const q = e.target.value.toLowerCase().trim();
        document.querySelectorAll(".integration-pick-item").forEach((item) => {
          const handle = (item.dataset.handle || "").toLowerCase();
          const plat = (item.dataset.platform || "").toLowerCase();
          if (handle.includes(q) || plat.includes(q)) {
            item.style.display = "";
          } else {
            item.style.display = "none";
          }
        });
      });
    }

    const connectedAccountsList = document.getElementById("connected-accounts-list");
    document.querySelectorAll(".integration-pick-item").forEach((item) => {
      item.addEventListener("click", () => {
        const handle = item.dataset.handle || "";
        const plat = item.dataset.platform || "";
        const icon = item.dataset.icon || "ti-brand-instagram";
        const color = item.dataset.color || "#111827";

        // Check if already linked
        const existing = document.querySelector(`[data-linked-handle="${handle}"]`);
        if (existing) {
          window.showAlert({
            variant: "warning",
            title: "Akun Terhubung",
            message: `Akun ${handle} sudah terhubung.`
          });
          return;
        }

        let svgHtml = '';
        if (plat.toLowerCase().includes('instagram')) {
          svgHtml = `<svg class="w-4.5 h-4.5 shrink-0" viewBox="0 0 2500 2500" xmlns="http://www.w3.org/2000/svg" fill="#000000"><defs><radialGradient id="ig-dyn-0" cx="332.14" cy="2511.81" r="3263.54" gradientUnits="userSpaceOnUse"><stop offset=".09" stop-color="#fa8f21"></stop><stop offset=".78" stop-color="#d82d7e"></stop></radialGradient><radialGradient id="ig-dyn-1" cx="1516.14" cy="2623.81" r="2572.12" gradientUnits="userSpaceOnUse"><stop offset=".64" stop-color="#8c3aaa" stop-opacity="0"></stop><stop offset="1" stop-color="#8c3aaa"></stop></radialGradient></defs><path d="M833.4,1250c0-230.11,186.49-416.7,416.6-416.7s416.7,186.59,416.7,416.7-186.59,416.7-416.7,416.7S833.4,1480.11,833.4,1250m-225.26,0c0,354.5,287.36,641.86,641.86,641.86S1891.86,1604.5,1891.86,1250,1604.5,608.14,1250,608.14,608.14,895.5,608.14,1250M1767.27,582.69a150,150,0,1,0,150.06-149.94h-0.06a150.07,150.07,0,0,0-150,149.94M745,2267.47c-121.87-5.55-188.11-25.85-232.13-43-58.36-22.72-100-49.78-143.78-93.5s-70.88-85.32-93.5-143.68c-17.16-44-37.46-110.26-43-232.13-6.06-131.76-7.27-171.34-7.27-505.15s1.31-373.28,7.27-505.15c5.55-121.87,26-188,43-232.13,22.72-58.36,49.78-100,93.5-143.78s85.32-70.88,143.78-93.5c44-17.16,110.26-37.46,232.13-43,131.76-6.06,171.34-7.27,505-7.27s373.28,1.31,505.15,7.27c121.87,5.55,188,26,232.13,43,58.36,22.62,100,49.78,143.78,93.5s70.78,85.42,93.5,143.78c17.16,44,37.46,110.26,43,232.13,6.06,131.87,7.27,171.34,7.27,505.15s-1.21,373.28-7.27,505.15c-5.55,121.87-25.95,188.11-43,232.13-22.72,58.36-49.78,100-93.5,143.68s-85.42,70.78-143.78,93.5c-44,17.16-110.26,37.46-232.13,43-131.76,6.06-171.34,7.27-505.15,7.27s-373.28-1.21-505-7.27M734.65,7.57c-133.07,6.06-224,27.16-303.41,58.06C349,97.54,279.38,140.35,209.81,209.81S97.54,349,65.63,431.24c-30.9,79.46-52,170.34-58.06,303.41C1.41,867.93,0,910.54,0,1250s1.41,382.07,7.57,515.35c6.06,133.08,27.16,223.95,58.06,303.41,31.91,82.19,74.62,152,144.18,221.43S349,2402.37,431.24,2434.37c79.56,30.9,170.34,52,303.41,58.06C868,2498.49,910.