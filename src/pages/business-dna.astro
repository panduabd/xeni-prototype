s112.18-139.24,144.18-221.43c30.9-79.46,52.1-170.34,58.06-303.41,6.06-133.38,7.47-175.89,7.47-515.35s-1.41-382.07-7.47-515.35c-6.06-133.08-27.16-224-58.06-303.41-32-82.19-74.72-151.86-144.18-221.43S2150.95,97.54,2068.86,65.63c-79.56-30.9-170.44-52.1-303.41-58.06C1632.17,1.51,1589.56,0,1250.1,0S868,1.41,734.65,7.57" fill="url(#ig-dyn-1)"></path></svg>`;
        } else if (plat.toLowerCase().includes('facebook')) {
          svgHtml = `<svg class="w-4.5 h-4.5 shrink-0" viewBox="0 0 24 24" fill="#1877F2"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`;
        } else {
          svgHtml = `<svg class="w-4.5 h-4.5 shrink-0" viewBox="0 0 24 24" fill="#000000"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298 0 .59.043.87.12V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.49 6.27 6.27 0 0 0 1.87-4.48V8.71a8.28 8.28 0 0 0 4.9 1.57v-3.59h-1z"/></svg>`;
        }

        const newRow = document.createElement("div");
        newRow.className = "p-3.5 rounded-2xl border border-[#eaecf0] bg-white flex items-center justify-between gap-3 shadow-xs animate-in fade-in duration-200";
        newRow.dataset.linkedHandle = handle;
        newRow.innerHTML = `
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0 bg-white border border-[#eaecf0] shadow-2xs">
              ${svgHtml}
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-[12.5px] font-bold text-[#111827] truncate">${handle}</p>
              <p class="text-[11px] text-[#667085]">${plat}</p>
            </div>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
              Active
            </span>
            <button type="button" class="btn-disconnect-account w-7 h-7 rounded-lg flex items-center justify-center text-[#98a2b3] hover:text-red-600 hover:bg-red-50 transition-all cursor-pointer">
              <i class="ti ti-trash text-[13px]"></i>
            </button>
          </div>
        `;

        newRow.querySelector(".btn-disconnect-account")?.addEventListener("click", () => newRow.remove());
        if (connectedAccountsList) connectedAccountsList.insertBefore(newRow, connectedAccountsList.firstChild);

        closeModal("modal-add-integration");
        showToast(`Akun ${handle} berhasil ditautkan!`);
      });
    });

    document.querySelectorAll(".btn-disconnect-account").forEach((btn) => {
      btn.addEventListener("click", () => {
        const row = btn.closest(".rounded-2xl");
        if (row) row.remove();
        showToast("Akun berhasil diputuskan.");
      });
    });
  });
</script>
