        <div id="integration-options-list" class="space-y-2 max-h-56 overflow-y-auto custom-scrollbar">
          <div
            class="integration-pick-item flex items-center justify-between p-3 rounded-2xl border border-[#eaecf0] hover:border-[#d0d5dd] hover:bg-[#F9FAFB] transition-all cursor-pointer group"
