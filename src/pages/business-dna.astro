              <div class="w-8 h-8 rounded-xl bg-white border border-[#eaecf0] shadow-2xs flex items-center justify-center">
                <SocialIcon platform="tiktok" size="md" />
              </div>
              <div>
                <p class="text-[12.5px] font-bold text-[#111827]">@freshjuice</p>
                <p class="text-[11px] text-[#667085]">TikTok</p>
