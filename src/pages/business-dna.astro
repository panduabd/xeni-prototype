                <p class="text-[12.5px] font-bold text-[#111827]">Fresh Juice Co.</p>
                <p class="text-[11px] text-[#667085]">Facebook Page</p>
              </div>
            </div>
            <button type="button" class="btn-pick-link h-7 px-2.5 rounded-lg border border-[#eaecf0] bg-white text-[11.5px] font-medium text-[#344054] shadow-xs group-hover:border-[#d0d5dd]">Link</button>
          </div>

          <div
            class="integration-pick-item flex items-center justify-between p-3 rounded-2xl border border-[#eaecf0] hover:border-[#d0d5dd] hover:bg-[#F9FAFB] transition-all cursor-pointer group"
            data-handle="@freshjuice"
