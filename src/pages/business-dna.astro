        const MAX_SIZE = 2 * 1024 * 1024; // 2MB
        const validFiles = [];
        let rejectedCount = 0;

        rawFiles.forEach((file) => {
          const isJpgOrPng = /image\/(jpeg|png|jpg)/i.test(file.type) || /\.(jpe?g|png)$/i.test(file.name);
          if (isJpgOrPng && file.size <= MAX_SIZE) {
