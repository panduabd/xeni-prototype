        const rawFiles = Array.from(e.target.files || []);
        if (rawFiles.length === 0) return;

        const MAX_SIZE = 2 * 1024 * 1024; // 2MB
        const MAX_ALLOWED = 25;
        const availableSlots = MAX_ALLOWED - stagedProductImages.length;

        if (availableSlots <= 0) {
          showToast("Maximum 25 images limit reached", "error");
          e.target.value = "";
          return;
        }

        const filesToProcess = rawFiles.slice(0, availableSlots);
        if (rawFiles.length > availableSlots) {
          showToast(`Only ${availableSlots} more image(s) allowed (max 25 limit)`, "error");
        }

        const validFiles = [];
        let rejectedCount = 0;

        filesToProcess.forEach((file) => {
          const isJpgOrPng = /image\/(jpeg|png|jpg)/i.test(file.type) || /\.(jpe?g|png)$/i.test(file.name);
          if (isJpgOrPng && file.size <= MAX_SIZE) {
            validFiles.push(file);
          } else {
            rejectedCount++;
          }
        });

        if (rejectedCount > 0) {
          showToast(`${rejectedCount} file(s) skipped: only JPG/PNG max 2MB allowed`, "error");
        }

        if (validFiles.length === 0) {
          e.target.value = "";
          return;
        }

        let loadedCount = 0;
        validFiles.forEach((file) => {
          const reader = new FileReader();
          reader.onload = (evt) => {
            stagedProductImages.push({
              id: `img_${Date.now()}_${Math.random().toString(36).substr(2, 4)}`,
              name: file.name,
              url: evt.target.result,
              size: file.size
