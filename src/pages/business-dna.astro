    // Fullscreen View Modal
    function openImageViewModal(url, title, context) {
      const modal = document.getElementById("modal-image-view");
      const targetImg = document.getElementById("image-view-target");
      const titleEl = document.getElementById("image-view-title");

      if (!modal || !targetImg) return;

      targetImg.src = url;
      if (titleEl) titleEl.textContent = title;
      viewedImageContext = context;

      modal.classList.remove("hidden");
    }

    function closeImageViewModal() {
      const modal = document.getElementById("modal-image-view");
      modal?.classList.add("hidden");
      viewedImageContext = null;
    }

    // ─── Font Loading ───
    async function handleFontFileUpload(file) {
      try {
        const fontName = file.name.replace(/\.[^/.]+$/, "").replace(/[^a-zA-Z0-9]/g, "");
        const buffer = await file.arrayBuffer();
        const fontFace = new FontFace(fontName, buffer);
        await fontFace.load();
        document.fonts.add(fontFace);

        const active = getActiveDNA();
        if (active) {
          if (!active.fonts) active.fonts = {};
          active.fonts.heading = `"${fontName}", sans-serif`;
          saveDataToStorage();
          renderTypographyTab(active);
          showToast(`Font "${fontName}" applied successfully!`);
        }
      } catch (err) {
        console.error("Font loading error:", err);
        showToast("Unsupported font format or corrupted file", "error");
      }
    }

    // ─── Global Event Listeners ───
    function bindEventListeners() {
      // 1. Create DNA Triggers (Directly creates Untitled DNA without modal)
      document.getElementById("btn-top-create-dna")?.addEventListener("click", createUntitledDNA);
      document.getElementById("btn-empty-create")?.addEventListener("click", createUntitledDNA);
      document.getElementById("btn-sidebar-create-brand-kit")?.addEventListener("click", createUntitledDNA);

      // 2. Tabs Switcher
      document.querySelectorAll(".dna-tab-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const tab = btn.getAttribute("data-tab");
          if (!tab) return;

          document.querySelectorAll(".dna-tab-btn").forEach((b) => {
            b.className = "dna-tab-btn pb-3 text-[13px] font-medium text-[#667085] border-b-2 border-transparent hover:text-[#111827] cursor-pointer select-none transition-colors shrink-0 whitespace-nowrap";
