        </button>
        <button type="button" id="btn-submit-moodboard" class="h-9 px-5 rounded-xl bg-[#111827] hover:bg-black text-white text-[12.5px] font-medium shadow-xs transition-all cursor-pointer">
          Save to Moodboard
