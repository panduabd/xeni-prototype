            <button type="button" class="btn-pick-link h-7 px-2.5 rounded-lg border border-[#eaecf0] bg-white text-[11.5px] font-medium text-[#344054] shadow-xs group-hover:border-[#d0d5dd]">Link</button>
          </div>
