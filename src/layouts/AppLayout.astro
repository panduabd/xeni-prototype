    <!-- Profile & Scrollbar Script -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        // --- Profile Dropdown ---
        const btnProfile = document.getElementById("btn-profile");
        const profileDropdown = document.getElementById("profile-dropdown");
        const profileChevron = document.getElementById("profile-chevron");

        if (btnProfile && profileDropdown) {
          btnProfile.addEventListener("click", (e) => {
            e.stopPropagation();
            const isOpen = !profileDropdown.classList.contains("hidden");
            profileDropdown.classList.toggle("hidden");
            // Close other dropdowns
            const creditDropdown = document.getElementById("credit-dropdown");
            if (creditDropdown) creditDropdown.classList.add("hidden");

            if (profileChevron) {
              profileChevron.style.transform = isOpen ? "" : "rotate(180deg)";
            }
          });

          document.addEventListener("click", (e) => {
            const profileWrapper = document.getElementById("profile-wrapper");
            if (profileWrapper && !profileWrapper.contains(e.target)) {
              profileDropdown.classList.add("hidden");
              if (profileChevron) profileChevron.style.transform = "";
            }

            const creditWrapper = document.getElementById("credit-wrapper");
            const creditDropdown = document.getElementById("credit-dropdown");
            if (
              creditWrapper &&
              !creditWrapper.contains(e.target) &&
              creditDropdown
            ) {
              creditDropdown.classList.add("hidden");
            }
          });
        }

        // --- Credit Dropdown ---
        const btnCredit = document.getElementById("btn-credit");
        const creditDropdown = document.getElementById("credit-dropdown");

        if (btnCredit && creditDropdown) {
          btnCredit.addEventListener("click", (e) => {
            e.stopPropagation();
            creditDropdown.classList.toggle("hidden");
            // Close profile dropdown
            const profileDropdown = document.getElementById("profile-dropdown");
            const profileChevron = document.getElementById("profile-chevron");
            if (profileDropdown) {
              profileDropdown.classList.add("hidden");
              if (profileChevron) profileChevron.style.transform = "";
            }
          });
        }

        // --- Manage Account Modal Triggers ---
        const btnNavAccount = document.getElementById("btn-nav-account");
        const btnNavUsageDetails = document.getElementById(
          "btn-nav-usage-details",
        );
        const upgradeButtons = document.querySelectorAll(
          ".btn-upgrade-trigger",
        );

        if (btnNavAccount) {
          btnNavAccount.addEventListener("click", (e) => {
            e.stopPropagation();
            if (profileDropdown) profileDropdown.classList.add("hidden");
            window.dispatchEvent(
              new CustomEvent("open-manage-account", {
                detail: { tab: "profile" },
              }),
            );
          });
        }

        if (btnNavUsageDetails) {
          btnNavUsageDetails.addEventListener("click", (e) => {
            e.stopPropagation();
            if (creditDropdown) creditDropdown.classList.add("hidden");
            window.dispatchEvent(
              new CustomEvent("open-manage-account", {
                detail: { tab: "subscription" },
              }),
            );
          });
        }

        upgradeButtons.forEach((btn) => {
          btn.addEventListener("click", (e) => {
            e.stopPropagation();
            if (profileDropdown) profileDropdown.classList.add("hidden");
            if (creditDropdown) creditDropdown.classList.add("hidden");
            const currentPlan = localStorage.getItem("userPlan") || localStorage.getItem("xeni_user_plan") || "free";
            if (currentPlan === "pro" || btn.textContent.trim() === "Manage") {
              window.dispatchEvent(
                new CustomEvent("open-manage-account", {
                  detail: { tab: "subscription" },
                }),
              );
            } else {
              window.dispatchEvent(
                new CustomEvent("open-get-credits"),
              );
            }
          });
        });

        // --- Plan Tier UI Sync (Free vs Pro) ---
        function syncSidebarPlanUI(plan) {
          const currentPlan = plan || localStorage.getItem("xeni_user_plan") || "free";
          const isPro = currentPlan === "pro";

          document.querySelectorAll(".plan-label-free").forEach((el) => {
            if (isPro) el.classList.add("hidden");
            else el.classList.remove("hidden");
          });

          document.querySelectorAll(".plan-label-pro").forEach((el) => {
            if (isPro) {
              el.classList.remove("hidden");
              el.classList.add("flex");
            } else {
              el.classList.add("hidden");
              el.classList.remove("flex");
            }
          });

          const sidebarPlanCard = document.getElementById("sidebar-plan-card");

          if (sidebarPlanCard) {
            if (isPro) {
              sidebarPlanCard.style.background = "linear-gradient(135deg, #FFFFFF 10%, #FFFDF5 45%, #FEF3C7 100%)";
              sidebarPlanCard.classList.remove("bg-transparent");
            } else {
              sidebarPlanCard.style.background = "";
              sidebarPlanCard.classList.add("bg-transparent");
            }
          }

          document.querySelectorAll(".btn-plan-action").forEach((btn) => {
            if (isPro) {
              btn.textContent = "Manage";
              btn.className = "btn-upgrade-trigger btn-plan-action px-3 py-1 rounded-full bg-white/90 hover:bg-white text-[#18181b] text-[11px] font-medium transition-all cursor-pointer border border-[#eaecf0] shadow-xs backdrop-blur-xs";
            } else {
              btn.textContent = "Upgrade";
              btn.className = "btn-upgrade-trigger btn-plan-action px-3.5 py-1 rounded-full bg-[#111827] text-white text-[11px] font-medium hover:bg-black transition-colors cursor-pointer";
            }
          });

          const sidebarCredits = document.getElementById("sidebar-credits-value");
          if (sidebarCredits) {
            sidebarCredits.textContent = isPro ? "1,500" : "300";
          }
        }

        // Initialize on load
        syncSidebarPlanUI();

        // Listen for plan changes across components
        window.addEventListener("plan-status-changed", (e) => {
          syncSidebarPlanUI(e.detail?.plan);
        });
        window.addEventListener("upgraded-to-pro", () => {
          syncSidebarPlanUI("pro");
        });

        // --- Dark Mode Toggle ---
        const darkModeToggle = document.getElementById("dark-mode-toggle");
        const darkModeThumb = document.getElementById("dark-mode-thumb");
        const darkModeIcon = document.getElementById("dark-mode-icon");

        let isDarkMode = localStorage.getItem("theme") === "dark";

        function updateTheme(dark) {
          if (dark) {
            document.documentElement.classList.add("dark");
            if (darkModeThumb)
              darkModeThumb.style.transform = "translateX(20px)";
            if (darkModeThumb) darkModeThumb.style.backgroundColor = "#111827";
            if (darkModeThumb) darkModeThumb.style.borderColor = "#1f2937";
            if (darkModeToggle)
              darkModeToggle.style.backgroundColor = "#111827";
            if (darkModeToggle) darkModeToggle.style.borderColor = "#1f2937";
            if (darkModeIcon)
              darkModeIcon.className = "ti ti-moon text-[10px] text-white";
            localStorage.setItem("theme", "dark");
          } else {
            document.documentElement.classList.remove("dark");
            if (darkModeThumb)
              darkModeThumb.style.transform = "translateX(0px)";
            if (darkModeThumb) darkModeThumb.style.backgroundColor = "#ffffff";
            if (darkModeThumb) darkModeThumb.style.borderColor = "#d1d5db";
            if (darkModeToggle)
              darkModeToggle.style.backgroundColor = "#ebebef";
            if (darkModeToggle) darkModeToggle.style.borderColor = "#d1d5db";
            if (darkModeIcon)
              darkModeIcon.className = "ti ti-sun text-[10px] text-[#4b5563]";
            localStorage.setItem("theme", "light");
          }
        }

        // Initialize theme
        updateTheme(isDarkMode);

        darkModeToggle?.addEventListener("click", () => {
          isDarkMode = !isDarkMode;
          updateTheme(isDarkMode);
        });

        // --- Smart Scrollbar Visibility ---
        const mainEl = document.querySelector(".custom-scrollbar");
        let scrollTimeout;

        if (mainEl) {
          mainEl.addEventListener("scroll", () => {
            mainEl.classList.add("is-scrolling");

            clearTimeout(scrollTimeout);
            scrollTimeout = setTimeout(() => {
              mainEl.classList.remove("is-scrolling");
            }, 1000); // Hide after 1 second
          });
        }

        // --- Log Out ---
        const btnLogout = document.getElementById("btn-logout");
        if (btnLogout) {
          btnLogout.addEventListener("click", () => {
            window.location.href = "/";
          });
        }

        // --- Global Tooltip Manager ---
        function initGlobalTooltips() {
          let tooltip = document.getElementById("xeni-global-tooltip");
          if (!tooltip) {
            tooltip = document.createElement("div");
            tooltip.id = "xeni-global-tooltip";
            document.body.appendChild(tooltip);
          }

          let activeTarget = null;

          function hideTooltip() {
            activeTarget = null;
            if (tooltip) tooltip.classList.remove("show");
          }

          function showTooltip(el) {
            const text =
              el.getAttribute("data-tooltip") || el.getAttribute("title");
            if (!text || text.trim() === "") return;

            if (el.hasAttribute("title")) {
              el.setAttribute("data-tooltip", text);
              el.removeAttribute("title");
            }

            activeTarget = el;
            tooltip.textContent = text;

            const rect = el.getBoundingClientRect();
            const tooltipRect = tooltip.getBoundingClientRect();
            const pos = el.getAttribute("data-tooltip-pos") || "top";

            let top = 0;
            let left = rect.left + rect.width / 2 - tooltipRect.width / 2;

            if (pos === "bottom") {
              top = rect.bottom + 6;
            } else if (pos === "left") {
              left = rect.left - tooltipRect.width - 6;
              top = rect.top + rect.height / 2 - tooltipRect.height / 2;
            } else if (pos === "right") {
              left = rect.right + 6;
              top = rect.top + rect.height / 2 - tooltipRect.height / 2;
            } else {
              top = rect.top - tooltipRect.height - 6;
              if (top < 8) {
                top = rect.bottom + 6;
              }
            }

            left = Math.max(
              8,
              Math.min(window.innerWidth - tooltipRect.width - 8, left),
            );

            tooltip.style.top = `${top}px`;
            tooltip.style.left = `${left}px`;
            tooltip.classList.add("show");
          }

          document.addEventListener(
            "mouseover",
            (e) => {
              const target = e.target;
              if (!target || !(target instanceof Element)) return;
              const el = target.closest("[data-tooltip], [title]");
              if (!el) {
                if (activeTarget) hideTooltip();
                return;
              }
              if (el === activeTarget) return;
              showTooltip(el);
            },
            true,
          );

          document.addEventListener(
            "mouseout",
            (e) => {
              if (
                activeTarget &&
                (!e.relatedTarget || !activeTarget.contains(e.relatedTarget))
              ) {
                hideTooltip();
              }
            },
            true,
          );

          document.addEventListener(
            "mousedown",
            () => {
              hideTooltip();
            },
            true,
          );

          window.addEventListener(
            "scroll",
            () => {
              hideTooltip();
            },
            { passive: true },
          );
        }

        initGlobalTooltips();
      });

      // ══════════════════════════════════════════════
      // EXACT CANVAS REUI ALERT SYSTEM (Bottom-Right)
      // ══════════════════════════════════════════════
      let globalToastTimeout;

      function showToast(titleOrMsg, optDescOrType, optType) {
        const toast = document.getElementById("toast");
        if (!toast) return;

        const toastIconContainer = document.getElementById(
          "toast-icon-container",
        );
        const toastTitle = document.getElementById("toast-title");
        const toastCloseBtn = document.getElementById("toast-close-btn");

        let message = titleOrMsg;
        let type = "success";

        if (typeof titleOrMsg === "object" && titleOrMsg !== null) {
          message = titleOrMsg.message || titleOrMsg.title || "";
          type = titleOrMsg.variant || titleOrMsg.type || "success";
        } else {
          if (typeof optDescOrType === "string") {
            if (
              optDescOrType === "success" ||
              optDescOrType === "error" ||
              optDescOrType === "failed" ||
              optDescOrType === "destructive" ||
              optDescOrType === "warning" ||
              optDescOrType === "info"
            ) {
              type =
                optDescOrType === "failed" || optDescOrType === "destructive"
                  ? "error"
                  : optDescOrType;
            } else if (
              optType === "error" ||
              optType === "failed" ||
              optType === "destructive" ||
              optType === "warning" ||
              optType === "info"
            ) {
              type =
                optType === "failed" || optType === "destructive"
                  ? "error"
                  : optType;
            }
          }
        }

        if (type === "destructive") type = "error";

        // Auto-detect error or warning from message
        if (type !== "error" && type !== "warning" && type !== "info") {
          const lower = `${message || ""} ${optDescOrType || ""}`.toLowerCase();
          if (
            lower.includes("fail") ||
            lower.includes("error") ||
            lower.includes("gagal") ||
            lower.includes("delete") ||
            lower.includes("hapus") ||
            lower.includes("permanently")
          ) {
            type = "error";
          } else if (
            lower.includes("pause") ||
            lower.includes("warn") ||
            lower.includes("required") ||
            lower.includes("perhatian") ||
            lower.includes("peringatan") ||
            lower.includes("minimal")
          ) {
            type = "warning";
          }
        }

        // Apply Exact Canvas Alert Styling
        if (type === "error") {
          // ReUI c-alert-8 variant="destructive"
          toast.className =
            "fixed bottom-6 right-6 transition-all duration-300 ease-out z-[9999] flex items-center gap-2.5 rounded-xl px-4 py-2.5 shadow-[0_10px_30px_-10px_rgba(239,68,68,0.2),0_4px_12px_rgba(0,0,0,0.05)] border border-red-500/30 bg-red-50/95 text-red-950 backdrop-blur-sm select-none";
          if (toastIconContainer) {
            toastIconContainer.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-red-600">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            `;
          }
          if (toastTitle) {
            toastTitle.className =
              "text-[13px] font-medium tracking-tight text-red-950 leading-none whitespace-nowrap";
            toastTitle.textContent = message;
          }
          if (toastCloseBtn) {
            toastCloseBtn.className =
              "text-red-700/60 hover:text-red-950 hover:bg-red-100/60 p-1 rounded-md transition-colors cursor-pointer shrink-0 ml-1.5";
          }
        } else if (type === "warning") {
          // ReUI variant="warning"
          toast.className =
            "fixed bottom-6 right-6 transition-all duration-300 ease-out z-[9999] flex items-center gap-2.5 rounded-xl px-4 py-2.5 shadow-[0_10px_30px_-10px_rgba(245,158,11,0.2),0_4px_12px_rgba(0,0,0,0.05)] border border-amber-500/30 bg-amber-50/95 text-amber-950 backdrop-blur-sm select-none";
          if (toastIconContainer) {
            toastIconContainer.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-600">
                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
            `;
          }
          if (toastTitle) {
            toastTitle.className =
              "text-[13px] font-medium tracking-tight text-amber-950 leading-none whitespace-nowrap";
            toastTitle.textContent = message;
          }
          if (toastCloseBtn) {
            toastCloseBtn.className =
              "text-amber-700/60 hover:text-amber-950 hover:bg-amber-100/60 p-1 rounded-md transition-colors cursor-pointer shrink-0 ml-1.5";
          }
        } else if (type === "info") {
          // ReUI variant="info"
          toast.className =
            "fixed bottom-6 right-6 transition-all duration-300 ease-out z-[9999] flex items-center gap-2.5 rounded-xl px-4 py-2.5 shadow-[0_10px_30px_-10px_rgba(59,130,246,0.2),0_4px_12px_rgba(0,0,0,0.05)] border border-blue-500/30 bg-blue-50/95 text-blue-950 backdrop-blur-sm select-none";
          if (toastIconContainer) {
            toastIconContainer.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
            `;
          }
          if (toastTitle) {
            toastTitle.className =
              "text-[13px] font-medium tracking-tight text-blue-950 leading-none whitespace-nowrap";
            toastTitle.textContent = message;
          }
          if (toastCloseBtn) {
            toastCloseBtn.className =
              "text-blue-700/60 hover:text-blue-950 hover:bg-blue-100/60 p-1 rounded-md transition-colors cursor-pointer shrink-0 ml-1.5";
          }
        } else {
          // ReUI c-alert-6 variant="success"
          toast.className =
            "fixed bottom-6 right-6 transition-all duration-300 ease-out z-[9999] flex items-center gap-2.5 rounded-xl px-4 py-2.5 shadow-[0_10px_30px_-10px_rgba(16,185,129,0.2),0_4px_12px_rgba(0,0,0,0.05)] border border-emerald-500/30 bg-emerald-50/95 text-emerald-950 backdrop-blur-sm select-none";
          if (toastIconContainer) {
            toastIconContainer.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            `;
          }
          if (toastTitle) {
            toastTitle.className =
              "text-[13px] font-medium tracking-tight text-emerald-950 leading-none whitespace-nowrap";
            toastTitle.textContent = message;
          }
          if (toastCloseBtn) {
            toastCloseBtn.className =
              "text-emerald-700/60 hover:text-emerald-950 hover:bg-emerald-100/60 p-1 rounded-md transition-colors cursor-pointer shrink-0 ml-1.5";
          }
        }

        toast.classList.remove(
          "translate-y-12",
          "opacity-0",
          "pointer-events-none",
        );
        toast.classList.add(
          "translate-y-0",
          "opacity-100",
          "pointer-events-auto",
        );

        clearTimeout(globalToastTimeout);
        globalToastTimeout = setTimeout(() => {
          toast.classList.add(
            "translate-y-12",
            "opacity-0",
            "pointer-events-none",
          );
          toast.classList.remove(
            "translate-y-0",
            "opacity-100",
            "pointer-events-auto",
          );
        }, 3000);
      }

      window.showToast = showToast;
      window.showAlert = function (options) {
        if (typeof options === "string") {
          showToast(options);
        } else if (typeof options === "object" && options !== null) {
          showToast(
            options.message || options.title || "",
            options.variant || "success",
          );
        }
      };

      // Polyfill window.alert to show the same alert
      window.alert = function (msg) {
        window.showToast(String(msg), "warning");
      };

      document.addEventListener("DOMContentLoaded", () => {
        const closeBtn = document.getElementById("toast-close-btn");
        if (closeBtn) {
          closeBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            const toast = document.getElementById("toast");
            if (toast) {
              clearTimeout(globalToastTimeout);
              toast.classList.add(
                "translate-y-12",
                "opacity-0",
                "pointer-events-none",
              );
              toast.classList.remove(
                "translate-y-0",
                "opacity-100",
                "pointer-events-auto",
              );
            }
          });
        }
      });
    </script>

    <!-- EXACT CANVAS-STYLE REUI / SHADCN ALERT NOTIFICATION (Bottom-Right) -->
    <div
      id="toast"
      role="alert"
      data-slot="alert"
      class="fixed bottom-6 right-6 translate-y-12 opacity-0 pointer-events-none transition-all duration-300 ease-out z-[9999] flex items-center gap-2.5 rounded-xl px-4 py-2.5 shadow-[0_10px_30px_-10px_rgba(16,185,129,0.2),0_4px_12px_rgba(0,0,0,0.05)] border border-emerald-500/30 bg-emerald-50/95 text-emerald-950 backdrop-blur-sm select-none"
    >
      <div
        id="toast-icon-container"
        data-slot="alert-icon"
        class="flex items-center justify-center shrink-0"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-emerald-600"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
      </div>
      <span
        id="toast-title"
        data-slot="alert-title"
        class="text-[13px] font-medium tracking-tight text-emerald-950 leading-none whitespace-nowrap"
        >Success! All good</span
      >
      <button
        id="toast-close-btn"
        class="text-emerald-700/60 hover:text-emerald-950 hover:bg-emerald-100/60 p-1 rounded-md transition-colors cursor-pointer shrink-0 ml-1.5"
        aria-label="Close"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>

    <ManageAccountModal />
    <GetCreditsModal />
  </body>
