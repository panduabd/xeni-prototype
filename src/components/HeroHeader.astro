---
interface Props {
  title?: string;
}

const {
  title = "Think Creative. Move Marketing.",
} = Astro.props;
---

<div class="w-full max-w-3xl mx-auto px-8 shrink-0 pt-4 pb-10 flex flex-col items-start">

  <!-- Draft Review Notification Card -->
  <div id="draft-review-banner" class="mb-[50px] w-full flex items-center justify-between p-4 rounded-2xl shadow-[0_4px_30px_rgba(0,0,0,0.02)] animate-in fade-in slide-in-from-top-3 duration-500 draft-border-shine select-none">
    <div class="flex items-center gap-3.5 min-w-0">
      <div class="relative w-10 h-10 rounded-lg bg-[#F2F4F7] dark:bg-[#272727] text-[#111827] dark:text-white border-none flex items-center justify-center shrink-0">
        <i class="ti ti-file-text text-[20px] text-[#111827] dark:text-white"></i>
        <!-- Yellow Counter Badge (Overlapping) -->
        <div class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-[#F59E0B] text-white text-[9px] font-extrabold flex items-center justify-center shadow-sm select-none border border-white dark:border-[#272727]">
          3
        </div>
      </div>
      <div class="flex flex-col min-w-0">
        <span class="text-[13px] font-bold text-[#111827] dark:text-white">Draft pending review</span>
        <span class="text-[11.5px] text-[#475467] dark:text-[#9ca3af] font-medium mt-0.5 truncate">Your automated "Summer Drink Campaign" has drafts ready for approval.</span>
      </div>
    </div>
    <div class="flex items-center gap-2 ml-4 shrink-0">
      <a href="/content-automation?tab=generated" class="flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-[#111827] dark:bg-white text-white dark:text-[#272727] text-[11.5px] font-bold hover:bg-black dark:hover:bg-zinc-200 transition-all cursor-pointer whitespace-nowrap shadow-sm">
        Review <i class="ti ti-arrow-right text-[12px]"></i>
      </a>
      <button
        id="close-draft-banner"
        type="button"
        title="Close"
        aria-label="Close notification"
        class="w-7 h-7 flex items-center justify-center rounded-lg text-[#9ca3af] hover:text-[#111827] dark:text-[#71717a] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10 transition-colors cursor-pointer"
      >
        <i class="ti ti-x text-[15px]"></i>
      </button>
    </div>
  </div>

  <div class="text-left max-w-2xl ml-[5px]">
    <h1 class="hero-title text-[24px] font-bold text-[#111827] dark:text-white tracking-tight leading-tight select-text">
      {title}
    </h1>
  </div>
</div>

<style>
  .hero-title {
    font-family: "Poppins", sans-serif;
  }
  @keyframes border-glow-flow {
    0% {
      background-position: 0 0, 200% center;
    }
    100% {
      background-position: 0 0, -200% center;
    }
  }
  .draft-border-shine {
    position: relative;
    background-image: linear-gradient(to right, white, white), linear-gradient(135deg, #eaecf0 35%, #F59E0B 50%, #eaecf0 65%);
    background-clip: padding-box, border-box;
    background-origin: padding-box, border-box;
    border: 1.5px solid transparent;
    background-size: 100% 100%, 200% 100%;
    animation: border-glow-flow 4s linear infinite;
  }
  :global(html.dark) .draft-border-shine {
    background-image: linear-gradient(to right, #272727, #272727), linear-gradient(135deg, #383838 35%, #F59E0B 50%, #383838 65%);
    background-clip: padding-box, border-box;
    background-origin: padding-box, border-box;
    border: 1.5px solid transparent;
    background-size: 100% 100%, 200% 100%;
    animation: border-glow-flow 4s linear infinite;
  }
</style>

<script is:inline>
  (function () {
    // Clear any previous dismissal state so the notification banner is always restored on reload
    try {
      sessionStorage.removeItem("xeni_draft_banner_dismissed");
      localStorage.removeItem("xeni_draft_banner_dismissed");
    } catch (e) {}

    function setupDraftBanner() {
      const banner = document.getElementById("draft-review-banner");
      const closeBtn = document.getElementById("close-draft-banner");
      if (!banner || !closeBtn) return;

      // Ensure banner is visible on page load/navigation
      banner.style.display = "";
      banner.style.opacity = "";
      banner.style.transform = "";
      banner.style.maxHeight = "";

      closeBtn.onclick = function (e) {
        e.preventDefault();
        e.stopPropagation();

        const initialHeight = banner.offsetHeight;
        banner.style.maxHeight = initialHeight + "px";
        banner.style.overflow = "hidden";
        banner.style.transition = "all 0.35s cubic-bezier(0.16, 1, 0.3, 1)";

        requestAnimationFrame(function () {
          banner.style.opacity = "0";
          banner.style.transform = "translateY(-8px)";
          banner.style.maxHeight = "0px";
          banner.style.paddingTop = "0px";
          banner.style.paddingBottom = "0px";
          banner.style.marginTop = "0px";
          banner.style.marginBottom = "0px";
          banner.style.borderWidth = "0px";
        });

        setTimeout(function () {
          banner.style.display = "none";
        }, 360);
      };
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupDraftBanner);
    } else {
      setupDraftBanner();
    }
    document.addEventListener("astro:page-load", setupDraftBanner);
  })();
</script>
