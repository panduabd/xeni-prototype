<style>
  /* 
    Pure CSS Keyframe Animation for Brand Guideline Chips Dropping into the Box
    Total cycle: 12 seconds (5 cards x 2.4s)
  */
  .dna-bucket-card {
    position: absolute;
    opacity: 0;
    transform: translateY(-80px) scale(0.85);
    animation: dnaCardPlunge 12s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    will-change: transform, opacity;
  }

  .dna-card-0 {
    animation-delay: 0s;
  }
  .dna-card-1 {
    animation-delay: 2.4s;
  }
  .dna-card-2 {
    animation-delay: 4.8s;
  }
  .dna-card-3 {
    animation-delay: 7.2s;
  }
  .dna-card-4 {
    animation-delay: 9.6s;
  }

  @keyframes dnaCardPlunge {
    /* 0% to 4%: Enters from top and settles at box mouth */
    0% {
      opacity: 0;
      transform: translateY(-85px) scale(0.85);
    }
    4% {
      opacity: 1;
      transform: translateY(0px) scale(1);
    }
    /* 4% to 15%: Hovers visibly at the mouth of the 3D box */
    15% {
      opacity: 1;
      transform: translateY(0px) scale(1);
    }
    /* 15% to 19.5%: Plunges down into the box interior behind front wall (Z-20) */
    19.5% {
      opacity: 0;
      transform: translateY(115px) scale(0.75);
    }
    /* 20% to 100%: Hidden while other cards cycle */
    20%, 100% {
      opacity: 0;
      transform: translateY(-85px) scale(0.85);
    }
  }
</style>
