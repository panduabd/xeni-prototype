</div>

<!-- ══════════ SUB-MODAL 7: ATTACHMENT PREVIEW LIGHTBOX ══════════ -->
<div
  id="modal-attachment-preview"
  class="hidden fixed inset-0 z-[250] flex items-center justify-center bg-black/80 backdrop-blur-xs p-4 animate-in fade-in duration-200"
>
  <div class="bg-white rounded-xl max-w-2xl w-full overflow-hidden shadow-xl border border-[#eaecf0] animate-in zoom-in-95 duration-200">
    <div class="flex items-center justify-between px-5 py-3 border-b border-[#eaecf0] bg-white">
      <span class="text-xs font-medium text-[#18181b] truncate max-w-md" id="preview-filename">File Preview</span>
      <button
        type="button"
        id="btn-close-attachment-preview"
        class="inline-flex items-center justify-center rounded-lg text-[#71717a] hover:text-[#18181b] hover:bg-[#f4f4f5] h-7 w-7 transition-colors cursor-pointer"
      >
        <i class="ti ti-x text-sm"></i>
      </button>
    </div>
    <div class="p-4 bg-[#fafafa] flex items-center justify-center min-h-[250px] max-h-[70vh] overflow-auto" id="preview-media-container">
      <!-- Injected <img> or <video> -->
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("manage-account-modal");
    const closeBtn = document.getElementById("close-manage-account");
    const tabButtons = document.querySelectorAll(".manage-account-tab-btn");
    const tabSections = document.querySelectorAll(".manage-account-tab-section");

    // Tab switcher logic
    function switchTab(tabId) {
      tabButtons.forEach(btn => {
        if (btn.getAttribute("data-tab") === tabId) {
          btn.classList.add("bg-white", "text-[#111827]", "shadow-xs");
          btn.classList.remove("text-[#475467]", "hover:bg-white/60", "hover:text-[#111827]");
        } else {
          btn.classList.remove("bg-white", "text-[#111827]", "shadow-xs");
          btn.classList.add("text-[#475467]", "hover:bg-white/60", "hover:text-[#111827]");
        }
      });

      tabSections.forEach(section => {
        if (section.id === `manage-account-tab-${tabId}`) {
          section.classList.remove("hidden");
        } else {
          section.classList.add("hidden");
        }
      });
    }

    tabButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        const tabId = btn.getAttribute("data-tab");
        switchTab(tabId);
      });
    });

    if (closeBtn && modal) {
      closeBtn.addEventListener("click", () => {
        modal.classList.add("hidden");
      });
      modal.addEventListener("click", (e) => {
        if (e.target === modal) modal.classList.add("hidden");
      });
    }

    // Global listener to trigger opening the modal and setting active tab
    window.addEventListener("open-manage-account", (e) => {
      if (modal) {
        modal.classList.remove("hidden");
        const activeTab = e.detail?.tab || "profile";
        switchTab(activeTab);
      }
    });

    // Log out button in modal
    const btnLogoutModal = document.getElementById("btn-logout-modal");
    if (btnLogoutModal) {
      btnLogoutModal.addEventListener("click", () => {
        window.location.href = "/";
      });
    }

    // Open Upgrade Plan (Get Credits) modal from Subscription tab
    const btnUpgradePlanAction = document.getElementById("btn-upgrade-plan-action");
    if (btnUpgradePlanAction) {
      btnUpgradePlanAction.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("open-get-credits"));
      });
    }

    // Modal copy referral link
    const btnModalCopy = document.getElementById("btn-modal-copy-ref");
    const modalRefLink = document.getElementById("modal-ref-link");
    const modalCopyBtnText = document.getElementById("modal-copy-btn-text");
    if (btnModalCopy && modalRefLink && modalCopyBtnText) {
      btnModalCopy.addEventListener("click", () => {
        navigator.clipboard.writeText(modalRefLink.textContent.trim());
        modalCopyBtnText.textContent = "Copied!";
        setTimeout(() => {
          modalCopyBtnText.textContent = "Copy Link";
        }, 2000);
      });
    }

    // Modal feedback category selection & interactivity
    const feedbackCategoryPills = document.querySelectorAll(".feedback-category-pill");
    const modalFeedbackTopic = document.getElementById("modal-feedback-topic");
    const modalFeedbackSubject = document.getElementById("modal-feedback-subject");
    const modalFeedbackMessage = document.getElementById("modal-feedback-message");
    const feedbackCharCount = document.getElementById("feedback-char-count");

    const categoryPlaceholders = {
      "Feature Request": "What feature or workflow would you like Xeni to have? Describe how you'd use it...",
      "Bug Report": "What happened? What did you expect to happen? Steps to reproduce the issue...",
      "UI & Design Improvement": "Which screen or component feels off? What would make it look or feel cleaner?",
      "General Feedback": "Share your thoughts, workflow stories, or general feedback with the team..."
    };

    feedbackCategoryPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const val = pill.getAttribute("data-value");
        if (modalFeedbackTopic) modalFeedbackTopic.value = val;
        feedbackCategoryPills.forEach((p) => {
          p.className = "feedback-category-pill px-3 py-2 rounded-lg border border-[#e4e4e7] bg-white text-[#3f3f46] hover:bg-[#f4f4f5] text-xs font-medium flex items-center gap-2 transition-colors cursor-pointer shadow-xs text-left";
        });
        pill.className = "feedback-category-pill active px-3 py-2 rounded-lg border border-[#18181b] bg-[#18181b] text-white text-xs font-medium flex items-center gap-2 transition-colors cursor-pointer shadow-xs text-left";
        if (modalFeedbackMessage && categoryPlaceholders[val]) {
          modalFeedbackMessage.placeholder = categoryPlaceholders[val];
        }
      });
    });

    // Character counter
    if (modalFeedbackMessage && feedbackCharCount) {
      modalFeedbackMessage.addEventListener("input", () => {
        feedbackCharCount.textContent = `${modalFeedbackMessage.value.length} / 1000`;
      });
    }

    // ─── Attachment Multi-File Manager (Max 5, View & Delete) ───
    const feedbackAttachmentInput = document.getElementById("feedback-attachment-input");
    const attachmentDropArea = document.getElementById("attachment-drop-area");
    const attachmentFilesList = document.getElementById("attachment-files-list");
    const attachmentCounter = document.getElementById("attachment-counter");

    // Preview lightbox elements
    const modalAttachmentPreview = document.getElementById("modal-attachment-preview");
    const previewFilename = document.getElementById("preview-filename");
    const previewMediaContainer = document.getElementById("preview-media-container");
    const btnCloseAttachmentPreview = document.getElementById("btn-close-attachment-preview");

    let attachedFiles = [];

    function renderAttachments() {
      if (!attachmentFilesList || !attachmentCounter) return;

      attachmentCounter.textContent = `${attachedFiles.length} / 5 files`;

      if (attachedFiles.length === 0) {
        attachmentFilesList.classList.add("hidden");
        attachmentFilesList.innerHTML = "";
        if (attachmentDropArea) attachmentDropArea.classList.remove("hidden");
        return;
      }

      attachmentFilesList.classList.remove("hidden");
      if (attachmentDropArea) {
        if (attachedFiles.length >= 5) {
          attachmentDropArea.classList.add("hidden");
        } else {
          attachmentDropArea.classList.remove("hidden");
        }
      }

      attachmentFilesList.innerHTML = "";
      attachedFiles.forEach((item, index) => {
        const row = document.createElement("div");
        row.className = "flex items-center justify-between p-2.5 rounded-xl border border-[#eaecf0] bg-white text-[12px] animate-in fade-in duration-200";

        const isImg = item.type.startsWith("image/");
        const isVid = item.type.startsWith("video/");

        row.innerHTML = `
          <div class="flex items-center gap-2.5 min-w-0 flex-1 mr-2">
            <div class="w-8 h-8 rounded-lg bg-[#f3f4f6] border border-[#eaecf0] flex items-center justify-center text-[#667085] shrink-0 overflow-hidden">
              ${isImg ? `<img src="${item.url}" class="w-full h-full object-cover" />` : (isVid ? `<i class="ti ti-video text-[15px]"></i>` : `<i class="ti ti-file text-[15px]"></i>`)}
            </div>
            <div class="min-w-0 flex-1">
              <p class="font-medium text-[#111827] truncate text-[12px]">${item.name}</p>
              <p class="text-[10.5px] text-[#98a2b3]">${item.sizeStr}</p>
            </div>
          </div>
          <div class="flex items-center gap-1.5 shrink-0">
            <button
              type="button"
              class="btn-view-file px-2.5 py-1 rounded-lg border border-[#eaecf0] bg-white text-[#344054] hover:bg-[#F9FAFB] hover:text-[#111827] text-[11px] font-medium flex items-center gap-1 transition-colors cursor-pointer"
              data-idx="${index}"
            >
              <i class="ti ti-eye text-[12px]"></i>
              <span>View</span>
            </button>
            <button
              type="button"
              class="btn-del-file w-7 h-7 rounded-lg border border-[#eaecf0] bg-white text-[#667085] hover:text-red-600 hover:border-red-200 hover:bg-red-50 flex items-center justify-center transition-colors cursor-pointer"
              data-idx="${index}"
              title="Delete attachment"
            >
              <i class="ti ti-trash text-[13px]"></i>
            </button>
          </div>
        `;

        attachmentFilesList.appendChild(row);
      });

      // Attach View & Delete click listeners
      attachmentFilesList.querySelectorAll(".btn-view-file").forEach(btn => {
        btn.addEventListener("click", () => {
          const idx = parseInt(btn.getAttribute("data-idx") || "0", 10);
          const item = attachedFiles[idx];
          if (item) openPreview(item);
        });
      });

      attachmentFilesList.querySelectorAll(".btn-del-file").forEach(btn => {
        btn.addEventListener("click", () => {
          const idx = parseInt(btn.getAttribute("data-idx") || "0", 10);
          attachedFiles.splice(idx, 1);
          renderAttachments();
        });
      });
    }

    function openPreview(item) {
      if (!modalAttachmentPreview || !previewMediaContainer || !previewFilename) return;
      previewFilename.textContent = item.name;

      if (item.type.startsWith("image/")) {
        previewMediaContainer.innerHTML = `<img src="${item.url}" alt="${item.name}" class="max-w-full max-h-[60vh] object-contain rounded-xl shadow-xs" />`;
      } else if (item.type.startsWith("video/")) {
        previewMediaContainer.innerHTML = `<video src="${item.url}" controls autoplay class="max-w-full max-h-[60vh] rounded-xl shadow-xs"></video>`;
      } else {
        previewMediaContainer.innerHTML = `<p class="text-[13px] text-[#667085]">Preview not available for this format.</p>`;
      }

      modalAttachmentPreview.classList.remove("hidden");
    }

    function closePreview() {
      if (modalAttachmentPreview) {
        modalAttachmentPreview.classList.add("hidden");
        if (previewMediaContainer) previewMediaContainer.innerHTML = "";
      }
    }

    if (btnCloseAttachmentPreview) btnCloseAttachmentPreview.addEventListener("click", closePreview);
    if (modalAttachmentPreview) {
      modalAttachmentPreview.addEventListener("click", (e) => {
        if (e.target === modalAttachmentPreview) closePreview();
      });
    }

    if (feedbackAttachmentInput) {
      feedbackAttachmentInput.addEventListener("change", (e) => {
        const files = Array.from(e.target.files || []);
        for (const file of files) {
          if (attachedFiles.length < 5) {
            attachedFiles.push({
              file: file,
              name: file.name,
              sizeStr: `${Math.round(file.size / 1024)} KB`,
              url: URL.createObjectURL(file),
              type: file.type
            });
          }
        }
        feedbackAttachmentInput.value = "";
        renderAttachments();
      });
    }

    // Modal feedback form submission
    const modalFeedbackForm = document.getElementById("modal-feedback-form");
    const modalFeedbackSuccess = document.getElementById("modal-feedback-success");
    if (modalFeedbackForm && modalFeedbackSuccess) {
      modalFeedbackForm.addEventListener("submit", (e) => {
        e.preventDefault();
        modalFeedbackSuccess.classList.remove("hidden");
        if (modalFeedbackMessage) modalFeedbackMessage.value = "";
        if (modalFeedbackSubject) modalFeedbackSubject.value = "";
        if (feedbackCharCount) feedbackCharCount.textContent = "0 / 1000";
        attachedFiles = [];
        renderAttachments();
        setTimeout(() => {
          modalFeedbackSuccess.classList.add("hidden");
        }, 5000);
      });
    }


    // ─── Payout Setup Modal & Method Toggle ───
    const modalPayoutSetup = document.getElementById("modal-payout-setup");
    const btnAddPayout = document.getElementById("btn-add-payout-method");
    const btnEditPayoutDetails = document.getElementById("btn-edit-payout-details");
    const btnClosePayout = document.getElementById("btn-close-payout-modal");
    const btnCancelPayout = document.getElementById("btn-cancel-payout-modal");
    const formPayoutSetup = document.getElementById("form-payout-setup");
    const payoutMethodOpts = document.querySelectorAll(".payout-method-opt");

    const fieldBank = document.getElementById("field-bank-container");
    const fieldEwallet = document.getElementById("field-ewallet-container");

    const payoutEmptyState = document.getElementById("payout-empty-state");
    const payoutConfiguredState = document.getElementById("payout-configured-state");
    const displayPayoutMethod = document.getElementById("display-payout-method");
    const displayPayoutAccount = document.getElementById("display-payout-account");
    const displayPayoutIcon = document.getElementById("display-payout-icon");

    let currentSelectedMethod = "Bank Transfer";
    let currentMethodIcon = "ti-building-bank";

    function openPayoutSetup() {
      if (modalPayoutSetup) modalPayoutSetup.classList.remove("hidden");
    }

    function closePayoutSetup() {
      if (modalPayoutSetup) modalPayoutSetup.classList.add("hidden");
    }

    if (btnAddPayout) btnAddPayout.addEventListener("click", openPayoutSetup);
    if (btnEditPayoutDetails) btnEditPayoutDetails.addEventListener("click", openPayoutSetup);
    if (btnClosePayout) btnClosePayout.addEventListener("click", closePayoutSetup);
    if (btnCancelPayout) btnCancelPayout.addEventListener("click", closePayoutSetup);
    if (modalPayoutSetup) {
      modalPayoutSetup.addEventListener("click", (e) => {
        if (e.target === modalPayoutSetup) closePayoutSetup();
      });
    }

    const activeMethodClass = "payout-method-opt px-3 py-2 rounded-lg border border-[#18181b] bg-[#18181b] text-white hover:bg-black text-xs font-medium flex items-center justify-center gap-2 transition-colors cursor-pointer shadow-xs";
    const inactiveMethodClass = "payout-method-opt px-3 py-2 rounded-lg border border-[#e4e4e7] bg-white text-[#3f3f46] hover:bg-[#f4f4f5] hover:text-[#18181b] text-xs font-medium flex items-center justify-center gap-2 transition-colors cursor-pointer shadow-xs";

    function updateMethodButtons(selectedMethod) {
      payoutMethodOpts.forEach((btn) => {
        if (btn.getAttribute("data-method") === selectedMethod) {
          btn.className = activeMethodClass;
        } else {
          btn.className = inactiveMethodClass;
        }
      });
    }

    // Toggle method buttons inside setup modal
    payoutMethodOpts.forEach((btn) => {
      btn.addEventListener("click", () => {
        currentSelectedMethod = btn.getAttribute("data-method") || "Bank Transfer";
        currentMethodIcon = btn.getAttribute("data-icon") || "ti-building-bank";
        updateMethodButtons(currentSelectedMethod);

        if (fieldBank) fieldBank.classList.add("hidden");
        if (fieldEwallet) fieldEwallet.classList.add("hidden");

        if (currentSelectedMethod === "Bank Transfer" && fieldBank) {
          fieldBank.classList.remove("hidden");
        } else if (currentSelectedMethod === "E-Wallet" && fieldEwallet) {
          fieldEwallet.classList.remove("hidden");
        }
      });
    });

    // Handle saving payout details
    if (formPayoutSetup) {
      formPayoutSetup.addEventListener("submit", (e) => {
        e.preventDefault();
        let methodName = "";
        let accountSummary = "";

        if (currentSelectedMethod === "Bank Transfer") {
          const bank = document.getElementById("input-bank-name")?.value || "BCA";
          const acc = document.getElementById("input-bank-account")?.value?.trim() || "8271928371";
          const holder = document.getElementById("input-bank-holder")?.value?.trim() || "Jane Cooper";
          methodName = `Bank ${bank}`;
          accountSummary = `${acc} (${holder})`;
        } else {
          const provider = document.getElementById("input-ewallet-provider")?.value || "GoPay";
          const phone = document.getElementById("input-ewallet-phone")?.value?.trim() || "081234567890";
          const holder = document.getElementById("input-ewallet-name")?.value?.trim() || "Jane Cooper";
          methodName = provider;
          accountSummary = `${phone} (${holder})`;
        }

        if (displayPayoutMethod) displayPayoutMethod.textContent = methodName;
        if (displayPayoutAccount) displayPayoutAccount.textContent = accountSummary;
        if (displayPayoutIcon) displayPayoutIcon.className = `ti ${currentMethodIcon} text-[18px]`;

        if (payoutEmptyState) payoutEmptyState.classList.add("hidden");
        if (payoutConfiguredState) payoutConfiguredState.classList.remove("hidden");
        if (btnEditPayoutDetails) btnEditPayoutDetails.classList.remove("hidden");

        closePayoutSetup();
      });
    }

    // ─── Payment History Modal ───
    const modalPaymentHistory = document.getElementById("modal-payment-history");
    const btnOpenHistory = document.getElementById("btn-open-payment-history");
    const btnCloseHistory = document.getElementById("btn-close-payment-history");
    const btnCloseHistoryBottom = document.getElementById("btn-close-payment-history-bottom");

    function openHistory() {
      if (modalPaymentHistory) modalPaymentHistory.classList.remove("hidden");
    }

    function closeHistory() {
      if (modalPaymentHistory) modalPaymentHistory.classList.add("hidden");
    }

    if (btnOpenHistory) btnOpenHistory.addEventListener("click", openHistory);
    if (btnCloseHistory) btnCloseHistory.addEventListener("click", closeHistory);
    if (btnCloseHistoryBottom) btnCloseHistoryBottom.addEventListener("click", closeHistory);
    if (modalPaymentHistory) {
      modalPaymentHistory.addEventListener("click", (e) => {
        if (e.target === modalPaymentHistory) closeHistory();
      });
    }

    // ─── Subscription Free vs Pro Switcher & Upgrade State ───
    const btnSwitchPlanFree = document.getElementById("btn-switch-plan-free");
    const btnSwitchPlanPro = document.getElementById("btn-switch-plan-pro");
    const viewFree = document.getElementById("subscription-view-free");
    const viewPro = document.getElementById("subscription-view-pro");
    const subAlertToast = document.getElementById("subscription-alert-toast");
    const subAlertText = document.getElementById("subscription-alert-text");
    const btnDismissSubAlert = document.getElementById("btn-dismiss-sub-alert");

    let subToastTimeout = null;
    function showSubAlert(message) {
      if (!subAlertToast || !subAlertText) return;
      subAlertText.textContent = message;
      subAlertToast.classList.remove("hidden");
      if (subToastTimeout) clearTimeout(subToastTimeout);
      subToastTimeout = setTimeout(() => {
        subAlertToast.classList.add("hidden");
      }, 5000);
    }

    if (btnDismissSubAlert && subAlertToast) {
      btnDismissSubAlert.addEventListener("click", () => {
        subAlertToast.classList.add("hidden");
      });
    }

    function switchToFree(persist = true) {
      if (viewFree) viewFree.classList.remove("hidden");
      if (viewPro) viewPro.classList.add("hidden");
      if (btnSwitchPlanFree && btnSwitchPlanPro) {
        btnSwitchPlanFree.className = "px-3 py-1 rounded-lg font-medium transition-all cursor-pointer bg-white text-[#111827] shadow-xs";
        btnSwitchPlanPro.className = "px-3 py-1 rounded-lg font-medium transition-all cursor-pointer text-[#667085] hover:text-[#111827]";
      }
      if (persist) {
        localStorage.setItem("xeni_user_plan", "free");
        window.dispatchEvent(new CustomEvent("plan-status-changed", { detail: { plan: "free" } }));
      }
    }

    function switchToPro(withAlert = false, alertMsg = "", persist = true) {
      if (viewFree) viewFree.classList.add("hidden");
      if (viewPro) viewPro.classList.remove("hidden");
      if (btnSwitchPlanFree && btnSwitchPlanPro) {
        btnSwitchPlanPro.className = "px-3 py-1 rounded-lg font-medium transition-all cursor-pointer bg-white text-[#111827] shadow-xs";
        btnSwitchPlanFree.className = "px-3 py-1 rounded-lg font-medium transition-all cursor-pointer text-[#667085] hover:text-[#111827]";
      }
      if (persist) {
        localStorage.setItem("xeni_user_plan", "pro");
        window.dispatchEvent(new CustomEvent("plan-status-changed", { detail: { plan: "pro" } }));
      }
      if (withAlert && alertMsg) {
        showSubAlert(alertMsg);
      }
    }

    if (btnSwitchPlanFree) btnSwitchPlanFree.addEventListener("click", () => switchToFree(true));
    if (btnSwitchPlanPro) btnSwitchPlanPro.addEventListener("click", () => switchToPro(false, "", true));

    // Initialize based on saved plan
    const initialSavedPlan = localStorage.getItem("xeni_user_plan") || "free";
    if (initialSavedPlan === "pro") {
      switchToPro(false, "", false);
    } else {
      switchToFree(false);
    }

    window.addEventListener("upgraded-to-pro", () => {
      switchToPro(true, "Congratulations! Your account was upgraded to Pro Plan! 1,500 credits have been added.", true);
    });

    // ─── Manage Plan & Upgrade Plan Mechanism ───
    const modalManagePlan = document.getElementById("modal-manage-plan");
    const btnManageSub = document.getElementById("btn-manage-subscription-action");
    const btnCloseManagePlan = document.getElementById("btn-close-manage-plan");
    const btnCloseManagePlanBottom = document.getElementById("btn-close-manage-plan-bottom");
    const modalManageSisaCredits = document.getElementById("modal-manage-sisa-credits");
    const btnTriggerUpgradePlan = document.getElementById("btn-trigger-upgrade-plan");
    const btnRenewEarlyPlan = document.getElementById("btn-renew-early-plan");
    const btnCancelRenewal = document.getElementById("btn-cancel-renewal-action");

    // Upgrade Sub-modal elements
    const modalUpgradePlan = document.getElementById("modal-upgrade-plan");
    const btnCloseUpgradePlan = document.getElementById("btn-close-upgrade-plan");
    const btnCancelUpgradeModal = document.getElementById("btn-cancel-upgrade-modal");
    const btnConfirmUpgradeAgency = document.getElementById("btn-confirm-upgrade-agency");
    const upgradeModalSisaCredits = document.getElementById("upgrade-modal-sisa-credits");

    // Renew Early Sub-modal elements
    const modalRenewEarly = document.getElementById("modal-renew-early");
    const btnCloseRenewEarly = document.getElementById("btn-close-renew-early");
    const btnCancelRenewEarlyModal = document.getElementById("btn-cancel-renew-early-modal");
    const btnConfirmRenewEarly = document.getElementById("btn-confirm-renew-early");
    const renewModalSisaCredits = document.getElementById("renew-modal-sisa-credits");

    let monthlyCreditsVal = 1000;
    let topupCreditsVal = 2250;

    // ─── Top-Up Detail Modal & Batches Controller (Max 3 + Show More) ───
    const modalTopupDetail = document.getElementById("modal-topup-detail");
    const btnOpenTopupDetail = document.getElementById("btn-open-topup-detail-modal");
    const btnCloseTopupDetail = document.getElementById("btn-close-topup-detail");
    const btnCloseTopupDetailBottom = document.getElementById("btn-close-topup-detail-bottom");
    const btnDetailModalToTopup = document.getElementById("btn-detail-modal-to-topup");
    const modalTopupDetailTotal = document.getElementById("modal-topup-detail-total");

    const btnToggleTopupBatches = document.getElementById("btn-toggle-topup-batches");
    const btnToggleTopupText = document.getElementById("btn-toggle-topup-text");
    const btnToggleTopupIcon = document.getElementById("btn-toggle-topup-icon");
    const activeTopupList = document.getElementById("active-topup-packs-list");
    const topupBatchesCountBadge = document.getElementById("topup-batches-count-badge");

    let isTopupBatchesExpanded = false;

    function openTopupDetailModal() {
      if (modalTopupDetail) {
        if (modalTopupDetailTotal) modalTopupDetailTotal.textContent = topupCreditsVal.toLocaleString("en-US");
        refreshTopupBatchesVisibility();
        modalTopupDetail.classList.remove("hidden");
      }
    }

    function closeTopupDetailModal() {
      if (modalTopupDetail) modalTopupDetail.classList.add("hidden");
    }

    if (btnOpenTopupDetail) btnOpenTopupDetail.addEventListener("click", openTopupDetailModal);
    if (btnCloseTopupDetail) btnCloseTopupDetail.addEventListener("click", closeTopupDetailModal);
    if (btnCloseTopupDetailBottom) btnCloseTopupDetailBottom.addEventListener("click", closeTopupDetailModal);
    if (modalTopupDetail) {
      modalTopupDetail.addEventListener("click", (e) => {
        if (e.target === modalTopupDetail) closeTopupDetailModal();
      });
    }

    // Button from inside detail modal to open Top Up credits modal
    if (btnDetailModalToTopup) {
      btnDetailModalToTopup.addEventListener("click", () => {
        closeTopupDetailModal();
        openTopupModal();
      });
    }

    function refreshTopupBatchesVisibility() {
      const rows = document.querySelectorAll(".topup-batch-row");
      const totalRows = rows.length;

      if (topupBatchesCountBadge) {
        topupBatchesCountBadge.textContent = `${totalRows} active packs`;
      }
      rows.forEach(r => r.classList.remove("hidden"));
    }

    // Initial setup
    refreshTopupBatchesVisibility();

    function openManagePlanModal() {
      if (modalManagePlan) {
        if (modalManageSisaCredits) modalManageSisaCredits.textContent = `${monthlyCreditsVal.toLocaleString("en-US")} credits`;
        modalManagePlan.classList.remove("hidden");
      }
    }

    function closeManagePlanModal() {
      if (modalManagePlan) modalManagePlan.classList.add("hidden");
    }

    if (btnManageSub) btnManageSub.addEventListener("click", openManagePlanModal);
    if (btnCloseManagePlan) btnCloseManagePlan.addEventListener("click", closeManagePlanModal);
    if (btnCloseManagePlanBottom) btnCloseManagePlanBottom.addEventListener("click", closeManagePlanModal);
    if (modalManagePlan) {
      modalManagePlan.addEventListener("click", (e) => {
        if (e.target === modalManagePlan) closeManagePlanModal();
      });
    }

    // "Upgrade Plan" button inside manage plan (highlighted) → open upgrade modal
    function openUpgradeModal() {
      if (modalUpgradePlan) {
        if (upgradeModalSisaCredits) upgradeModalSisaCredits.textContent = `${monthlyCreditsVal.toLocaleString("en-US")} credits`;
        modalUpgradePlan.classList.remove("hidden");
      }
    }

    function closeUpgradeModal() {
      if (modalUpgradePlan) modalUpgradePlan.classList.add("hidden");
    }

    if (btnTriggerUpgradePlan) {
      btnTriggerUpgradePlan.addEventListener("click", () => {
        closeManagePlanModal();
        window.dispatchEvent(new CustomEvent("open-get-credits"));
      });
    }

    if (btnCloseUpgradePlan) btnCloseUpgradePlan.addEventListener("click", closeUpgradeModal);
    if (btnCancelUpgradeModal) btnCancelUpgradeModal.addEventListener("click", closeUpgradeModal);
    if (modalUpgradePlan) {
      modalUpgradePlan.addEventListener("click", (e) => {
        if (e.target === modalUpgradePlan) closeUpgradeModal();
      });
    }

    // Confirm Upgrade to Agency Plan: old credits expire, +5000 new monthly credits
    if (btnConfirmUpgradeAgency) {
      btnConfirmUpgradeAgency.addEventListener("click", () => {
        monthlyCreditsVal = 5000;
        if (proMonthlyCredits) proMonthlyCredits.textContent = "5,000";
        if (modalManageSisaCredits) modalManageSisaCredits.textContent = "5,000 credits";

        const activePlanTitle = document.getElementById("active-plan-title");
        const activePlanSubtitle = document.getElementById("active-plan-subtitle");
        if (activePlanTitle) activePlanTitle.textContent = "Agency Plan";
        if (activePlanSubtitle) activePlanSubtitle.textContent = "Rp 990,000 / month · Auto-renews on Oct 09, 2026";

        // Prepend new usage row
        if (proUsageTableBody) {
          const newRow = document.createElement("tr");
          newRow.className = "hover:bg-[#F9FAFB] transition-colors";
          newRow.innerHTML = `
            <td class="px-4 py-3 font-medium text-[#111827]">Plan Upgrade (Agency Plan · 5,000 Credits)</td>
            <td class="px-4 py-3 font-medium text-[#667085]">Upgrade</td>
            <td class="px-4 py-3 text-[#4b5563]">Today, just now</td>
            <td class="px-4 py-3 text-right font-bold text-emerald-600">+5,000</td>
          `;
          proUsageTableBody.insertBefore(newRow, proUsageTableBody.firstChild);
        }

        closeUpgradeModal();
        showSubAlert("Congratulations! Your account has been upgraded to Agency Plan! 5,000 fresh monthly credits are ready to use.");
      });
    }

    // ─── Renew Early Modal Controller ───
    function openRenewEarlyModal() {
      if (modalRenewEarly) {
        if (renewModalSisaCredits) renewModalSisaCredits.textContent = `${monthlyCreditsVal.toLocaleString("en-US")} credits`;
        modalRenewEarly.classList.remove("hidden");
      }
    }

    function closeRenewEarlyModal() {
      if (modalRenewEarly) modalRenewEarly.classList.add("hidden");
    }

    if (btnRenewEarlyPlan) {
      btnRenewEarlyPlan.addEventListener("click", () => {
        closeManagePlanModal();
        openRenewEarlyModal();
      });
    }

    if (btnCloseRenewEarly) btnCloseRenewEarly.addEventListener("click", closeRenewEarlyModal);
    if (btnCancelRenewEarlyModal) btnCancelRenewEarlyModal.addEventListener("click", closeRenewEarlyModal);
    if (modalRenewEarly) {
      modalRenewEarly.addEventListener("click", (e) => {
        if (e.target === modalRenewEarly) closeRenewEarlyModal();
      });
    }

    if (btnConfirmRenewEarly) {
      btnConfirmRenewEarly.addEventListener("click", () => {
        monthlyCreditsVal = 1500;
        if (proMonthlyCredits) proMonthlyCredits.textContent = "1,500";
        if (modalManageSisaCredits) modalManageSisaCredits.textContent = "1,500 credits";

        // Prepend new usage row
        if (proUsageTableBody) {
          const newRow = document.createElement("tr");
          newRow.className = "hover:bg-[#F9FAFB] transition-colors";
          newRow.innerHTML = `
            <td class="px-4 py-3 font-medium text-[#111827]">Renew Subscription Early (Pro Plan · +1,500 Credits)</td>
            <td class="px-4 py-3 font-medium text-[#667085]">Subscription</td>
            <td class="px-4 py-3 text-[#4b5563]">Today, just now</td>
            <td class="px-4 py-3 text-right font-bold text-emerald-600">+1,500</td>
          `;
          proUsageTableBody.insertBefore(newRow, proUsageTableBody.firstChild);
        }

        closeRenewEarlyModal();
        showSubAlert("Pro subscription renewed early! A new cycle has started and 1,500 monthly credits are ready to use.");
      });
    }



    if (btnCancelRenewal) {
      btnCancelRenewal.addEventListener("click", () => {
        closeManagePlanModal();
        showSubAlert("Auto-renewal disabled. Credits remain active until Oct 09, 2026.");
      });
    }

    // ─── Top Up Credits Modal & Purchase Mechanism ───
    const modalTopup = document.getElementById("modal-topup-credits");
    const btnOpenTopupPro = document.getElementById("btn-open-topup-pro");
    const btnCloseTopup = document.getElementById("btn-close-topup-credits");
    const btnCancelTopup = document.getElementById("btn-cancel-topup-credits");
    const formTopup = document.getElementById("form-topup-credits");
    const topupPackCards = document.querySelectorAll(".topup-pack-card");
    const topupSummaryPrice = document.getElementById("topup-summary-price");
    const btnTopupLabel = document.getElementById("btn-topup-label");
    const proMonthlyCredits = document.getElementById("pro-monthly-credits");
    const proTopupCredits = document.getElementById("pro-topup-credits");
    const proUsageTableBody = document.getElementById("pro-usage-table-body");

    let selectedTopupCredits = 150;
    let selectedTopupPriceFmt = "Rp 179,000";
    let selectedTopupLabel = "150 Credits";

    function openTopupModal() {
      if (modalTopup) modalTopup.classList.remove("hidden");
    }

    function closeTopupModal() {
      if (modalTopup) modalTopup.classList.add("hidden");
    }

    if (btnOpenTopupPro) btnOpenTopupPro.addEventListener("click", openTopupModal);
    if (btnCloseTopup) btnCloseTopup.addEventListener("click", closeTopupModal);
    if (btnCancelTopup) btnCancelTopup.addEventListener("click", closeTopupModal);
    if (modalTopup) {
      modalTopup.addEventListener("click", (e) => {
        if (e.target === modalTopup) closeTopupModal();
      });
    }

    // Toggle Top Up pack cards
    topupPackCards.forEach((card) => {
      card.addEventListener("click", (e) => {
        // If clicking radio input directly, let change handler handle it
        if (e.target && (e.target.tagName === "INPUT" || e.target.closest("label"))) return;

        topupPackCards.forEach((c) => {
          c.classList.remove("border-2", "border-[#111827]", "bg-[#F9FAFB]", "shadow-xs");
          c.classList.add("border", "border-[#eaecf0]", "bg-white");
        });
        card.classList.add("border-2", "border-[#111827]", "bg-[#F9FAFB]", "shadow-xs");
        card.classList.remove("border-[#eaecf0]", "bg-white");

        selectedTopupCredits = parseInt(card.getAttribute("data-credits") || "150", 10);
        selectedTopupPriceFmt = card.getAttribute("data-price-fmt") || "Rp 179,000";
        selectedTopupLabel = card.getAttribute("data-label") || "150 Credits";

        if (topupSummaryPrice) topupSummaryPrice.textContent = selectedTopupPriceFmt;
        if (btnTopupLabel) btnTopupLabel.textContent = `Buy ${selectedTopupLabel}`;
      });
    });

    // Radio cycle change handler for credit pack cards
    const radioCycleInputs = document.querySelectorAll(".radio-cycle-input");
    radioCycleInputs.forEach((radio) => {
      radio.addEventListener("change", () => {
        const card = radio.closest(".topup-pack-card");
        if (!card) return;
        const isYearly = radio.value === "yearly";
        const priceMonthly = parseInt(card.getAttribute("data-price-monthly") || "179000", 10);
        const priceYearly = parseInt(card.getAttribute("data-price-yearly") || "143000", 10);
        const priceDisplay = card.querySelector(".pack-price-display");
        const cycleDisplay = card.querySelector(".pack-cycle-display");

        if (isYearly) {
          const formattedYearlyMonthly = "Rp " + priceYearly.toLocaleString("en-US");
          if (priceDisplay) priceDisplay.textContent = formattedYearlyMonthly;
          if (cycleDisplay) cycleDisplay.textContent = "/mo";
          card.setAttribute("data-price-fmt", formattedYearlyMonthly + " (Yearly)");
        } else {
          const formattedMonthly = "Rp " + priceMonthly.toLocaleString("en-US");
          if (priceDisplay) priceDisplay.textContent = formattedMonthly;
          if (cycleDisplay) cycleDisplay.textContent = "/mo";
          card.setAttribute("data-price-fmt", formattedMonthly);
        }

        // Auto-select this card if not already selected
        topupPackCards.forEach((c) => {
          c.classList.remove("border-2", "border-[#111827]", "bg-[#F9FAFB]", "shadow-xs");
          c.classList.add("border", "border-[#eaecf0]", "bg-white");
        });
        card.classList.add("border-2", "border-[#111827]", "bg-[#F9FAFB]", "shadow-xs");
        card.classList.remove("border-[#eaecf0]", "bg-white");

        selectedTopupCredits = parseInt(card.getAttribute("data-credits") || "150", 10);
        selectedTopupPriceFmt = card.getAttribute("data-price-fmt") || "Rp 179,000";
        selectedTopupLabel = card.getAttribute("data-label") || "150 Credits";

        if (topupSummaryPrice) topupSummaryPrice.textContent = selectedTopupPriceFmt;
        if (btnTopupLabel) btnTopupLabel.textContent = `Buy ${selectedTopupLabel}`;
      });
    });

    // Buy credit button directly inside each card
    const buyCardCreditBtns = document.querySelectorAll(".btn-buy-card-credit");
    buyCardCreditBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();

        const credits = parseInt(btn.getAttribute("data-credits") || "150", 10);
        const label = btn.getAttribute("data-label") || `${credits} Credits`;

        topupCreditsVal += credits;
        if (proTopupCredits) {
          proTopupCredits.textContent = topupCreditsVal.toLocaleString("en-US");
        }

        // Prepend new batch to active top-up packs list (individual 6-month validity)
        if (activeTopupList) {
          const newPackRow = document.createElement("div");
          newPackRow.className = "topup-batch-row flex items-center justify-between px-4 py-3 bg-white hover:bg-[#F9FAFB] transition-colors animate-in fade-in duration-300";
          newPackRow.innerHTML = `
            <div class="flex items-center gap-3">
              <span class="font-bold text-[#111827] text-[13px]">+${credits.toLocaleString("en-US")} cr</span>
              <span class="text-[#98a2b3]">·</span>
              <span class="text-[#667085] text-[12px]">Purchased Today</span>
            </div>
            <span class="text-[11px] font-medium text-[#344054] bg-[#f3f4f6] px-2.5 py-1 rounded-md">Until Mar 09, 2027</span>
          `;
          activeTopupList.insertBefore(newPackRow, activeTopupList.firstChild);
          refreshTopupBatchesVisibility();
        }

        // Prepend new usage row
        if (proUsageTableBody) {
          const newRow = document.createElement("tr");
          newRow.className = "hover:bg-[#F9FAFB] transition-colors";
          newRow.innerHTML = `
            <td class="px-4 py-3 font-medium text-[#111827]">Credit Top-Up (${label})</td>
            <td class="px-4 py-3 font-medium text-[#667085]">Top Up</td>
            <td class="px-4 py-3 text-[#4b5563]">Today, just now</td>
            <td class="px-4 py-3 text-right font-bold text-emerald-600">+${credits.toLocaleString("en-US")}</td>
          `;
          proUsageTableBody.insertBefore(newRow, proUsageTableBody.firstChild);
        }

        closeTopupModal();
        showSubAlert(`Payment successful! +${credits.toLocaleString("en-US")} Top-Up Credits added (Valid for 6 months).`);
      });
    });

    // Handle Top Up Form Submission (Fallback)
    if (formTopup) {
      formTopup.addEventListener("submit", (e) => {
        e.preventDefault();
        topupCreditsVal += selectedTopupCredits;
        if (proTopupCredits) {
          proTopupCredits.textContent = topupCreditsVal.toLocaleString("en-US");
        }

        // Prepend new batch to active top-up packs list (individual 6-month validity)
        if (activeTopupList) {
          const newPackRow = document.createElement("div");
          newPackRow.className = "topup-batch-row flex items-center justify-between px-4 py-3 bg-white hover:bg-[#F9FAFB] transition-colors animate-in fade-in duration-300";
          newPackRow.innerHTML = `
            <div class="flex items-center gap-3">
              <span class="font-bold text-[#111827] text-[13px]">+${selectedTopupCredits.toLocaleString("en-US")} cr</span>
              <span class="text-[#98a2b3]">·</span>
              <span class="text-[#667085] text-[12px]">Purchased Today</span>
            </div>
            <span class="text-[11px] font-medium text-[#344054] bg-[#f3f4f6] px-2.5 py-1 rounded-md">Until Mar 09, 2027</span>
          `;
          activeTopupList.insertBefore(newPackRow, activeTopupList.firstChild);
          refreshTopupBatchesVisibility();
        }

        // Prepend new usage row
        if (proUsageTableBody) {
          const newRow = document.createElement("tr");
          newRow.className = "hover:bg-[#F9FAFB] transition-colors";
          newRow.innerHTML = `
            <td class="px-4 py-3 font-medium text-[#111827]">Credit Top-Up (${selectedTopupLabel})</td>
            <td class="px-4 py-3 font-medium text-[#667085]">Top Up</td>
            <td class="px-4 py-3 text-[#4b5563]">Today, just now</td>
            <td class="px-4 py-3 text-right font-bold text-emerald-600">+${selectedTopupCredits.toLocaleString("en-US")}</td>
          `;
          proUsageTableBody.insertBefore(newRow, proUsageTableBody.firstChild);
        }

        closeTopupModal();
        showSubAlert(`Payment successful! +${selectedTopupCredits.toLocaleString("en-US")} Top-Up Credits added (Valid for 6 months).`);
      });
    }

    // ══════════ BILLING TAB INTERACTIONS ══════════
    // 1. Download Invoice
    const invoiceBtns = document.querySelectorAll(".btn-download-invoice");
    invoiceBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const invId = btn.getAttribute("data-invoice") || "INV";
        showSubAlert(`Invoice ${invId} downloaded successfully (PDF).`);
      });
    });
  });
</script>
