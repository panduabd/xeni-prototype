          <div class="topup-batch-row flex items-center justify-between px-4 py-3 bg-white hover:bg-[#fafafa] transition-colors">
            <div class="flex items-center gap-3">
              <div class="w-7 h-7 rounded-md bg-[#f4f4f5] flex items-center justify-center text-[#18181b] shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" class="text-[#18181b]" aria-hidden="true">
                  <path d="M17.949 9.61616C20.6497 10.6155 22 11.1151 22 12C22 12.8848 20.6497 13.3845 17.949 14.3838L16.4429 14.9411C15.9036 15.1407 15.6339 15.2405 15.4372 15.4372C15.2405 15.6339 15.1407 15.9036 14.9411 16.4429L14.3838 17.949C13.3845 20.6497 12.8848 22 12 22C11.1151 22 10.6155 20.6497 9.61616 17.949L9.05883 16.4429C8.85926 15.9036 8.75948 15.6339 8.56277 15.4372C8.36606 15.2405 8.09641 15.1407 7.5571 14.9411L6.05093 14.3838C3.3503 13.3845 1.99998 12.8848 1.99998 12C1.99998 11.1151 3.3503 10.6155 6.05093 9.61616L7.5571 9.05883C8.09641 8.85926 8.36606 8.75948 8.56277 8.56277C8.75948 8.36606 8.85926 8.09641 9.05883 7.5571L9.61616 6.05093C10.6155 3.3503 11.1151 1.99998 12 1.99998C12.8848 1.99998 13.3845 3.3503 14.3838 6.05093L14.9411 7.5571C15.1407 8.09641 15.2405 8.36606 15.4372 8.56277C15.6339 8.75948 15.9036 8.85926 16.4429 9.05883L17.949 9.61616Z" fill="currentColor"/>
                </svg>
              </div>
              <div>
                <span class="font-medium text-[#18181b] text-xs block">+250 Credits</span>
                <span class="text-[#71717a] text-[11px]">Purchased Aug 15, 2026</span>
              </div>
            </div>
            <div class="text-right">
              <span class="text-xs font-medium text-[#18181b] block">Until Feb 15, 2027</span>
              <span class="text-[10px] text-[#71717a]">158 days remaining</span>
            </div>
          </div>

          <!-- Batch 4 -->
          <div class="topup-batch-row flex items-center justify-between px-4 py-3 bg-white hover:bg-[#fafafa] transition-colors">
            <div class="flex items-center gap-3">
              <div class="w-7 h-7 rounded-md bg-[#f4f4f5] flex items-center justify-center text-[#18181b] shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" class="text-[#18181b]" aria-hidden="true">
                  <path d="M17.949 9.61616C20.6497 10.6155 22 11.1151 22 12C22 12.8848 20.6497 13.3845 17.949 14.3838L16.4429 14.9411C15.9036 15.1407 15.6339 15.2405 15.4372 15.4372C15.2405 15.6339 15.1407 15.9036 14.9411 16.4429L14.3838 17.949C13.3845 20.6497 12.8848 22 12 22C11.1151 22 10.6155 20.6497 9.61616 17.949L9.05883 16.4429C8.85926 15.9036 8.75948 15.6339 8.56277 15.4372C8.36606 15.2405 8.09641 15.1407 7.5571 14.9411L6.05093 14.3838C3.3503 13.3845 1.99998 12.8848 1.99998 12C1.99998 11.1151 3.3503 10.6155 6.05093 9.61616L7.5571 9.05883C8.09641 8.85926 8.36606 8.75948 8.56277 8.56277C8.75948 8.36606 8.85926 8.09641 9.05883 7.5571L9.61616 6.05093C10.6155 3.3503 11.1151 1.99998 12 1.99998C12.8848 1.99998 13.3845 3.3503 14.3838 6.05093L14.9411 7.5571C15.1407 8.09641 15.2405 8.36606 15.4372 8.56277C15.6339 8.75948 15.9036 8.85926 16.4429 9.05883L17.949 9.61616Z" fill="currentColor"/>
                </svg>
              </div>
              <div>
                <span class="font-medium text-[#18181b] text-xs block">+500 Credits</span>
                <span class="text-[#71717a] text-[11px]">Purchased Jul 20, 2026</span>
              </div>
            </div>
            <div class="text-right">
              <span class="text-xs font-medium text-[#18181b] block">Until Jan 20, 2027</span>
              <span class="text-[10px] text-[#71717a]">133 days remaining</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center justify-between pt-3 border-t border-[#eaecf0]">
      <button
        type="button"
        id="btn-detail-modal-to-topup"
        class="inline-flex items-center justify-center gap-1.5 rounded-lg text-xs font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 bg-[#18181b] text-white hover:bg-black h-8 px-3.5 shadow-xs cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" class="text-white" aria-hidden="true">
          <path d="M17.949 9.61616C20.6497 10.6155 22 11.1151 22 12C22 12.8848 20.6497 13.3845 17.949 14.3838L16.4429 14.9411C15.9036 15.1407 15.6339 15.2405 15.4372 15.4372C15.2405 15.6339 15.1407 15.9036 14.9411 16.4429L14.3838 17.949C13.3845 20.6497 12.8848 22 12 22C11.1151 22 10.6155 20.6497 9.61616 17.949L9.05883 16.4429C8.85926 15.9036 8.75948 15.6339 8.56277 15.4372C8.36606 15.2405 8.09641 15.1407 7.5571 14.9411L6.05093 14.3838C3.3503 13.3845 1.99998 12.8848 1.99998 12C1.99998 11.1151 3.3503 10.6155 6.05093 9.61616L7.5571 9.05883C8.09641 8.85926 8.36606 8.75948 8.56277 8.56277C8.75948 8.36606 8.85926 8.09641 9.05883 7.5571L9.61616 6.05093C10.6155 3.3503 11.1151 1.99998 12 1.99998C12.8848 1.99998 13.3845 3.3503 14.3838 6.05093L14.9411 7.5571C15.1407 8.09641 15.2405 8.36606 15.4372 8.56277C15.6339 8.75948 15.9036 8.85926 16.4429 9.05883L17.949 9.61616Z" fill="currentColor"/>
        </svg>
        Top Up Credits
      </button>

      <button
        type="button"
        id="btn-close-topup-detail-bottom"
        class="inline-flex items-center justify-center rounded-lg text-xs font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 border border-[#e4e4e7] bg-white text-[#18181b] hover:bg-[#f4f4f5] h-8 px-3.5 shadow-xs cursor-pointer"
      >
        Close
      </button>
    </div>
