---
// src/components/modals/ManageAccountModal.astro
import SocialIcon from "../icons/SocialIcon.astro";
---

<style is:global>
  #manage-account-modal::-webkit-scrollbar {
    width: 4px;
  }
  #manage-account-content::-webkit-scrollbar {
    width: 4px;
  }
  #manage-account-content::-webkit-scrollbar-thumb {
    background: #d1d5db;
    border-radius: 10px;
  }

  /* Smooth, slow wipe light animation for Upgrade Plan button */
  @keyframes wipe-light-slow {
    0% {
      transform: translateX(-160%) skewX(-20deg);
    }
    30%,
    100% {
      transform: translateX(360%) skewX(-20deg);
    }
  }

  .btn-wipe-shine {
    position: relative;
    overflow: hidden;
  }

  .btn-wipe-shine::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 45%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.22) 50%,
      transparent 100%
    );
    animation: wipe-light-slow 4.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    pointer-events: none;
    z-index: 5;
  }

  .card-wipe-shine {
    position: relative;
    overflow: hidden;
  }

  .card-wipe-shine::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 35%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.35) 50%,
      transparent 100%
    );
    animation: wipe-light-slow 3.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    pointer-events: none;
    z-index: 5;
  }
</style>

<div
  id="manage-account-modal"
  class="hidden fixed inset-0 z-[150] flex items-center justify-center bg-black/40 backdrop-blur-sm p-4 animate-in fade-in duration-200"
>
  <div
    class="bg-white w-full max-w-5xl h-[640px] rounded-[32px] shadow-2xl flex overflow-hidden animate-in zoom-in-95 duration-300 relative border border-[#eaecf0]"
  >
    <!-- Close Button (Top Right of Content Panel) -->
    <button
      id="close-manage-account"
      class="absolute top-6 right-6 w-10 h-10 rounded-full flex items-center justify-center hover:bg-gray-100 transition-colors text-[#667085] z-30 cursor-pointer"
    >
      <i class="ti ti-x text-[20px]"></i>
    </button>

    <!-- LEFT SIDEBAR: NAVIGATION -->
    <aside class="w-[240px] bg-[#eaecf0] border-r border-[#eaecf0] p-5 flex flex-col gap-6 shrink-0">
      <div>
        <div class="px-3 pb-3">
          <h2 class="text-[11px] font-medium uppercase tracking-wider text-[#475467]">Manage Account</h2>
        </div>
        <div class="flex flex-col gap-1">
          <!-- Profile Tab Button -->
          <button
            id="tab-btn-profile"
            class="manage-account-tab-btn flex items-center gap-3 px-3 h-9 rounded-lg text-xs font-medium text-[#111827] bg-white shadow-xs transition-colors cursor-pointer text-left w-full"
            data-tab="profile"
          >
            <i class="ti ti-user-circle text-[16px]"></i>
            Profile
          </button>
          <!-- Subscription Tab Button -->
          <button
            id="tab-btn-subscription"
            class="manage-account-tab-btn flex items-center gap-3 px-3 h-9 rounded-lg text-xs font-medium text-[#475467] hover:bg-white/60 hover:text-[#111827] transition-colors cursor-pointer text-left w-full"
            data-tab="subscription"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" class="shrink-0" aria-hidden="true">
              <path d="M17.949 9.61616C20.6497 10.6155 22 11.1151 22 12C22 12.8848 20.6497 13.3845 17.949 14.3838L16.4429 14.9411C15.9036 15.1407 15.6339 15.2405 15.4372 15.4372C15.2405 15.6339 15.1407 15.9036 14.9411 16.4429L14.3838 17.949C13.3845 20.6497 12.8848 22 12 22C11.1151 22 10.6155 20.6497 9.61616 17.949L9.05883 16.4429C8.85926 15.9036 8.75948 15.6339 8.56277 15.4372C8.36606 15.2405 8.09641 15.1407 7.5571 14.9411L6.05093 14.3838C3.3503 13.3845 1.99998 12.8848 1.99998 12C1.99998 11.1151 3.3503 10.6155 6.05093 9.61616L7.5571 9.05883C8.09641 8.85926 8.36606 8.75948 8.56277 8.56277C8.75948 8.36606 8.85926 8.09641 9.05883 7.5571L9.61616 6.05093C10.6155 3.3503 11.1151 1.99998 12 1.99998C12.8848 1.99998 13.3845 3.3503 14.3838 6.05093L14.9411 7.5571C15.1407 8.09641 15.2405 8.36606 15.4372 8.56277C15.6339 8.75948 15.9036 8.85926 16.4429 9.05883L17.949 9.61616Z" fill="currentColor"/>
            </svg>
            Subscription
          </button>
          <!-- Billing Tab Button -->
          <button
            id="tab-btn-billing"
            class="manage-account-tab-btn flex items-center gap-3 px-3 h-9 rounded-lg text-xs font-medium text-[#475467] hover:bg-white/60 hover:text-[#111827] transition-colors cursor-pointer text-left w-full"
            data-tab="billing"
          >
            <i class="ti ti-receipt text-[16px]"></i>
            Billing
          </button>
          <!-- Affiliate Tab Button -->
          <button
            id="tab-btn-affiliate"
            class="manage-account-tab-btn flex items-center gap-3 px-3 h-9 rounded-lg text-xs font-medium text-[#475467] hover:bg-white/60 hover:text-[#111827] transition-colors cursor-pointer text-left w-full"
            data-tab="affiliate"
          >
            <i class="ti ti-users text-[16px]"></i>
            Affiliate
          </button>
          <!-- Feedback Tab Button -->
          <button
            id="tab-btn-feedback"
            class="manage-account-tab-btn flex items-center gap-3 px-3 h-9 rounded-lg text-xs font-medium text-[#475467] hover:bg-white/60 hover:text-[#111827] transition-colors cursor-pointer text-left w-full"
            data-tab="feedback"
          >
            <i class="ti ti-message-dots text-[16px]"></i>
            Feedback
          </button>
        </div>
      </div>
    </aside>

    <!-- RIGHT PANEL: CONTENT -->
    <main id="manage-account-content" class="flex-1 p-10 overflow-y-auto bg-white relative">
      
      <!-- ══════════ PROFILE TAB CONTENT ══════════ -->
      <section id="manage-account-tab-profile" class="manage-account-tab-section space-y-6">
        <div>
          <h3 class="text-lg font-semibold text-[#111827] tracking-tight">Profile</h3>
        </div>
          
        <!-- Card 1: Avatar & Profile Info -->
        <div class="rounded-xl border border-[#eaecf0] bg-white p-5 shadow-xs">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3.5">
              <div class="w-14 h-14 rounded-full border border-[#eaecf0] bg-[#f4f4f5] overflow-hidden shrink-0 shadow-2xs">
                <img
                  src="https://api.dicebear.com/7.x/avataaars/svg?seed=Jane"
                  class="w-full h-full object-cover"
                  alt="avatar"
                />
              </div>
              <div>
                <h4 class="text-sm font-semibold text-[#111827]">Jane Cooper</h4>
                <p class="text-xs text-[#71717a]">jane@xeni.io</p>
              </div>
            </div>
            <button
              type="button"
              class="inline-flex items-center justify-center gap-1.5 h-8 px-3 rounded-lg border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-xs font-medium text-[#18181b] transition-colors shadow-xs cursor-pointer"
            >
              <i class="ti ti-camera text-sm"></i>
              <span>Change photo</span>
            </button>
          </div>
        </div>

        <!-- Card 2: Account Details -->
        <div class="rounded-xl border border-[#eaecf0] bg-white shadow-xs overflow-hidden">
          <div class="p-5 pb-3">
            <h4 class="text-sm font-semibold text-[#111827]">Personal Details</h4>
          </div>
          <div class="divide-y divide-[#eaecf0] border-t border-[#eaecf0] text-xs">
            <div class="flex items-center justify-between px-5 py-3">
              <span class="text-[#71717a] font-medium">Full Name</span>
              <div class="flex items-center gap-2">
                <span class="text-[#18181b] font-normal">Jane Cooper</span>
                <button type="button" class="text-[#71717a] hover:text-[#18181b] transition-colors cursor-pointer p-0.5" title="Edit name">
                  <i class="ti ti-pencil text-sm"></i>
                </button>
              </div>
            </div>
            <div class="flex items-center justify-between px-5 py-3">
              <span class="text-[#71717a] font-medium">Email Address</span>
              <span class="text-[#18181b] font-normal">jane@xeni.io</span>
            </div>
            <div class="flex items-center justify-between px-5 py-3">
              <div>
                <span class="text-[#71717a] font-medium block">User ID</span>
                <span class="text-[11px] text-[#a1a1aa] font-mono">310519663553695297</span>
              </div>
              <button
                type="button"
                id="btn-copy-userid"
                class="inline-flex items-center justify-center gap-1.5 h-7 px-2.5 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[11px] font-medium text-[#18181b] transition-colors shadow-2xs cursor-pointer"
              >
                <i class="ti ti-copy text-xs"></i>
                <span>Copy</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Card 3: Account & Security -->
        <div class="rounded-xl border border-[#eaecf0] bg-white shadow-xs overflow-hidden">
          <div class="p-5 pb-3">
            <h4 class="text-sm font-semibold text-[#111827]">Account Management</h4>
          </div>
          <div class="border-t border-[#eaecf0] text-xs">
            <div class="flex items-center justify-between px-5 py-3.5">
              <div>
                <span class="text-[#18181b] font-medium block">Sign out from this device</span>
                <span class="text-[11px] text-[#71717a]">Securely end your active session on this browser.</span>
              </div>
              <button
                type="button"
                id="btn-logout-modal"
                class="inline-flex items-center justify-center h-8 px-3 rounded-lg border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-xs font-medium text-[#18181b] transition-colors shadow-xs cursor-pointer shrink-0"
              >
                Sign Out
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- ══════════ SUBSCRIPTION TAB CONTENT ══════════ -->
      <section id="manage-account-tab-subscription" class="manage-account-tab-section space-y-6 hidden">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-lg font-semibold text-[#111827] tracking-tight">Subscription</h3>
            <p class="text-xs text-[#71717a] mt-0.5">Manage your billing, plan tier, and credit balances.</p>
          </div>
          <div class="relative group/dev inline-flex">
            <div class="flex items-center gap-1 bg-[#f4f4f5] p-1 rounded-lg text-xs">
              <button id="btn-switch-plan-free" type="button" class="px-3 py-1 rounded-lg font-medium transition-all cursor-pointer bg-white text-[#111827] shadow-xs">Free</button>
              <button id="btn-switch-plan-pro" type="button" class="px-3 py-1 rounded-lg font-medium transition-all cursor-pointer text-[#667085] hover:text-[#111827]">Pro</button>
            </div>
            <!-- Tooltip: For Developer Purposes -->
            <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 flex flex-col items-center pointer-events-none z-50 opacity-0 invisible group-hover/dev:opacity-100 group-hover/dev:visible transition-all duration-200 ease-out transform translate-y-1 group-hover/dev:translate-y-0">
              <div class="bg-[#111827] text-white text-[11px] font-medium px-2.5 py-1 rounded-md shadow-lg whitespace-nowrap">
                For Developer Purposes
              </div>
              <div class="w-1.5 h-1.5 bg-[#111827] rotate-45 -mt-0.75"></div>
            </div>
          </div>
        </div>

        <!-- ── STATE 1: FREE PLAN ── -->
        <div id="subscription-view-free" class="space-y-6">
          <!-- 2 Columns: Free Plan & Credits Available -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Current Plan Card -->
            <div class="p-5 rounded-xl border border-[#eaecf0] bg-white shadow-xs flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between">
                  <span class="text-xs font-medium text-[#71717a]">Current Plan</span>
                  <span class="inline-flex items-center rounded-md border border-[#e4e4e7] bg-[#f4f4f5] px-2 py-0.5 text-[10.5px] font-medium text-[#71717a]">Free Plan</span>
                </div>
                <div class="mt-3">
                  <h4 class="text-lg font-semibold text-[#111827]">Free Plan</h4>
                </div>
              </div>
              <div class="mt-5 pt-3.5 border-t border-[#eaecf0] flex items-center justify-end">
                <button
                  id="btn-upgrade-plan-action"
                  type="button"
                  class="inline-flex items-center justify-center h-8 px-3.5 rounded-lg bg-[#18181b] hover:bg-black text-white text-xs font-medium transition-colors shadow-xs cursor-pointer shrink-0"
                >
                  Upgrade to Pro
                </button>
              </div>
            </div>

            <!-- Credits Balance Card -->
            <div class="p-5 rounded-xl border border-[#eaecf0] bg-white shadow-xs flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between">
                  <span class="text-xs font-medium text-[#71717a]">Available Credits</span>
                </div>
                <div class="flex items-center gap-2.5 mt-3">
                  <div class="w-8 h-8 rounded-lg bg-[#f4f4f5] border border-[#eaecf0] flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" class="text-[#18181b]" aria-hidden="true">
                      <path d="M17.949 9.61616C20.6497 10.6155 22 11.1151 22 12C22 12.8848 20.6497 13.3845 17.949 14.3838L16.4429 14.9411C15.9036 15.1407 15.6339 15.2405 15.4372 15.4372C15.2405 15.6339 15.1407 15.9036 14.9411 16.4429L14.3838 17.949C13.3845 20.6497 12.8848 22 12 22C11.1151 22 10.6155 20.6497 9.61616 17.949L9.05883 16.4429C8.85926 15.9036 8.75948 15.6339 8.56277 15.4372C8.36606 15.2405 8.09641 15.1407 7.5571 14.9411L6.05093 14.3838C3.3503 13.3845 1.99998 12.8848 1.99998 12C1.99998 11.1151 3.3503 10.6155 6.05093 9.61616L7.5571 9.05883C8.09641 8.85926 8.36606 8.75948 8.56277 8.56277C8.75948 8.36606 8.85926 8.09641 9.05883 7.5571L9.61616 6.05093C10.6155 3.3503 11.1151 1.99998 12 1.99998C12.8848 1.99998 13.3845 3.3503 14.3838 6.05093L14.9411 7.5571C15.1407 8.09641 15.2405 8.36606 15.4372 8.56277C15.6339 8.75948 15.9036 8.85926 16.4429 9.05883L17.949 9.61616Z" fill="currentColor"/>
                    </svg>
                  </div>
                  <span class="text-2xl font-semibold text-[#111827] leading-none">30</span>
                  <span class="text-xs text-[#71717a] ml-0.5">credits</span>
                </div>
              </div>
              <div class="mt-5 pt-3.5 border-t border-[#eaecf0] text-xs text-[#71717a] flex items-center justify-between min-h-[32px]">
                <span>Quota status</span>
                <span class="inline-flex items-center rounded-md border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[10.5px] font-medium text-emerald-700">Welcome Bonus (Active)</span>
              </div>
            </div>
          </div>

          <!-- Usage History -->
          <div class="space-y-3 pt-1">
            <h4 class="text-sm font-semibold text-[#111827]">Usage History</h4>
            <div class="border border-[#eaecf0] rounded-xl overflow-hidden shadow-xs bg-white text-xs">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="bg-[#fafafa] border-b border-[#eaecf0] text-[#71717a] text-[11px] font-medium uppercase tracking-wider">
                    <th class="px-4 py-2.5">Activity</th>
                    <th class="px-4 py-2.5">Date</th>
                    <th class="px-4 py-2.5 text-right">Amount</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-[#eaecf0] text-[#18181b]">
                  <tr class="hover:bg-[#fafafa]/50 transition-colors">
                    <td class="px-4 py-3 font-medium text-[#111827]">Registration Welcome Bonus</td>
                    <td class="px-4 py-3 text-[#71717a]">2026-09-09 10:00</td>
                    <td class="px-4 py-3 text-right font-medium text-emerald-600">+30</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ── STATE 2: PRO PLAN ── -->
        <div id="subscription-view-pro" class="hidden space-y-6">
          <!-- Current Plan Card -->
          <div class="p-5 rounded-xl border border-[#eaecf0] bg-white shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#000000" viewBox="0 0 256 256" class="shrink-0" aria-hidden="true">
                  <path d="M239.75,90.81c0,.11,0,.21-.07.32L217,195a16,16,0,0,1-15.72,13H54.71A16,16,0,0,1,39,195L16.32,91.13c0-.11-.05-.21-.07-.32A16,16,0,0,1,44,77.39l33.67,36.29,35.8-80.29a1,1,0,0,0,0-.1,16,16,0,0,1,29.06,0,1,1,0,0,0,0,.1l35.8,80.29L212,77.39a16,16,0,0,1,27.71,13.42Z"></path>
                </svg>
                <h4 class="text-lg font-semibold text-[#111827]" id="active-plan-title">Pro Plan</h4>
                <span class="inline-flex items-center rounded-md border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[10.5px] font-medium text-emerald-700" id="active-plan-badge">Active</span>
              </div>
              <p class="text-xs text-[#71717a] mt-1" id="active-plan-subtitle">Rp 390,000 / month · Auto-renews on Oct 09, 2026</p>
            </div>
            <div class="flex items-center gap-2">
              <button
                id="btn-open-topup-pro"
                type="button"
                class="inline-flex items-center justify-center h-8 px-3.5 rounded-lg bg-[#18181b] hover:bg-black text-white text-xs font-medium transition-colors shadow-xs cursor-pointer"
              >
                Top Up Credits
              </button>
              <button
                id="btn-manage-subscription-action"
                type="button"
                class="inline-flex items-center justify-center h-8 px-3.5 rounded-lg border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-xs font-medium text-[#18181b] transition-colors shadow-xs cursor-pointer"
              >
                Manage Subscription
              </button>
            </div>
          </div>

          <!-- Credits Balance: Separated 2 Balanced Columns -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Column 1: Monthly Subscription Credits -->
            <div class="p-5 rounded-xl border border-[#eaecf0] bg-white shadow-xs flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between">
                  <span class="text-xs font-medium text-[#71717a]">Monthly Credits</span>
                  <span class="inline-flex items-center rounded-md border border-[#e4e4e7] bg-[#f4f4f5] px-2 py-0.5 text-[10px] font-medium text-[#71717a]">Subscription</span>
                </div>
                <div class="flex items-center gap-2.5 mt-3">
                  <div class="w-8 h-8 rounded-lg bg-[#f4f4f5] border border-[#eaecf0] flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" class="text-[#18181b]" aria-hidden="true">
                      <path d="M17.949 9.61616C20.6497 10.6155 22 11.1151 22 12C22 12.8848 20.6497 13.3845 17.949 14.3838L16.4429 14.9411C15.9036 15.1407 15.6339 15.2405 15.4372 15.4372C15.2405 15.6339 15.1407 15.9036 14.9411 16.4429L14.3838 17.949C13.3845 20.6497 12.8848 22 12 22C11.1151 22 10.6155 20.6497 9.61616 17.949L9.05883 16.4429C8.85926 15.9036 8.75948 15.6339 8.56277 15.4372C8.36606 15.2405 8.09641 15.1407 7.5571 14.9411L6.05093 14.3838C3.3503 13.3845 1.99998 12.8848 1.99998 12C1.99998 11.1151 3.3503 10.6155 6.05093 9.61616L7.5571 9.05883C8.09641 8.85926 8.36606 8.75948 8.56277 8.56277C8.75948 8.36606 8.85926 8.09641 9.05883 7.5571L9.61616 6.05093C10.6155 3.3503 11.1151 1.99998 12 1.99998C12.8848 1.99998 13.3845 3.3503 14.3838 6.05093L14.9411 7.5571C15.1407 8.09641 15.2405 8.36606 15.4372 8.56277C15.6339 8.75948 15.9036 8.85926 16.4429 9.05883L17.949 9.61616Z" fill="currentColor"/>
                    </svg>
                  </div>
                  <span class="text-2xl font-semibold text-[#111827] leading-none" id="pro-monthly-credits">1,000</span>
                </div>
              </div>
              <div class="mt-4 pt-3 border-t border-[#eaecf0] text-xs text-[#71717a] flex items-center justify-between min-h-[28px]">
                <span>Expires</span>
                <span class="font-medium text-[#18181b]">Oct 09, 2026</span>
              </div>
            </div>

            <!-- Column 2: Top Up Credits Summary -->
            <div class="p-5 rounded-xl border border-[#eaecf0] bg-white shadow-xs flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between">
                  <span class="text-xs font-medium text-[#71717a]">Top-Up Credits</span>
                  <span class="inline-flex items-center rounded-md border border-[#e4e4e7] bg-[#f4f4f5] px-2 py-0.5 text-[10px] font-medium text-[#71717a]">6-mo validity</span>
                </div>
                <div class="flex items-center gap-2.5 mt-3">
