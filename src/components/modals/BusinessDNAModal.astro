---

<style is:global>
  #dna-main-content::-webkit-scrollbar {
    width: 5px;
  }
  #dna-main-content::-webkit-scrollbar-track {
    background: transparent;
  }
  #dna-main-content::-webkit-scrollbar-thumb {
    background: #e2e8f0;
    border-radius: 9999px;
  }
  #dna-main-content::-webkit-scrollbar-thumb:hover {
    background: #cbd5e1;
  }
  #dna-main-content {
    scrollbar-width: thin;
    scrollbar-color: #e2e8f0 transparent;
  }
</style>

<div
  id="business-dna-modal"
  class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/40 backdrop-blur-xs p-4 animate-in fade-in duration-150"
>
  <div
    class="bg-white w-full max-w-[460px] rounded-2xl shadow-2xl border border-[#eaecf0] flex flex-col overflow-hidden animate-in zoom-in-95 duration-200"
  >
    <!-- Header -->
    <div class="px-5 pt-4 pb-2 flex items-center justify-between">
      <h2 class="text-[15px] font-semibold text-[#111827]">Business DNA</h2>
      <button
        id="close-business-dna"
        class="w-7 h-7 rounded-lg flex items-center justify-center text-[#98a2b3] hover:text-[#344054] hover:bg-[#f2f4f7] transition-colors cursor-pointer"
        title="Close"
      >
        <i class="ti ti-x text-[16px]"></i>
      </button>
    </div>

    <!-- Search Input Bar -->
    <div class="px-5 pt-3 pb-1.5">
      <div class="relative w-full">
        <i class="ti ti-search absolute left-2.5 top-1/2 -translate-y-1/2 text-[#98a2b3] text-[13px] pointer-events-none"></i>
        <input
          id="dna-search-input"
          type="text"
          placeholder="Search Business DNA..."
          class="w-full h-8.5 pl-8 pr-3 text-[12px] bg-[#f9fafb] border border-[#eaecf0] rounded-lg outline-none focus:bg-white focus:border-[#2563eb] transition-all placeholder:text-[#98a2b3]"
        />
      </div>
    </div>

    <!-- Scrollable Content Area -->
    <div class="relative px-5 py-2">
      <div
        id="dna-main-content"
        class="max-h-[260px] overflow-y-auto space-y-1.5 pr-1"
      >
        {businessList.map((item) => (
          <button
            type="button"
            class="dna-item w-full flex items-center gap-3 p-2.5 rounded-xl border border-[#eaecf0] bg-white text-left transition-all hover:border-[#d0d5dd] hover:bg-gray-50/80 group cursor-pointer"
            data-name={item.name}
          >
            <!-- Logo Image -->
            <div class="w-9 h-9 rounded-lg overflow-hidden shrink-0 border border-black/5 bg-gray-100 flex items-center justify-center shadow-2xs">
              <img
                src={item.logo}
                alt={item.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                loading="lazy"
              />
            </div>

            <!-- Content -->
            <div class="flex-1 min-w-0 pr-2">
              <h4 class="text-[13px] font-semibold text-[#111827] truncate leading-tight mb-0.5">
                {item.name}
              </h4>
              <p class="dna-desc text-[11.5px] text-[#667085] truncate leading-tight">
                {item.tagline}
              </p>
            </div>

            <!-- Check Badge -->
            <div class="w-4.5 h-4.5 rounded-full bg-[#2563eb] flex items-center justify-center hidden check-badge shrink-0 shadow-2xs">
              <i class="ti ti-check text-[11px] text-white"></i>
            </div>
          </button>
        ))}

        <!-- Empty Search State -->
        <div id="dna-empty-state" class="hidden py-6 text-center">
          <p class="text-[12.5px] text-[#667085]">No matching Business DNA found.</p>
        </div>
      </div>

      <!-- Bottom Separator & Create Action -->
      <div class="pt-2">
        <a
          href="/business-dna"
          class="w-full flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl border border-dashed border-[#d0d5dd] text-[12px] font-medium text-[#475467] hover:border-[#2563eb] hover:bg-blue-50/30 hover:text-[#2563eb] transition-all cursor-pointer"
        >
          <i class="ti ti-plus text-[13px]"></i>
          <span>Create New Business DNA</span>
        </a>
      </div>
    </div>

    <!-- Pinned Footer -->
    <div class="px-5 pt-2 pb-4 bg-white flex items-center justify-end gap-2">
      <button
        type="button"
        id="cancel-business-dna"
        class="px-3.5 h-8.5 rounded-lg border border-[#d0d5dd] bg-white text-[12.5px] font-medium text-[#344054] hover:bg-gray-50 shadow-2xs transition-all cursor-pointer"
      >
        Cancel
      </button>
      <button
        type="button"
        class="btn-active-dark px-4 h-8.5 rounded-lg bg-[#111827] text-white text-[12.5px] font-semibold hover:bg-black shadow-2xs transition-all cursor-pointer"
      >
        Apply
      </button>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById("dna-search-input");
    const emptyState = document.getElementById("dna-empty-state");
    const dnaItems = document.querySelectorAll(".dna-item");

    // Search filter
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        const val = e.target.value.toLowerCase().trim();
        let visible = 0;
        dnaItems.forEach((item) => {
          const name = (item.getAttribute("data-name") || "").toLowerCase();
          const desc = (item.querySelector(".dna-desc")?.textContent || "").toLowerCase();
          if (name.includes(val) || desc.includes(val)) {
            item.style.display = "flex";
            visible++;
          } else {
            item.style.display = "none";
          }
        });
        if (emptyState) {
          emptyState.classList.toggle("hidden", visible > 0);
        }
      });
    }
  });
</script>
