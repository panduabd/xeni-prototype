---
// src/components/modals/GetCreditsModal.astro
import Pricing from "@/components/ui/pricing";
---

<style is:global>
  #get-credits-modal::-webkit-scrollbar {
    width: 6px;
  }
  #get-credits-content::-webkit-scrollbar {
    width: 6px;
  }
  #get-credits-content::-webkit-scrollbar-thumb {
    background: #d1d5db;
    border-radius: 10px;
  }
</style>

<div
  id="get-credits-modal"
  class="hidden fixed inset-0 z-[200] flex items-center justify-center bg-black/50 backdrop-blur-sm p-3 sm:p-6 animate-in fade-in duration-200"
>
  <div
    class="bg-[#F8F9FB] w-full max-w-[1380px] h-[95vh] max-h-[960px] rounded-[28px] sm:rounded-[32px] shadow-2xl flex flex-col overflow-hidden animate-in zoom-in-95 duration-300 relative border border-[#eaecf0]"
  >
    <!-- Close Button -->
    <button
      id="close-get-credits"
      type="button"
      class="absolute top-4 right-4 sm:top-5 sm:right-5 w-8 h-8 rounded-full bg-transparent flex items-center justify-center text-[#9CA3AF] hover:text-[#111827] hover:bg-black/5 transition-colors z-50 cursor-pointer"
      aria-label="Close modal"
    >
      <i class="ti ti-x text-[20px]"></i>
    </button>

    <!-- Scrollable Content Container -->
    <div id="get-credits-content" class="flex-1 overflow-y-auto px-4 pt-14 pb-6 sm:px-6 sm:pt-[72px] sm:pb-8">
      <Pricing client:load className="!pt-0 !py-0 pb-4 border-b-0 [--line-width:0px]" containerClassName="gap-6 sm:gap-7" plansClassName="mt-2 sm:mt-2.5" />
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("get-credits-modal");
    const closeBtn = document.getElementById("close-get-credits");

    if (closeBtn && modal) {
      closeBtn.addEventListener("click", () => {
        modal.classList.add("hidden");
      });
      modal.addEventListener("click", (e) => {
        if (e.target === modal) modal.classList.add("hidden");
      });
    }

    window.addEventListener("open-get-credits", () => {
      if (modal) {
        modal.classList.remove("hidden");
      }
    });

    var monthlyData = {
      Starter: { price: "140K", badge: "53% OFF", orig: "Rp 300K", subtext: "Billed monthly, cancel anytime.", note: '<span><strong class="font-semibold text-foreground">Save Rp 240K</strong><span> with annual billing</span></span><span class="transition-transform group-hover/save:translate-x-0.5">→</span>' },
      Basic: { price: "280K", badge: "49% OFF", orig: "Rp 550K", subtext: "Billed monthly, cancel anytime.", note: '<span><strong class="font-semibold text-foreground">Save Rp 480K</strong><span> with annual billing</span></span><span class="transition-transform group-hover/save:translate-x-0.5">→</span>' },
      Pro: { price: "680K", badge: "55% OFF", orig: "Rp 1.500K", subtext: "Billed monthly, cancel anytime.", note: '<span><strong class="font-semibold text-foreground">Save Rp 1.680K</strong><span> with annual billing</span></span><span class="transition-transform group-hover/save:translate-x-0.5">→</span>' },
      Agency: { price: "1.680K", badge: "40% OFF", orig: "Rp 2.800K", subtext: "Billed monthly, cancel anytime.", note: '<span><strong class="font-semibold text-foreground">Save Rp 3.360K</strong><span> with annual billing</span></span><span class="transition-transform group-hover/save:translate-x-0.5">→</span>' }
    };

    var annualData = {
      Starter: { price: "120K", badge: "60% OFF", orig: "Rp 300K", subtext: "Billed annually, cancel anytime.", noteText: '<span><strong class="font-semibold text-foreground">Save Rp 240K</strong><span> compared to monthly</span></span>' },
      Basic: { price: "240K", badge: "56% OFF", orig: "Rp 550K", subtext: "Billed annually, cancel anytime.", noteText: '<span><strong class="font-semibold text-foreground">Save Rp 480K</strong><span> compared to monthly</span></span>' },
      Pro: { price: "540K", badge: "64% OFF", orig: "Rp 1.500K", subtext: "Billed annually, cancel anytime.", noteText: '<span><strong class="font-semibold text-foreground">Save Rp 1.680K</strong><span> compared to monthly</span></span>' },
      Agency: { price: "1.400K", badge: "50% OFF", orig: "Rp 2.800K", subtext: "Billed annually, cancel anytime.", noteText: '<span><strong class="font-semibold text-foreground">Save Rp 3.360K</strong><span> compared to monthly</span></span>' }
    };

    function updateModalCycle(cycle) {
      var isAnnual = cycle === "annual";
      if (!modal) return;

      var mBtnNow = modal.querySelector("#pricing-toggle-monthly");
      var aBtnNow = modal.querySelector("#pricing-toggle-annual");

      if (mBtnNow && aBtnNow) {
        if (isAnnual) {
          mBtnNow.className = "inline-flex items-center justify-center whitespace-nowrap rounded-lg px-5 py-1.5 text-sm font-medium transition-all cursor-pointer select-none font-poppins relative z-50 pointer-events-auto text-muted-foreground hover:text-foreground";
          aBtnNow.className = "inline-flex items-center gap-2 justify-center whitespace-nowrap rounded-lg px-5 py-1.5 text-sm font-medium transition-all cursor-pointer select-none font-poppins relative z-50 pointer-events-auto bg-background text-foreground shadow-xs font-semibold";
        } else {
          aBtnNow.className = "inline-flex items-center gap-2 justify-center whitespace-nowrap rounded-lg px-5 py-1.5 text-sm font-medium transition-all cursor-pointer select-none font-poppins relative z-50 pointer-events-auto text-muted-foreground hover:text-foreground";
          mBtnNow.className = "inline-flex items-center justify-center whitespace-nowrap rounded-lg px-5 py-1.5 text-sm font-medium transition-all cursor-pointer select-none font-poppins relative z-50 pointer-events-auto bg-background text-foreground shadow-xs font-semibold";
        }
      }

      var dataSet = isAnnual ? annualData : monthlyData;

      Object.keys(dataSet).forEach(function (planName) {
        var card = modal.querySelector('[data-plan="' + planName + '"]');
        if (!card) return;

        var planInfo = dataSet[planName];

        var priceEl = card.querySelector("[data-price-amount]");
        if (priceEl) priceEl.textContent = planInfo.price;

        var origEl = card.querySelector("[data-original-price-wrap]");
        if (origEl) {
          origEl.style.display = "";
          origEl.textContent = planInfo.orig;
        }

        var badgeEl = card.querySelector("[data-discount-badge]");
        if (badgeEl) badgeEl.textContent = planInfo.badge;

        var subEl = card.querySelector("[data-billing-subtext]");
        if (subEl) subEl.textContent = planInfo.subtext;

        var noteArea = card.querySelector("[data-note-area]");
        if (noteArea) {
          if (isAnnual) {
            noteArea.innerHTML = '<p class="text-muted-foreground text-[12px] leading-snug font-normal text-center">' + planInfo.noteText + '</p>';
          } else {
            noteArea.innerHTML = '<button type="button" data-action="switch-annual" class="text-muted-foreground hover:text-foreground text-[12px] leading-snug font-normal inline-flex items-center justify-center gap-1 cursor-pointer transition-colors group/save select-none">' + planInfo.note + '</button>';
          }
        }
      });
    }

    // Toggle click handler & CTA upgrade click handler
    document.addEventListener("click", (e) => {
      const target = e.target;
      if (!target) return;

      var toggleAnn = target.closest && target.closest("#pricing-toggle-annual");
      var toggleMon = target.closest && target.closest("#pricing-toggle-monthly");
      var switchAnn = target.closest && target.closest('[data-action="switch-annual"]');

      if (toggleAnn || switchAnn) {
        if (window.__setBillingCycle) window.__setBillingCycle("annual");
        updateModalCycle("annual");
      } else if (toggleMon) {
        if (window.__setBillingCycle) window.__setBillingCycle("monthly");
        updateModalCycle("monthly");
      }

      const card = target.closest && target.closest("[data-plan]");
      const ctaBtn = target.closest && target.closest("a");
      if (card && ctaBtn && modal && !modal.classList.contains("hidden")) {
        const href = ctaBtn.getAttribute("href");
        if (href === "/login") {
          e.preventDefault();
          modal.classList.add("hidden");
          window.dispatchEvent(new CustomEvent("upgraded-to-pro"));
          window.dispatchEvent(new CustomEvent("open-manage-account", { detail: { tab: "subscription" } }));
        }
      }
    });
  });
</script>
