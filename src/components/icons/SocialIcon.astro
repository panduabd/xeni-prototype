---
interface Props {
  platform: string;
  size?: "sm" | "md" | "lg" | "share";
  class?: string;
}

const { platform, size = "md", class: extraClass = "" } = Astro.props;
const p = (platform || "").toLowerCase();

const sizeMap: Record<string, Record<string, string>> = {
  sm: {
    instagram: "w-3.5 h-3.5",
    threads: "w-3.5 h-3.5",
    facebook: "w-[11px] h-[11px]",
    tiktok: "w-[11px] h-[11px]",
    whatsapp: "w-[11px] h-[11px]",
    x: "w-[11px] h-[11px]",
  },
  md: {
    instagram: "w-[17.5px] h-[17.5px]",
    threads: "w-[17.5px] h-[17.5px]",
    facebook: "w-[13.5px] h-[13.5px]",
    tiktok: "w-[13.5px] h-[13.5px]",
    whatsapp: "w-[13.5px] h-[13.5px]",
    x: "w-[13.5px] h-[13.5px]",
  },
  lg: {
    instagram: "w-5 h-5",
    threads: "w-5 h-5",
    facebook: "w-[15.5px] h-[15.5px]",
    tiktok: "w-[15.5px] h-[15.5px]",
    whatsapp: "w-[15.5px] h-[15.5px]",
    x: "w-[15.5px] h-[15.5px]",
  },
  share: {
    instagram: "w-4 h-4",
    threads: "w-4 h-4",
    facebook: "w-[12.5px] h-[12.5px]",
    tiktok: "w-[12.5px] h-[12.5px]",
    whatsapp: "w-[12.5px] h-[12.5px]",
    x: "w-[12.5px] h-[12.5px]",
  },
};

const igId = `ig-${Math.random().toString(36).slice(2, 8)}`;

const currentSize = sizeMap[size] || sizeMap.md;

function getIconClass(platKey: string): string {
  const baseSize = currentSize[platKey] || "w-4 h-4";
  const cleanedExtra = extraClass
    .split(/\s+/)
    .filter(
      (c) =>
        c &&
        !c.startsWith("w-") &&
        !c.startsWith("h-") &&
        !c.startsWith("w-[") &&
        !c.startsWith("h-[")
    )
    .join(" ");
  return `${baseSize} shrink-0 ${cleanedExtra}`.trim();
}
---

{p.includes("instagram") && (
  <svg class={getIconClass("instagram")} viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id={igId} x1="0" y1="1" x2="1" y2="0">
        <stop offset="0%" stop-color="#f9a825"/>
        <stop offset="20%" stop-color="#f77737"/>
        <stop offset="45%" stop-color="#e1306c"/>
        <stop offset="70%" stop-color="#c13584"/>
        <stop offset="100%" stop-color="#833ab4"/>
      </linearGradient>
    </defs>
    <path fill={`url(#${igId})`} d="M128,80a48,48,0,1,0,48,48A48.05,48.05,0,0,0,128,80Zm0,72a24,24,0,1,1,24-24A24,24,0,0,1,128,152ZM176,20H80A60.07,60.07,0,0,0,20,80v96a60.07,60.07,0,0,0,60,60h96a60.07,60.07,0,0,0,60-60V80A60.07,60.07,0,0,0,176,20Zm36,156a36,36,0,0,1-36,36H80a36,36,0,0,1-36-36V80A36,36,0,0,1,80,44h96a36,36,0,0,1,36,36ZM196,76a16,16,0,1,1-16-16A16,16,0,0,1,196,76Z"/>
  </svg>
)}

